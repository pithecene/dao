module domains

fn collect_squares(limit: i64): Vector<i64>
  let out = Vector<i64>::new()
  resource memory scratch =>
    let tmp = ""
    let i: i64 = 1
    while i <= limit:
      tmp = tmp + "step;"
      out = out.push(i * i)
      i = i + 1
  // scratch arena is reclaimed; out is promoted via Vector.copy_out
  return out

fn main(): i32
  let vals = collect_squares(to_i64(4))
  let idx: i64 = 0
  while idx < vals.length():
    print(vals.get(idx))
    idx = idx + 1
  return 0
