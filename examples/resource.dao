module resource_demo
fn compute_in_pool(): i32
  let result: i32 = 0
  resource memory pool =>
    let a: i32 = 10
    let b: i32 = 20
    result = a + b
  return result

fn nested_domains(): i32
  let total: i32 = 0
  resource memory outer =>
    let x: i32 = 100
    resource memory inner =>
      let y: i32 = 50
      total = x + y
  return total

fn early_return(flag: i32): i32
  resource memory arena =>
    if flag > 0:
      return flag
    let x: i32 = 42
  return 0

fn scratch_in_pool(): i64
  // Everything the block allocates -- every intermediate string here --
  // is the block's, reclaimed when it ends; only the length leaves.
  let size: i64 = 0
  resource memory scratch =>
    let text: string = ""
    let i: i32 = 0
    while i < 100:
      text = text + "ab"
      i = i + 1
    size = length(text)
  return size

fn main(): i32
  print("scratch_in_pool:")
  print(scratch_in_pool())
  print("compute_in_pool:")
  print(compute_in_pool())
  print("nested_domains:")
  print(nested_domains())
  print("early_return(5):")
  print(early_return(5))
  print("early_return(0):")
  print(early_return(0))
  return 0
