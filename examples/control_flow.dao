module control_flow
fn factorial(n: i32): i32
  let result = 1
  let i = 1
  while i <= n:
    result = result * i
    i = i + 1
  return result

fn fibonacci(n: i32): i32
  let a = 0
  let b = 1
  let i = 0
  while i < n:
    let tmp = b
    b = a + b
    a = tmp
    i = i + 1
  return a

// Announces that it ran, so the output shows which operands did.
fn announced(label: string, value: bool): bool
  print(label)
  return value

fn main(): i32
  print("abs(-7):")
  print(abs(0 - 7))

  print("max(3, 8):")
  print(max(3, 8))

  print("factorial(6):")
  print(factorial(6))

  print("fibonacci(10):")
  print(fibonacci(10))

  // `and` and `or` evaluate the right operand only when the left one
  // does not decide the result.
  print("false and ...:")
  if announced("left", false) and announced("right", true):
    print("both")

  print("true or ...:")
  if announced("left", true) or announced("right", false):
    print("either")

  print("true and ...:")
  if announced("left", true) and announced("right", true):
    print("both")

  return 0
