module control_flow
fn factorial(n: i32): i32
  let result = 1
  let i = 1
  while i <= n:
    result = result * i
    i = i + 1
  return result

fn fibonacci(n: i32): i32
  let a = 0
  let b = 1
  let i = 0
  while i < n:
    let tmp = b
    b = a + b
    a = tmp
    i = i + 1
  return a

fn main(): i32
  print("abs(-7):")
  print(abs(0 - 7))

  print("max(3, 8):")
  print(max(3, 8))

  print("factorial(6):")
  print(factorial(6))

  print("fibonacci(10):")
  print(fibonacci(10))

  return 0
