module raw_memory
// raw_memory.dao — Low-level memory substrate proof of concept.
//
// Demonstrates: alloc, Ptr.cast, Ptr.offset, Ptr.set, Ptr.get,
// size_of, align_of, Ptr<T>::new, Ptr.is_null, free.

fn main(): i32
  // Allocate space for 4 i32 values.
  let raw = __dao_mem_alloc(size_of<i32>() * 4, align_of<i32>())
  let data = raw.cast<i32>()
  mode unsafe =>
    // Store values through the pointer, element by element.
    data.set(10)
    data.offset(1).set(20)
    data.offset(2).set(30)
    data.offset(3).set(40)

    // Read them back.
    print(data.get())
    print(data.offset(1).get())
    print(data.offset(2).get())
    print(data.offset(3).get())

  // Null pointer check.
  let np = Ptr<i32>::new()
  if np.is_null():
    print("null check passed")
  if data.is_null() == false:
    print("non-null check passed")

  __dao_mem_free(raw)

  // Size and alignment queries.
  print(size_of<i32>())
  print(size_of<f64>())
  print(align_of<i32>())
  print(align_of<f64>())

  return 0
