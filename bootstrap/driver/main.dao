module bootstrap::driver_main

import bootstrap::lexer
import bootstrap::parser
import bootstrap::graph
import bootstrap::base
import bootstrap::resolver

// Entry point for the bootstrap compiler driver. Reads an explicit
// manifest path from the command line, validates every directive and
// input file, lowers the program to textual LLVM IR, and writes the
// module only when compilation succeeds.

fn main(): i32
  let manifest_path: string = ""
  match resolve_manifest_arg(args()):
    Result::Ok(path):
      manifest_path = path
    Result::Err(err):
      eprint("driver: " + err)
      return 2

  let m: Manifest = Manifest("", Vector<graph::SourceInput>::new())
  match load_manifest(manifest_path):
    Result::Ok(loaded):
      m = loaded
    Result::Err(err):
      eprint("driver: " + err)
      return 2

  let lowered: ProgramLlvm = lower_program_to_llvm(m.inputs)
  let result: LlvmTextResult = lowered.result
  let located: Vector<graph::FileDiagnostic> = lowered.program.diags
  let di: i64 = to_i64(0)
  while di < result.diags.length():
    if di < located.length():
      eprint("driver: " + located_message(located.get(di), lowered.program.module_graph.files))
    else:
      eprint("driver: " + result.diags.get(di).message)
    di = di + to_i64(1)
  if result.ok == false:
    eprint("driver: " + i64_to_string(result.diags.length()) + " diagnostic(s), no module written")
    return 1
  if write_llvm_text(result, m.output) == false:
    eprint("driver: could not write " + m.output)
    return 1
  return 0
