module bootstrap::mir::impl
// bootstrap/mir/impl.dao — Tier A MIR subsystem.
//
// Lowers HIR into a basic-block MIR mirroring the host compiler's
// structure (compiler/ir/mir/mir.h):
//   MirModule → list of MirFunction
//   MirFunction → list of MirBlock (entry first) + locals
//   MirBlock → list of MirInst, last must be terminator
//   MirInst → result value id, semantic type, payload variant
//
// Tier A scope (matches the host's MIR surface at the time Task 24
// landed HIR): functions, constants, binary/unary, let/assign,
// calls, returns, if/else, while, field-access reads.
//
// Deferred to Tier B (same deferrals as the bootstrap HIR, plus):
//   - Generators (iter init/has_next/next/destroy/yield)
//   - Monomorphization / generic template separation
//   - (mode and resource blocks lower to regions: Task 42 slice 5)
//     a diagnostic until the domain is represented in MIR)
//   - Enum construction / discriminant / payload
//   - Lambda / closures
//   - Try operator
//   - For-over-iterable
//   - Index expressions

// =========================================================================
// Section 60: MIR node model
// =========================================================================
//
// Everything flat-indexed into hir_nodes... no wait, we need MIR nodes.
// The MIR subsystem owns its own arena (mir_nodes + mir_idx) so it can
// reference HIR nodes by index without mutating them.

// Every MirNode is value-producing OR effect-producing OR terminator.
// For Tier A we do not track per-instruction types (defer to backend).

enum class MirNode:
  // Program root: one MirModule per HIR module, in program order.
  MirProgram(module_list_lp: i64, module_count: i64)

  // A module's functions: the concrete ones (`fn_list_lp`), and the
  // generic ones lowered as templates (`template_list_lp`), which are
  // not concrete and are kept out of the function list until an
  // instantiation names them.  Token indices in its nodes (literal
  // lexemes, field names) are `file_id`'s.
  MirModule(file_id: i64, fn_list_lp: i64, fn_count: i64, template_list_lp: i64, template_count: i64)

  // Function.  Params + locals are unified: params are indices [0, param_count)
  // and locals are [param_count, locals.length()).  `entry_bb` is the
  // index of the first block in this function's block list.
  MirFunction(
    sym: i64,              // resolver symbol index (−1 for anonymous)
    ret_type: i64,         // type_idx or −1 for void
    param_count: i64,      // number of leading locals that are params
    local_list_lp: i64,    // MirLocal indices
    local_count: i64,
    block_list_lp: i64,    // MirBlock indices; block_list_lp[0] is entry
    block_count: i64,
    is_extern: i64)

  // Local slot (param or let-binding).
  MirLocal(
    sym: i64,              // resolver symbol index (−1 for synthetic)
    type_idx: i64,
    is_param: i64)

  // Basic block.
  MirBlock(
    block_id: i64,
    inst_list_lp: i64,
    inst_count: i64)

  // ---------- value-producing instructions (result = this node's index) ----------

  MirConstInt(value: i64, type_idx: i64)
  MirConstFloat(tok: i64, type_idx: i64)   // stored as lexeme for Tier A
  MirConstBool(value: i64, type_idx: i64)  // 0 / 1
  MirConstString(tok: i64, type_idx: i64)  // stored as lexeme

  // op_tok points at the binary/unary operator token (reused for printing).
  MirBinary(op_tok: i64, lhs: i64, rhs: i64, type_idx: i64)
  MirUnary(op_tok: i64, operand: i64, type_idx: i64)

  // Load the value stored in a local.
  MirLoad(local_idx: i64, type_idx: i64)

  // An enum value's variant index, and a payload value of one of its
  // variants (the host's enum_discriminant / enum_payload).
  MirEnumDiscriminant(value: i64, type_idx: i64)
  MirEnumPayload(value: i64, variant: i64, field: i64, type_idx: i64)

  // A class value from its field values, in declaration order, and a
  // payload-bearing enum's value of variant `variant` from its payload
  // values, in declaration order (the host's construct / enum_construct).
  MirConstruct(arg_list_lp: i64, arg_count: i64, type_idx: i64)
  MirEnumConstruct(variant: i64, arg_list_lp: i64, arg_count: i64, type_idx: i64)

  // Field access on a struct value: obj is a value, field_tok is the name.
  // field_index is resolved at lowering time (−1 if deferred).
  MirFieldAccess(obj: i64, field_tok: i64, field_index: i64, type_idx: i64)

  // Function reference (used as a call callee when the callee is an identifier
  // resolving to a function symbol).
  MirFnRef(sym: i64, type_idx: i64)

  // Call: callee is the value id of a MirFnRef (Tier A).
  MirCall(callee: i64, arg_list_lp: i64, arg_count: i64, type_idx: i64)

  // ---------- effect-producing instructions (no result) ----------

  // Store a value into a place: a local, or the field its field-index
  // path reaches (`store _0.inner.v`, the host's MirPlace with field
  // projections).  An empty path stores the whole local.
  MirStore(local_idx: i64, path_lp: i64, path_count: i64, value: i64)

  // Execution-mode and resource regions (the host's mode_enter /
  // mode_exit, resource_enter / resource_exit).  Token indices are the
  // module's; a resource region's exit names its domain handle, the
  // value of its resource_enter.
  MirModeEnter(name_tok: i64)
  MirModeExit(name_tok: i64)
  MirResourceEnter(kind_tok: i64, name_tok: i64)
  MirResourceExit(kind_tok: i64, name_tok: i64, handle: i64)

  // ---------- terminators (must be last in a block) ----------

  MirReturn(value: i64, has_value: i64)
  MirBr(target_block: i64)
  MirCondBr(cond: i64, then_block: i64, else_block: i64)

  // Error sentinel (unsupported HIR pattern).
  MirErrorExpr(tok: i64)

// =========================================================================
// Section 61: MIR state and result types
// =========================================================================

// Mutable state threaded through lowering.
class MS:
  // Input (read-only, from HIR result).
  hir_nodes: Vector<HirNode>
  hir_idx: Vector<i64>
  types: Vector<DaoType>
  type_info: Vector<i64>
  toks: Vector<Token>
  src: string
  symbols: Vector<Symbol>
  sym_types: Vector<i64>
  uses_map: HashMap<i64>    // program-level uses_key(file_id, tok_idx) → sym_idx

  // Accumulated MIR.
  mir_nodes: Vector<MirNode>
  mir_idx: Vector<i64>
  diags: Vector<Diagnostic>

  // Per-function state.
  file_id: i64              // file id for uses_map lookups (-1 in single-file)
  current_fn: i64           // index into mir_nodes of current MirFunction (−1 none)
  locals: Vector<i64>       // list of MirLocal node indices for current fn
  fn_blocks: Vector<i64>    // list of MirBlock node indices for current fn
  sym_to_local: HashMap<i64> // resolver sym_idx (as string) → local slot index
  next_block_id: i64        // for block.id numbering
  in_template: bool         // lowering a generic function's template
  flow: Flow                // enclosing loops and regions
  copy_out_sym: i64         // the prelude's `copy_out`, for resource exits (-1 when absent)

// A loop being lowered: where `break` goes, and how many regions were
// open when it began — a `break` leaves only the regions entered inside.
class LoopExit:
  block: i64
  region_depth: i64

// An open region: its HirMode / HirResource statement and, for a
// resource block, its domain handle (-1 for a mode) and the bindings its
// exit copies out, each with the local holding its dirty flag.
class ActiveRegion:
  stmt: i64
  handle: i64
  escapes: Vector<i64>
  flags: Vector<i64>

// The control-flow context of the statement being lowered.
class Flow:
  loops: Vector<LoopExit>
  regions: Vector<ActiveRegion>

fn flow_empty(): Flow
  return Flow(Vector<LoopExit>::new(), Vector<ActiveRegion>::new())

fn mir_result_empty(): MirResult
  return MirResult(Vector<MirNode>::new(), Vector<i64>::new(), Vector<Diagnostic>::new(), to_i64(-1))

class MirResult:
  mir_nodes: Vector<MirNode>
  mir_idx: Vector<i64>
  diags: Vector<Diagnostic>
  root: i64                 // index of root MirModule node, or −1 on failure

class MirR:
  ms: MS
  mir: i64                  // index of the newly added node

class MirFlush:
  ms: MS
  list_pos: i64

// =========================================================================
// Section 62: MS helpers (all mutating — no COW reconstruction)
// =========================================================================

fn ms_add_node(ms: MS, node: MirNode): MirR
  let idx: i64 = ms.mir_nodes.length()
  ms.mir_nodes = ms.mir_nodes.push(node)
  return MirR(ms, idx)

fn ms_add_diag(ms: MS, span: Span, msg: string): MS
  ms.diags = ms.diags.push(make_error(span, msg))
  return ms

// Flush a Vector<i64> of node indices into the shared mir_idx store
// using the HIR list format: items pushed first, count at list_pos.
// To read: count = mir_idx.get(list_pos); items = mir_idx[list_pos -
// count .. list_pos).
fn mir_flush_list(ms: MS, items: Vector<i64>): MirFlush
  let i: i64 = to_i64(0)
  while i < items.length():
    ms.mir_idx = ms.mir_idx.push(items.get(i))
    i = i + to_i64(1)
  let pos: i64 = ms.mir_idx.length()
  ms.mir_idx = ms.mir_idx.push(items.length())
  return MirFlush(ms, pos)

// Look up the HIR expression type for an AST node (by index).
fn ms_get_hir_type(ms: MS, hir_node: HirNode): i64
  match hir_node:
    HirNode::HirIntLit(t, ti):
      return ti
    HirNode::HirFloatLit(t, ti):
      return ti
    HirNode::HirStringLit(t, ti):
      return ti
    HirNode::HirBoolLit(t, ti):
      return ti
    HirNode::HirIdent(s, ti, t):
      return ti
    HirNode::HirBinary(o, l, r, ti):
      return ti
    HirNode::HirUnary(o, op, ti):
      return ti
    HirNode::HirCall(c, a, n, ti):
      return ti
    HirNode::HirFieldAccess(o, f, ti):
      return ti
    HirNode::HirPipe(l, r, ti):
      return ti
    HirNode::HirQualName(s, n, ti):
      return ti
    HirNode::HirEnumDiscriminant(v, ti):
      return ti
    HirNode::HirEnumPayload(v, vi, fi, ti):
      return ti
    HirNode::HirConstruct(a, n, ti):
      return ti
    HirNode::HirEnumConstruct(v, p, n, ti):
      return ti
  return to_i64(-1)

// =========================================================================
// Section 63: Per-function state management
// =========================================================================

fn ms_reset_fn_state(ms: MS): MS
  ms.current_fn = to_i64(-1)
  ms.locals = Vector<i64>::new()
  ms.fn_blocks = Vector<i64>::new()
  ms.sym_to_local = HashMap<i64>::new()
  ms.next_block_id = to_i64(0)
  ms.flow = flow_empty()
  return ms

// Declare a local slot for the given resolver symbol.  Returns the
// local slot index (position within the current function's local_list).
fn ms_declare_local(ms: MS, sym: i64, type_idx: i64, is_param: bool): MirR
  let is_param_i: i64 = to_i64(0)
  if is_param:
    is_param_i = to_i64(1)
  let r: MirR = ms_add_node(ms, MirNode::MirLocal(sym = sym, type_idx = type_idx, is_param = is_param_i))
  let slot: i64 = r.ms.locals.length()
  r.ms.locals = r.ms.locals.push(r.mir)
  // Any symbol but -1 ("none"): a synthesized local's is negative
  // (synthetic_local_sym).
  if sym != to_i64(-1):
    r.ms.sym_to_local = r.ms.sym_to_local.set(i64_to_string(sym), slot)
  return MirR(r.ms, slot)

fn ms_lookup_local(ms: MS, sym: i64): i64
  if sym == to_i64(-1):
    return to_i64(-1)
  let found: Option<i64> = ms.sym_to_local.get(i64_to_string(sym))
  match found:
    Option::Some(slot):
      return slot
    Option::None:
      return to_i64(-1)

// Resolve a name token to its resolver symbol via the uses map.
// Returns -1 if no binding.
fn ms_tok_to_sym(ms: MS, tok_idx: i64): i64
  if tok_idx < 0:
    return to_i64(-1)
  let key: string = uses_key(ms.file_id, tok_idx)
  let found: Option<i64> = ms.uses_map.get(key)
  match found:
    Option::Some(sym):
      return sym
    Option::None:
      return to_i64(-1)

// Create a new basic block, append it to the current function's
// block list, and return its node index.
fn ms_new_block(ms: MS): MirR
  let bid: i64 = ms.next_block_id
  ms.next_block_id = bid + 1
  let r: MirR = ms_add_node(ms, MirNode::MirBlock(block_id = bid, inst_list_lp = to_i64(0), inst_count = to_i64(0)))
  r.ms.fn_blocks = r.ms.fn_blocks.push(r.mir)
  return r

// Append an instruction to the current block.  Because MirBlock stores
// its instruction list as (lp, count), and we don't know the count
// until all instructions for the block are emitted, Tier A appends
// instructions to a running scratch vector held on MS.  The block's
// list is flushed when the block is sealed (ms_seal_block).
//
// For simplicity Tier A uses a per-block scratch list in the HS-like
// way HIR does.  We thread it through manually.

class BlockR:
  ms: MS
  block_idx: i64       // MirBlock node index this BlockR is emitting into
  insts: Vector<i64>   // instruction node indices accumulated for this block
  sealed: i64          // 1 if a terminator has been emitted, 0 otherwise

fn block_open(ms: MS, block_idx: i64): BlockR
  return BlockR(ms, block_idx, Vector<i64>::new(), to_i64(0))

fn block_emit(br: BlockR, inst_idx: i64): BlockR
  br.insts = br.insts.push(inst_idx)
  return br

// Seal the block: flush instructions into mir_idx, rewrite the
// MirBlock node with the list offset and count.
fn block_seal(br: BlockR): MS
  let fl: MirFlush = mir_flush_list(br.ms, br.insts)
  let blk: MirNode = fl.ms.mir_nodes.get(br.block_idx)
  match blk:
    MirNode::MirBlock(bid, old_lp, old_count):
      fl.ms.mir_nodes = fl.ms.mir_nodes.set(br.block_idx, MirNode::MirBlock(block_id = bid, inst_list_lp = fl.list_pos, inst_count = br.insts.length()))
  return fl.ms

// Mark the current block sealed (terminator emitted).
fn block_mark_sealed(br: BlockR): BlockR
  br.sealed = to_i64(1)
  return br

// Seal current block, create a new one, and return a fresh BlockR
// positioned at the new block.  Used by if/while to advance the CFG.
fn block_advance(br: BlockR): BlockR
  let ms: MS = block_seal(br)
  let nr: MirR = ms_new_block(ms)
  return block_open(nr.ms, nr.mir)

// =========================================================================
// Section 63b: Field index resolution (Tier B)
// =========================================================================
//
// Resolve a field name token to its positional index within a struct's
// type_info field list.  Used by MirFieldAccess lowering.
// type_info stores pairs of (field symbol index, field_type_idx)
// starting at DaoType.info_lp with DaoType.info_count pairs; the symbol
// is program-wide, so the name reads the same from any module.

fn mir_resolve_field_index(ms: MS, struct_type_idx: i64, field_tok: i64): i64
  if struct_type_idx < 0:
    return to_i64(-1)
  if struct_type_idx >= ms.types.length():
    return to_i64(-1)
  let t: DaoType = ms.types.get(struct_type_idx)
  match t.kind:
    TypeKind::TStruct:
      // Extract the field name from the field_tok.
      let ft: Token = ms.toks.get(field_tok)
      let field_name: string = substring(ms.src, ft.offset, ft.len)
      // Walk the struct's field pairs in type_info; each name slot holds
      // the field's symbol (field_slot_name), readable from any module.
      let i: i64 = to_i64(0)
      while i < t.info_count:
        if field_slot_name(ms.symbols, ms.type_info.get(t.info_lp + i * to_i64(2))) == field_name:
          return i
        i = i + to_i64(1)
  return to_i64(-1)

// =========================================================================
// Section 64: Expression lowering
// =========================================================================

// Result of lowering an expression: updated BlockR + produced value id.
// BlockR must be threaded explicitly through returns because Dao passes
// classes by value across function boundaries — in-function mutations
// to `br.ms` and `br.insts` do not propagate back to the caller.
class ExprR:
  br: BlockR
  value: i64

// Emit a MirNode as a value instruction into `br`'s current block.
// Returns the updated BlockR and the new value id.
fn br_emit_value(br: BlockR, node: MirNode): ExprR
  let r: MirR = ms_add_node(br.ms, node)
  br.ms = r.ms
  br.insts = br.insts.push(r.mir)
  return ExprR(br, r.mir)

// Emit a terminator (br / cond_br / return).  Marks the block as sealed.
fn br_emit_terminator(br: BlockR, node: MirNode): BlockR
  let r: MirR = ms_add_node(br.ms, node)
  br.ms = r.ms
  br.insts = br.insts.push(r.mir)
  br.sealed = to_i64(1)
  return br

// Lower an expression.  Returns an ExprR containing the updated BlockR
// (accumulated MIR state + current block insts) and the produced value id.
fn lower_expr_value(br: BlockR, hir_node_idx: i64): ExprR
  if hir_node_idx < 0:
    return br_emit_value(br, MirNode::MirErrorExpr(tok = to_i64(0)))
  let node: HirNode = br.ms.hir_nodes.get(hir_node_idx)
  match node:
    HirNode::HirIntLit(value, type_idx):
      return br_emit_value(br, MirNode::MirConstInt(value = value, type_idx = type_idx))
    HirNode::HirEnumDiscriminant(value, type_idx):
      let disc_of: ExprR = lower_expr_value(br, value)
      return br_emit_value(disc_of.br, MirNode::MirEnumDiscriminant(value = disc_of.value, type_idx = type_idx))
    HirNode::HirEnumPayload(value, variant, field, type_idx):
      let payload_of: ExprR = lower_expr_value(br, value)
      return br_emit_value(payload_of.br, MirNode::MirEnumPayload(value = payload_of.value, variant = variant, field = field, type_idx = type_idx))
    HirNode::HirConstruct(args_lp, arg_count, type_idx):
      let fields: ExprValues = lower_expr_values(br, read_hir_list(br.ms.hir_idx, args_lp))
      let cfl: MirFlush = mir_flush_list(fields.br.ms, fields.values)
      fields.br.ms = cfl.ms
      return br_emit_value(fields.br, MirNode::MirConstruct(arg_list_lp = cfl.list_pos, arg_count = arg_count, type_idx = type_idx))
    HirNode::HirEnumConstruct(variant, payload_lp, payload_count, type_idx):
      // Evaluated in source order, placed in declaration order.
      let pairs: Vector<i64> = read_pairs(br.ms.hir_idx, payload_lp)
      let exprs: Vector<i64> = Vector<i64>::new()
      let pi: i64 = to_i64(0)
      while pi < pairs.length():
        exprs = exprs.push(pairs.get(pi))
        pi = pi + to_i64(2)
      let payload: ExprValues = lower_expr_values(br, exprs)
      let placed: Vector<i64> = payload.values
      let fi: i64 = to_i64(0)
      while fi < payload.values.length():
        let field: i64 = pairs.get(fi * to_i64(2) + to_i64(1))
        if field >= 0 and field < placed.length():
          placed = placed.set(field, payload.values.get(fi))
        fi = fi + to_i64(1)
      let efl: MirFlush = mir_flush_list(payload.br.ms, placed)
      payload.br.ms = efl.ms
      return br_emit_value(payload.br, MirNode::MirEnumConstruct(variant = variant, arg_list_lp = efl.list_pos, arg_count = payload_count, type_idx = type_idx))
    HirNode::HirBoolLit(tok, type_idx):
      if tok < to_i64(0) or tok >= br.ms.toks.length():
        br.ms = ms_add_diag(br.ms, Span(to_i64(0), to_i64(1)), "unsupported in Tier A MIR lowering: bool literal without a source token (synthesized HIR)")
        return br_emit_value(br, MirNode::MirErrorExpr(tok = to_i64(0)))
      let tk: Token = br.ms.toks.get(tok)
      let lex: string = substring(br.ms.src, tk.offset, tk.len)
      let v: i64 = to_i64(0)
      if lex == "true":
        v = to_i64(1)
      return br_emit_value(br, MirNode::MirConstBool(value = v, type_idx = type_idx))
    HirNode::HirFloatLit(tok, type_idx):
      return br_emit_value(br, MirNode::MirConstFloat(tok = tok, type_idx = type_idx))
    HirNode::HirStringLit(tok, type_idx):
      return br_emit_value(br, MirNode::MirConstString(tok = tok, type_idx = type_idx))
    HirNode::HirIdent(sym, type_idx, tok):
      let slot: i64 = ms_lookup_local(br.ms, sym)
      if slot >= 0:
        return br_emit_value(br, MirNode::MirLoad(local_idx = slot, type_idx = type_idx))
      return br_emit_value(br, MirNode::MirFnRef(sym = sym, type_idx = type_idx))
    HirNode::HirBinary(op_tok, left, right, type_idx):
      let lhs_r: ExprR = lower_expr_value(br, left)
      let rhs_r: ExprR = lower_expr_value(lhs_r.br, right)
      return br_emit_value(rhs_r.br, MirNode::MirBinary(op_tok = op_tok, lhs = lhs_r.value, rhs = rhs_r.value, type_idx = type_idx))
    HirNode::HirUnary(op_tok, operand, type_idx):
      let operand_r: ExprR = lower_expr_value(br, operand)
      return br_emit_value(operand_r.br, MirNode::MirUnary(op_tok = op_tok, operand = operand_r.value, type_idx = type_idx))
    HirNode::HirCall(callee, args_lp, arg_count, type_idx):
      // A call on a member access is a call through a type parameter's
      // bound (lower_bound_call): which function it calls is decided by
      // an instantiation.  A template carries it, as the host's template
      // does, with the member access as its callee, for the instantiation
      // to resolve (monomorphization, Task 43); a concrete function never
      // has a type parameter's value to call through, so there it is
      // rejected rather than lowered as a field.
      match br.ms.hir_nodes.get(callee):
        HirNode::HirFieldAccess(bound_obj, bound_field, bound_ti):
          if br.ms.in_template == false and mir_is_type_param(br.ms, ms_get_hir_type(br.ms, br.ms.hir_nodes.get(bound_obj))):
            br.ms = ms_add_diag(br.ms, Span(to_i64(0), to_i64(1)),
              "unsupported in Tier A MIR lowering: a call through a type parameter's bound (HirCall on HirFieldAccess) needs an instantiation to name its function")
            return br_emit_value(br, MirNode::MirErrorExpr(tok = to_i64(0)))
      let callee_r: ExprR = lower_expr_value(br, callee)
      let call_args: ExprValues = lower_expr_values(callee_r.br, read_hir_list(callee_r.br.ms.hir_idx, args_lp))
      let cur_br: BlockR = call_args.br
      let fl: MirFlush = mir_flush_list(cur_br.ms, call_args.values)
      cur_br.ms = fl.ms
      return br_emit_value(cur_br, MirNode::MirCall(callee = callee_r.value, arg_list_lp = fl.list_pos, arg_count = arg_count, type_idx = type_idx))
    HirNode::HirFieldAccess(obj, field_tok, type_idx):
      let obj_r: ExprR = lower_expr_value(br, obj)
      // Resolve field_index from the object's struct type (Tier B).
      let obj_hir: HirNode = obj_r.br.ms.hir_nodes.get(obj)
      let obj_ti: i64 = ms_get_hir_type(obj_r.br.ms, obj_hir)
      let fidx: i64 = mir_resolve_field_index(obj_r.br.ms, obj_ti, field_tok)
      return br_emit_value(obj_r.br, MirNode::MirFieldAccess(obj = obj_r.value, field_tok = field_tok, field_index = fidx, type_idx = type_idx))
    HirNode::HirErrorExpr(err_tok):
      // HIR reported this expression already.
      return br_emit_value(br, MirNode::MirErrorExpr(tok = to_i64(0)))
  // An expression kind with no Tier A lowering is reported, as an
  // unsupported statement is: its subexpressions are not lowered, so a
  // failure inside them (a call through a bound) must not vanish with it.
  br.ms = ms_add_diag(br.ms, Span(to_i64(0), to_i64(1)),
    "unsupported expression kind in Tier A MIR lowering: " + hir_node_kind(node))
  return br_emit_value(br, MirNode::MirErrorExpr(tok = to_i64(0)))

// Expressions lowered in order: the block after them and their values.
class ExprValues:
  br: BlockR
  values: Vector<i64>

fn lower_expr_values(br: BlockR, exprs: Vector<i64>): ExprValues
  let cur: BlockR = br
  let values: Vector<i64> = Vector<i64>::new()
  let i: i64 = to_i64(0)
  while i < exprs.length():
    let r: ExprR = lower_expr_value(cur, exprs.get(i))
    cur = r.br
    values = values.push(r.value)
    i = i + to_i64(1)
  return ExprValues(cur, values)

// Whether a type index names a type parameter.
fn mir_is_type_param(ms: MS, ti: i64): bool
  if ti < 0 or ti >= ms.types.length():
    return false
  match ms.types.get(ti).kind:
    TypeKind::TGenericParam:
      return true
  return false

// =========================================================================
// Section 65: Statement lowering
// =========================================================================

// Lower a single statement into `br`'s current block.  May seal the
// block and create new ones (if/while), in which case the returned
// BlockR positions on a different block than the input.
fn mir_lower_stmt(br: BlockR, hir_node_idx: i64): BlockR
  if hir_node_idx < 0:
    return br
  let node: HirNode = br.ms.hir_nodes.get(hir_node_idx)
  match node:
    HirNode::HirLet(let_sym, type_idx, init):
      let dl: MirR = ms_declare_local(br.ms, let_sym, type_idx, false)
      br.ms = dl.ms
      let slot: i64 = dl.mir
      if init >= 0:
        let init_r: ExprR = lower_expr_value(br, init)
        return emit_store(init_r.br, MirPlace(slot, Vector<i64>::new()), init_r.value)
      return br
    HirNode::HirAssign(target, value):
      // The place first, then the value, as the host lowers them.
      let place: PlaceR = lower_place(br.ms, target)
      br.ms = place.ms
      if place.place.local < 0:
        return br
      let val_r: ExprR = lower_expr_value(br, value)
      let stored: BlockR = emit_store(val_r.br, place.place, val_r.value)
      return mark_escapes_dirty(stored, place.place.local)
    HirNode::HirBreak(t):
      let loop_count: i64 = br.ms.flow.loops.length()
      if loop_count == 0:
        br.ms = ms_add_diag(br.ms, Span(to_i64(0), to_i64(1)), "break outside a loop")
        return br
      // Leave the regions entered inside the loop, then branch out of it.
      let lp: LoopExit = br.ms.flow.loops.get(loop_count - 1)
      let left: RegionExitR = emit_region_exits(br, lp.region_depth, false, to_i64(-1), to_i64(-1))
      return br_emit_terminator(left.br, MirNode::MirBr(target_block = lp.block))
    HirNode::HirMode(name, body_lp):
      return lower_mode(br, hir_node_idx, name, body_lp)
    HirNode::HirReturn(value):
      // Every open region is left; a memory domain's exit copies the
      // returned value out first.
      if value >= 0:
        let val_r: ExprR = lower_expr_value(br, value)
        let ret_ti: i64 = ms_get_hir_type(val_r.br.ms, val_r.br.ms.hir_nodes.get(value))
        let ret_left: RegionExitR = emit_region_exits(val_r.br, to_i64(0), true, val_r.value, ret_ti)
        return br_emit_terminator(ret_left.br, MirNode::MirReturn(value = ret_left.carried, has_value = to_i64(1)))
      let left_void: RegionExitR = emit_region_exits(br, to_i64(0), true, to_i64(-1), to_i64(-1))
      return br_emit_terminator(left_void.br, MirNode::MirReturn(value = to_i64(-1), has_value = to_i64(0)))
    HirNode::HirExprStmt(expr):
      let expr_r: ExprR = lower_expr_value(br, expr)
      return expr_r.br
    HirNode::HirErrorStmt(t):
      return br
    HirNode::HirIf(cond, then_lp, else_lp):
      return mir_lower_if_stmt(br, cond, then_lp, else_lp)
    HirNode::HirWhile(cond, body_lp):
      return mir_lower_while_stmt(br, cond, body_lp)
    HirNode::HirResource(kind, name, body_lp):
      return lower_resource(br, hir_node_idx, kind, name, body_lp)
  // Unsupported statement kind (Tier A): HirBreak, HirFor, etc.  Emit
  // a diagnostic so downstream consumers observe the failure instead
  // of seeing valid-looking MIR with silently-dropped control flow.
  br.ms = ms_add_diag(br.ms, Span(to_i64(0), to_i64(1)),
    "unsupported statement kind in Tier A MIR lowering: " + hir_node_kind(node))
  return br

// A place a store writes: a local slot and the field-index path from it.
class MirPlace:
  local: i64
  path: Vector<i64>

class PlaceR:
  ms: MS
  place: MirPlace

// The place an assignment target names: a local, or a field path rooted
// at one (`o.inner.v`).  Any other target is reported, and its place's
// local is -1.  A field a template cannot resolve yet (on a type
// parameter's value) is tolerated there, as the host tolerates it.
fn lower_place(ms: MS, target: i64): PlaceR
  let none: MirPlace = MirPlace(to_i64(-1), Vector<i64>::new())
  match ms.hir_nodes.get(target):
    HirNode::HirIdent(sym, ti, tok):
      let slot: i64 = ms_lookup_local(ms, sym)
      if slot >= 0:
        return PlaceR(ms, MirPlace(slot, Vector<i64>::new()))
    HirNode::HirFieldAccess(obj, field_tok, ti):
      let base: PlaceR = lower_place(ms, obj)
      if base.place.local < 0:
        return base
      let field: i64 = mir_resolve_field_index(base.ms, ms_get_hir_type(base.ms, base.ms.hir_nodes.get(obj)), field_tok)
      if field < 0 and base.ms.in_template == false:
        let ft: Token = base.ms.toks.get(field_tok)
        return PlaceR(ms_add_diag(base.ms, Span(ft.offset, ft.len), "unresolved field '" + substring(base.ms.src, ft.offset, ft.len) + "' in assignment target"), none)
      return PlaceR(base.ms, MirPlace(base.place.local, base.place.path.push(field)))
  return PlaceR(ms_add_diag(ms, Span(to_i64(0), to_i64(1)), "unsupported assignment target: " + hir_node_kind(ms.hir_nodes.get(target))), none)

fn emit_store(br: BlockR, place: MirPlace, value: i64): BlockR
  let fl: MirFlush = mir_flush_list(br.ms, place.path)
  br.ms = fl.ms
  return emit_effect(br, MirNode::MirStore(local_idx = place.local, path_lp = fl.list_pos, path_count = place.path.length(), value = value))

// =========================================================================
// Section 65b: Regions — mode and resource blocks
// =========================================================================
//
// As the host's MirBuilder: entering a region emits its enter and opens
// it; leaving it — falling off its body, a `return` through it, a
// `break` out of a loop around it — emits its exit.  A `resource memory`
// block is an allocation domain: a binding declared outside it and
// stored to inside, whose type owns heap memory, is copied one domain
// outward at the exit (through the prelude's `copy_out`) when a store
// marked it dirty; a `return` through it copies the returned value
// instead.

fn mir_bool_type(): i64
  // ts_init registers the builtins first; bool is the eleventh.
  return to_i64(10)

class RegionExitR:
  br: BlockR
  carried: i64   // the value carried out (a return's, copied out), or -1

fn lower_mode(br: BlockR, stmt: i64, name_tok: i64, body_lp: i64): BlockR
  let entered: BlockR = emit_effect(br, MirNode::MirModeEnter(name_tok = name_tok))
  let outer: Vector<ActiveRegion> = entered.ms.flow.regions
  entered.ms.flow = Flow(entered.ms.flow.loops, outer.push(ActiveRegion(stmt, to_i64(-1), Vector<i64>::new(), Vector<i64>::new())))
  let body: BlockR = lower_stmt_list(entered, body_lp)
  body.ms.flow = Flow(body.ms.flow.loops, outer)
  if body.sealed == to_i64(0):
    return emit_effect(body, MirNode::MirModeExit(name_tok = name_tok))
  return body

fn lower_resource(br: BlockR, stmt: i64, kind_tok: i64, name_tok: i64, body_lp: i64): BlockR
  let enter_r: ExprR = br_emit_value(br, MirNode::MirResourceEnter(kind_tok = kind_tok, name_tok = name_tok))
  let cur: BlockR = enter_r.br
  // One dirty flag per escaping binding, clear at entry.
  let escapes: Vector<i64> = Vector<i64>::new()
  let flags: Vector<i64> = Vector<i64>::new()
  if mir_tok_text(cur.ms, kind_tok) == "memory":
    escapes = resource_escapes(cur.ms, body_lp, Vector<i64>::new())
    let ei: i64 = to_i64(0)
    while ei < escapes.length():
      let flag: MirR = ms_declare_local(cur.ms, to_i64(-1), mir_bool_type(), false)
      cur.ms = flag.ms
      flags = flags.push(flag.mir)
      let clear: ExprR = br_emit_value(cur, MirNode::MirConstBool(value = to_i64(0), type_idx = mir_bool_type()))
      cur = emit_store(clear.br, MirPlace(flag.mir, Vector<i64>::new()), clear.value)
      ei = ei + to_i64(1)
  let region: ActiveRegion = ActiveRegion(stmt, enter_r.value, escapes, flags)
  let outer: Vector<ActiveRegion> = cur.ms.flow.regions
  cur.ms.flow = Flow(cur.ms.flow.loops, outer.push(region))
  let body: BlockR = lower_stmt_list(cur, body_lp)
  body.ms.flow = Flow(body.ms.flow.loops, outer)
  if body.sealed == to_i64(0):
    return emit_region_exit(body, region, false, to_i64(-1), to_i64(-1)).br
  return body

// Leave the regions open above `depth`, innermost first.  Leaving the
// function (`leaving_fn`) carries `carried` (of type `carried_ti`) out
// of each memory domain instead of the domains' escaping bindings.
fn emit_region_exits(br: BlockR, depth: i64, leaving_fn: bool, carried: i64, carried_ti: i64): RegionExitR
  let r: RegionExitR = RegionExitR(br, carried)
  let i: i64 = br.ms.flow.regions.length()
  while i > depth:
    r = emit_region_exit(r.br, r.br.ms.flow.regions.get(i - 1), leaving_fn, r.carried, carried_ti)
    i = i - to_i64(1)
  return r

fn emit_region_exit(br: BlockR, region: ActiveRegion, leaving_fn: bool, carried: i64, carried_ti: i64): RegionExitR
  match br.ms.hir_nodes.get(region.stmt):
    HirNode::HirMode(name_tok, body_lp):
      return RegionExitR(emit_effect(br, MirNode::MirModeExit(name_tok = name_tok)), carried)
    HirNode::HirResource(kind_tok, name_tok, body_lp):
      let cur: BlockR = br
      let out: i64 = carried
      if mir_tok_text(br.ms, kind_tok) == "memory":
        if leaving_fn:
          if carried >= 0:
            let copied: ExprR = emit_copy_out(cur, carried, carried_ti)
            cur = copied.br
            out = copied.value
        else:
          let ei: i64 = to_i64(0)
          while ei < region.escapes.length():
            cur = emit_escape_copy(cur, region.escapes.get(ei), region.flags.get(ei))
            ei = ei + to_i64(1)
      let exit: BlockR = emit_effect(cur, MirNode::MirResourceExit(kind_tok = kind_tok, name_tok = name_tok, handle = region.handle))
      return RegionExitR(exit, out)
  return RegionExitR(br, carried)

// `if dirty: binding = copy_out(binding)`, then continue.
fn emit_escape_copy(br: BlockR, binding: i64, flag: i64): BlockR
  let dirty: ExprR = br_emit_value(br, MirNode::MirLoad(local_idx = flag, type_idx = mir_bool_type()))
  let copy_r: MirR = ms_new_block(dirty.br.ms)
  let next_r: MirR = ms_new_block(copy_r.ms)
  let cur: BlockR = dirty.br
  cur.ms = next_r.ms
  cur = br_emit_terminator(cur, MirNode::MirCondBr(cond = dirty.value, then_block = copy_r.mir, else_block = next_r.mir))
  let copy_br: BlockR = block_open(block_seal(cur), copy_r.mir)
  let binding_ti: i64 = mir_local_type(copy_br.ms, binding)
  let current: ExprR = br_emit_value(copy_br, MirNode::MirLoad(local_idx = binding, type_idx = binding_ti))
  let copied: ExprR = emit_copy_out(current.br, current.value, binding_ti)
  let stored: BlockR = emit_store(copied.br, MirPlace(binding, Vector<i64>::new()), copied.value)
  let jumped: BlockR = br_emit_terminator(stored, MirNode::MirBr(target_block = next_r.mir))
  return block_open(block_seal(jumped), next_r.mir)

// `copy_out(value)`: a value that owns heap memory, copied one domain
// outward; any other value is itself.
fn emit_copy_out(br: BlockR, value: i64, ti: i64): ExprR
  if mir_owns_heap(br.ms, ti) == false:
    return ExprR(br, value)
  if br.ms.copy_out_sym < 0:
    br.ms = ms_add_diag(br.ms, Span(to_i64(0), to_i64(1)), "no prelude `copy_out` to copy a value out of a resource block")
    return ExprR(br, value)
  let callee: ExprR = br_emit_value(br, MirNode::MirFnRef(sym = br.ms.copy_out_sym, type_idx = br.ms.sym_types.get(br.ms.copy_out_sym)))
  let arg_values: Vector<i64> = Vector<i64>::new()
  let args: MirFlush = mir_flush_list(callee.br.ms, arg_values.push(value))
  let cur: BlockR = callee.br
  cur.ms = args.ms
  return br_emit_value(cur, MirNode::MirCall(callee = callee.value, arg_list_lp = args.list_pos, arg_count = to_i64(1), type_idx = ti))

// Where a store inside open memory domains is rooted at an escaping
// binding, mark it dirty in each: that domain's exit copies it.
fn mark_escapes_dirty(br: BlockR, local: i64): BlockR
  let cur: BlockR = br
  let ri: i64 = to_i64(0)
  while ri < cur.ms.flow.regions.length():
    let region: ActiveRegion = cur.ms.flow.regions.get(ri)
    let ei: i64 = to_i64(0)
    while ei < region.escapes.length():
      if region.escapes.get(ei) == local:
        let set: ExprR = br_emit_value(cur, MirNode::MirConstBool(value = to_i64(1), type_idx = mir_bool_type()))
        cur = emit_store(set.br, MirPlace(region.flags.get(ei), Vector<i64>::new()), set.value)
      ei = ei + to_i64(1)
    ri = ri + to_i64(1)
  return cur

// The bindings a resource block's body stores to (at any depth) that
// were declared before it — they already have a slot — and whose type
// owns heap memory, in first-store order.  (The host's checker records
// the same set per block: check_store_escapes_domain.)
fn resource_escapes(ms: MS, list_pos: i64, found: Vector<i64>): Vector<i64>
  let out: Vector<i64> = found
  let stmts: Vector<i64> = read_hir_list(ms.hir_idx, list_pos)
  let i: i64 = to_i64(0)
  while i < stmts.length():
    match ms.hir_nodes.get(stmts.get(i)):
      HirNode::HirAssign(target, value):
        let root: i64 = place_root_local(ms, target)
        if root >= 0 and mir_owns_heap(ms, mir_local_type(ms, root)) and vec_contains(out, root) == false:
          out = out.push(root)
      HirNode::HirIf(cond, then_lp, else_lp):
        out = resource_escapes(ms, then_lp, out)
        out = resource_escapes(ms, else_lp, out)
      HirNode::HirWhile(cond, body_lp):
        out = resource_escapes(ms, body_lp, out)
      HirNode::HirMode(name, body_lp):
        out = resource_escapes(ms, body_lp, out)
      HirNode::HirResource(kind, name, body_lp):
        out = resource_escapes(ms, body_lp, out)
    i = i + to_i64(1)
  return out

// The local slot an assignment target is rooted at, or -1.
fn place_root_local(ms: MS, target: i64): i64
  match ms.hir_nodes.get(target):
    HirNode::HirIdent(sym, ti, tok):
      return ms_lookup_local(ms, sym)
    HirNode::HirFieldAccess(obj, field_tok, ti):
      return place_root_local(ms, obj)
  return to_i64(-1)

fn vec_contains(v: Vector<i64>, x: i64): bool
  let i: i64 = to_i64(0)
  while i < v.length():
    if v.get(i) == x:
      return true
    i = i + to_i64(1)
  return false

// The type of a local slot of the function being lowered.
fn mir_local_type(ms: MS, slot: i64): i64
  if slot < 0 or slot >= ms.locals.length():
    return to_i64(-1)
  match ms.mir_nodes.get(ms.locals.get(slot)):
    MirNode::MirLocal(sym, type_idx, is_param):
      return type_idx
  return to_i64(-1)

// A token's text in the module being lowered.
fn mir_tok_text(ms: MS, tok: i64): string
  if tok < 0 or tok >= ms.toks.length():
    return ""
  let t: Token = ms.toks.get(tok)
  return substring(ms.src, t.offset, t.len)

// Whether a value of `ti` owns heap memory, so leaving a domain must copy
// it (the host's owns_heap_memory): a string, a generator, a type
// parameter, or a struct / enum holding a pointer or such a value.
fn mir_owns_heap(ms: MS, ti: i64): bool
  return mir_heap_search(ms, ti, HashMap<i64>::new()).found

fn mir_heap_search(ms: MS, ti: i64, seen: HashMap<i64>): GenericSearch
  if ti < 0 or ti >= ms.types.length():
    return GenericSearch(seen, false)
  let key: string = i64_to_string(ti)
  if seen.contains(key):
    return GenericSearch(seen, false)
  let so_far: HashMap<i64> = seen.set(key, to_i64(1))
  let t: DaoType = ms.types.get(ti)
  let held: Vector<i64> = Vector<i64>::new()
  match t.kind:
    TypeKind::TString:
      return GenericSearch(so_far, true)
    TypeKind::TGenerator:
      return GenericSearch(so_far, true)
    TypeKind::TGenericParam:
      return GenericSearch(so_far, true)
    TypeKind::TStruct:
      // Field pairs: (name, type).
      let fi: i64 = to_i64(0)
      while fi < t.info_count:
        held = held.push(ms.type_info.get(t.info_lp + fi * to_i64(2) + to_i64(1)))
        fi = fi + to_i64(1)
    TypeKind::TEnum:
      // Per variant: name, payload count, then (name, type) per value.
      let at: i64 = t.info_lp
      let vi: i64 = to_i64(0)
      while vi < t.info_count:
        let count: i64 = ms.type_info.get(at + to_i64(1))
        let pi: i64 = to_i64(0)
        while pi < count:
          held = held.push(ms.type_info.get(at + to_i64(2) + pi * to_i64(2) + to_i64(1)))
          pi = pi + to_i64(1)
        at = at + to_i64(2) + count * to_i64(2)
        vi = vi + to_i64(1)
  let i: i64 = to_i64(0)
  while i < held.length():
    let part: i64 = held.get(i)
    if part >= 0 and part < ms.types.length():
      match ms.types.get(part).kind:
        TypeKind::TPointer:
          return GenericSearch(so_far, true)
    let sub: GenericSearch = mir_heap_search(ms, part, so_far)
    if sub.found:
      return sub
    so_far = sub.seen
    i = i + to_i64(1)
  return GenericSearch(so_far, false)

// Emit an effect-only instruction (e.g. Store).  Same pattern as
// br_emit_value but discards the value id.
fn emit_effect(br: BlockR, node: MirNode): BlockR
  let r: MirR = ms_add_node(br.ms, node)
  br.ms = r.ms
  br.insts = br.insts.push(r.mir)
  return br

// Lower a list of statements into `br`.  If any statement seals
// the block (returns/break/etc.), subsequent statements are
// appended to whatever new block that statement switched to.
fn lower_stmt_list(br: BlockR, list_pos: i64): BlockR
  let stmts: Vector<i64> = read_hir_list(br.ms.hir_idx, list_pos)
  let i: i64 = to_i64(0)
  while i < stmts.length():
    // After a terminator (`return`, `break`) the rest of the list is
    // unreachable; the host's builder drops it, and so does this one,
    // rather than appending instructions after the block's terminator.
    if br.sealed == to_i64(1):
      return br
    br = mir_lower_stmt(br, stmts.get(i))
    i = i + to_i64(1)
  return br

// Lower an if/else statement.  Control flow:
//   [current] --cond_br--> [then] --br--> [merge]
//                      \-> [else] --br--> [merge]
// The returned BlockR is positioned on [merge].  If both branches
// returned / unconditionally exited, [merge] may end up empty —
// lower_function will still emit an implicit return to terminate it.
fn mir_lower_if_stmt(br: BlockR, cond: i64, then_lp: i64, else_lp: i64): BlockR
  let cond_r: ExprR = lower_expr_value(br, cond)
  br = cond_r.br
  let cond_val: i64 = cond_r.value

  // Allocate then/else/merge blocks up front so we have their IDs
  // for the cond_br before sealing the predecessor.
  let then_r: MirR = ms_new_block(br.ms)
  br.ms = then_r.ms
  let else_r: MirR = ms_new_block(br.ms)
  br.ms = else_r.ms
  let merge_r: MirR = ms_new_block(br.ms)
  br.ms = merge_r.ms

  // Terminate the predecessor with cond_br.
  br = br_emit_terminator(br, MirNode::MirCondBr(cond = cond_val, then_block = then_r.mir, else_block = else_r.mir))
  br.ms = block_seal(br)

  // Lower the then branch.
  let then_br: BlockR = block_open(br.ms, then_r.mir)
  let then_after: BlockR = lower_stmt_list(then_br, then_lp)
  let then_final: BlockR = then_after
  if then_final.sealed == to_i64(0):
    then_final = br_emit_terminator(then_final, MirNode::MirBr(target_block = merge_r.mir))
  let ms_after_then: MS = block_seal(then_final)

  // Lower the else branch (may be empty).
  let else_br: BlockR = block_open(ms_after_then, else_r.mir)
  let else_after: BlockR = else_br
  if else_lp >= 0:
    else_after = lower_stmt_list(else_br, else_lp)
  let else_final: BlockR = else_after
  if else_final.sealed == to_i64(0):
    else_final = br_emit_terminator(else_final, MirNode::MirBr(target_block = merge_r.mir))
  let ms_after_else: MS = block_seal(else_final)

  // Continue on the merge block.
  return block_open(ms_after_else, merge_r.mir)

// Lower a while loop.  Control flow:
//   [current] --br--> [header] --cond_br--> [body] --br--> [header]
//                                      \-> [exit]
fn mir_lower_while_stmt(br: BlockR, cond: i64, body_lp: i64): BlockR
  let header_r: MirR = ms_new_block(br.ms)
  br.ms = header_r.ms
  let body_r: MirR = ms_new_block(br.ms)
  br.ms = body_r.ms
  let exit_r: MirR = ms_new_block(br.ms)
  br.ms = exit_r.ms

  // Jump from predecessor into the loop header.
  br = br_emit_terminator(br, MirNode::MirBr(target_block = header_r.mir))
  br.ms = block_seal(br)

  // Header: evaluate condition and cond_br into body or exit.
  let header_br: BlockR = block_open(br.ms, header_r.mir)
  let cond_r: ExprR = lower_expr_value(header_br, cond)
  let header_term: BlockR = br_emit_terminator(cond_r.br, MirNode::MirCondBr(cond = cond_r.value, then_block = body_r.mir, else_block = exit_r.mir))
  let ms_after_header: MS = block_seal(header_term)

  // Body: lower statements, then unconditional br back to header.
  // A `break` in the body leaves to the exit block.
  let body_br: BlockR = block_open(ms_after_header, body_r.mir)
  let enclosing_loops: Vector<LoopExit> = body_br.ms.flow.loops
  body_br.ms.flow = Flow(enclosing_loops.push(LoopExit(exit_r.mir, body_br.ms.flow.regions.length())), body_br.ms.flow.regions)
  let body_after: BlockR = lower_stmt_list(body_br, body_lp)
  body_after.ms.flow = Flow(enclosing_loops, body_after.ms.flow.regions)
  let body_final: BlockR = body_after
  if body_final.sealed == to_i64(0):
    body_final = br_emit_terminator(body_final, MirNode::MirBr(target_block = header_r.mir))
  let ms_after_body: MS = block_seal(body_final)

  // Continue on the exit block.
  return block_open(ms_after_body, exit_r.mir)

// =========================================================================
// Section 66: Function lowering
// =========================================================================

// Read a list from the HIR idx stream.  The HIR list format
// (hir_flush_list) stores items first and the count at `list_pos`,
// so items live at [list_pos - count, list_pos).
fn read_hir_list(hir_idx: Vector<i64>, list_pos: i64): Vector<i64>
  let result: Vector<i64> = Vector<i64>::new()
  if list_pos < to_i64(0):
    return result
  if list_pos >= hir_idx.length():
    return result
  let count: i64 = hir_idx.get(list_pos)
  let start: i64 = list_pos - count
  let i: i64 = to_i64(0)
  while i < count:
    result = result.push(hir_idx.get(start + i))
    i = i + to_i64(1)
  return result

fn read_hir_list_count(hir_idx: Vector<i64>, list_pos: i64): i64
  if list_pos < to_i64(0):
    return to_i64(0)
  if list_pos >= hir_idx.length():
    return to_i64(0)
  return hir_idx.get(list_pos)

fn lower_function(ms: MS, hir_fn_idx: i64): MirR
  let node: HirNode = ms.hir_nodes.get(hir_fn_idx)
  match node:
    HirNode::HirFunction(fn_sym, tparams, params_lp, ret_ti, body_lp, is_extern_i, class_owner):
      ms = ms_reset_fn_state(ms)

      // Placeholder MirFunction — fields updated after lowering.
      let fn_r: MirR = ms_add_node(ms, MirNode::MirFunction(sym = fn_sym, ret_type = ret_ti, param_count = to_i64(0), local_list_lp = to_i64(0), local_count = to_i64(0), block_list_lp = to_i64(0), block_count = to_i64(0), is_extern = is_extern_i))
      let fn_idx: i64 = fn_r.mir
      ms = fn_r.ms
      ms.current_fn = fn_idx

      // Params are (sym, type_idx) pairs stored via hir_flush_pairs
      // (count = pair_count, not flat item count).
      let param_count: i64 = read_hir_list_count(ms.hir_idx, params_lp)
      let params_start: i64 = params_lp - (param_count * to_i64(2))
      let pi: i64 = to_i64(0)
      while pi < param_count:
        let psym: i64 = ms.hir_idx.get(params_start + pi * to_i64(2))
        let pti: i64 = ms.hir_idx.get(params_start + pi * to_i64(2) + to_i64(1))
        let dl: MirR = ms_declare_local(ms, psym, pti, true)
        ms = dl.ms
        pi = pi + to_i64(1)

      // Extern declarations have no body.  Still flush params into
      // mir_idx so consumers reading (local_list_lp, local_count)
      // get a real local list instead of indexing unrelated data.
      if is_extern_i > 0:
        let extern_local_fl: MirFlush = mir_flush_list(ms, ms.locals)
        ms = extern_local_fl.ms
        // …and an empty block list of its own, so a reader walking the
        // blocks reads none rather than following a stray offset.
        let no_blocks: MirFlush = mir_flush_list(ms, Vector<i64>::new())
        ms = no_blocks.ms
        ms.mir_nodes = ms.mir_nodes.set(fn_idx, MirNode::MirFunction(sym = fn_sym, ret_type = ret_ti, param_count = param_count, local_list_lp = extern_local_fl.list_pos, local_count = ms.locals.length(), block_list_lp = no_blocks.list_pos, block_count = to_i64(0), is_extern = is_extern_i))
        return MirR(ms, fn_idx)

      // Create the entry block and lower the body into it.  Control
      // flow statements (if/while) may seal the entry block and
      // advance br to a different block.
      let entry_r: MirR = ms_new_block(ms)
      let entry_br: BlockR = block_open(entry_r.ms, entry_r.mir)
      let final_br: BlockR = lower_stmt_list(entry_br, body_lp)

      // If the final block is not sealed (no terminator emitted),
      // emit an implicit return-void.
      let closed_br: BlockR = final_br
      if closed_br.sealed == to_i64(0):
        closed_br = br_emit_terminator(closed_br, MirNode::MirReturn(value = to_i64(-1), has_value = to_i64(0)))
      ms = block_seal(closed_br)

      // Flush locals and per-function block list.
      let local_fl: MirFlush = mir_flush_list(ms, ms.locals)
      ms = local_fl.ms
      let block_fl: MirFlush = mir_flush_list(ms, ms.fn_blocks)
      ms = block_fl.ms

      ms.mir_nodes = ms.mir_nodes.set(fn_idx, MirNode::MirFunction(sym = fn_sym, ret_type = ret_ti, param_count = param_count, local_list_lp = local_fl.list_pos, local_count = ms.locals.length(), block_list_lp = block_fl.list_pos, block_count = ms.fn_blocks.length(), is_extern = is_extern_i))
      return MirR(ms, fn_idx)
  return MirR(ms, to_i64(-1))

// =========================================================================
// Section 67: Top-level lowering
// =========================================================================

// A function is generic — lowered as a template — if it declares its
// own type parameters or its signature mentions one (a method of a
// generic class, whose `self` is the class's head): the host's
// `hir_function_is_generic` rule.
fn mir_function_is_generic(ms: MS, tparams_lp: i64, params_lp: i64, ret_ti: i64): bool
  if read_hir_list_count(ms.hir_idx, tparams_lp) > 0:
    return true
  if mir_type_mentions_generic(ms, ret_ti):
    return true
  let param_count: i64 = read_hir_list_count(ms.hir_idx, params_lp)
  let params_start: i64 = params_lp - (param_count * to_i64(2))
  let pi: i64 = to_i64(0)
  while pi < param_count:
    if mir_type_mentions_generic(ms, ms.hir_idx.get(params_start + pi * to_i64(2) + to_i64(1))):
      return true
    pi = pi + to_i64(1)
  return false

// Whether `ti` is, or holds at any depth, a type parameter.  A type
// graph shares its parts, so each type is searched once.
fn mir_type_mentions_generic(ms: MS, ti: i64): bool
  return mir_generic_search(ms, ti, HashMap<i64>::new()).found

class GenericSearch:
  seen: HashMap<i64>
  found: bool

fn mir_generic_search(ms: MS, ti: i64, seen: HashMap<i64>): GenericSearch
  if ti < 0 or ti >= ms.types.length():
    return GenericSearch(seen, false)
  let key: string = i64_to_string(ti)
  if seen.contains(key):
    return GenericSearch(seen, false)
  let so_far: HashMap<i64> = seen.set(key, to_i64(1))
  let t: DaoType = ms.types.get(ti)
  let parts: Vector<i64> = Vector<i64>::new()
  match t.kind:
    TypeKind::TGenericParam:
      return GenericSearch(so_far, true)
    TypeKind::TPointer:
      parts = parts.push(t.pointee)
    TypeKind::TGenerator:
      parts = parts.push(t.pointee)
    TypeKind::TFunction:
      parts = parts.push(t.ret_type)
      let fi: i64 = to_i64(0)
      while fi < t.info_count:
        parts = parts.push(ms.type_info.get(t.info_lp + fi))
        fi = fi + to_i64(1)
    TypeKind::TStruct:
      parts = mir_stands_for_args(ms, t.ret_type)
    TypeKind::TEnum:
      parts = mir_stands_for_args(ms, t.ret_type)
  let i: i64 = to_i64(0)
  while i < parts.length():
    let sub: GenericSearch = mir_generic_search(ms, parts.get(i), so_far)
    if sub.found:
      return sub
    so_far = sub.seen
    i = i + to_i64(1)
  return GenericSearch(so_far, false)

// The arguments a nominal type's stands-for record holds (typecheck
// `write_stands_for`: head, count, arguments); none for -1.
fn mir_stands_for_args(ms: MS, record: i64): Vector<i64>
  let args: Vector<i64> = Vector<i64>::new()
  if record < 0 or record + 1 >= ms.type_info.length():
    return args
  let count: i64 = ms.type_info.get(record + 1)
  if record + 2 + count > ms.type_info.length():
    return args
  let i: i64 = to_i64(0)
  while i < count:
    args = args.push(ms.type_info.get(record + 2 + i))
    i = i + to_i64(1)
  return args

// The prelude's free function `copy_out(x)`, which a resource block's
// exit calls to copy a value one domain outward; -1 when the program has
// none (a program without the prelude).
fn find_prelude_copy_out(p: Program, ms: MS): i64
  if p.hir.root < 0 or p.hir.root >= ms.hir_nodes.length():
    return to_i64(-1)
  match ms.hir_nodes.get(p.hir.root):
    HirNode::HirProgram(module_list_lp):
      let modules: Vector<i64> = read_hir_list(ms.hir_idx, module_list_lp)
      let mi: i64 = to_i64(0)
      while mi < modules.length():
        match ms.hir_nodes.get(modules.get(mi)):
          HirNode::HirModule(name_tok, decls_lp, module_id):
            if program_module(p, module_id).is_prelude:
              let decls: Vector<i64> = read_hir_list(ms.hir_idx, decls_lp)
              let di: i64 = to_i64(0)
              while di < decls.length():
                match ms.hir_nodes.get(decls.get(di)):
                  HirNode::HirFunction(sym, tparams_lp, params_lp, ret_ti, body_lp, is_extern, class_owner):
                    if class_owner < 0 and sym >= 0 and ms.symbols.get(sym).name == "copy_out" and read_hir_list_count(ms.hir_idx, params_lp) == 1:
                      return sym
                di = di + to_i64(1)
        mi = mi + to_i64(1)
  return to_i64(-1)

// A program lowered to MIR: the program, its diagnostics grown by
// MIR's (each on its module's file), and the MIR, rooted at a
// MirProgram.
class ProgramMir:
  program: Program
  mir: MirResult

// One module's lowered functions: the MIR state after them, and the
// MirModule node.
class ModuleLowering:
  ms: MS
  module_node: i64

// Lower each function of one HIR module, with the module's own tokens
// and source: concrete functions into the module, generic ones into
// its templates.
fn lower_module(ms: MS, sf: SourceFile, decls: Vector<i64>): ModuleLowering
  ms.toks = sf.parse_output.toks
  ms.src = sf.source_text
  ms.file_id = sf.file_id
  let fns: Vector<i64> = Vector<i64>::new()
  let templates: Vector<i64> = Vector<i64>::new()
  let i: i64 = to_i64(0)
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    match ms.hir_nodes.get(decl_idx):
      HirNode::HirFunction(n, tparams_lp, params_lp, ret_ti, b, ie, co):
        ms.in_template = mir_function_is_generic(ms, tparams_lp, params_lp, ret_ti)
        let r: MirR = lower_function(ms, decl_idx)
        ms = r.ms
        if r.mir >= 0:
          if ms.in_template:
            templates = templates.push(r.mir)
          else:
            fns = fns.push(r.mir)
        ms.in_template = false
    i = i + to_i64(1)
  let fn_fl: MirFlush = mir_flush_list(ms, fns)
  let tmpl_fl: MirFlush = mir_flush_list(fn_fl.ms, templates)
  let mod_r: MirR = ms_add_node(tmpl_fl.ms, MirNode::MirModule(file_id = sf.file_id, fn_list_lp = fn_fl.list_pos, fn_count = fns.length(), template_list_lp = tmpl_fl.list_pos, template_count = templates.length()))
  return ModuleLowering(mod_r.ms, mod_r.mir)

// Lower a resolved, type-checked program to MIR: HIR for every module,
// then each module's functions, in program order.  MIR's diagnostics
// join the program's, each on the file of the module it came from.
fn program_run_mir(p: Program): ProgramMir
  let ph: ProgramHir = program_lower_hir(p)
  let hp: Program = ph.program
  let ms: MS = MS(
    ph.arena.nodes,
    ph.arena.idx,
    hp.typecheck.types,
    hp.typecheck.type_info,
    Vector<Token>::new(),
    "",
    hp.resolve.symbols,
    hp.typecheck.sym_types,
    hp.resolve.uses,
    Vector<MirNode>::new(),
    Vector<i64>::new(),
    Vector<Diagnostic>::new(),
    to_i64(-1),
    to_i64(-1),
    Vector<i64>::new(),
    Vector<i64>::new(),
    HashMap<i64>::new(),
    to_i64(0),
    false,
    flow_empty(),
    to_i64(-1))
  ms.copy_out_sym = find_prelude_copy_out(hp, ms)
  let all_diags: Vector<FileDiagnostic> = hp.diags
  let module_nodes: Vector<i64> = Vector<i64>::new()
  if hp.hir.root >= 0 and hp.hir.root < ms.hir_nodes.length():
    match ms.hir_nodes.get(hp.hir.root):
      HirNode::HirProgram(module_list_lp):
        let modules: Vector<i64> = read_hir_list(ms.hir_idx, module_list_lp)
        let mi: i64 = to_i64(0)
        while mi < modules.length():
          match ms.hir_nodes.get(modules.get(mi)):
            HirNode::HirModule(name_tok, decls_lp, module_id):
              let sf: SourceFile = program_file_of_module(hp, module_id)
              let before: i64 = ms.diags.length()
              let lowered: ModuleLowering = lower_module(ms, sf, read_hir_list(ms.hir_idx, decls_lp))
              ms = lowered.ms
              module_nodes = module_nodes.push(lowered.module_node)
              let di: i64 = before
              while di < ms.diags.length():
                all_diags = all_diags.push(FileDiagnostic(sf.file_id, sf.path, ms.diags.get(di)))
                di = di + to_i64(1)
          mi = mi + to_i64(1)
  let mod_fl: MirFlush = mir_flush_list(ms, module_nodes)
  let root_r: MirR = ms_add_node(mod_fl.ms, MirNode::MirProgram(module_list_lp = mod_fl.list_pos, module_count = module_nodes.length()))
  let flat: Vector<Diagnostic> = Vector<Diagnostic>::new()
  let fi: i64 = to_i64(0)
  while fi < all_diags.length():
    flat = flat.push(all_diags.get(fi).diag)
    fi = fi + to_i64(1)
  let out: Program = Program(hp.graph, hp.resolve, hp.typecheck, hp.hir, all_diags)
  return ProgramMir(out, MirResult(root_r.ms.mir_nodes, root_r.ms.mir_idx, flat, root_r.mir))

// The module a single-source program lowers to: its MirProgram holds
// exactly one.
fn mir_only_module(r: MirResult): i64
  if r.root < 0:
    return to_i64(-1)
  match r.mir_nodes.get(r.root):
    MirNode::MirProgram(module_list_lp, module_count):
      if module_count == 1:
        return read_hir_list(r.mir_idx, module_list_lp).get(to_i64(0))
  return to_i64(-1)

// Lower one source snippet, wrapped as a module, to MIR.  The root is
// the snippet's MirModule, and the diagnostics every stage's.
fn lower_to_mir(src: string): MirResult
  let wrapped: string = wrap_test_module(src)
  let inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  inputs = inputs.push(SourceInput("test.dao", wrapped, false))
  let pg: ProgramGraph = program_graph_empty()
  resource memory graph =>
    pg = build_program(inputs)
  let p: Program = program_from_graph(pg)
  // Each stage in its own domain: its scratch is reclaimed at the exit and the result is copied out.
  resource memory resolve =>
    p = program_run_resolve(p)
  resource memory typecheck =>
    p = program_run_typecheck(p)
  let pm: ProgramMir = ProgramMir(p, mir_result_empty())
  resource memory mir_lowering =>
    pm = program_run_mir(p)
  let r: MirResult = pm.mir
  return MirResult(r.mir_nodes, r.mir_idx, r.diags, mir_only_module(r))

// Every reference a module's concrete functions make to a generic
// function: until an instantiation names a concrete copy (Task 43) a
// template has no code, so a consumer that needs concrete MIR reports
// each one rather than referring to a function it never emits.
fn mir_template_refs(r: MirResult, symbols: Vector<Symbol>, module_node: i64): Vector<Diagnostic>
  let out: Vector<Diagnostic> = Vector<Diagnostic>::new()
  if module_node < 0:
    return out
  match r.mir_nodes.get(module_node):
    MirNode::MirModule(file_id, fn_list_lp, fn_count, template_list_lp, template_count):
      let generic_syms: HashMap<i64> = HashMap<i64>::new()
      let templates: Vector<i64> = read_hir_list(r.mir_idx, template_list_lp)
      let ti: i64 = to_i64(0)
      while ti < templates.length():
        match r.mir_nodes.get(templates.get(ti)):
          MirNode::MirFunction(sym, rt, pc, llp, lc, blp, bc, ie):
            generic_syms = generic_syms.set(i64_to_string(sym), to_i64(1))
        ti = ti + to_i64(1)
      if templates.length() == 0:
        return out
      let fns: Vector<i64> = read_hir_list(r.mir_idx, fn_list_lp)
      let fi: i64 = to_i64(0)
      while fi < fns.length():
        match r.mir_nodes.get(fns.get(fi)):
          MirNode::MirFunction(sym, rt, pc, llp, lc, block_list_lp, bc, ie):
            let blocks: Vector<i64> = read_hir_list(r.mir_idx, block_list_lp)
            let bi: i64 = to_i64(0)
            while bi < blocks.length():
              match r.mir_nodes.get(blocks.get(bi)):
                MirNode::MirBlock(bid, inst_list_lp, ic):
                  let insts: Vector<i64> = read_hir_list(r.mir_idx, inst_list_lp)
                  let ii: i64 = to_i64(0)
                  while ii < insts.length():
                    match r.mir_nodes.get(insts.get(ii)):
                      MirNode::MirFnRef(ref_sym, ref_ti):
                        if generic_syms.contains(i64_to_string(ref_sym)):
                          out = out.push(make_error(Span(to_i64(0), to_i64(1)), "generic function '" + symbols.get(ref_sym).name + "' has no concrete code until an instantiation names it (monomorphization, Task 43)"))
                    ii = ii + to_i64(1)
              bi = bi + to_i64(1)
        fi = fi + to_i64(1)
  return out

// =========================================================================
// Section 68: Node kind name (for tests and debug)
// =========================================================================

fn mir_node_kind(n: MirNode): string
  match n:
    MirNode::MirProgram(a, b):
      return "MirProgram"
    MirNode::MirModule(a, b, c, d, e):
      return "MirModule"
    MirNode::MirFunction(a, b, c, d, e, f, g, h):
      return "MirFunction"
    MirNode::MirLocal(a, b, c):
      return "MirLocal"
    MirNode::MirBlock(a, b, c):
      return "MirBlock"
    MirNode::MirConstInt(a, b):
      return "MirConstInt"
    MirNode::MirConstFloat(a, b):
      return "MirConstFloat"
    MirNode::MirConstBool(a, b):
      return "MirConstBool"
    MirNode::MirConstString(a, b):
      return "MirConstString"
    MirNode::MirBinary(a, b, c, d):
      return "MirBinary"
    MirNode::MirUnary(a, b, c):
      return "MirUnary"
    MirNode::MirLoad(a, b):
      return "MirLoad"
    MirNode::MirEnumDiscriminant(a, b):
      return "MirEnumDiscriminant"
    MirNode::MirEnumPayload(a, b, c, d):
      return "MirEnumPayload"
    MirNode::MirConstruct(a, b, c):
      return "MirConstruct"
    MirNode::MirEnumConstruct(a, b, c, d):
      return "MirEnumConstruct"
    MirNode::MirFieldAccess(a, b, c, d):
      return "MirFieldAccess"
    MirNode::MirFnRef(a, b):
      return "MirFnRef"
    MirNode::MirCall(a, b, c, d):
      return "MirCall"
    MirNode::MirStore(a, b, c, d):
      return "MirStore"
    MirNode::MirModeEnter(a):
      return "MirModeEnter"
    MirNode::MirModeExit(a):
      return "MirModeExit"
    MirNode::MirResourceEnter(a, b):
      return "MirResourceEnter"
    MirNode::MirResourceExit(a, b, c):
      return "MirResourceExit"
    MirNode::MirReturn(a, b):
      return "MirReturn"
    MirNode::MirBr(a):
      return "MirBr"
    MirNode::MirCondBr(a, b, c):
      return "MirCondBr"
    MirNode::MirErrorExpr(a):
      return "MirErrorExpr"
  return "Unknown"

fn mir_count_nodes(r: MirResult): i64
  return r.mir_nodes.length()
