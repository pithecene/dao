module bootstrap::mir_tests
// Test runner for the bootstrap mir.  Assembled after the
// shared base and every library it exercises; never compiled
// standalone.

// =========================================================================
// Section 69: Tests
// =========================================================================

fn mir_contains_kind(r: MirResult, kind: string): bool
  let i: i64 = to_i64(0)
  while i < r.mir_nodes.length():
    if mir_node_kind(r.mir_nodes.get(i)) == kind:
      return true
    i = i + to_i64(1)
  return false

// Whether any diagnostic of `r` mentions `needle`.
fn mir_diag_mentions(r: MirResult, needle: string): bool
  let i: i64 = 0
  while i < r.diags.length():
    if index_of(r.diags.get(i).message, needle) >= 0:
      return true
    i = i + 1
  return false

fn mir_count_kind(r: MirResult, kind: string): i64
  let n: i64 = to_i64(0)
  let i: i64 = to_i64(0)
  while i < r.mir_nodes.length():
    if mir_node_kind(r.mir_nodes.get(i)) == kind:
      n = n + to_i64(1)
    i = i + to_i64(1)
  return n

// A program of `inputs` resolved, type-checked and lowered to MIR.
fn mir_of_program(inputs: Vector<SourceInput>): ProgramMir
  let p: Program = program_from_graph(build_program(inputs))
  p = program_run_resolve(p)
  p = program_run_typecheck(p)
  return program_run_mir(p)

// The MirModule nodes of a MirProgram root, in program order.
fn mir_modules(r: MirResult): Vector<i64>
  match r.mir_nodes.get(r.root):
    MirNode::MirProgram(module_list_lp, module_count):
      return read_hir_list(r.mir_idx, module_list_lp)
  return Vector<i64>::new()

// A module's concrete functions (`templates` false) or its templates.
fn mir_module_fns(r: MirResult, module_node: i64, templates: bool): Vector<i64>
  match r.mir_nodes.get(module_node):
    MirNode::MirModule(file_id, fn_list_lp, fn_count, template_list_lp, template_count):
      if templates:
        return read_hir_list(r.mir_idx, template_list_lp)
      return read_hir_list(r.mir_idx, fn_list_lp)
  return Vector<i64>::new()

// The resolver symbol a MirFunction lowers.
fn mir_fn_sym(r: MirResult, fn_node: i64): i64
  match r.mir_nodes.get(fn_node):
    MirNode::MirFunction(sym, rt, pc, llp, lc, blp, bc, ie):
      return sym
  return to_i64(-1)

// The values of the MirConstInt instructions of one function, in order.
fn mir_fn_int_consts(r: MirResult, fn_node: i64): Vector<i64>
  let out: Vector<i64> = Vector<i64>::new()
  match r.mir_nodes.get(fn_node):
    MirNode::MirFunction(sym, rt, pc, llp, lc, block_list_lp, bc, ie):
      let blocks: Vector<i64> = read_hir_list(r.mir_idx, block_list_lp)
      let bi: i64 = 0
      while bi < blocks.length():
        match r.mir_nodes.get(blocks.get(bi)):
          MirNode::MirBlock(bid, inst_list_lp, ic):
            let insts: Vector<i64> = read_hir_list(r.mir_idx, inst_list_lp)
            let ii: i64 = 0
            while ii < insts.length():
              match r.mir_nodes.get(insts.get(ii)):
                MirNode::MirConstInt(value, ti):
                  out = out.push(value)
              ii = ii + 1
        bi = bi + 1
  return out

fn main(): i32
  print("=== bootstrap/mir: Tier A MIR subsystem ===")
  print("")

  let pass_count: i32 = 0
  let total: i32 = 27

  // -----------------------------------------------------------------
  // Test 1: minimal program produces MirModule + MirFunction
  // -----------------------------------------------------------------
  let src1: string = "fn main(): i32\n  return 0\n"
  let r1: MirResult = lower_to_mir(src1)
  if r1.root >= 0:
    if mir_contains_kind(r1, "MirModule"):
      if mir_contains_kind(r1, "MirFunction"):
        if mir_contains_kind(r1, "MirReturn"):
          print("PASS minimal_program")
          pass_count = pass_count + 1
        else:
          print("FAIL minimal_program: no MirReturn")
      else:
        print("FAIL minimal_program: no MirFunction")
    else:
      print("FAIL minimal_program: no MirModule")
  else:
    print("FAIL minimal_program: root < 0")

  // -----------------------------------------------------------------
  // Test 2: let + binary + return lowers to expected instruction kinds
  // -----------------------------------------------------------------
  let src2: string = "fn main(): i32\n  let x: i32 = 1 + 2\n  return x\n"
  let r2: MirResult = lower_to_mir(src2)
  let has_const: bool = mir_contains_kind(r2, "MirConstInt")
  let has_binary: bool = mir_contains_kind(r2, "MirBinary")
  let has_store: bool = mir_contains_kind(r2, "MirStore")
  let has_load: bool = mir_contains_kind(r2, "MirLoad")
  let has_ret: bool = mir_contains_kind(r2, "MirReturn")
  if has_const:
    if has_binary:
      if has_store:
        if has_load:
          if has_ret:
            print("PASS let_binary_return")
            pass_count = pass_count + 1
          else:
            print("FAIL let_binary_return: no MirReturn")
        else:
          print("FAIL let_binary_return: no MirLoad")
      else:
        print("FAIL let_binary_return: no MirStore")
    else:
      print("FAIL let_binary_return: no MirBinary")
  else:
    print("FAIL let_binary_return: no MirConstInt")

  // -----------------------------------------------------------------
  // Test 3: function call lowers to MirCall + MirFnRef
  // -----------------------------------------------------------------
  let src3: string = "fn add(a: i32, b: i32): i32\n  return a + b\n\nfn main(): i32\n  return add(1, 2)\n"
  let r3: MirResult = lower_to_mir(src3)
  if mir_contains_kind(r3, "MirCall"):
    if mir_contains_kind(r3, "MirFnRef"):
      print("PASS function_call")
      pass_count = pass_count + 1
    else:
      print("FAIL function_call: no MirFnRef")
  else:
    print("FAIL function_call: no MirCall")

  // -----------------------------------------------------------------
  // Test 4: multiple functions produce multiple MirFunction nodes
  // -----------------------------------------------------------------
  let src4: string = "fn a(): i32 -> 1\n\nfn b(): i32 -> 2\n\nfn main(): i32\n  return 0\n"
  let r4: MirResult = lower_to_mir(src4)
  if mir_count_kind(r4, "MirFunction") >= to_i64(3):
    print("PASS multi_function")
    pass_count = pass_count + 1
  else:
    print("FAIL multi_function: expected >= 3 MirFunction nodes")

  // -----------------------------------------------------------------
  // Test 5: params become MirLocal with is_param=1
  // -----------------------------------------------------------------
  let src5: string = "fn f(x: i32, y: i32): i32\n  return x\n"
  let r5: MirResult = lower_to_mir(src5)
  let param_count: i64 = to_i64(0)
  let li: i64 = to_i64(0)
  while li < r5.mir_nodes.length():
    let mn: MirNode = r5.mir_nodes.get(li)
    match mn:
      MirNode::MirLocal(s, ti, ip):
        if ip > 0:
          param_count = param_count + to_i64(1)
    li = li + to_i64(1)
  if param_count >= to_i64(2):
    print("PASS param_locals")
    pass_count = pass_count + 1
  else:
    print("FAIL param_locals: expected >= 2 param locals, got " + i64_to_string(param_count))

  // -----------------------------------------------------------------
  // Test 6: extern fn lowers to MirFunction with is_extern=1 and no blocks
  // -----------------------------------------------------------------
  let src6: string = "extern fn puts(s: string): i32\n\nfn main(): i32\n  return 0\n"
  let r6: MirResult = lower_to_mir(src6)
  let has_extern_fn: bool = false
  let ei: i64 = to_i64(0)
  while ei < r6.mir_nodes.length():
    let en: MirNode = r6.mir_nodes.get(ei)
    match en:
      MirNode::MirFunction(s, rt, pc, llp, lc, blp, bc, ie):
        if ie > 0:
          if bc == to_i64(0):
            has_extern_fn = true
    ei = ei + to_i64(1)
  if has_extern_fn:
    print("PASS extern_function")
    pass_count = pass_count + 1
  else:
    print("FAIL extern_function: no extern MirFunction with zero blocks")

  // -----------------------------------------------------------------
  // Test 7: if/else lowers to MirCondBr with multiple blocks + MirBr
  // -----------------------------------------------------------------
  let src7: string = "fn f(x: i32): i32\n  if x > 0\n    return 1\n  else\n    return 2\n"
  let r7: MirResult = lower_to_mir(src7)
  let has_condbr: bool = mir_contains_kind(r7, "MirCondBr")
  // Count MirBlock nodes in the MirFunction for `f`: should be >= 3
  // (entry, then, else) — merge may or may not exist depending on
  // whether both branches terminate.
  let block_count_7: i64 = mir_count_kind(r7, "MirBlock")
  if has_condbr:
    if block_count_7 >= to_i64(3):
      print("PASS if_stmt")
      pass_count = pass_count + 1
    else:
      print("FAIL if_stmt: expected >= 3 MirBlock, got " + i64_to_string(block_count_7))
  else:
    print("FAIL if_stmt: no MirCondBr")

  // -----------------------------------------------------------------
  // Test 8: while loop lowers to header/body/exit with MirCondBr + MirBr
  // -----------------------------------------------------------------
  let src8: string = "fn f(n: i32): i32\n  let i: i32 = 0\n  while i < n\n    i = i + 1\n  return i\n"
  let r8: MirResult = lower_to_mir(src8)
  let has_condbr_8: bool = mir_contains_kind(r8, "MirCondBr")
  let has_br_8: bool = mir_contains_kind(r8, "MirBr")
  let block_count_8: i64 = mir_count_kind(r8, "MirBlock")
  if has_condbr_8:
    if has_br_8:
      if block_count_8 >= to_i64(4):
        print("PASS while_stmt")
        pass_count = pass_count + 1
      else:
        print("FAIL while_stmt: expected >= 4 MirBlock, got " + i64_to_string(block_count_8))
    else:
      print("FAIL while_stmt: no MirBr")
  else:
    print("FAIL while_stmt: no MirCondBr")

  // -----------------------------------------------------------------
  // Test 9: a resource block is rejected fail-closed — one diagnostic
  // naming HirResource, nothing of the block lowered silently.
  // -----------------------------------------------------------------
  let src9: string = "fn main(): i32\n  let x: i32 = 0\n  resource memory pool =>\n    x = 1\n  return x\n"
  let r9: MirResult = lower_to_mir(src9)
  let rejected: bool = false
  if r9.diags.length() == 1:
    if index_of(r9.diags.get(0).message, "HirResource") >= 0:
      rejected = true
  if rejected:
    print("PASS resource_block_rejected")
    pass_count = pass_count + 1
  else:
    print("FAIL resource_block_rejected: expected one diagnostic naming HirResource, got " + i64_to_string(r9.diags.length()))

  // -----------------------------------------------------------------
  // Tests 10–11: what HIR rejected fail-closed reaches MIR's result as
  // diagnostics — a member a concept provides, and a method taken as a
  // value — never as a silent MirErrorExpr.
  // -----------------------------------------------------------------
  let src10: string = "derived concept Show:\n  fn show(self): string\n\nextend i64 as Show:\n  fn show(self): string\n    return \"n\"\n\nclass P:\n  x: i64\n\nfn f(p: P): string\n  return p.show()\n"
  let r10: MirResult = lower_to_mir(src10)
  let derived_rejected: bool = false
  let d10: i64 = 0
  while d10 < r10.diags.length():
    if index_of(r10.diags.get(d10).message, "derived conformance or a bound") >= 0:
      derived_rejected = true
    d10 = d10 + 1
  if derived_rejected:
    print("PASS derived_member_call_rejected_in_mir")
    pass_count = pass_count + 1
  else:
    print("FAIL derived_member_call_rejected_in_mir: expected HIR's rejection among the MIR diagnostics, got " + i64_to_string(r10.diags.length()))

  let src11: string = "class C:\n  x: i64\n  fn get(self): i64 -> self.x\n\nfn f(c: C): i64\n  let g = c.get\n  return 0\n"
  let r11: MirResult = lower_to_mir(src11)
  let value_rejected: bool = false
  let d11: i64 = 0
  while d11 < r11.diags.length():
    if index_of(r11.diags.get(d11).message, "taken as a value") >= 0:
      value_rejected = true
    d11 = d11 + 1
  if value_rejected:
    print("PASS method_value_rejected_in_mir")
    pass_count = pass_count + 1
  else:
    print("FAIL method_value_rejected_in_mir: expected HIR's rejection among the MIR diagnostics, got " + i64_to_string(r11.diags.length()))

  // -----------------------------------------------------------------
  // Tests 12–13: a static call `C::make()` lowers to a call of the
  // method symbol (no error expression), and a checker diagnostic — a
  // static method called through a value — reaches MIR's result.
  // -----------------------------------------------------------------
  let src12: string = "class C:\n  x: i32\n  fn make(): i32 -> 7\n\nfn f(): i32\n  return C::make()\n"
  let r12: MirResult = lower_to_mir(src12)
  if r12.diags.length() == 0 and mir_count_kind(r12, "MirErrorExpr") == 0 and mir_contains_kind(r12, "MirCall"):
    print("PASS static_call_lowered_in_mir")
    pass_count = pass_count + 1
  else:
    print("FAIL static_call_lowered_in_mir: expected a call, no error expression, no diagnostics; got " + i64_to_string(r12.diags.length()) + " diagnostics, " + i64_to_string(mir_count_kind(r12, "MirErrorExpr")) + " error expressions")

  let src13: string = "class C:\n  x: i32\n  fn make(): i32 -> 7\n\nfn f(c: C): i32\n  return c.make()\n"
  let r13: MirResult = lower_to_mir(src13)
  if r13.diags.length() >= 1:
    print("PASS checker_diagnostic_reaches_mir")
    pass_count = pass_count + 1
  else:
    print("FAIL checker_diagnostic_reaches_mir: expected the checker's diagnostic in the MIR result, got 0")

  // Test 14: a static method taken as a value is a function reference,
  // lowered without an error expression.
  let src14: string = "class C:\n  x: i32\n  fn make(): i32 -> 7\n\nfn f(): i32\n  let g = C::make\n  return g()\n"
  let r14: MirResult = lower_to_mir(src14)
  if r14.diags.length() == 0 and mir_count_kind(r14, "MirErrorExpr") == 0 and mir_contains_kind(r14, "MirFnRef"):
    print("PASS static_method_value_lowered_in_mir")
    pass_count = pass_count + 1
  else:
    print("FAIL static_method_value_lowered_in_mir: expected a function reference, no error expression, no diagnostics; got " + i64_to_string(r14.diags.length()) + " diagnostics, " + i64_to_string(mir_count_kind(r14, "MirErrorExpr")) + " error expressions")

  // Tests 15–16: `mode` blocks and `yield` have no Tier A lowering; MIR
  // rejects each with a diagnostic naming the construct.
  if mir_diag_mentions(lower_to_mir("fn f(): i32\n  mode unsafe =>\n    return 1\n  return 0\n"), "HirMode"):
    print("PASS mode_block_rejected_in_mir")
    pass_count = pass_count + 1
  else:
    print("FAIL mode_block_rejected_in_mir: expected a diagnostic naming HirMode")
  let r16: MirResult = lower_to_mir("fn g(): Generator<i32>\n  yield 1\n  return\n")
  if mir_diag_mentions(r16, "HirYield") and r16.diags.length() == 1:
    print("PASS yield_rejected_in_mir")
    pass_count = pass_count + 1
  else:
    print("FAIL yield_rejected_in_mir: expected exactly the diagnostic naming HirYield, got " + i64_to_string(r16.diags.length()) + " diagnostics")

  // -----------------------------------------------------------------
  // Summary
  // Test 17: a call through a type parameter's bound has no function
  // until an instantiation names one.  Its generic function is a
  // template, which carries the call with the member access as its
  // callee, as the host's template does; nothing is reported.
  let r17: MirResult = lower_to_mir("concept Printable:\n  fn to_string(self): string\n\nfn show<T: Printable>(x: T): string\n  return x.to_string()\n")
  let r17_templates: Vector<i64> = mir_module_fns(r17, r17.root, true)
  if r17.diags.length() == 0 and r17_templates.length() == 1 and mir_module_fns(r17, r17.root, false).length() == 0 and mir_contains_kind(r17, "MirFieldAccess") and mir_contains_kind(r17, "MirCall"):
    print("PASS bound_call_carried_by_template")
    pass_count = pass_count + 1
  else:
    print("FAIL bound_call_carried_by_template: expected one template holding the call, no function, no diagnostics; got " + i64_to_string(r17.diags.length()) + " diagnostics, " + i64_to_string(r17_templates.length()) + " templates")
  // Test 18: an expression kind with no Tier A lowering is reported, so
  // a call through a bound beneath it does not vanish with it.
  let r18: MirResult = lower_to_mir("concept Printable:\n  fn to_string(self): string\n\nfn identity(s: string): string -> s\n\nfn show<T: Printable>(x: T): string\n  return x.to_string() |> identity\n")
  if r18.diags.length() >= 1:
    print("PASS unsupported_expression_kind_reported_in_mir")
    pass_count = pass_count + 1
  else:
    print("FAIL unsupported_expression_kind_reported_in_mir: expected a diagnostic, got 0")

  // Test 19: a program lowers to one MirModule per module, in program
  // order; the call in `app::main` names the function `core::util`
  // declares (a prelude module, so it is called unqualified).
  let two: Vector<SourceInput> = Vector<SourceInput>::new()
  two = two.push(SourceInput("core_util.dao", "module core::util\n\nfn add(a: i32, b: i32): i32 -> a + b\n", true))
  two = two.push(SourceInput("main.dao", "module app::main\n\nfn main(): i32\n  let x: i32 = 7\n  return add(40, 2)\n", false))
  let pm19: ProgramMir = mir_of_program(two)
  let r19: MirResult = pm19.mir
  let mods19: Vector<i64> = mir_modules(r19)
  let add_sym: i64 = to_i64(-1)
  let main_fn: i64 = to_i64(-1)
  if mods19.length() == 2:
    let util_fns: Vector<i64> = mir_module_fns(r19, mods19.get(0), false)
    let main_fns: Vector<i64> = mir_module_fns(r19, mods19.get(1), false)
    if util_fns.length() == 1 and main_fns.length() == 1:
      add_sym = mir_fn_sym(r19, util_fns.get(0))
      main_fn = main_fns.get(0)
  let ref_names_add: bool = false
  let ni: i64 = 0
  while ni < r19.mir_nodes.length():
    match r19.mir_nodes.get(ni):
      MirNode::MirFnRef(ref_sym, ref_ti):
        if ref_sym == add_sym and add_sym >= 0:
          ref_names_add = true
    ni = ni + 1
  if r19.diags.length() == 0 and ref_names_add:
    print("PASS program_lowers_every_module")
    pass_count = pass_count + 1
  else:
    print("FAIL program_lowers_every_module: expected two modules and a call naming add, no diagnostics; got " + i64_to_string(mods19.length()) + " modules, " + i64_to_string(r19.diags.length()) + " diagnostics")

  // Test 20: a literal lowers with its own module's lexeme: `main`'s
  // constants read 7, 40, 2 from main.dao, not from core_util.dao.
  let consts20: Vector<i64> = Vector<i64>::new()
  if main_fn >= 0:
    consts20 = mir_fn_int_consts(r19, main_fn)
  if consts20.length() == 3 and consts20.get(0) == 7 and consts20.get(1) == 40 and consts20.get(2) == 2:
    print("PASS literal_reads_its_module_source")
    pass_count = pass_count + 1
  else:
    print("FAIL literal_reads_its_module_source: expected constants 7, 40, 2, got " + i64_to_string(consts20.length()) + " constants")

  // Test 21: a function with its own type parameters, and a method of a
  // generic class (its `self` is the head), are templates; a function
  // beside them is concrete.
  let r21: MirResult = lower_to_mir("fn id<T>(x: T): T -> x\n\nclass Box<T>:\n  v: T\n\n  fn get(self): T -> self.v\n\nfn one(): i32 -> 1\n")
  let t21: i64 = mir_module_fns(r21, r21.root, true).length()
  let f21: i64 = mir_module_fns(r21, r21.root, false).length()
  if r21.diags.length() == 0 and t21 == 2 and f21 == 1:
    print("PASS generic_functions_are_templates")
    pass_count = pass_count + 1
  else:
    print("FAIL generic_functions_are_templates: expected 2 templates and 1 function, got " + i64_to_string(t21) + " and " + i64_to_string(f21) + ", " + i64_to_string(r21.diags.length()) + " diagnostics")

  // Test 22: a MIR diagnostic is on the file of the module it came from.
  let two22: Vector<SourceInput> = Vector<SourceInput>::new()
  two22 = two22.push(SourceInput("core_util.dao", "module core::util\n\nfn add(a: i32, b: i32): i32 -> a + b\n", true))
  two22 = two22.push(SourceInput("main.dao", "module app::main\n\nfn main(): i32\n  while true:\n    break\n  return add(1, 2)\n", false))
  let pm22: ProgramMir = mir_of_program(two22)
  let d22: Vector<FileDiagnostic> = pm22.program.diags
  if d22.length() == 1 and d22.get(0).path == "main.dao" and index_of(d22.get(0).diag.message, "HirBreak") >= 0:
    print("PASS mir_diagnostic_on_its_module_file")
    pass_count = pass_count + 1
  else:
    print("FAIL mir_diagnostic_on_its_module_file: expected one diagnostic naming HirBreak on main.dao, got " + i64_to_string(d22.length()))

  // Test 23: a match on a payload-bearing enum lowers as the host's does
  // (`daoc mir`): the scrutinee stored to a local, enum_discriminant
  // compared per arm, enum_payload stored to each binding.
  let r23: MirResult = lower_to_mir("enum class Shape:\n  Circle(r: i32)\n  Empty\n\nfn s(x: Shape): i32\n  match x:\n    Shape::Empty:\n      return 0\n    Shape::Circle(r):\n      return r\n  return 9\n")
  if r23.diags.length() == 0 and mir_count_kind(r23, "MirEnumDiscriminant") == 2 and mir_count_kind(r23, "MirEnumPayload") == 1 and mir_count_kind(r23, "MirFnRef") == 0 and mir_count_kind(r23, "MirLocal") == 3:
    print("PASS match_lowers_to_discriminant_and_payload")
    pass_count = pass_count + 1
  else:
    print("FAIL match_lowers_to_discriminant_and_payload: got " + i64_to_string(mir_count_kind(r23, "MirEnumDiscriminant")) + " discriminants, " + i64_to_string(mir_count_kind(r23, "MirEnumPayload")) + " payloads, " + i64_to_string(mir_count_kind(r23, "MirLocal")) + " locals, " + i64_to_string(r23.diags.length()) + " diagnostics")

  // Test 24: construction lowers as the host's does (`daoc mir`):
  // `construct P(%0, %1)`, and a variant's payload evaluated in source
  // order (h = 2 first) and placed in declaration order (w, h).
  let r24: MirResult = lower_to_mir("class P:\n  x: i32\n  y: i64\n\nenum class Shape:\n  Rect(w: i32, h: i32)\n  Empty\n\nfn main(): i32\n  let p: P = P(1, 2)\n  let s: Shape = Shape::Rect(h = 2, w = 1)\n  return 0\n")
  let placed24: string = ""
  let ni24: i64 = 0
  while ni24 < r24.mir_nodes.length():
    match r24.mir_nodes.get(ni24):
      MirNode::MirEnumConstruct(variant, arg_list_lp, arg_count, ti):
        let a24: Vector<i64> = read_hir_list(r24.mir_idx, arg_list_lp)
        let ai24: i64 = 0
        while ai24 < a24.length():
          match r24.mir_nodes.get(a24.get(ai24)):
            MirNode::MirConstInt(value, cti):
              placed24 = placed24 + i64_to_string(value) + ";"
          ai24 = ai24 + 1
    ni24 = ni24 + 1
  if r24.diags.length() == 0 and mir_count_kind(r24, "MirConstruct") == 1 and placed24 == "1;2;" and mir_count_kind(r24, "MirCall") == 0:
    print("PASS construction_lowers_to_construct")
    pass_count = pass_count + 1
  else:
    print("FAIL construction_lowers_to_construct: got payload '" + placed24 + "', " + i64_to_string(mir_count_kind(r24, "MirConstruct")) + " constructs, " + i64_to_string(r24.diags.length()) + " diagnostics")
  // Test 24b: a class named through its module, `lib::P(1)`, constructs
  // too (host: `construct P(%0)`).
  let in24b: Vector<SourceInput> = Vector<SourceInput>::new()
  in24b = in24b.push(SourceInput("lib.dao", "module probe::lib\n\nclass P:\n  x: i32\n", false))
  in24b = in24b.push(SourceInput("main.dao", "module probe::main\n\nimport probe::lib\n\nfn main(): i32\n  let p: lib::P = lib::P(1)\n  return p.x\n", false))
  let r24b: MirResult = mir_of_program(in24b).mir
  if r24b.diags.length() == 0 and mir_count_kind(r24b, "MirConstruct") == 1 and mir_count_kind(r24b, "MirCall") == 0:
    print("PASS qualified_class_constructs")
    pass_count = pass_count + 1
  else:
    print("FAIL qualified_class_constructs: got " + i64_to_string(mir_count_kind(r24b, "MirConstruct")) + " constructs, " + i64_to_string(r24b.diags.length()) + " diagnostics")

  // Test 25: an assignment to a field stores to a place, as the host's
  // does (`daoc mir`): `store _0.a`, `store _0.inner.v`, and in a
  // method `store _0.a` on `self`.
  let r25: MirResult = lower_to_mir("class In:\n  v: i32\n\nclass Out:\n  a: i32\n  inner: In\n\n  fn bump(self): i32\n    self.a = self.a + 1\n    return self.a\n\nfn main(): i32\n  let o: Out = Out(1, In(2))\n  o.a = 5\n  o.inner.v = 7\n  return o.a\n")
  let paths25: string = ""
  let ni25: i64 = 0
  while ni25 < r25.mir_nodes.length():
    match r25.mir_nodes.get(ni25):
      MirNode::MirStore(local_idx, path_lp, path_count, value):
        if path_count > 0:
          let p25: Vector<i64> = read_hir_list(r25.mir_idx, path_lp)
          paths25 = paths25 + "_" + i64_to_string(local_idx)
          let pi25: i64 = 0
          while pi25 < p25.length():
            paths25 = paths25 + "." + i64_to_string(p25.get(pi25))
            pi25 = pi25 + 1
          paths25 = paths25 + ";"
    ni25 = ni25 + 1
  if r25.diags.length() == 0 and paths25 == "_0.0;_0.0;_0.1.0;":
    print("PASS field_assignment_stores_to_place")
    pass_count = pass_count + 1
  else:
    print("FAIL field_assignment_stores_to_place: got '" + paths25 + "', " + i64_to_string(r25.diags.length()) + " diagnostics")

  // Test 26: `break` branches to the innermost loop's exit block.
  let r26: MirResult = lower_to_mir("fn main(): i32\n  let n: i32 = 0\n  while true:\n    if n > 3:\n      break\n    n = n + 1\n  return n\n")
  if r26.diags.length() == 0 and mir_count_kind(r26, "MirBr") >= 3:
    print("PASS break_branches_to_loop_exit")
    pass_count = pass_count + 1
  else:
    print("FAIL break_branches_to_loop_exit: got " + i64_to_string(r26.diags.length()) + " diagnostics, " + i64_to_string(mir_count_kind(r26, "MirBr")) + " branches")

  // -----------------------------------------------------------------
  print("")
  print(i32_to_string(pass_count) + " / " + i32_to_string(total) + " tests passed")
  if pass_count == total:
    print("ALL TESTS PASSED")
  else:
    print("SOME TESTS FAILED")
  return 0

