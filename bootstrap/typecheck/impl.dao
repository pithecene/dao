module bootstrap::typecheck
// =========================================================================
// Section 33: Type checker data structures
// =========================================================================
//
// Bootstrap type checker — Task 23.
//
// This file is a FRAGMENT: it is assembled after shared/base.dao and
// resolver/impl.dao.  It must NOT contain any token model, lexer,
// parser, or resolver code — those come from the preceding files.
//
// Assembly:
//   cat bootstrap/shared/base.dao \
//       bootstrap/resolver/impl.dao \
//       bootstrap/typecheck/impl.dao \
//       > bootstrap/typecheck/typecheck.gen.dao
//
// Covered here: concepts, `extend`, derived conformance with the host's
// module visibility, method dispatch by the receiver's type (a class's
// own methods and extends, over a program-wide index), generic
// parameter bounds and member access through them, contextual literal
// typing, static factory calls, `mode unsafe =>` as the context a
// dereference requires, and generators (`Generator<T>` as a type of its
// own kind, `yield` checked against it).  A member a concept provides through a
// derived conformance or a bound is typed here and rejected by HIR
// until its implementation is synthesized or instantiated.
//
// Tier B deferrals:
//   - Generic type inference, substitution, instantiation (TGenericParam
//     types are registered; a generic annotation other than a concept's
//     self form and `Generator<T>` reads as unresolved; full
//     monomorphization is deferred)
//   - Concept default method bodies (unchecked, as in the host)
//   - Lambda contextual typing
//   - List literal type inference
//   - Try operator (requires generic Option/Result)
//   - Index expressions
//   - Checking rules of `mode gpu` / `mode parallel` (their bodies are
//     checked as blocks); resource-block domain semantics beyond `yield`
//     legality (bodies are checked)
//   - C ABI type validation
//
// The checker state is `TC` (the module's parse context) and `TS` (the
// mutable state: type tables, diagnostics, the body context `CheckCtx`,
// and the program-wide `Registry`).

// TypeKind and DaoType promoted to shared/base.dao in D1a so that
// TypeCheckData can carry `types: Vector<DaoType>` and every pass
// can reference the type universe.  See the comment in shared/base.dao.

// =========================================================================
// Section 34: Type checker state
// =========================================================================

// Immutable parse context — shared, never modified during type checking.
class TC:
  nodes: Vector<Node>
  idx_data: Vector<i64>
  toks: Vector<Token>
  src: string
  symbols: Vector<Symbol>
  scopes: Vector<Scope>
  uses_map: HashMap<i64>         // program-level uses_key(file_id, tok_idx) → sym_idx
  file_id: i64                   // module-level file provenance (-1 for dummy)
  concept_bindings: HashMap<i64> // program-level extend_binding_key → concept sym_idx
  module_id: i64                 // module identity for owner_module_id filtering (D2)
  exports: ExportTables          // cross-module export lookup (D4)

// Mutable type checker state — threaded through all operations.
// The context of the function body being checked: what a `return`,
// `break`, `yield`, or dereference is measured against.  Entered per
// function body (tc_enter_fn_ctx) and restored after it.
class CheckCtx:
  return_type: i64      // the function's return type, -1 when unresolved
  loop_depth: i64       // enclosing loops — `break` legality
  in_generator: i64     // 1 when the return type is a TGenerator
  gen_elem: i64         // that generator's element type, -1 when unresolved
  unsafe_depth: i64     // enclosing `mode unsafe =>` blocks — dereference legality
  resource_depth: i64   // enclosing `resource memory` blocks — `yield` legality

class TS:
  tc: TC
  types: Vector<DaoType>
  type_info: Vector<i64>
  sym_types: Vector<i64>
  diags: Vector<Diagnostic>
  ctx: CheckCtx              // the body being checked (see CheckCtx)
  reg: Registry              // program-wide registries threaded across modules (see Registry)

// The registries a program's type check threads across its modules in
// topo order — expression types, the variant registry, conformances —
// and two program facts indexed once from the resolved program: the
// type-declaring symbol of every declaration, and the prelude modules.
/// The types a program makes once and shares: a generator per element
/// type, and an instantiation per head and arguments.  They are one
/// value so the registry keeps saying what it is rather than growing a
/// field per kind of type that is interned.
class MadeTypes:
  generators: HashMap<i64>      // by element type index (find_or_add_generator_type)
  instantiations: HashMap<i64>  // by head type and arguments (instantiate_generic)
  in_progress: Vector<i64>      // the instantiations being made, innermost last: (head, nesting of its arguments) each
  nesting: HashMap<i64>         // how deeply a type nests, by type index (type_nesting)
  pending: Vector<i64>          // instantiations made before their head's layout was written (materialize_pending)

class Registry:
  expr_types: HashMap<i64>      // keyed by expr_id_key(module_id, node_idx)
  variant_set: HashMap<i64>     // program-wide variant registry, keyed by name (see tc_pass1)
  conform: Conformance          // conformance state (explicit extends, derived concepts)
  methods: HashMap<i64>         // method dispatch by owner type and name (dispatch_key_*), filled by tc_bind_self
  index: ProgramIndex           // the resolved program's declaration indexes
  made: MadeTypes               // the types this program made once and shares (see MadeTypes)


// The registries for a resolved program: the declaration indexes
// (ProgramIndex) built in one scan of the symbols, every accumulating
// registry empty.
fn registry_new(symbols: Vector<Symbol>, modules: Vector<ModuleEntry>): Registry
  let type_syms: HashMap<i64> = HashMap<i64>::new()
  let callables: HashMap<i64> = HashMap<i64>::new()
  let members: HashMap<i64> = HashMap<i64>::new()
  let si: i64 = 0
  while si < symbols.length():
    let sym: Symbol = symbols.get(si)
    let kind: string = symbol_kind_name(sym.kind)
    if kind == "Type":
      type_syms = type_syms.set(decl_key(sym.owner_module_id, sym.decl_node), si)
    if is_method_symbol(sym):
      callables = callables.set(decl_key(sym.owner_module_id, sym.decl_node), si)
    if kind == "Param" or kind == "Field":
      members = members.set(member_key(sym.owner_module_id, sym.decl_node, kind, sym.name), si)
    if kind == "Local":
      members = members.set(member_key(sym.owner_module_id, sym.decl_node, kind, ""), si)
    si = si + 1
  let preludes: HashMap<i64> = HashMap<i64>::new()
  let mi: i64 = 0
  while mi < modules.length():
    let me: ModuleEntry = modules.get(mi)
    if me.is_prelude:
      preludes = preludes.set(i64_to_string(me.module_id), to_i64(1))
    mi = mi + 1
  return Registry(HashMap<i64>::new(), HashMap<i64>::new(), conformance_empty(), HashMap<i64>::new(), ProgramIndex(type_syms, callables, members, preludes), MadeTypes(HashMap<i64>::new(), HashMap<i64>::new(), Vector<i64>::new(), HashMap<i64>::new(), Vector<i64>::new()))

fn conformance_empty(): Conformance
  return Conformance(HashMap<i64>::new(), Vector<i64>::new(), HashMap<i64>::new(), HashMap<i64>::new())

// The registries with nothing declared: for a state that checks no
// declarations (builtin seeding).
fn registry_empty(): Registry
  return registry_new(Vector<Symbol>::new(), Vector<ModuleEntry>::new())

fn reg_with_expr_types(rg: Registry, m: HashMap<i64>): Registry
  return Registry(m, rg.variant_set, rg.conform, rg.methods, rg.index, rg.made)

fn reg_with_variant_set(rg: Registry, m: HashMap<i64>): Registry
  return Registry(rg.expr_types, m, rg.conform, rg.methods, rg.index, rg.made)

fn reg_with_conform(rg: Registry, c: Conformance): Registry
  return Registry(rg.expr_types, rg.variant_set, c, rg.methods, rg.index, rg.made)

fn reg_with_methods(rg: Registry, m: HashMap<i64>): Registry
  return Registry(rg.expr_types, rg.variant_set, rg.conform, m, rg.index, rg.made)

/// The registry with `made` as the types the program made.
fn reg_with_made(rg: Registry, made: MadeTypes): Registry
  return Registry(rg.expr_types, rg.variant_set, rg.conform, rg.methods, rg.index, made)

fn reg_with_generators(rg: Registry, m: HashMap<i64>): Registry
  let made: MadeTypes = rg.made
  made.generators = m
  return reg_with_made(rg, made)

/// The registry with instantiation `ti` under `key` (instantiation_key).
fn reg_add_instantiation(rg: Registry, key: string, ti: i64): Registry
  let made: MadeTypes = rg.made
  made.instantiations = made.instantiations.set(key, ti)
  return reg_with_made(rg, made)

/// The registry with `in_progress` as the instantiations being made.
fn reg_with_in_progress(rg: Registry, in_progress: Vector<i64>): Registry
  let made: MadeTypes = rg.made
  made.in_progress = in_progress
  return reg_with_made(rg, made)

// The "Type" symbol the declaration at `decl_idx` of the module being
// checked introduces (a class, enum, alias, or concept), or -1 — a
// constant-time read of the program's index.
fn type_sym_of_decl(ts: TS, decl_idx: i64): i64
  return hm_get_or(ts.reg.index.type_syms, decl_key(ts.tc.module_id, decl_idx), to_i64(-1))

// The callable symbol the declaration at `decl_idx` of the module being
// checked introduces (a free function, a class's method, an extend's
// method), or -1 — a constant-time read of the program's index.
fn callable_sym_of_decl(ts: TS, decl_idx: i64): i64
  return hm_get_or(ts.reg.index.callables, decl_key(ts.tc.module_id, decl_idx), to_i64(-1))

// A member symbol of the declaration at `decl_idx` of module `module_id`
// — a "Param" or "Field" by name, a "Local" by kind — or -1: a
// constant-time read of the program's index, shared with HIR.
fn member_sym_of(index: ProgramIndex, module_id: i64, decl_idx: i64, kind: string, name: string): i64
  return hm_get_or(index.members, member_key(module_id, decl_idx, kind, name), to_i64(-1))

// A fresh checker state over a module (`tc`) and the accumulated type
// tables, with no diagnostics and no body context yet.  The one place a
// TS is built field by field; every other site goes through here.
fn ts_new(tc: TC, types: Vector<DaoType>, type_info: Vector<i64>, sym_types: Vector<i64>, reg: Registry): TS
  return TS(tc, types, type_info, sym_types, Vector<Diagnostic>::new(), ctx_outside_fn(), reg)

// The program's conformance state, accumulated across every module
// before any body is checked: the conformances known — explicit
// `extend`s and derived ones — keyed conform_key(type, concept,
// visible-from), where the third component is the module an extend is
// visible from or conform_everywhere(); the program's `derived
// concept` types; and the concept method signatures substituted per
// receiver.  Grouped so the registry carries one field for it.
class Conformance:
  known: HashMap<i64>
  derived_concepts: Vector<i64>
  subst_cache: HashMap<i64>  // concept method signatures per receiver, keyed "fn_ti:concept_ti:self_ti"
  providers: HashMap<i64>    // derived concepts by member name: "<name>" → how many, "<name>:<j>" → the j-th concept (provider_key), "<name>:<j>:fn" → its member signature (provider_fn_key)

class TypeR:
  ts: TS
  type_idx: i64

class TypeCheckResult:
  types: Vector<DaoType>
  type_info: Vector<i64>
  expr_types: HashMap<i64>
  sym_types: Vector<i64>
  diags: Vector<Diagnostic>
  node_count: i64

// =========================================================================
// Section 35: TS state helpers
// =========================================================================

fn ts_add_type(ts: TS, t: DaoType): TypeR
  let idx: i64 = ts.types.length()
  ts.types = ts.types.push(t)
  return TypeR(ts, idx)

fn ts_add_diag(ts: TS, span: Span, msg: string): TS
  ts.diags = ts.diags.push(make_error(span, msg))
  return ts

fn ts_set_expr_type(ts: TS, node_idx: i64, type_idx: i64): TS
  // Key by (module_id, node_idx) so the per-program expr_types
  // HashMap disambiguates nodes across modules.
  let key: string = expr_id_key(ts.tc.module_id, node_idx)
  ts.reg = reg_with_expr_types(ts.reg, ts.reg.expr_types.set(key, type_idx))
  return ts

fn vec_i64_set(v: Vector<i64>, idx: i64, val: i64): Vector<i64>
  // Extend vector if needed, then set.
  while v.length() <= idx:
    v = v.push(to_i64(-1))
  return v.set(idx, val)

fn vec_i64_get(v: Vector<i64>, idx: i64): i64
  if idx < 0:
    return to_i64(-1)
  if idx >= v.length():
    return to_i64(-1)
  return v.get(idx)

// A symbol's type index, valid in *this* module's `types` array.  Every
// in-module symbol's type is appended to `types` before its index is
// recorded, so an in-module index is always < `types.length()`; an index
// at or past it came from a wider module (a prelude type reached across
// the module boundary) and would overrun `types` / `type_info`.  Return
// -1 for such, so the type reads as unresolved here rather than crashing
// (cross-module type layout is deferred to a later program-level pass).
fn sym_type_at(ts: TS, sym_idx: i64): i64
  let ti: i64 = vec_i64_get(ts.sym_types, sym_idx)
  if ti < 0:
    return to_i64(-1)
  if ti >= ts.types.length():
    return to_i64(-1)
  return ti

fn ts_set_sym_type(ts: TS, sym_idx: i64, type_idx: i64): TS
  ts.sym_types = vec_i64_set(ts.sym_types, sym_idx, type_idx)
  return ts

fn ctx_with_loop(c: CheckCtx, v: i64): CheckCtx
  return CheckCtx(c.return_type, v, c.in_generator, c.gen_elem, c.unsafe_depth, c.resource_depth)

fn ctx_with_unsafe(c: CheckCtx, v: i64): CheckCtx
  return CheckCtx(c.return_type, c.loop_depth, c.in_generator, c.gen_elem, v, c.resource_depth)

fn ctx_with_resource(c: CheckCtx, v: i64): CheckCtx
  return CheckCtx(c.return_type, c.loop_depth, c.in_generator, c.gen_elem, c.unsafe_depth, v)

// The context outside any function body: no return type, no nesting.
fn ctx_outside_fn(): CheckCtx
  return CheckCtx(to_i64(-1), to_i64(0), to_i64(0), to_i64(-1), to_i64(0), to_i64(0))

fn ts_inc_loop_depth(ts: TS): TS
  ts.ctx = ctx_with_loop(ts.ctx, ts.ctx.loop_depth + 1)
  return ts

fn ts_dec_loop_depth(ts: TS): TS
  ts.ctx = ctx_with_loop(ts.ctx, ts.ctx.loop_depth - 1)
  return ts

// Enter a function body: its return type from the function's type.  A
// function whose return type is a generator (`Generator<T>`, the
// compiler-provided coroutine type, CONTRACT_SYNTAX_SURFACE.md) is a
// generator body: `yield` is legal, the generator's element type is what
// a yielded value must have, and a valued `return` is invalid.  Loop,
// mode, and resource nesting start at zero for the body.
fn tc_enter_fn_ctx(ts: TS, fn_ti: i64): TS
  let r: TS = ts
  let ret_ti: i64 = to_i64(-1)
  if fn_ti >= 0:
    if fn_ti < r.types.length():
      let fn_type: DaoType = r.types.get(fn_ti)
      ret_ti = fn_type.ret_type
  let in_gen: i64 = 0
  let gen_elem: i64 = to_i64(-1)
  if ret_ti >= 0:
    if ret_ti < r.types.length():
      let rt: DaoType = r.types.get(ret_ti)
      match rt.kind:
        TypeKind::TGenerator:
          in_gen = 1
          gen_elem = rt.pointee
  r.ctx = CheckCtx(ret_ti, to_i64(0), in_gen, gen_elem, to_i64(0), to_i64(0))
  return r

fn ts_push_type_info(ts: TS, val: i64): TS
  ts.type_info = ts.type_info.push(val)
  return ts

/// `records` appended to `type_info` as one run.  A layout — a
/// signature's parameter slots, a class's fields, an enum's variants,
/// a concept's methods — is read by its start and count, so it is
/// written only once every annotation in it has been resolved:
/// resolving one can make an instantiation, which appends records of
/// its own.
fn ts_push_info_run(ts: TS, records: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < records.length():
    r = ts_push_type_info(r, records.get(i))
    i = i + 1
  return r

// =========================================================================
// Section 36: Name extraction for type checker
// =========================================================================

fn ts_tok_name(ts: TS, tidx: i64): string
  let tok: Token = ts.tc.toks.get(tidx)
  return substring(ts.tc.src, tok.offset, tok.len)

fn ts_tok_span(ts: TS, tidx: i64): Span
  let tok: Token = ts.tc.toks.get(tidx)
  return Span(tok.offset, tok.len)

fn ts_node_span(ts: TS, node_idx: i64): Span
  if node_idx < 0:
    return Span(to_i64(0), to_i64(1))
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::IdentE(tidx):
      return ts_tok_span(ts, tidx)
    Node::IntLitE(tidx):
      return ts_tok_span(ts, tidx)
    Node::FloatLitE(tidx):
      return ts_tok_span(ts, tidx)
    Node::StringLitE(tidx):
      return ts_tok_span(ts, tidx)
    Node::BoolLitE(tidx):
      return ts_tok_span(ts, tidx)
    Node::BinaryE(op_tidx, left, right):
      return ts_tok_span(ts, op_tidx)
    Node::UnaryE(op_tidx, operand):
      return ts_tok_span(ts, op_tidx)
    Node::CallE(callee, args_lp, arg_count, targs_lp, names_lp, targs_on_type):
      return ts_node_span(ts, callee)
    Node::FieldE(obj, field_tidx):
      return ts_tok_span(ts, field_tidx)
    Node::LetS(name_tidx, type_node, init_node):
      return ts_tok_span(ts, name_tidx)
    Node::ReturnS(val_node):
      return Span(to_i64(0), to_i64(1))
    Node::BreakS(tidx):
      return ts_tok_span(ts, tidx)
    Node::YieldS(yield_tidx, val_node):
      return ts_tok_span(ts, yield_tidx)
    Node::NamedT(tidx):
      return ts_tok_span(ts, tidx)
    Node::QualNameE(seg_lp, seg_count):
      let segs: Vector<i64> = read_list(ts.tc.idx_data, seg_lp)
      if segs.length() > 0:
        return ts_tok_span(ts, segs.get(0))
      return Span(to_i64(0), to_i64(1))
  return Span(to_i64(0), to_i64(1))

// =========================================================================
// Section 37: Uses map and lookup
// =========================================================================

fn lookup_use(ts: TS, tok_idx: i64): i64
  let key: string = uses_key(ts.tc.file_id, tok_idx)
  let result: Option<i64> = ts.tc.uses_map.get(key)
  match result:
    Option::Some(sym_idx):
      return sym_idx
    Option::None:
      return to_i64(-1)

// =========================================================================
// Section 38: Builtin type registration
// =========================================================================

fn register_builtins(ts: TS): TS
  let r0: TypeR = ts_add_type(ts, DaoType(TypeKind::TBuiltin, to_i64(0), "i8", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r1: TypeR = ts_add_type(r0.ts, DaoType(TypeKind::TBuiltin, to_i64(1), "i16", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r2: TypeR = ts_add_type(r1.ts, DaoType(TypeKind::TBuiltin, to_i64(2), "i32", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r3: TypeR = ts_add_type(r2.ts, DaoType(TypeKind::TBuiltin, to_i64(3), "i64", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r4: TypeR = ts_add_type(r3.ts, DaoType(TypeKind::TBuiltin, to_i64(4), "u8", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r5: TypeR = ts_add_type(r4.ts, DaoType(TypeKind::TBuiltin, to_i64(5), "u16", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r6: TypeR = ts_add_type(r5.ts, DaoType(TypeKind::TBuiltin, to_i64(6), "u32", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r7: TypeR = ts_add_type(r6.ts, DaoType(TypeKind::TBuiltin, to_i64(7), "u64", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r8: TypeR = ts_add_type(r7.ts, DaoType(TypeKind::TBuiltin, to_i64(8), "f32", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r9: TypeR = ts_add_type(r8.ts, DaoType(TypeKind::TBuiltin, to_i64(9), "f64", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r10: TypeR = ts_add_type(r9.ts, DaoType(TypeKind::TBuiltin, to_i64(10), "bool", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r11: TypeR = ts_add_type(r10.ts, DaoType(TypeKind::TVoid, to_i64(-1), "void", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let r12: TypeR = ts_add_type(r11.ts, DaoType(TypeKind::TString, to_i64(-1), "string", to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  return r12.ts

// =========================================================================
// Section 34a: Program-level typecheck initialization (Task 27 D1a)
// =========================================================================

// Seed the program's `TypeCheckData` with canonical builtin types.
// Called exactly once per `Program` before any per-module pass runs.
// Produces the same builtin layout as single-file `register_builtins`
// (indices 0–12 are i8, i16, i32, i64, u8, u16, u32, u64, f32, f64,
// bool, void, string) so all modules share a canonical type table.
fn program_init_typecheck(p: Program): Program
  // Guard: if TypeCheckData is already initialized (builtins seeded),
  // return unchanged.  A second call must not discard accumulated
  // canonical types, type_info, sym_types, or expr_types — the
  // program-level type table is shared and accumulates across modules
  // per Task 27 §4.1.
  if p.typecheck.initialized:
    return p
  // Build a throwaway TC/TS just to drive register_builtins, then
  // harvest the resulting types/type_info/sym_types into
  // TypeCheckData.  This avoids duplicating the builtin registration
  // logic — register_builtins is the single source of truth.
  let dummy_tc: TC = TC(
    Vector<Node>::new(),
    Vector<i64>::new(),
    Vector<Token>::new(),
    "",
    Vector<Symbol>::new(),
    Vector<Scope>::new(),
    HashMap<i64>::new(),  // uses_map
    to_i64(-1),
    HashMap<i64>::new(),  // concept_bindings
    to_i64(-1),
    ExportTables(Vector<ExportTable>::new()))
  let dummy_ts: TS = ts_new(dummy_tc, Vector<DaoType>::new(), Vector<i64>::new(), Vector<i64>::new(), registry_empty())
  let seeded: TS = register_builtins(dummy_ts)
  let td: TypeCheckData = TypeCheckData(
    true,
    seeded.types,
    seeded.type_info,
    seeded.sym_types,
    program_lookup_empty())
  return Program(p.graph, p.resolve, td, p.hir, p.diags)

// =========================================================================
// Section 39: Type query helpers
// =========================================================================

fn is_numeric(ts: TS, type_idx: i64): bool
  if type_idx < 0:
    return false
  if type_idx >= ts.types.length():
    return false
  let t: DaoType = ts.types.get(type_idx)
  match t.kind:
    TypeKind::TBuiltin:
      if t.builtin_id >= 0:
        if t.builtin_id <= 9:
          return true
  return false

fn is_integer(ts: TS, type_idx: i64): bool
  if type_idx < 0:
    return false
  if type_idx >= ts.types.length():
    return false
  let t: DaoType = ts.types.get(type_idx)
  match t.kind:
    TypeKind::TBuiltin:
      if t.builtin_id >= 0:
        if t.builtin_id <= 7:
          return true
  return false

fn is_float(ts: TS, type_idx: i64): bool
  if type_idx < 0:
    return false
  if type_idx >= ts.types.length():
    return false
  let t: DaoType = ts.types.get(type_idx)
  match t.kind:
    TypeKind::TBuiltin:
      if t.builtin_id == 8:
        return true
      if t.builtin_id == 9:
        return true
  return false

fn is_bool_type(ts: TS, type_idx: i64): bool
  if type_idx < 0:
    return false
  if type_idx >= ts.types.length():
    return false
  let t: DaoType = ts.types.get(type_idx)
  match t.kind:
    TypeKind::TBuiltin:
      return t.builtin_id == 10
  return false

fn is_string_type(ts: TS, type_idx: i64): bool
  if type_idx < 0:
    return false
  if type_idx >= ts.types.length():
    return false
  let t: DaoType = ts.types.get(type_idx)
  match t.kind:
    TypeKind::TString:
      return true
  return false

fn is_void_type(ts: TS, type_idx: i64): bool
  if type_idx < 0:
    return false
  if type_idx >= ts.types.length():
    return false
  let t: DaoType = ts.types.get(type_idx)
  match t.kind:
    TypeKind::TVoid:
      return true
  return false

fn types_equal(ts: TS, a: i64, b: i64): bool
  if a == b:
    return true
  // Two generators, one of whose element type is unresolved, compare as
  // an unresolved type does everywhere else: never a reported mismatch.
  if a >= 0 and b >= 0 and a < ts.types.length() and b < ts.types.length():
    let ta: DaoType = ts.types.get(a)
    let tb: DaoType = ts.types.get(b)
    if is_generator_kind(ta) and is_generator_kind(tb):
      if ta.pointee < 0 or tb.pointee < 0:
        return true
  return false

fn is_generator_kind(t: DaoType): bool
  match t.kind:
    TypeKind::TGenerator:
      return true
  return false

fn type_name(ts: TS, type_idx: i64): string
  if type_idx < 0:
    return "<unknown>"
  if type_idx >= ts.types.length():
    return "<unknown>"
  let t: DaoType = ts.types.get(type_idx)
  return t.name

// =========================================================================
// Section 40: Resolve builtin name to type index
// =========================================================================

fn builtin_type_index(name: string): i64
  if name == "i8":
    return to_i64(0)
  if name == "i16":
    return to_i64(1)
  if name == "i32":
    return to_i64(2)
  if name == "i64":
    return to_i64(3)
  if name == "u8":
    return to_i64(4)
  if name == "u16":
    return to_i64(5)
  if name == "u32":
    return to_i64(6)
  if name == "u64":
    return to_i64(7)
  if name == "f32":
    return to_i64(8)
  if name == "f64":
    return to_i64(9)
  if name == "bool":
    return to_i64(10)
  if name == "void":
    return to_i64(11)
  if name == "string":
    return to_i64(12)
  return to_i64(-1)

// A type's field / method layout lives in the `type_info` of the module
// that registered it.  A type reached from a wider module (a prelude
// generic head named in a smaller program module, say) can carry an
// `info_lp` / `info_count` that overruns this module's `type_info`, so a
// per-field walk `type_info.get(info_lp + i*2)` reads out of bounds.
// Report whether the layout is walkable here; a caller skips the walk
// when it is not (fail-closed — cross-module generic layout is deferred to a later program-level pass).
fn layout_walkable(ts: TS, t: DaoType): bool
  if t.info_lp < 0:
    return false
  if t.info_lp + t.info_count * 2 <= ts.type_info.length():
    return true
  return false

// A function type stores its `info_count` parameter type slots singly at
// `info_lp` (its return type is a separate field), so its walkable span is
// `info_count`, not `info_count * 2`.  A callee reached from a wider
// module (a prelude function or method) can carry an `info_lp` that
// overruns this module's `type_info`; report whether the parameter slots
// are in range so a caller skips the per-argument walk otherwise.
fn fn_params_walkable(ts: TS, t: DaoType): bool
  if t.info_lp < 0:
    return false
  if t.info_lp + t.info_count <= ts.type_info.length():
    return true
  return false

// =========================================================================
// Section 41: AST type node resolution
// =========================================================================

fn resolve_ast_type(ts: TS, node_idx: i64): TypeR
  if node_idx < 0:
    return TypeR(ts, to_i64(-1))
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::NamedT(tidx):
      let name: string = ts_tok_name(ts, tidx)
      let bi: i64 = builtin_type_index(name)
      if bi >= 0:
        return TypeR(ts, bi)
      let sym_idx: i64 = lookup_use(ts, tidx)
      if sym_idx >= 0:
        let sym: Symbol = ts.tc.symbols.get(sym_idx)
        let sk: string = symbol_kind_name(sym.kind)
        if sk == "GenericParam":
          // Check if we already have a TGenericParam type for this symbol
          let existing_ti: i64 = sym_type_at(ts, sym_idx)
          if existing_ti >= 0:
            return TypeR(ts, existing_ti)
          // Create a new TGenericParam type
          let tr: TypeR = ts_add_type(ts, DaoType(TypeKind::TGenericParam, sym_idx, name, to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
          let ts2: TS = ts_set_sym_type(tr.ts, sym_idx, tr.type_idx)
          return TypeR(ts2, tr.type_idx)
        let ti: i64 = sym_type_at(ts, sym_idx)
        // A generic class written bare names no type: `Node` where
        // `class Node<T>` is declared (the host's "requires N type
        // argument(s)").
        if ti >= 0 and is_generic_head(ts, ti):
          let arity: ParamIds = head_params(ts, ts.types.get(ti))
          if arity.ids.length() > 0:
            return TypeR(ts_add_diag(arity.ts, ts_tok_span(arity.ts, tidx), "generic type '" + name + "' requires " + i64_to_string(arity.ids.length()) + " type argument(s)"), to_i64(-1))
        return TypeR(ts, ti)
      // sym not found in uses_map — might be an unresolved type param
      // Try to find it by scanning symbols for GenericParam with matching name
      let gi: i64 = 0
      while gi < ts.tc.symbols.length():
        let gsym: Symbol = ts.tc.symbols.get(gi)
        if gsym.name == name:
          if symbol_kind_name(gsym.kind) == "GenericParam":
            let existing_ti: i64 = sym_type_at(ts, gi)
            if existing_ti >= 0:
              return TypeR(ts, existing_ti)
            let tr: TypeR = ts_add_type(ts, DaoType(TypeKind::TGenericParam, gi, name, to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
            let ts2: TS = ts_set_sym_type(tr.ts, gi, tr.type_idx)
            return TypeR(ts2, tr.type_idx)
        gi = gi + 1
      return TypeR(ts, to_i64(-1))
    Node::GenericT(name_tidx, args_lp, arg_count):
      // `Generator<T>` is the compiler-provided coroutine type
      // (CONTRACT_SYNTAX_SURFACE.md), declared by no module: it is a type
      // of its own kind whose element is T, so a generator function's
      // signature, its calls, and HIR all carry it.  A malformed spelling
      // reads as unresolved here and is diagnosed once, where the
      // annotation is resolved (generator_spelling_diags).
      if is_generator_head(ts, name_tidx):
        if arg_count != 1:
          return TypeR(ts, to_i64(-1))
        let gargs: Vector<i64> = read_list(ts.tc.idx_data, args_lp)
        let elem_r: TypeR = resolve_ast_type(ts, gargs.get(0))
        let gen_r: TypeR = find_or_add_generator_type(elem_r.ts, elem_r.type_idx)
        // Recorded under the annotation node, so HIR reads the generator
        // type an annotation denotes (enum payloads) instead of
        // re-resolving the spelling.
        return TypeR(ts_set_expr_type(gen_r.ts, node_idx, gen_r.type_idx), gen_r.type_idx)
      // `Ptr<T>` is the pointer surface the contract froze
      // (ADR_RAW_POINTER_SURFACE.md), the other head read here rather
      // than deferred: a pointer's pointee is what `get` reads, `set`
      // writes, and `offset` walks.
      if ts_tok_name(ts, name_tidx) == "Ptr":
        let pargs: Vector<i64> = read_list(ts.tc.idx_data, args_lp)
        if pargs.length() == 1:
          let pointee_r: TypeR = resolve_ast_type(ts, pargs.get(0))
          if pointee_r.type_idx < 0:
            return TypeR(pointee_r.ts, to_i64(-1))
          let ptr_r: TypeR = find_or_add_pointer_type(pointee_r.ts, pointee_r.type_idx)
          return TypeR(ts_set_expr_type(ptr_r.ts, node_idx, ptr_r.type_idx), ptr_r.type_idx)
      // Any other generic annotation names the instantiation it spells:
      // `Box<i32>` is the class with `i32` in place of its parameter,
      // made once per head and arguments, so two such annotations are
      // one type — whichever module declared the head, since a head
      // stands for its own parameters in the shared type table.  A
      // head whose layout the table does not hold yet leaves the
      // annotation unresolved.
      let head_sym: i64 = lookup_use(ts, name_tidx)
      if head_sym < 0:
        return TypeR(ts, to_i64(-1))
      let head_ti: i64 = sym_type_at(ts, head_sym)
      if head_ti < 0:
        return TypeR(ts, to_i64(-1))
      let g_args: Vector<i64> = read_list(ts.tc.idx_data, args_lp)
      let resolved_args: Vector<i64> = Vector<i64>::new()
      let r_args: TS = ts
      let ga: i64 = 0
      while ga < g_args.length():
        let arg_r: TypeR = resolve_ast_type(r_args, g_args.get(ga))
        r_args = arg_r.ts
        if arg_r.type_idx < 0:
          return TypeR(r_args, to_i64(-1))
        resolved_args = resolved_args.push(arg_r.type_idx)
        ga = ga + 1
      // A bound is held where a parameter is decided by a value — a
      // call or a construction (check_decided_bounds).  An annotation
      // writes a type and owes none, as the host's instantiate_generic
      // verifies none: `Box<U>` with `U: Show` and `Box<Plain>` alike.
      // Recorded under the annotation node, as a generator's is, so HIR
      // reads the instantiation the annotation denotes.
      let made: TypeR = instantiate_generic(r_args, head_ti, resolved_args)
      if made.type_idx < 0:
        return made
      return TypeR(ts_set_expr_type(made.ts, node_idx, made.type_idx), made.type_idx)
    Node::QualNameE(seg_lp, seg_count):
      // A qualified type (`core::Printable`): the resolver bound its last
      // segment; read that symbol's type when it is in this module's
      // `types` (a symbol reached across the module boundary reads as
      // unresolved here, as `sym_type_at` guards).
      let qsegs: Vector<i64> = read_list(ts.tc.idx_data, seg_lp)
      if qsegs.length() > 0:
        let qsym: i64 = lookup_use(ts, qsegs.get(qsegs.length() - 1))
        if qsym >= 0:
          return TypeR(ts, sym_type_at(ts, qsym))
      return TypeR(ts, to_i64(-1))
    Node::ErrorT(t):
      return TypeR(ts, to_i64(-1))
  return TypeR(ts, to_i64(-1))

/// The pointee of a pointer annotation (`Ptr<T>`), or -1 where the
/// annotation names no pointer.  A pointer is a generic annotation like
/// any other in the AST (ADR_RAW_POINTER_SURFACE.md), so the places
/// that look THROUGH one ask here rather than each reading the head.
fn pointer_annotation_pointee(ts: TS, node_idx: i64): i64
  if node_idx < 0:
    return to_i64(-1)
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::GenericT(name_tidx, args_lp, arg_count):
      if ts_tok_name(ts, name_tidx) == "Ptr":
        let args: Vector<i64> = read_list(ts.tc.idx_data, args_lp)
        if args.length() == 1:
          return args.get(0)
  return to_i64(-1)

// Whether a type head token names the compiler-provided `Generator`:
// the predeclared builtin symbol (no module may declare the name), or,
// where no resolution ran, the bare spelling.
fn is_generator_head(ts: TS, name_tidx: i64): bool
  if ts_tok_name(ts, name_tidx) != "Generator":
    return false
  let sym: i64 = lookup_use(ts, name_tidx)
  if sym < 0:
    return true
  if sym >= ts.tc.symbols.length():
    return false
  return symbol_kind_name(ts.tc.symbols.get(sym).kind) == "Builtin"

// Diagnose a malformed `Generator` nested in an ordinary annotation's
// spelling (through pointers and generic arguments): bare `Generator`,
// any argument count but one, or an element naming no type at all.  A
// generator at the top of an annotation is resolve_generator_annotation's.
// Run where an annotation is resolved, once per annotation site, so a
// signature re-read for its body reports nothing twice.
fn generator_spelling_diags(ts: TS, node_idx: i64): TS
  if node_idx < 0:
    return ts
  let through_ptr: i64 = pointer_annotation_pointee(ts, node_idx)
  if through_ptr >= 0:
    return generator_spelling_diags(ts, through_ptr)
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::NamedT(tidx):
      if is_generator_head(ts, tidx):
        return ts_add_diag(ts, ts_tok_span(ts, tidx), "Generator requires exactly one type argument")
    Node::GenericT(name_tidx, args_lp, arg_count):
      let args: Vector<i64> = read_list(ts.tc.idx_data, args_lp)
      let r: TS = ts
      if is_generator_head(r, name_tidx):
        if arg_count != 1:
          return ts_add_diag(r, ts_tok_span(r, name_tidx), "Generator requires exactly one type argument")
        let unknown_tidx: i64 = unknown_named_type(r, args.get(0))
        if unknown_tidx >= 0:
          return ts_add_diag(r, ts_tok_span(r, unknown_tidx), "unknown type '" + ts_tok_name(r, unknown_tidx) + "' in Generator")
      let ai: i64 = 0
      while ai < args.length():
        r = generator_spelling_diags(r, args.get(ai))
        ai = ai + 1
      return r
  return ts

// The first name token of an annotation, through its pointers and
// generic arguments, that names no type at all (no builtin, no symbol)
// — a plain name or a generic head — or -1.
fn unknown_named_type(ts: TS, node_idx: i64): i64
  if node_idx < 0:
    return to_i64(-1)
  let through_ptr: i64 = pointer_annotation_pointee(ts, node_idx)
  if through_ptr >= 0:
    return unknown_named_type(ts, through_ptr)
  match ts.tc.nodes.get(node_idx):
    Node::NamedT(tidx):
      if builtin_type_index(ts_tok_name(ts, tidx)) < 0 and lookup_use(ts, tidx) < 0:
        return tidx
    Node::GenericT(name_tidx, args_lp, arg_count):
      if is_generator_head(ts, name_tidx) == false and lookup_use(ts, name_tidx) < 0:
        return name_tidx
      let args: Vector<i64> = read_list(ts.tc.idx_data, args_lp)
      let ai: i64 = 0
      while ai < args.length():
        let in_arg: i64 = unknown_named_type(ts, args.get(ai))
        if in_arg >= 0:
          return in_arg
        ai = ai + 1
    Node::QualNameE(seg_lp, seg_count):
      // The resolver binds a qualified type by its last segment.
      let qsegs: Vector<i64> = read_list(ts.tc.idx_data, seg_lp)
      if qsegs.length() > 0:
        let last: i64 = qsegs.get(qsegs.length() - 1)
        if lookup_use(ts, last) < 0:
          return last
  return to_i64(-1)

// The concept a type names — the type itself, or the pointee of a
// pointer to one or the element of a generator of one, recursively — or
// -1 when it names none.
fn concept_named_by(ts: TS, ti: i64): i64
  if ti < 0:
    return to_i64(-1)
  if ti >= ts.types.length():
    return to_i64(-1)
  let t: DaoType = ts.types.get(ti)
  match t.kind:
    TypeKind::TConcept:
      return ti
    TypeKind::TPointer:
      return concept_named_by(ts, t.pointee)
    TypeKind::TGenerator:
      return concept_named_by(ts, t.pointee)
  return to_i64(-1)

// The first concept other than `allowed` an annotation names anywhere
// in its spelling — through pointers, a generic head, and generic
// arguments — or -1.  A generic annotation reads as unresolved (its
// instantiation is deferred), so this reads the spelling the type
// resolution did not.
fn annotation_names_concept(ts: TS, node_idx: i64, allowed: i64): i64
  if node_idx < 0:
    return to_i64(-1)
  let through_ptr: i64 = pointer_annotation_pointee(ts, node_idx)
  if through_ptr >= 0:
    return annotation_names_concept(ts, through_ptr, allowed)
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::NamedT(tidx):
      return concept_other_than(ts, sym_type_at(ts, lookup_use(ts, tidx)), allowed)
    Node::QualNameE(seg_lp, seg_count):
      // A qualified name (`lib::C`): the resolver bound its last segment.
      let qsegs: Vector<i64> = read_list(ts.tc.idx_data, seg_lp)
      if qsegs.length() == 0:
        return to_i64(-1)
      return concept_other_than(ts, sym_type_at(ts, lookup_use(ts, qsegs.get(qsegs.length() - 1))), allowed)
    Node::GenericT(name_tidx, args_lp, arg_count):
      let head: i64 = concept_other_than(ts, sym_type_at(ts, lookup_use(ts, name_tidx)), allowed)
      if head >= 0:
        return head
      let args: Vector<i64> = read_list(ts.tc.idx_data, args_lp)
      let ai: i64 = 0
      while ai < args.length():
        let in_arg: i64 = annotation_names_concept(ts, args.get(ai), allowed)
        if in_arg >= 0:
          return in_arg
        ai = ai + 1
  return to_i64(-1)

// concept_named_by, except that `allowed` names none.
fn concept_other_than(ts: TS, ti: i64, allowed: i64): i64
  let named: i64 = concept_named_by(ts, ti)
  if named == allowed:
    return to_i64(-1)
  return named

// The applied self form (see resolve_annotation) as a type: the
// concept itself, wrapped in the annotation's pointers.
fn resolve_applied_self(ts: TS, node_idx: i64, self_concept: i64): TypeR
  let through_ptr: i64 = pointer_annotation_pointee(ts, node_idx)
  if through_ptr >= 0:
    let inner_r: TypeR = resolve_applied_self(ts, through_ptr, self_concept)
    return find_or_add_pointer_type(inner_r.ts, inner_r.type_idx)
  return TypeR(ts, self_concept)

// The type-parameter nodes the concept `concept_ti` declares (its
// declaration is in the module being checked), in order.
fn concept_type_params(ts: TS, concept_ti: i64): Vector<i64>
  let none: Vector<i64> = Vector<i64>::new()
  if concept_ti < 0:
    return none
  if concept_ti >= ts.types.length():
    return none
  let decl_idx: i64 = ts.types.get(concept_ti).decl_node
  if decl_idx < 0:
    return none
  if decl_idx >= ts.tc.nodes.length():
    return none
  let node: Node = ts.tc.nodes.get(decl_idx)
  match node:
    Node::ConceptDeclD(name_tidx, tparams_lp, methods_lp, is_derived):
      if tparams_lp < 0:
        return none
      return read_list(ts.tc.idx_data, tparams_lp)
  return none

// A type parameter's name, from its `GenericParamT` node.
fn type_param_name(ts: TS, tp_node: i64): string
  let node: Node = ts.tc.nodes.get(tp_node)
  match node:
    Node::GenericParamT(tidx, bounds_lp):
      return ts_tok_name(ts, tidx)
  return ""

// A type parameter's symbol (the resolver bound its declaring token).
fn type_param_symbol(ts: TS, tp_node: i64): i64
  let node: Node = ts.tc.nodes.get(tp_node)
  match node:
    Node::GenericParamT(tidx, bounds_lp):
      return lookup_use(ts, tidx)
  return to_i64(-1)

// The concept's type parameters as written in its head, `A, B`.
fn concept_type_param_list(ts: TS, concept_ti: i64): string
  let tparams: Vector<i64> = concept_type_params(ts, concept_ti)
  let out: string = ""
  let i: i64 = 0
  while i < tparams.length():
    if i > 0:
      out = out + ", "
    out = out + type_param_name(ts, tparams.get(i))
    i = i + 1
  return out

// Whether a generic annotation (through its pointers) applies the
// concept's own type parameters, each by its bare name in its own
// position — the only application that is the concept's self form.
fn applied_self_matches_params(ts: TS, node_idx: i64, concept_ti: i64): bool
  if node_idx < 0:
    return false
  let through_ptr: i64 = pointer_annotation_pointee(ts, node_idx)
  if through_ptr >= 0:
    return applied_self_matches_params(ts, through_ptr, concept_ti)
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::GenericT(name_tidx, args_lp, arg_count):
      let tparams: Vector<i64> = concept_type_params(ts, concept_ti)
      let args: Vector<i64> = read_list(ts.tc.idx_data, args_lp)
      if args.length() != tparams.length():
        return false
      let i: i64 = 0
      while i < args.length():
        // By symbol, not spelling: a method's own `T` shadowing the
        // concept's `T` is a different parameter (the resolver bound
        // each declaring token to its symbol).
        let arg: Node = ts.tc.nodes.get(args.get(i))
        let matches: bool = false
        match arg:
          Node::NamedT(tidx):
            let arg_sym: i64 = lookup_use(ts, tidx)
            if arg_sym >= 0:
              matches = arg_sym == type_param_symbol(ts, tparams.get(i))
        if matches == false:
          return false
        i = i + 1
      return true
  return false

// The concept a generic annotation's head names, or -1 for a
// non-generic annotation or a head that is no concept.
fn generic_head_concept(ts: TS, node_idx: i64): i64
  if node_idx < 0:
    return to_i64(-1)
  let through_ptr: i64 = pointer_annotation_pointee(ts, node_idx)
  if through_ptr >= 0:
    return generic_head_concept(ts, through_ptr)
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::GenericT(name_tidx, args_lp, arg_count):
      return concept_named_by(ts, sym_type_at(ts, lookup_use(ts, name_tidx)))
  return to_i64(-1)

// A type annotation, resolved as a type and then held to the host's
// rule: a concept's name is a type only in the concept's own method
// signatures (`self_concept`), where it means the conforming type;
// anywhere else it constrains a type parameter (`<T: Eq>`), it does
// not stand for one.  Such an annotation is diagnosed and reads as
// unresolved.
fn resolve_annotation(ts: TS, node_idx: i64, self_concept: i64): TypeR
  if generator_under_pointers(ts, node_idx):
    return resolve_generator_annotation(ts, node_idx, self_concept)
  let tr0: TypeR = resolve_ast_type(ts, node_idx)
  let tr: TypeR = TypeR(generator_spelling_diags(tr0.ts, node_idx), tr0.type_idx)
  let named: i64 = concept_named_by(tr.ts, tr.type_idx)
  if named == self_concept and named >= 0:
    return tr
  if named < 0:
    // A generic annotation reads as unresolved (deferred instantiation),
    // so its whole spelling is inspected: `C<i32>`, `Box<C>`, or
    // `Pair<Self, C>` with `C` a concept is no type, wherever `C` sits.
    named = annotation_names_concept(tr.ts, node_idx, self_concept)
  if named < 0:
    if self_concept >= 0 and tr.type_idx < 0 and generic_head_concept(tr.ts, node_idx) == self_concept:
      // The applied self form (`C<T>` in C's signatures, under its
      // pointer wrappers) reads as the concept, so a member lookup
      // substitutes the receiver for it as for the bare name.  It is
      // the self form only when it applies the concept's own type
      // parameters, each in its place: `C<bool>` or `C<B, A>` names
      // some other instantiation, which no substitution could keep,
      // and is rejected.
      if applied_self_matches_params(tr.ts, node_idx, self_concept) == false:
        let sname: string = type_name(tr.ts, self_concept)
        let rs: TS = ts_add_diag(tr.ts, ts_node_span(tr.ts, node_idx), "'" + sname + "' in its own signatures applies only its own type parameters, in order (" + sname + "<" + concept_type_param_list(tr.ts, self_concept) + ">)")
        return TypeR(rs, to_i64(-1))
      return resolve_applied_self(tr.ts, node_idx, self_concept)
    // A type, or the self name inside a deferred generic (`Box<C>` in
    // C's signatures: unresolved, as every generic annotation is until
    // instantiation is typed).
    return tr
  let cname: string = type_name(tr.ts, named)
  let r: TS = ts_add_diag(tr.ts, ts_node_span(tr.ts, node_idx), "'" + cname + "' is a concept, not a type; use it as a bound (<T: " + cname + ">)")
  return TypeR(r, to_i64(-1))

// Whether an annotation is a `Generator` spelling, bare or applied,
// under any pointers.
fn generator_under_pointers(ts: TS, node_idx: i64): bool
  if node_idx < 0:
    return false
  let through_ptr: i64 = pointer_annotation_pointee(ts, node_idx)
  if through_ptr >= 0:
    return generator_under_pointers(ts, through_ptr)
  match ts.tc.nodes.get(node_idx):
    Node::NamedT(tidx):
      return is_generator_head(ts, tidx)
    Node::GenericT(name_tidx, args_lp, arg_count):
      return is_generator_head(ts, name_tidx)
  return false

// A generator annotation (under any pointers), resolved element first:
// the element is an annotation in its own right, held to every rule
// resolve_annotation applies — a concept is no type, the applied self
// form in a concept's own signatures, unknown names — and the generator
// wraps what it resolved to.  An element that resolves to nothing still
// makes a generator, so the function stays a generator body.
fn resolve_generator_annotation(ts: TS, node_idx: i64, self_concept: i64): TypeR
  let through_ptr: i64 = pointer_annotation_pointee(ts, node_idx)
  if through_ptr >= 0:
    let ir: TypeR = resolve_generator_annotation(ts, through_ptr, self_concept)
    if ir.type_idx < 0:
      return ir
    return find_or_add_pointer_type(ir.ts, ir.type_idx)
  match ts.tc.nodes.get(node_idx):
    Node::NamedT(tidx):
      return TypeR(ts_add_diag(ts, ts_tok_span(ts, tidx), "Generator requires exactly one type argument"), to_i64(-1))
    Node::GenericT(name_tidx, args_lp, arg_count):
      if arg_count != 1:
        return TypeR(ts_add_diag(ts, ts_tok_span(ts, name_tidx), "Generator requires exactly one type argument"), to_i64(-1))
      let elem: i64 = read_list(ts.tc.idx_data, args_lp).get(0)
      let diags_before: i64 = ts.diags.length()
      let er: TypeR = resolve_annotation(ts, elem, self_concept)
      let r: TS = er.ts
      if er.type_idx < 0 and r.diags.length() == diags_before:
        let unknown_tidx: i64 = unknown_named_type(r, elem)
        if unknown_tidx >= 0:
          r = ts_add_diag(r, ts_tok_span(r, unknown_tidx), "unknown type '" + ts_tok_name(r, unknown_tidx) + "' in Generator")
      let gr: TypeR = find_or_add_generator_type(r, er.type_idx)
      return TypeR(ts_set_expr_type(gr.ts, node_idx, gr.type_idx), gr.type_idx)
  return TypeR(ts, to_i64(-1))

// =========================================================================
// Section 42: Pass 1 — Register declarations
// =========================================================================

// Find a symbol index by decl_node and kind name
// The callable symbol a declaration introduces: a free function's is
// a `Function`, a class's own method's a `Method`.  A declaration
// index is file-local, so the owning module is half the identity: two
// modules' declarations share an index freely.  A negative module id
// is the single-file adapters', where no other module exists.
fn find_callable_sym(symbols: Vector<Symbol>, decl_idx: i64, module_id: i64): i64
  let si: i64 = 0
  while si < symbols.length():
    let sym: Symbol = symbols.get(si)
    if sym.decl_node == decl_idx:
      if is_method_symbol(sym):
        if module_id < 0:
          return si
        if sym.owner_module_id == module_id:
          return si
    si = si + 1
  return to_i64(-1)

fn find_callable_sym_by_decl(ts: TS, decl_idx: i64): i64
  if ts.tc.module_id < 0:
    return find_callable_sym(ts.tc.symbols, decl_idx, ts.tc.module_id)
  return callable_sym_of_decl(ts, decl_idx)

// The field symbol named `field_name` of the class declared at
// `decl_idx` in this module, or -1.
fn find_field_sym(ts: TS, decl_idx: i64, field_name: string): i64
  return member_sym_of(ts.reg.index, ts.tc.module_id, decl_idx, "Field", field_name)

// The name a struct layout's field slot carries: the slot holds the
// field's symbol index (program-wide, so a struct declared in another
// module is read the same way), or -1 for a field the resolver never
// declared, which names nothing.
fn field_slot_name(symbols: Vector<Symbol>, slot: i64): string
  if slot < 0:
    return ""
  if slot >= symbols.length():
    return ""
  return symbols.get(slot).name

// Find a param symbol by decl_node and param name
// The parameter symbol named `param_name` of the callable declared at
// `decl_idx` in this module, or -1.
fn find_param_sym(ts: TS, decl_idx: i64, param_name: string): i64
  return member_sym_of(ts.reg.index, ts.tc.module_id, decl_idx, "Param", param_name)

// A type parameter's bound concepts are stored singly at `info_lp`
// (`info_count` slots, each a TConcept type index, or -1 for a bound
// whose concept lives outside this module's `types`).  Report whether the
// slots are in range of this module's `type_info`.
fn bounds_walkable(ts: TS, t: DaoType): bool
  if t.info_lp < 0:
    return false
  if t.info_lp + t.info_count <= ts.type_info.length():
    return true
  return false

// The TGenericParam type for `sym_idx`, created on first use.
fn generic_param_type(ts: TS, sym_idx: i64, name: string): TypeR
  let existing_ti: i64 = sym_type_at(ts, sym_idx)
  if existing_ti >= 0:
    return TypeR(ts, existing_ti)
  let tr: TypeR = ts_add_type(ts, DaoType(TypeKind::TGenericParam, sym_idx, name, to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
  let ts2: TS = ts_set_sym_type(tr.ts, sym_idx, tr.type_idx)
  return TypeR(ts2, tr.type_idx)

// The symbol the resolver bound a bound type node's head name to (a use
// recorded for its name token), or -1 when the name resolved to nothing.
fn bound_symbol(ts: TS, b_node: i64): i64
  let node: Node = ts.tc.nodes.get(b_node)
  match node:
    Node::NamedT(tidx):
      return lookup_use(ts, tidx)
    Node::GenericT(name_tidx, args_lp, arg_count):
      return lookup_use(ts, name_tidx)
    Node::QualNameE(seg_lp, seg_count):
      let segs: Vector<i64> = read_list(ts.tc.idx_data, seg_lp)
      if segs.length() > 0:
        return lookup_use(ts, segs.get(segs.length() - 1))
      return to_i64(-1)
  return to_i64(-1)

// Whether `sym_idx` was declared by the module being checked (its
// declaration and type are readable here); a symbol from another module
// (a prelude concept) has neither in this module's arrays.
fn sym_in_module(ts: TS, sym_idx: i64): bool
  if ts.tc.module_id < 0:
    return true
  let sym: Symbol = ts.tc.symbols.get(sym_idx)
  return sym.owner_module_id == ts.tc.module_id

// Bind a declaration's generic parameter bounds: for each `<T: A + B>`
// record the bound concepts on T's TGenericParam type, so a body derives
// member availability from them (`x.to_string()` where `T: Printable`
// types through Printable's signature).  A bound that names nothing in
// scope, or names a non-concept, is a diagnostic (fail-closed).  A bound
// whose concept is a symbol with no readable type in this module (a
// prelude concept) is recorded as -1: its members cannot be read here,
// so a member access through it stays unresolved rather than falsely
// reported.
fn tc_bind_generic_bounds(ts: TS, tparams_lp: i64): TS
  if tparams_lp < 0:
    return ts
  let r: TS = ts
  let tparams: Vector<i64> = read_list(r.tc.idx_data, tparams_lp)
  let i: i64 = 0
  while i < tparams.length():
    let tp_node: Node = r.tc.nodes.get(tparams.get(i))
    match tp_node:
      Node::GenericParamT(tidx, bounds_lp):
        let tname: string = ts_tok_name(r, tidx)
        // The resolver bound the declaring token to the parameter's symbol.
        let tsym: i64 = lookup_use(r, tidx)
        if tsym < 0:
          // The resolver binds every type parameter it visits; one with
          // no symbol was never resolved, so its bounds cannot be
          // validated — fail closed rather than skip.
          r = ts_add_diag(r, ts_tok_span(r, tidx), "type parameter '" + tname + "' was never resolved")
        if tsym >= 0:
          if bounds_lp >= 0:
            let gtr: TypeR = generic_param_type(r, tsym, tname)
            r = gtr.ts
            let bounds: Vector<i64> = read_list(r.tc.idx_data, bounds_lp)
            let bound_tis: Vector<i64> = Vector<i64>::new()
            let bi: i64 = 0
            while bi < bounds.length():
              let b_node: i64 = bounds.get(bi)
              let btr: TypeR = resolve_ast_type(r, b_node)
              r = btr.ts
              let b_name: string = extract_type_name(r, b_node)
              if btr.type_idx >= 0:
                let bt: DaoType = r.types.get(btr.type_idx)
                let is_concept: bool = false
                match bt.kind:
                  TypeKind::TConcept:
                    is_concept = true
                if is_concept:
                  bound_tis = bound_tis.push(btr.type_idx)
                else:
                  r = ts_add_diag(r, ts_node_span(r, b_node), "bound '" + b_name + "' on type parameter '" + tname + "' is not a concept")
              else:
                let b_sym: i64 = bound_symbol(r, b_node)
                if b_sym < 0:
                  r = ts_add_diag(r, ts_node_span(r, b_node), "unknown concept '" + b_name + "' in bound of type parameter '" + tname + "'")
                else:
                  // The bound names a symbol but did not resolve as a
                  // type: a generic head (`Iter<i64>`), or a symbol from
                  // another module.  Read the head symbol's own type — a
                  // concept head is the bound (its arguments substitute
                  // at an instantiation, generic-inference work), any
                  // other kind is not a concept.  A symbol whose type is
                  // unreadable here and that this module did not declare
                  // (a prelude concept) is recorded as -1, never falsely
                  // reported; one this module declared with no readable
                  // type is not a concept.
                  let head_ti: i64 = sym_type_at(r, b_sym)
                  if head_ti >= 0:
                    let ht: DaoType = r.types.get(head_ti)
                    let head_is_concept: bool = false
                    match ht.kind:
                      TypeKind::TConcept:
                        head_is_concept = true
                    if head_is_concept:
                      bound_tis = bound_tis.push(head_ti)
                    else:
                      r = ts_add_diag(r, ts_node_span(r, b_node), "bound '" + b_name + "' on type parameter '" + tname + "' is not a concept")
                  else:
                    if sym_in_module(r, b_sym):
                      r = ts_add_diag(r, ts_node_span(r, b_node), "bound '" + b_name + "' on type parameter '" + tname + "' is not a concept")
                    else:
                      // Another module's symbol: its kind is readable even
                      // when its type is not.  Only a type-declaring symbol
                      // can be a concept; a function, module, value, or
                      // variant is rejected here.  A type-declaring symbol
                      // (concept, class, enum, alias) cannot be told apart
                      // without its declaration, so it is recorded as -1.
                      let b_sym_obj: Symbol = r.tc.symbols.get(b_sym)
                      if symbol_kind_name(b_sym_obj.kind) == "Type":
                        bound_tis = bound_tis.push(to_i64(-1))
                      else:
                        r = ts_add_diag(r, ts_node_span(r, b_node), "bound '" + b_name + "' on type parameter '" + tname + "' is not a concept")
              bi = bi + 1
            let info_start: i64 = r.type_info.length()
            let pi: i64 = 0
            while pi < bound_tis.length():
              r = ts_push_type_info(r, bound_tis.get(pi))
              pi = pi + 1
            let gt: DaoType = r.types.get(gtr.type_idx)
            r.types = r.types.set(gtr.type_idx, DaoType(TypeKind::TGenericParam, gt.builtin_id, gt.name, gt.decl_node, info_start, bound_tis.length(), gt.ret_type, gt.pointee))
    i = i + 1
  return r

// The program's aliases, resolved once in dependency order: an alias
// whose target names another alias — declared anywhere, in any module
// — is bound after that one (a depth-first walk over the program's
// alias graph with a cycle guard), so every chain costs its length.
// The maps: "d:<sym>" → the alias's declaration, "m:<sym>" → its module,
// "t:<sym>" → how many symbols its target's spelling names and
// "t:<sym>:<j>" → the j-th (annotation_symbol_refs); `order` lists the
// alias symbols.  tc_check_aliases then diagnoses what could not bind.
class AliasGraph:
  edges: HashMap<i64>
  order: Vector<i64>

fn alias_graph_of(p: Program, acc: TcAccum): AliasGraph
  let g: AliasGraph = AliasGraph(HashMap<i64>::new(), Vector<i64>::new())
  let ti: i64 = 0
  while ti < p.graph.topo_order.length():
    let mid: i64 = p.graph.topo_order.get(ti)
    let ts: TS = ts_new(build_module_tc(p, mid), acc.types, acc.type_info, acc.sym_types, acc.reg)
    let root: Node = ts.tc.nodes.get(program_file_of_module(p, mid).parse_output.root)
    match root:
      Node::FileN(module_decl, imports_lp, decls_lp):
        let decls: Vector<i64> = read_list(ts.tc.idx_data, decls_lp)
        let i: i64 = 0
        while i < decls.length():
          let decl_idx: i64 = decls.get(i)
          let node: Node = ts.tc.nodes.get(decl_idx)
          match node:
            Node::TypeAliasD(name_tidx, target_type):
              let sym_idx: i64 = type_sym_of_decl(ts, decl_idx)
              if sym_idx >= 0:
                let k: string = i64_to_string(sym_idx)
                g.edges = g.edges.set("d:" + k, decl_idx)
                g.edges = g.edges.set("m:" + k, mid)
                let refs: Vector<i64> = annotation_symbol_refs(ts, target_type, Vector<i64>::new())
                g.edges = g.edges.set("t:" + k, refs.length())
                let ri: i64 = 0
                while ri < refs.length():
                  g.edges = g.edges.set("t:" + k + ":" + i64_to_string(ri), refs.get(ri))
                  ri = ri + 1
                g.order = g.order.push(sym_idx)
          i = i + 1
    ti = ti + 1
  return g

// The accumulated state and the walk's marks (symbol → 1 once bound,
// 2 while its target is being bound).
class AliasBindR:
  acc: TcAccum
  marks: HashMap<i64>

fn tc_resolve_aliases(p: Program, acc: TcAccum): TcAccum
  let g: AliasGraph = alias_graph_of(p, acc)
  let st: AliasBindR = AliasBindR(acc, HashMap<i64>::new())
  let i: i64 = 0
  while i < g.order.length():
    st = bind_alias(p, g, g.order.get(i), st)
    i = i + 1
  return st.acc

// Bind one alias, after every alias its target's spelling names.  An
// alias naming an alias that stayed unbound — a cycle, reached through
// pointers, generic arguments, or a generator's element — stays unbound
// itself, and is diagnosed as such.
fn bind_alias(p: Program, g: AliasGraph, sym_idx: i64, st: AliasBindR): AliasBindR
  let k: string = i64_to_string(sym_idx)
  if hm_get_or(st.marks, k, to_i64(0)) != 0:
    return st
  let r: AliasBindR = AliasBindR(st.acc, st.marks.set(k, to_i64(2)))
  let target_unbound: bool = false
  let ref_count: i64 = hm_get_or(g.edges, "t:" + k, to_i64(0))
  let ri: i64 = 0
  while ri < ref_count:
    let ref_sym: i64 = hm_get_or(g.edges, "t:" + k + ":" + i64_to_string(ri), to_i64(-1))
    if ref_sym >= 0 and g.edges.contains("d:" + i64_to_string(ref_sym)):
      r = bind_alias(p, g, ref_sym, r)
      if vec_i64_get(r.acc.sym_types, ref_sym) < 0:
        target_unbound = true
    ri = ri + 1
  let mid: i64 = hm_get_or(g.edges, "m:" + k, to_i64(-1))
  let decl_idx: i64 = hm_get_or(g.edges, "d:" + k, to_i64(-1))
  let ts: TS = ts_new(build_module_tc(p, mid), r.acc.types, r.acc.type_info, r.acc.sym_types, r.acc.reg)
  let node: Node = ts.tc.nodes.get(decl_idx)
  match node:
    Node::TypeAliasD(name_tidx, target_type):
      let target_r: TypeR = resolve_ast_type(ts, target_type)
      ts = target_r.ts
      let ti: i64 = to_i64(-1)
      if target_unbound == false and target_r.type_idx >= 0 and concept_named_by(ts, target_r.type_idx) < 0:
        ti = target_r.type_idx
      ts = ts_set_sym_type(ts, sym_idx, ti)
  let acc2: TcAccum = TcAccum(ts.types, ts.type_info, ts.sym_types, ts.reg, r.acc.diags)
  return AliasBindR(acc2, r.marks.set(k, to_i64(1)))

// Every symbol an annotation's spelling names — through pointers,
// generic heads and their arguments (a generator's element among them),
// a qualified name by its last segment — appended to `out`.
fn annotation_symbol_refs(ts: TS, node_idx: i64, out: Vector<i64>): Vector<i64>
  if node_idx < 0:
    return out
  let through_ptr: i64 = pointer_annotation_pointee(ts, node_idx)
  if through_ptr >= 0:
    return annotation_symbol_refs(ts, through_ptr, out)
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::NamedT(tidx):
      return out.push(lookup_use(ts, tidx))
    Node::GenericT(name_tidx, args_lp, arg_count):
      let acc: Vector<i64> = out.push(lookup_use(ts, name_tidx))
      let args: Vector<i64> = read_list(ts.tc.idx_data, args_lp)
      let ai: i64 = 0
      while ai < args.length():
        acc = annotation_symbol_refs(ts, args.get(ai), acc)
        ai = ai + 1
      return acc
    Node::QualNameE(seg_lp, seg_count):
      let qsegs: Vector<i64> = read_list(ts.tc.idx_data, seg_lp)
      if qsegs.length() == 0:
        return out
      return out.push(lookup_use(ts, qsegs.get(qsegs.length() - 1)))
  return out

// An alias the walk could not bind names a concept (diagnosed as
// such), an unknown type, or an alias cycle: never a silent unresolved
// type.
fn tc_check_aliases(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::TypeAliasD(name_tidx, target_type):
        let sym_idx: i64 = type_sym_of_decl(r, decl_idx)
        // Every alias's target is held to the annotation rules once (the
        // walk bound it without diagnostics: a generator of an invalid
        // element binds); one left unbound is also reported as such.
        if sym_idx >= 0:
          let diags_before: i64 = r.diags.length()
          let target_r: TypeR = resolve_annotation(r, target_type, to_i64(-1))
          r = target_r.ts
          if sym_type_at(r, sym_idx) < 0 and r.diags.length() == diags_before:
            r = ts_add_diag(r, ts_node_span(r, target_type), "type alias '" + ts_tok_name(r, name_tidx) + "' has no resolvable target (an unknown type, or an alias cycle)")
    i = i + 1
  return r

fn tc_register_struct_shells(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::ClassDeclD(name_tidx, tparams_lp, fields_lp, methods_lp):
        let name: string = ts_tok_name(r, name_tidx)
        // `builtin_id` records the declaring module: a declaration index
        // is file-local, so the type itself must say whose it is.
        let tr: TypeR = ts_add_type(r, DaoType(TypeKind::TStruct, r.tc.module_id, name, decl_idx, to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
        r = tr.ts
        // The head stands for its own parameters — the record any
        // module instantiates it from, where its declaration is not
        // readable.
        r = record_own_params(r, tr.type_idx, tparams_lp)
        let sym_idx: i64 = type_sym_of_decl(r, decl_idx)
        if sym_idx >= 0:
          r = ts_set_sym_type(r, sym_idx, tr.type_idx)
    i = i + 1
  return r

// Register every enum's type — its identity, with no variant table yet —
// before any signature in the program is resolved (tc_pass_shells).
fn tc_register_enum_shells(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::EnumDeclD(name_tidx, tparams_lp, variants_lp):
        let tr: TypeR = ts_add_type(r, DaoType(TypeKind::TEnum, r.tc.module_id, ts_tok_name(r, name_tidx), decl_idx, to_i64(-1), to_i64(0), to_i64(-1), to_i64(-1)))
        r = tr.ts
        let sym_idx: i64 = type_sym_of_decl(r, decl_idx)
        if sym_idx >= 0:
          r = ts_set_sym_type(r, sym_idx, tr.type_idx)
    i = i + 1
  return r

// Fill each enum's variant table and the program-wide variant registry
// (the type tc_register_enum_shells registered).
fn tc_fill_enum_variants(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::EnumDeclD(name_tidx, tparams_lp, variants_lp):
        let enum_sym: i64 = type_sym_of_decl(r, decl_idx)
        let enum_ti: i64 = to_i64(-1)
        if enum_sym >= 0:
          enum_ti = sym_type_at(r, enum_sym)
        let pairs: Vector<i64> = read_pairs(r.tc.idx_data, variants_lp)
        let variant_records: Vector<i64> = Vector<i64>::new()
        let vi: i64 = 0
        let variant_count: i64 = 0
        while vi < pairs.length():
          let v_tidx: i64 = pairs.get(vi)
          let payload_lp: i64 = pairs.get(vi + 1)
          variant_records = variant_records.push(v_tidx)
          // The payload list is (field name token, type node) pairs; the
          // enum's type_info keeps, per variant: name, field count, then
          // (field name token, type index) per field.
          let payload_fields: Vector<i64> = read_list(r.tc.idx_data, payload_lp)
          variant_records = variant_records.push(payload_fields.length() / 2)
          let pi: i64 = 0
          while pi < payload_fields.length():
            let pt_r: TypeR = resolve_annotation(r, payload_fields.get(pi + 1), to_i64(-1))
            r = pt_r.ts
            variant_records = variant_records.push(payload_fields.get(pi))
            variant_records = variant_records.push(pt_r.type_idx)
            pi = pi + 2
          variant_count = variant_count + 1
          vi = vi + 2
        let info_start: i64 = r.type_info.length()
        r = ts_push_info_run(r, variant_records)
        if enum_ti >= 0:
          let et: DaoType = r.types.get(enum_ti)
          et.info_lp = info_start
          et.info_count = variant_count
          r.types = r.types.set(enum_ti, et)
        // The variant registry is program-wide and keyed by name, so a
        // construction in any module reads it without the declaring
        // module's tokens (type_info holds token indexes of this
        // module).  Keys: "{type_idx}:{variant}" -> parameter count;
        // "{type_idx}:{variant}:{param}" -> parameter index;
        // "{type_idx}:{variant}:{param}:type" -> parameter type index.
        let vr: i64 = 0
        let v_offset: i64 = info_start
        while vr < variant_count:
          let vname: string = ts_tok_name(r, r.type_info.get(v_offset))
          let vkey: string = i64_to_string(enum_ti) + ":" + vname
          let param_count: i64 = r.type_info.get(v_offset + 1)
          r.reg = reg_with_variant_set(r.reg, r.reg.variant_set.set(vkey, param_count))
          let pi2: i64 = 0
          while pi2 < param_count:
            let pname: string = ts_tok_name(r, r.type_info.get(v_offset + 2 + pi2 * 2))
            r.reg = reg_with_variant_set(r.reg, r.reg.variant_set.set(vkey + ":" + pname, pi2))
            r.reg = reg_with_variant_set(r.reg, r.reg.variant_set.set(vkey + ":" + pname + ":type", r.type_info.get(v_offset + 2 + pi2 * 2 + 1)))
            pi2 = pi2 + 1
          v_offset = v_offset + 2 + param_count * 2
          vr = vr + 1
    i = i + 1
  return r


// Fill each class's field layout (the type tc_register_struct_shells
// registered).  Every annotation is resolved before the layout is
// written: resolving one can make an instantiation, which appends
// records of its own, and the layout has to be one run.  A field typed
// with an instantiation of a class whose layout is not written yet —
// declared further down, or this very class — holds the instantiation's
// index; its layout follows the head's (materialize_pending).
fn tc_fill_struct_fields(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::ClassDeclD(name_tidx, tparams_lp, fields_lp, methods_lp):
        let pairs: Vector<i64> = read_pairs(r.tc.idx_data, fields_lp)
        let field_records: Vector<i64> = Vector<i64>::new()
        let field_count: i64 = 0
        let fi: i64 = 0
        while fi < pairs.length():
          let f_tidx: i64 = pairs.get(fi)
          let ft_r: TypeR = resolve_annotation(r, pairs.get(fi + 1), to_i64(-1))
          r = ft_r.ts
          // The layout names a field by its symbol (see field_slot_name),
          // which any module can read; the symbol's type is the field's.
          let fsym: i64 = find_field_sym(r, decl_idx, ts_tok_name(r, f_tidx))
          field_records = field_records.push(fsym)
          field_records = field_records.push(ft_r.type_idx)
          if fsym >= 0:
            r = ts_set_sym_type(r, fsym, ft_r.type_idx)
          field_count = field_count + 1
          fi = fi + 2
        let field_info_start: i64 = r.type_info.length()
        r = ts_push_info_run(r, field_records)
        let struct_ti: i64 = sym_type_at(r, type_sym_of_decl(r, decl_idx))
        if struct_ti >= 0:
          let t: DaoType = r.types.get(struct_ti)
          t.info_lp = field_info_start
          t.info_count = field_count
          r.types = r.types.set(struct_ti, t)
    i = i + 1
  return r

// Register fn signature. Only modifies types and type_info; sym_types
// is set by the caller to work around a compiler bug with HashMap fields
// being lost when TS is passed through function calls.
// Register a callable's signature as a function type.  `self_concept`
// is the concept whose own method this is (its name in the signature
// means the conforming type), or -1 for every other callable.
fn tc_register_fn_sig_core(ts: TS, decl_idx: i64, name_tidx: i64, params_lp: i64, ret_type_node: i64, self_concept: i64): TypeR
  let r: TS = ts
  let pairs: Vector<i64> = read_pairs(r.tc.idx_data, params_lp)
  let param_tis: Vector<i64> = Vector<i64>::new()
  let param_count: i64 = 0
  let pi: i64 = 0
  while pi < pairs.length():
    let p_tidx: i64 = pairs.get(pi)
    let p_type_node: i64 = pairs.get(pi + 1)
    let pt_r: TypeR = resolve_annotation(r, p_type_node, self_concept)
    r = pt_r.ts
    param_tis = param_tis.push(pt_r.type_idx)
    // Set the param symbol's declared type here so extern fns (which
    // have no body-check pass) still propagate their param types into
    // sym_types.  For non-extern fns, this runs before body checking
    // and writes the same type the body-check pass would write, so
    // it is safe to run unconditionally.
    let p_name: string = ts_tok_name(r, p_tidx)
    let p_sym: i64 = find_param_sym(r, decl_idx, p_name)
    if p_sym >= 0:
      r.sym_types = vec_i64_set(r.sym_types, p_sym, pt_r.type_idx)
    param_count = param_count + 1
    pi = pi + 2
  let ret_r: TypeR = resolve_annotation(r, ret_type_node, self_concept)
  r = ret_r.ts
  let ret_ti: i64 = ret_r.type_idx
  if ret_ti < 0:
    ret_ti = to_i64(11)
  let param_info_start: i64 = r.type_info.length()
  r = ts_push_info_run(r, param_tis)
  // A function type records whether its first parameter is `self`
  // (`builtin_id` 1), so a requirement and an implementation are held
  // to the same receiver shape.
  let takes_self: i64 = to_i64(0)
  if pairs.length() >= 2:
    if ts_tok_name(r, pairs.get(0)) == "self":
      takes_self = to_i64(1)
  let fname: string = ts_tok_name(r, name_tidx)
  let fn_name: string = "fn " + fname
  let tr: TypeR = ts_add_type(r, DaoType(TypeKind::TFunction, takes_self, fn_name, decl_idx, param_info_start, param_count, ret_ti, to_i64(-1)))
  // The signature stands for its own type parameters: what a call
  // from any module may decide (callee_own_params).
  return TypeR(record_own_params(tr.ts, tr.type_idx, callable_tparams_lp(tr.ts, decl_idx)), tr.type_idx)

fn tc_register_functions(ts: TS, decls: Vector<i64>): TS
  // Phase A: Register types/type_info for all functions, collect sym mappings
  let r: TS = ts
  let fn_syms: Vector<i64> = Vector<i64>::new()
  let fn_type_idxs: Vector<i64> = Vector<i64>::new()
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    let is_fn: bool = false
    let fn_name_tidx: i64 = to_i64(-1)
    let fn_params_lp: i64 = to_i64(-1)
    let fn_ret_type: i64 = to_i64(-1)
    match node:
      Node::FnDeclD(nt, tp, plp, rtn, blp):
        is_fn = true
        fn_name_tidx = nt
        fn_params_lp = plp
        fn_ret_type = rtn
      Node::ExprFnD(nt, tp, plp, rtn, be):
        is_fn = true
        fn_name_tidx = nt
        fn_params_lp = plp
        fn_ret_type = rtn
      Node::ExternFnD(nt, tp, plp, rtn):
        is_fn = true
        fn_name_tidx = nt
        fn_params_lp = plp
        fn_ret_type = rtn
    if is_fn:
      let tr: TypeR = tc_register_fn_sig_core(r, decl_idx, fn_name_tidx, fn_params_lp, fn_ret_type, to_i64(-1))
      r = tr.ts
      let fn_sym: i64 = find_callable_sym_by_decl(r, decl_idx)
      fn_syms = fn_syms.push(fn_sym)
      fn_type_idxs = fn_type_idxs.push(tr.type_idx)
    i = i + 1
  // Phase B: Set all sym_types.
  let j: i64 = 0
  while j < fn_syms.length():
    let sym: i64 = fn_syms.get(j)
    let tidx: i64 = fn_type_idxs.get(j)
    if sym >= 0:
      r.sym_types = vec_i64_set(r.sym_types, sym, tidx)
    j = j + 1
  return r

// The type a method's owner declaration gives its methods — what
// `self` is and where they dispatch: a class's struct type, or the
// type an extend's target annotation resolves to in the extend's
// module.
fn method_owner(ts: TS, owner_decl_idx: i64): TypeR
  let node: Node = ts.tc.nodes.get(owner_decl_idx)
  match node:
    Node::ClassDeclD(cn_tidx, cn_tparams_lp, cn_fields_lp, cn_methods_lp):
      let ssym: i64 = type_sym_of_decl(ts, owner_decl_idx)
      if ssym >= 0:
        return TypeR(ts, sym_type_at(ts, ssym))
      return TypeR(ts, to_i64(-1))
    Node::ExtendDeclD(target_type_node, concept_name_tidx, e_methods_lp):
      return resolve_ast_type(ts, target_type_node)
  return TypeR(ts, to_i64(-1))

// Register one method's signature (block- or expression-bodied alike):
// its function type, on its mangled symbol, bound to its owner.
fn tc_register_method_sig(ts: TS, owner_ti: i64, meth_idx: i64, m_name_tidx: i64, m_params_lp: i64, m_ret_type: i64): TS
  let tr: TypeR = tc_register_fn_sig_core(ts, meth_idx, m_name_tidx, m_params_lp, m_ret_type, to_i64(-1))
  let r: TS = tr.ts
  let msym: i64 = callable_sym_of_decl(r, meth_idx)
  if msym >= 0:
    r = ts_set_sym_type(r, msym, tr.type_idx)
  return tc_bind_self(r, meth_idx, msym, m_name_tidx, owner_ti)

// An extend's method must take `self` first (the host's
// validate_receiver): a conformance method has a receiver.  A class's
// own method may be static instead.
fn tc_require_receiver(ts: TS, m_name_tidx: i64, m_params_lp: i64): TS
  let pairs: Vector<i64> = read_pairs(ts.tc.idx_data, m_params_lp)
  if pairs.length() >= 2:
    if ts_tok_name(ts, pairs.get(0)) == "self":
      return ts
  return ts_add_diag(ts, ts_tok_span(ts, m_name_tidx), "method '" + ts_tok_name(ts, m_name_tidx) + "' must have 'self' as its first parameter")

fn tc_register_methods(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::ClassDeclD(name_tidx, tparams_lp, fields_lp, methods_lp):
        if methods_lp >= 0:
          let own: TypeR = method_owner(r, decl_idx)
          r = own.ts
          let methods: Vector<i64> = read_list(r.tc.idx_data, methods_lp)
          let mi: i64 = 0
          while mi < methods.length():
            let meth_idx: i64 = methods.get(mi)
            let meth_node: Node = r.tc.nodes.get(meth_idx)
            match meth_node:
              Node::FnDeclD(m_name_tidx, m_tparams_lp, m_params_lp, m_ret_type, m_body_lp):
                r = tc_register_method_sig(r, own.type_idx, meth_idx, m_name_tidx, m_params_lp, m_ret_type)
              Node::ExprFnD(m_name_tidx, m_tparams_lp, m_params_lp, m_ret_type, m_body_expr):
                r = tc_register_method_sig(r, own.type_idx, meth_idx, m_name_tidx, m_params_lp, m_ret_type)
            mi = mi + 1
    i = i + 1
  return r

// Extract a type name from a NamedT or GenericT node.
fn extract_type_name(ts: TS, type_node_idx: i64): string
  if type_node_idx < 0:
    return ""
  let tnode: Node = ts.tc.nodes.get(type_node_idx)
  match tnode:
    Node::NamedT(t_tidx):
      return ts_tok_name(ts, t_tidx)
    Node::GenericT(t_name_tidx, t_args_lp, t_arg_count):
      return ts_tok_name(ts, t_name_tidx)
  return ""

// Register every concept's type — its identity, with no method table
// yet — before any signature in the module is resolved, so a
// signature naming a concept resolves it whatever the declaration
// order: the concept's own name in its signatures means the conforming
// type (a member lookup substitutes the receiver, concept_method_sig),
// and any other concept named as a type is diagnosed.  `builtin_id`
// records the declaring module.  A concept's method-name tokens index
// that module's token vector; a member lookup matches methods through
// their types' names instead (method_type_named), which holds from any
// module.
fn tc_register_concept_shells(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::ConceptDeclD(name_tidx, tparams_lp, methods_lp, is_derived):
        let csym: i64 = type_sym_of_decl(r, decl_idx)
        if csym >= 0:
          let cname: string = ts_tok_name(r, name_tidx)
          let ctr: TypeR = ts_add_type(r, concept_type(r.tc.module_id, cname, decl_idx, to_i64(-1), to_i64(0)))
          r = ctr.ts
          r = ts_set_sym_type(r, csym, ctr.type_idx)
    i = i + 1
  return r

// Register each concept's method signatures and attach the method table
// to the type tc_register_concept_shells registered.  A method's
// default body (expression or block) is abstract over `self`'s type;
// the host checks nothing of it beyond its signature (concept-level
// reasoning is deferred there too), and a concept lowers to no code, so
// the bootstrap registers the signature and leaves the body unchecked
// as the host does.
fn tc_register_concepts(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::ConceptDeclD(name_tidx, tparams_lp, methods_lp, is_derived):
        let csym: i64 = type_sym_of_decl(r, decl_idx)
        let cti: i64 = to_i64(-1)
        if csym >= 0:
          cti = sym_type_at(r, csym)
        if cti >= 0:
          let cname: string = ts_tok_name(r, name_tidx)
          // Register concept method signatures. Collect pairs
          // (name_tidx, fn_type_idx) locally first, then flush to
          // type_info after all fn registrations are done (since
          // tc_register_fn_sig_core also pushes to type_info).
          let method_pairs: Vector<i64> = Vector<i64>::new()
          let method_count: i64 = 0
          if methods_lp >= 0:
            let methods: Vector<i64> = read_list(r.tc.idx_data, methods_lp)
            let mi: i64 = 0
            while mi < methods.length():
              let meth_idx: i64 = methods.get(mi)
              let meth_node: Node = r.tc.nodes.get(meth_idx)
              // Handle signature-only (ExternFnD) and default-body methods
              let cm_name_tidx: i64 = to_i64(-1)
              let cm_params_lp: i64 = to_i64(-1)
              let cm_ret_type: i64 = to_i64(-1)
              let cm_valid: bool = false
              match meth_node:
                Node::ExternFnD(mn, mt, mp, mr):
                  cm_name_tidx = mn
                  cm_params_lp = mp
                  cm_ret_type = mr
                  cm_valid = true
                Node::FnDeclD(mn, mt, mp, mr, mb):
                  cm_name_tidx = mn
                  cm_params_lp = mp
                  cm_ret_type = mr
                  cm_valid = true
                Node::ExprFnD(mn, mt, mp, mr, mb):
                  cm_name_tidx = mn
                  cm_params_lp = mp
                  cm_ret_type = mr
                  cm_valid = true
              if cm_valid:
                let mtr: TypeR = tc_register_fn_sig_core(r, meth_idx, cm_name_tidx, cm_params_lp, cm_ret_type, cti)
                r = mtr.ts
                method_pairs = method_pairs.push(cm_name_tidx)
                method_pairs = method_pairs.push(mtr.type_idx)
                method_count = method_count + 1
              mi = mi + 1
          // Flush concept method pairs to type_info contiguously.
          let info_start: i64 = r.type_info.length()
          r = ts_push_info_run(r, method_pairs)
          // Attach the method table to the concept's registered type.
          r.types = r.types.set(cti, concept_type(r.tc.module_id, cname, decl_idx, info_start, method_count))
    i = i + 1
  return r

// A symbol is visible from a module when it is a builtin
// (owner_module_id == -1), a prelude declaration (declared into the
// prelude scope, whichever prelude module owns it — its `extend`
// methods join every module's method set, CONTRACT_MODULE_SYSTEM.md
// §7.2), or the module's own.
fn sym_visible_in_module(sym: Symbol, module_id: i64): bool
  if sym.owner_module_id < 0:
    return true
  if sym.scope_id == prelude_scope_idx():
    return true
  return sym.owner_module_id == module_id

// The method symbol `mangled` names from `module_id`: the module's own
// declaration when it has one — a module that shadows a prelude type
// shadows its methods too (§7.4), whatever the symbols' order — else
// a visible prelude or builtin one; -1 when none is visible.
// A mangled name (`Box.m`) is borne by a class's own method
// (`SymbolKind::Method`) and by one an `extend` block introduces
// (`Function`, like the free function it is).
fn is_method_symbol(sym: Symbol): bool
  if symbol_kind_name(sym.kind) == "Method":
    return true
  return symbol_kind_name(sym.kind) == "Function"

// Where a method is found at dispatch: the receiver's type and the
// method's own name — never the owner's spelling, which an alias
// (`extend Alias as C`) or a same-named type can share.  A class's own
// method is keyed by its type alone; an extend's by its type and the
// module the extend is visible from (its declaring module, or
// conform_everywhere() for the prelude's — CONTRACT_MODULE_SYSTEM.md
// §5, §7.2).
fn dispatch_key_inherent(owner_ti: i64, name: string): string
  return "I:" + i64_to_string(owner_ti) + ":" + name

fn dispatch_key_extend(owner_ti: i64, name: string, from_module: i64): string
  return "E:" + i64_to_string(owner_ti) + ":" + name + ":" + i64_to_string(from_module)

// Bind a method to the type it belongs to: its `self` parameter (the
// symbol and the signature's first slot), when it has one, takes
// `owner_ti`, and the method is entered into the dispatch index under
// that type — a class's own method as inherent,
// an extend's as visible from the extend's module (everywhere for the
// prelude's).  Nothing is bound for an unresolved owner or a method
// the resolver never declared.
fn tc_bind_self(ts: TS, meth_idx: i64, msym: i64, m_name_tidx: i64, owner_ti: i64): TS
  if owner_ti < 0:
    return ts
  if msym < 0:
    return ts
  let r: TS = ts
  let self_sym: i64 = find_param_sym(r, meth_idx, "self")
  if self_sym >= 0:
    r = ts_set_sym_type(r, self_sym, owner_ti)
  // The signature's receiver slot names the owner too, so a qualified
  // call (`C::get(c)`) checks its first argument against it.
  let fn_ti: i64 = sym_type_at(r, msym)
  if fn_ti >= 0:
    let ft: DaoType = r.types.get(fn_ti)
    if ft.builtin_id == 1 and fn_params_walkable(r, ft) and ft.info_count > 0:
      r.type_info = vec_i64_set(r.type_info, ft.info_lp, owner_ti)
  let name: string = ts_tok_name(r, m_name_tidx)
  let sym: Symbol = r.tc.symbols.get(msym)
  let key: string = dispatch_key_inherent(owner_ti, name)
  if symbol_kind_name(sym.kind) != "Method":
    let from_module: i64 = r.tc.module_id
    if module_in_prelude(r):
      from_module = conform_everywhere()
    key = dispatch_key_extend(owner_ti, name, from_module)
  // One type answers one name once: a second method for it — an extend
  // written through an alias of an already extended type, say, or an
  // extend redefining the type's own method, which dispatch would
  // always prefer — is a conflict, never a silent replacement.
  let existing: i64 = hm_get_or(r.reg.methods, key, to_i64(-1))
  if existing < 0 and symbol_kind_name(sym.kind) != "Method":
    existing = hm_get_or(r.reg.methods, dispatch_key_inherent(owner_ti, name), to_i64(-1))
  if existing < 0 and symbol_kind_name(sym.kind) == "Method":
    // The type's own method registered after an extend of it visible
    // here — one of a prelude file registered earlier — conflicts too.
    existing = hm_get_or(r.reg.methods, dispatch_key_extend(owner_ti, name, r.tc.module_id), to_i64(-1))
    if existing < 0:
      existing = hm_get_or(r.reg.methods, dispatch_key_extend(owner_ti, name, conform_everywhere()), to_i64(-1))
  if existing >= 0 and existing != msym:
    // Two methods of one mangled name in one resolver namespace (one
    // module, or the prelude's files) are the resolver's duplicate
    // declaration, already reported.  Every other conflict — spelled
    // through an alias, or a module's extend of a prelude type, which
    // the resolver lets shadow the prelude's name — is the checker's.
    if existing < r.tc.symbols.length():
      let es: Symbol = r.tc.symbols.get(existing)
      if es.name == sym.name and same_resolver_namespace(r, es.owner_module_id, sym.owner_module_id):
        return r
    return ts_add_diag(r, ts_tok_span(r, m_name_tidx), "method '" + name + "' is already defined for type " + type_name(r, owner_ti))
  r.reg = reg_with_methods(r.reg, r.reg.methods.set(key, msym))
  return r

// The class's own method named `name` of the type `owner_ti`, whatever
// the class's spelling here, or -1.
fn find_inherent_method_sym(methods: HashMap<i64>, name: string, owner_ti: i64): i64
  return hm_get_or(methods, dispatch_key_inherent(owner_ti, name), to_i64(-1))

/// The type a receiver's methods are declared on: an instantiation
/// answers with its head's (`Box<i32>` has what `class Box<T>`
/// declares); any other type answers with its own.
fn dispatch_owner(types: Vector<DaoType>, type_info: Vector<i64>, receiver_ti: i64): i64
  if receiver_ti < 0:
    return receiver_ti
  if receiver_ti >= types.length():
    return receiver_ti
  let t: DaoType = types.get(receiver_ti)
  match t.kind:
    TypeKind::TStruct:
      if t.ret_type >= 0:
        if t.ret_type < type_info.length():
          return type_info.get(t.ret_type)
  return receiver_ti

/// The method symbol a receiver in the module being checked answers
/// `name` with (find_method_sym_for_receiver).
fn ts_method_for_receiver(ts: TS, name: string, receiver_ti: i64): i64
  return find_method_sym_for_receiver(ts.reg.methods, ts.tc.module_id, name, receiver_ti, dispatch_owner(ts.types, ts.type_info, receiver_ti))

// The method named `name` a receiver of type `receiver_ti` answers to,
// as seen from `module_id`, in precedence order: the type's own method,
// then an `extend` of this type this module wrote, then a prelude one.
// Every candidate is matched to the receiver by the type it belongs to,
// never by the owner's spelling: a value of `core::box`'s `Box`
// answers with that module's method even where this module declares
// its own `Box` (§7.4 shadows the name, not the value's type); another
// type's own method is never a candidate; an extend written through an
// alias answers for the type the alias names.  An `extend` is not the
// type's own: the orphan rule lets any module write one for a foreign
// type, and this module's wins over the prelude's (§5, §7.2).  Both the
// type checker and the HIR builder dispatch through here, so they
// cannot disagree about which symbol a call means.  An instantiation's
// own methods are its head's (`owner_ti`, dispatch_owner); an extend
// answers for the receiver as written — `extend Box<i32>` for a
// `Box<i32>`, `extend Box<T>` for every one.  A handful of
// constant-time reads of the dispatch index.
fn find_method_sym_for_receiver(methods: HashMap<i64>, module_id: i64, name: string, receiver_ti: i64, owner_ti: i64): i64
  if receiver_ti < 0:
    return to_i64(-1)
  let inherent: i64 = find_inherent_method_sym(methods, name, owner_ti)
  if inherent >= 0:
    return inherent
  let for_receiver: i64 = find_extend_method_sym(methods, module_id, name, receiver_ti)
  if for_receiver >= 0:
    return for_receiver
  if owner_ti == receiver_ti:
    return to_i64(-1)
  return find_extend_method_sym(methods, module_id, name, owner_ti)

// The method an extend visible from `module_id` gives `type_ti` under
// `name`: this module's, else the prelude's.
fn find_extend_method_sym(methods: HashMap<i64>, module_id: i64, name: string, type_ti: i64): i64
  let local: i64 = hm_get_or(methods, dispatch_key_extend(type_ti, name, module_id), to_i64(-1))
  if local >= 0:
    return local
  return hm_get_or(methods, dispatch_key_extend(type_ti, name, conform_everywhere()), to_i64(-1))

fn tc_register_extend_methods(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::ExtendDeclD(target_type_node, concept_name_tidx, methods_lp):
        if methods_lp >= 0:
          // The target is the type the annotation resolves to in this
          // module's scope (a foreign type the orphan rule lets this
          // module extend, a builtin, or a local one that shadows a
          // prelude name).  Only the extend METHOD symbols are
          // module-scoped.
          let own: TypeR = method_owner(r, decl_idx)
          r = own.ts
          let methods: Vector<i64> = read_list(r.tc.idx_data, methods_lp)
          let mi: i64 = 0
          while mi < methods.length():
            let meth_idx: i64 = methods.get(mi)
            let meth_node: Node = r.tc.nodes.get(meth_idx)
            match meth_node:
              Node::FnDeclD(m_name_tidx, m_tparams_lp, m_params_lp, m_ret_type, m_body_lp):
                r = tc_require_receiver(r, m_name_tidx, m_params_lp)
                r = tc_register_method_sig(r, own.type_idx, meth_idx, m_name_tidx, m_params_lp, m_ret_type)
              Node::ExprFnD(m_name_tidx, m_tparams_lp, m_params_lp, m_ret_type, m_body_expr):
                r = tc_require_receiver(r, m_name_tidx, m_params_lp)
                r = tc_register_method_sig(r, own.type_idx, meth_idx, m_name_tidx, m_params_lp, m_ret_type)
            mi = mi + 1
    i = i + 1
  return r

// Validate that each extend Type as Concept: provides all required
// methods with matching signatures. Emits diagnostics for missing
// methods and signature mismatches.
fn tc_check_concept_satisfaction(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::ExtendDeclD(target_type_node, concept_name_tidx, methods_lp):
        // Look up the concept type via the resolver-bound identity in
        // TC.concept_bindings, NOT by scanning symbols by name.
        // The resolver already bound the concept name to its sym_idx
        // during resolution.
        let concept_name: string = ts_tok_name(r, concept_name_tidx)
        let concept_ti: i64 = to_i64(-1)
        let cb_key: string = extend_binding_key(r.tc.file_id, decl_idx)
        let cb_found: Option<i64> = r.tc.concept_bindings.get(cb_key)
        let concept_sym_idx: i64 = to_i64(-1)
        match cb_found:
          Option::Some(sym):
            concept_sym_idx = sym
          Option::None:
            concept_sym_idx = to_i64(-1)
        if concept_sym_idx >= 0:
          let cti: i64 = sym_type_at(r, concept_sym_idx)
          if cti >= 0:
            let ct: DaoType = r.types.get(cti)
            match ct.kind:
              TypeKind::TConcept:
                concept_ti = cti
        if concept_ti < 0:
          // The name after `as` names no concept: nothing in scope, or a
          // type that is no concept.  Diagnosed here, once; the
          // conformance pass records nothing for it.
          if concept_sym_idx < 0:
            r = ts_add_diag(r, ts_tok_span(r, concept_name_tidx), "unknown concept '" + concept_name + "' in extend")
          else:
            r = ts_add_diag(r, ts_tok_span(r, concept_name_tidx), "'" + concept_name + "' is not a concept")
        else:
          let concept_type: DaoType = r.types.get(concept_ti)
          // The concept's own name in a required signature means the
          // conforming type, so each requirement is compared as its
          // signature for this extend's target — a type, never a concept
          // (resolve_annotation diagnoses `extend C as C`).
          let target_r: TypeR = resolve_annotation(r, target_type_node, to_i64(-1))
          r = target_r.ts
          // The requirements of a concept declared in any module are
          // walked (the type tables are program-wide, and a requirement's
          // name is read off its type); only a table still out of range —
          // a shell whose signatures never registered — walks zero.
          let req_count: i64 = to_i64(0)
          if layout_walkable(r, concept_type):
            req_count = concept_type.info_count
          // Check each required concept method
          let req_mi: i64 = 0
          while req_mi < req_count:
            // The requirement's name is read off its method type, which
            // any module can read (the name token is the concept's own
            // module's).
            let req_name: string = method_type_name(r, r.type_info.get(concept_type.info_lp + req_mi * 2 + 1))
            let req_sig: TypeR = concept_method_sig(r, r.type_info.get(concept_type.info_lp + req_mi * 2 + 1), concept_ti, target_r.type_idx)
            r = req_sig.ts
            let req_fn_ti: i64 = req_sig.type_idx
            let found_method: bool = false
            // The candidate is the method the target type itself answers
            // with (its own, or an extend of this very type), never a
            // same-named type's.
            let chosen: i64 = ts_method_for_receiver(r, req_name, target_r.type_idx)
            if chosen >= 0:
              found_method = true
            // Check full signature match: param count, each param type, return type.
            let impl_ti: i64 = sym_type_at(r, chosen)
            // A class's own method answers for an instantiated target
            // with the target's arguments in place of the class's
            // parameters: `get(self): T` on a `Box<i32>` returns `i32`.
            if impl_ti >= 0:
              let by_target: Bound = instantiation_decided(r, target_r.type_idx, HashMap<i64>::new())
              r = by_target.ts
              let as_target: TypeR = substitute_fn_type(r, by_target.map, impl_ti)
              r = as_target.ts
              impl_ti = as_target.type_idx
            // A method's own type parameters are matched to the
            // requirement's by position: `use<V>(self, x: Box<V>)` meets
            // `use<U>(self, x: Box<U>)`, whatever they are called.
            if impl_ti >= 0 and req_fn_ti >= 0:
              let req_own: Vector<i64> = stands_for_args(r, r.types.get(req_fn_ti).pointee)
              let impl_own: Vector<i64> = stands_for_args(r, r.types.get(impl_ti).pointee)
              if req_own.length() > 0 and req_own.length() == impl_own.length():
                let by_position: HashMap<i64> = HashMap<i64>::new()
                let oi: i64 = 0
                while oi < impl_own.length():
                  by_position = by_position.set(i64_to_string(impl_own.get(oi)), req_own.get(oi))
                  oi = oi + 1
                let as_required: TypeR = substitute_fn_type(r, by_position, impl_ti)
                r = as_required.ts
                impl_ti = as_required.type_idx
            if impl_ti >= 0:
              if req_fn_ti >= 0:
                let impl_type: DaoType = r.types.get(impl_ti)
                let req_type: DaoType = r.types.get(req_fn_ti)
                // A requirement taking `self` is met only by a method
                // taking `self` (a class's static method is no match),
                // and a static requirement only by a static method.
                if impl_type.builtin_id != req_type.builtin_id:
                  let sp_s: Span = Span(to_i64(0), to_i64(1))
                  if concept_name_tidx >= 0:
                    let tok_s: Token = r.tc.toks.get(concept_name_tidx)
                    sp_s = Span(tok_s.offset, tok_s.len)
                  if req_type.builtin_id == 1:
                    r = ts_add_diag(r, sp_s, "method '" + req_name + "' must take self as concept '" + concept_name + "' requires")
                  else:
                    r = ts_add_diag(r, sp_s, "method '" + req_name + "' takes self but concept '" + concept_name + "' requires a static method")
                // Compare param counts (both include self)
                if impl_type.info_count != req_type.info_count:
                  let sp: Span = Span(to_i64(0), to_i64(1))
                  if concept_name_tidx >= 0:
                    let tok: Token = r.tc.toks.get(concept_name_tidx)
                    sp = Span(tok.offset, tok.len)
                  r = ts_add_diag(r, sp, "extend method '" + req_name + "' has " + i64_to_string(impl_type.info_count) + " param(s), concept requires " + i64_to_string(req_type.info_count))
                else:
                  // Param counts match — compare each non-self param type.
                  // Skip param 0 (self) since it differs by design
                  // (impl has the concrete type, concept has Self placeholder).
                  // The tables are program-wide; a parameter list still out
                  // of range (a shell whose signature never registered)
                  // compares zero parameters.
                  let cmp_count: i64 = req_type.builtin_id
                  if fn_params_walkable(r, impl_type):
                    if fn_params_walkable(r, req_type):
                      cmp_count = impl_type.info_count
                  // `self` (slot 0 of a receiver-taking pair) differs by
                  // design: the concept's placeholder against the concrete
                  // type; a static pair compares every parameter.
                  let pi: i64 = req_type.builtin_id
                  while pi < cmp_count:
                    let impl_param_ti: i64 = r.type_info.get(impl_type.info_lp + pi)
                    let req_param_ti: i64 = r.type_info.get(req_type.info_lp + pi)
                    if impl_param_ti != req_param_ti:
                      // Diagnose mismatch. Unresolved (-1) on either side
                      // is also a mismatch when the other side resolved.
                      let sp_p: Span = Span(to_i64(0), to_i64(1))
                      if concept_name_tidx >= 0:
                        let tok_p: Token = r.tc.toks.get(concept_name_tidx)
                        sp_p = Span(tok_p.offset, tok_p.len)
                      let impl_pname: string = "<unresolved>"
                      if impl_param_ti >= 0:
                        impl_pname = type_name(r, impl_param_ti)
                      let req_pname: string = "<unresolved>"
                      if req_param_ti >= 0:
                        req_pname = type_name(r, req_param_ti)
                      r = ts_add_diag(r, sp_p, "extend method '" + req_name + "' param " + i64_to_string(pi) + " has type " + impl_pname + ", concept requires " + req_pname)
                    pi = pi + 1
                // Compare return types
                if impl_type.ret_type != req_type.ret_type:
                  let sp2: Span = Span(to_i64(0), to_i64(1))
                  if concept_name_tidx >= 0:
                    let tok2: Token = r.tc.toks.get(concept_name_tidx)
                    sp2 = Span(tok2.offset, tok2.len)
                  let impl_rname: string = "<unresolved>"
                  if impl_type.ret_type >= 0:
                    impl_rname = type_name(r, impl_type.ret_type)
                  let req_rname: string = "<unresolved>"
                  if req_type.ret_type >= 0:
                    req_rname = type_name(r, req_type.ret_type)
                  r = ts_add_diag(r, sp2, "extend method '" + req_name + "' returns " + impl_rname + ", concept requires " + req_rname)
            if found_method == false:
              let sp3: Span = Span(to_i64(0), to_i64(1))
              if concept_name_tidx >= 0:
                let tok3: Token = r.tc.toks.get(concept_name_tidx)
                sp3 = Span(tok3.offset, tok3.len)
              r = ts_add_diag(r, sp3, "extend does not implement required method '" + req_name + "' from concept '" + concept_name + "'")
            req_mi = req_mi + 1
    i = i + 1
  return r

// The file-level passes of a program's type check, in order.  Each runs
// over every module before the next starts (run_program_pass), so a
// signature in one module resolves a type or concept declared in any
// other and an extend is checked against a concept's full requirements
// — the prelude's files see one another as one namespace.  Derivation
// (derive_program_conformances) runs program-wide between Collect and
// Bodies, so every class's derived conformances are known before any
// body is checked.
enum TcPass:
  Shells         // struct, enum, and concept identities (tc_pass_shells)
  Declarations   // every other declaration and signature (tc_pass1)
  Satisfaction   // extends against their concepts' requirements (tc_pass_satisfaction)
  Collect        // derived concepts and extends into the conformance map (tc_pass_collect)
  Bodies         // function bodies (tc_pass2) — after program-wide derivation

fn tc_file_pass(ts: TS, pass: TcPass, file_node_idx: i64): TS
  match pass:
    TcPass::Shells:
      return tc_pass_shells(ts, file_node_idx)
    TcPass::Declarations:
      return tc_pass1(ts, file_node_idx)
    TcPass::Satisfaction:
      return tc_pass_satisfaction(ts, file_node_idx)
    TcPass::Collect:
      return tc_pass_collect(ts, file_node_idx)
    TcPass::Bodies:
      return tc_pass2(ts, file_node_idx)
  return ts

// The identities of a file's structs, enums, and concepts, registered
// before any alias or signature anywhere is resolved
// (tc_resolve_aliases runs between this pass and the next).
fn tc_pass_shells(ts: TS, file_node_idx: i64): TS
  let file_node: Node = ts.tc.nodes.get(file_node_idx)
  match file_node:
    Node::FileN(module_decl, imports_lp, decls_lp):
      let decls: Vector<i64> = read_list(ts.tc.idx_data, decls_lp)
      let r: TS = tc_register_struct_shells(ts, decls)
      r = tc_register_enum_shells(r, decls)
      return tc_register_concept_shells(r, decls)
  return ts

fn tc_pass1(ts: TS, file_node_idx: i64): TS
  let file_node: Node = ts.tc.nodes.get(file_node_idx)
  match file_node:
    Node::FileN(module_decl, imports_lp, decls_lp):
      let decls: Vector<i64> = read_list(ts.tc.idx_data, decls_lp)
      let r: TS = tc_check_aliases(ts, decls)
      r = tc_fill_struct_fields(r, decls)
      r = tc_fill_enum_variants(r, decls)
      // Every class layout of the module is written: the instantiations
      // made while they were being written get theirs — and those of
      // earlier modules still waiting on a head declared here.
      r = materialize_pending(r)
      // Bounds are bound in this pass, which runs over every module
      // before any body is checked: a call is held to its callee's
      // bounds whatever the order of the modules or declarations.
      r = tc_bind_module_bounds(r, decls)
      r = tc_register_functions(r, decls)
      r = tc_register_methods(r, decls)
      r = tc_register_concepts(r, decls)
      r = tc_register_extend_methods(r, decls)
      return r
  return ts

// =========================================================================
// Section 43: Expression checking
// =========================================================================

fn check_expr(ts: TS, node_idx: i64): TS
  if node_idx < 0:
    return ts
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::IntLitE(tidx):
      return ts_set_expr_type(ts, node_idx, to_i64(2))
    Node::FloatLitE(tidx):
      return ts_set_expr_type(ts, node_idx, to_i64(9))
    Node::StringLitE(tidx):
      return ts_set_expr_type(ts, node_idx, to_i64(12))
    Node::BoolLitE(tidx):
      return ts_set_expr_type(ts, node_idx, to_i64(10))
    Node::IdentE(tidx):
      return check_ident_expr(ts, node_idx, tidx)
    Node::QualNameE(seg_lp, seg_count):
      return check_qualname_expr(ts, node_idx, seg_lp, seg_count)
    Node::BinaryE(op_tidx, left, right):
      return check_binary_expr(ts, node_idx, op_tidx, left, right)
    Node::UnaryE(op_tidx, operand):
      return check_unary_expr(ts, node_idx, op_tidx, operand)
    Node::CallE(callee, args_lp, arg_count, targs_lp, names_lp, targs_on_type):
      return check_call_expr(ts, node_idx, callee, args_lp, WrittenTypeArgs(targs_lp, targs_on_type), names_lp)
    Node::FieldE(obj, field_tidx):
      return check_field_expr(ts, node_idx, obj, field_tidx)
    Node::PipeE(left, right):
      return check_pipe_expr(ts, node_idx, left, right)
    Node::IndexE(obj, idx_expr):
      let r: TS = check_expr(ts, obj)
      r = check_expr(r, idx_expr)
      return r
    Node::TryE(operand):
      return check_expr(ts, operand)
    Node::LambdaE(params_lp, param_count, body):
      return check_expr(ts, body)
    Node::ListLitE(elems_lp, elem_count):
      let elems: Vector<i64> = read_list(ts.tc.idx_data, elems_lp)
      let r: TS = ts
      let ei: i64 = 0
      while ei < elems.length():
        r = check_expr(r, elems.get(ei))
        ei = ei + 1
      return r
    Node::ErrorE(t):
      return ts
  return ts

fn check_ident_expr(ts: TS, node_idx: i64, tidx: i64): TS
  let sym_idx: i64 = lookup_use(ts, tidx)
  if sym_idx < 0:
    return ts
  let ti: i64 = sym_type_at(ts, sym_idx)
  if ti >= 0:
    return ts_set_expr_type(ts, node_idx, ti)
  return ts

// D4: Look up a named export in a module's export table via TC.exports.
// Returns the program-wide sym_idx or -1 if absent.
fn tc_export_lookup(ts: TS, target_mid: i64, name: string): i64
  if target_mid < 0:
    return to_i64(-1)
  if target_mid >= ts.tc.exports.tables.length():
    return to_i64(-1)
  let table: ExportTable = ts.tc.exports.tables.get(target_mid)
  let found: Option<i64> = table.entries.get(name)
  match found:
    Option::Some(sym_idx):
      return sym_idx
    Option::None:
      return to_i64(-1)
  return to_i64(-1)

fn check_qualname_expr(ts: TS, node_idx: i64, seg_lp: i64, seg_count: i64): TS
  let segs: Vector<i64> = read_list(ts.tc.idx_data, seg_lp)
  if segs.length() == 0:
    return ts
  let first_tidx: i64 = segs.get(0)
  let sym_idx: i64 = lookup_use(ts, first_tidx)
  if sym_idx < 0:
    return ts
  let sym: Symbol = ts.tc.symbols.get(sym_idx)
  // D4: If the first segment resolves to a Module symbol, look up
  // the second segment in the target module's export table.
  if symbol_kind_name(sym.kind) == "Module":
    if segs.length() < 2:
      return ts
    let target_mid: i64 = sym.decl_node  // Module symbols store target_module_id in decl_node
    let second_tidx: i64 = segs.get(1)
    let second_name: string = ts_tok_name(ts, second_tidx)
    // Explicit rejection of unsupported deeper qualification.
    if segs.length() > 2:
      // Could be mod::Enum::Variant (exactly 3 segments) or
      // mod::Type::method (rejected). Anything deeper than 3
      // segments is always rejected per the D4 case table.
      if segs.length() > 3:
        let sp_deep: Span = ts_tok_span(ts, segs.get(3))
        return ts_add_diag(ts, sp_deep, "nested module access not supported in this release")
      // Exactly 3 segments: check if second segment is an exported enum.
      let exp_sym: i64 = tc_export_lookup(ts, target_mid, second_name)
      if exp_sym >= 0:
        let exp_ti: i64 = sym_type_at(ts, exp_sym)
        if exp_ti >= 0:
          let exp_type: DaoType = ts.types.get(exp_ti)
          match exp_type.kind:
            TypeKind::TEnum:
              // mod::Enum::Variant — validate the variant exists via
              // variant_set (populated during pass1 of the declaring
              // module) then type as the enum type.
              let variant_tidx: i64 = segs.get(2)
              let variant_name: string = ts_tok_name(ts, variant_tidx)
              let vcheck_key: string = i64_to_string(exp_ti) + ":" + variant_name
              let vcheck: Option<i64> = ts.reg.variant_set.get(vcheck_key)
              match vcheck:
                Option::Some(v):
                  return ts_set_expr_type(ts, node_idx, exp_ti)
                Option::None:
                  let vsp: Span = ts_tok_span(ts, variant_tidx)
                  return ts_add_diag(ts, vsp, "'" + variant_name + "' is not a variant of enum '" + second_name + "'")
            TypeKind::TStruct:
              let sp: Span = ts_tok_span(ts, segs.get(2))
              return ts_add_diag(ts, sp, "associated items on imported types are not supported in this release (Task 28)")
      let sp: Span = ts_tok_span(ts, segs.get(2))
      return ts_add_diag(ts, sp, "nested module access not supported in this release")
    // Two-segment: mod::name
    let exported_sym: i64 = tc_export_lookup(ts, target_mid, second_name)
    if exported_sym < 0:
      let mod_name: string = ts_tok_name(ts, first_tidx)
      let sp: Span = ts_tok_span(ts, second_tidx)
      return ts_add_diag(ts, sp, "no exported symbol '" + second_name + "' in module '" + mod_name + "'")
    let exp_ti: i64 = sym_type_at(ts, exported_sym)
    if exp_ti >= 0:
      return ts_set_expr_type(ts, node_idx, exp_ti)
    return ts
  // Non-module first segment: a type's own namespace.  A two-segment
  // name whose head is an enum is a variant access, `Enum::Variant`; the
  // variant must exist, as for `mod::Enum::Variant` above.  A value's
  // name (`c::make` with `c` a parameter) is no namespace: the host
  // reaches a type's members through the type, never through a value.
  if symbol_kind_name(ts.tc.symbols.get(sym_idx).kind) != "Type":
    return ts_add_diag(ts, ts_tok_span(ts, first_tidx), "'" + ts_tok_name(ts, first_tidx) + "' is a value, not a type: '" + ts_tok_name(ts, first_tidx) + "::…' names nothing")
  let ti: i64 = sym_type_at(ts, sym_idx)
  if ti < 0:
    return ts
  if segs.length() == 2:
    let head_type: DaoType = ts.types.get(ti)
    match head_type.kind:
      TypeKind::TEnum:
        let variant_tidx: i64 = segs.get(1)
        let variant_name: string = ts_tok_name(ts, variant_tidx)
        let vkey: string = i64_to_string(ti) + ":" + variant_name
        let known: Option<i64> = ts.reg.variant_set.get(vkey)
        match known:
          Option::Some(v):
            return ts_set_expr_type(ts, node_idx, ti)
          Option::None:
            let vsp: Span = ts_tok_span(ts, variant_tidx)
            return ts_add_diag(ts, vsp, "'" + variant_name + "' is not a variant of enum '" + head_type.name + "'")
    // `Type::method` is a static/factory method reference when the type
    // declares a method of that name (mangled `Type.method`): e.g.
    // `Builder::new()`, `Vector<T>::new()`.  Type the qualified name as
    // the method's function type so the call checks against the method
    // signature and yields its return type, rather than reading as
    // zero-argument construction of the type.  The method must belong to
    // the resolved type, not a same-named type further out: a module's
    // own `Box` shadows the prelude's, so `Box::make` must miss the
    // prelude's method when the local `Box` declares none (the host
    // resolver binds `Type::method` only where the method's module
    // matches the type's — resolve.cpp).
    let member_name: string = ts_tok_name(ts, segs.get(1))
    let msym: i64 = find_inherent_method_sym(ts.reg.methods, member_name, ti)
    if msym >= 0:
      let mti: i64 = sym_type_at(ts, msym)
      if mti >= 0:
        return ts_set_expr_type(ts, node_idx, mti)
    // Neither a variant nor a method of the type: the member does not
    // exist, and the name is not the type itself.
    return ts_add_diag(ts, ts_tok_span(ts, segs.get(1)), "no member '" + member_name + "' on type " + type_name(ts, ti))
  return ts_set_expr_type(ts, node_idx, ti)

fn get_expr_type(ts: TS, node_idx: i64): i64
  let key: string = expr_id_key(ts.tc.module_id, node_idx)
  let found: Option<i64> = ts.reg.expr_types.get(key)
  match found:
    Option::Some(ti):
      return ti
    Option::None:
      return to_i64(-1)

// An integer literal defaults to i32 but adopts a concrete integer
// context, and a float literal a concrete float context — the host's
// contextual literal fitting (`check_int_literal` / `check_float_literal`).
// Refit `node` to `expected` when `node` is such a literal and
// `expected` is the matching concrete kind; return the type `node`
// should carry.  Non-literal operands are never coerced (the numeric
// contract forbids implicit width coercion between named integers).
fn fit_literal(ts: TS, node_idx: i64, expected_ti: i64): TS
  if expected_ti < 0:
    return ts
  match ts.tc.nodes.get(node_idx):
    Node::IntLitE(tidx):
      if is_integer(ts, expected_ti):
        return ts_set_expr_type(ts, node_idx, expected_ti)
    Node::FloatLitE(tidx):
      if is_float(ts, expected_ti):
        return ts_set_expr_type(ts, node_idx, expected_ti)
    Node::UnaryE(op_tidx, operand):
      // A unary +/- over a numeric literal (`-1`) is still a literal for
      // fitting: adopt the context on the operand and the unary node.
      match ts.tc.nodes.get(operand):
        Node::IntLitE(t2):
          if is_integer(ts, expected_ti):
            let ri: TS = ts_set_expr_type(ts, operand, expected_ti)
            return ts_set_expr_type(ri, node_idx, expected_ti)
        Node::FloatLitE(t2):
          if is_float(ts, expected_ti):
            let rf: TS = ts_set_expr_type(ts, operand, expected_ti)
            return ts_set_expr_type(rf, node_idx, expected_ti)
  return ts

fn is_literal_node(ts: TS, node_idx: i64): bool
  match ts.tc.nodes.get(node_idx):
    Node::IntLitE(tidx):
      return true
    Node::FloatLitE(tidx):
      return true
    Node::UnaryE(op_tidx, operand):
      match ts.tc.nodes.get(operand):
        Node::IntLitE(t2):
          return true
        Node::FloatLitE(t2):
          return true
  return false

fn check_binary_expr(ts: TS, node_idx: i64, op_tidx: i64, left: i64, right: i64): TS
  let r: TS = check_expr(ts, left)
  r = check_expr(r, right)
  let lt: i64 = get_expr_type(r, left)
  let rt: i64 = get_expr_type(r, right)
  // Contextual literal fitting: a literal operand adopts a concrete
  // numeric peer's type (host `check_binary`), so `n + 1` with `n: i64`
  // is `i64 + i64`.  Only a literal side moves; two named integers of
  // different width still mismatch.
  if is_literal_node(r, left):
    if is_literal_node(r, right) == false:
      if is_numeric(r, rt):
        r = fit_literal(r, left, rt)
        lt = get_expr_type(r, left)
  else:
    if is_literal_node(r, right):
      if is_numeric(r, lt):
        r = fit_literal(r, right, lt)
        rt = get_expr_type(r, right)
  let op_tok: Token = r.tc.toks.get(op_tidx)
  let op_name_str: string = tk_name(op_tok.kind)
  if op_name_str == "Plus":
    if is_string_type(r, lt):
      if is_string_type(r, rt):
        return ts_set_expr_type(r, node_idx, to_i64(12))
    if lt >= 0:
      if rt >= 0:
        if is_numeric(r, lt):
          if is_numeric(r, rt):
            if types_equal(r, lt, rt):
              return ts_set_expr_type(r, node_idx, lt)
            else:
              let sp: Span = ts_tok_span(r, op_tidx)
              r = ts_add_diag(r, sp, "type mismatch in '+': " + type_name(r, lt) + " vs " + type_name(r, rt))
              return r
          else:
            let sp: Span = ts_tok_span(r, op_tidx)
            r = ts_add_diag(r, sp, "'+' requires numeric operands, got " + type_name(r, lt) + " and " + type_name(r, rt))
            return r
    return ts_set_expr_type(r, node_idx, lt)
  if op_name_str == "Minus":
    return check_arith_binop(r, node_idx, op_tidx, lt, rt, "-")
  if op_name_str == "Star":
    return check_arith_binop(r, node_idx, op_tidx, lt, rt, "*")
  if op_name_str == "Slash":
    return check_arith_binop(r, node_idx, op_tidx, lt, rt, "/")
  if op_name_str == "Percent":
    return check_arith_binop(r, node_idx, op_tidx, lt, rt, "%")
  if op_name_str == "Lt":
    return check_compare_binop(r, node_idx, op_tidx, lt, rt, "<")
  if op_name_str == "LtEq":
    return check_compare_binop(r, node_idx, op_tidx, lt, rt, "<=")
  if op_name_str == "Gt":
    return check_compare_binop(r, node_idx, op_tidx, lt, rt, ">")
  if op_name_str == "GtEq":
    return check_compare_binop(r, node_idx, op_tidx, lt, rt, ">=")
  if op_name_str == "EqEq":
    return check_equality_binop(r, node_idx, op_tidx, lt, rt, "==")
  if op_name_str == "BangEq":
    return check_equality_binop(r, node_idx, op_tidx, lt, rt, "!=")
  if op_name_str == "KwAnd":
    return check_logical_binop(r, node_idx, op_tidx, lt, rt, "and")
  if op_name_str == "KwOr":
    return check_logical_binop(r, node_idx, op_tidx, lt, rt, "or")
  return ts_set_expr_type(r, node_idx, lt)

fn check_arith_binop(ts: TS, node_idx: i64, op_tidx: i64, lt: i64, rt: i64, op_str: string): TS
  if lt >= 0:
    if rt >= 0:
      if is_numeric(ts, lt):
        if is_numeric(ts, rt):
          if types_equal(ts, lt, rt):
            return ts_set_expr_type(ts, node_idx, lt)
          else:
            let sp: Span = ts_tok_span(ts, op_tidx)
            return ts_add_diag(ts, sp, "type mismatch in '" + op_str + "': " + type_name(ts, lt) + " vs " + type_name(ts, rt))
        else:
          let sp: Span = ts_tok_span(ts, op_tidx)
          return ts_add_diag(ts, sp, "'" + op_str + "' requires numeric operands")
  return ts_set_expr_type(ts, node_idx, lt)

fn check_compare_binop(ts: TS, node_idx: i64, op_tidx: i64, lt: i64, rt: i64, op_str: string): TS
  if lt >= 0:
    if rt >= 0:
      if is_numeric(ts, lt):
        if is_numeric(ts, rt):
          if types_equal(ts, lt, rt):
            return ts_set_expr_type(ts, node_idx, to_i64(10))
          else:
            let sp: Span = ts_tok_span(ts, op_tidx)
            return ts_add_diag(ts, sp, "type mismatch in '" + op_str + "': " + type_name(ts, lt) + " vs " + type_name(ts, rt))
        else:
          let sp: Span = ts_tok_span(ts, op_tidx)
          return ts_add_diag(ts, sp, "'" + op_str + "' requires numeric operands")
  return ts_set_expr_type(ts, node_idx, to_i64(10))

fn check_equality_binop(ts: TS, node_idx: i64, op_tidx: i64, lt: i64, rt: i64, op_str: string): TS
  if lt >= 0:
    if rt >= 0:
      if types_equal(ts, lt, rt):
        return ts_set_expr_type(ts, node_idx, to_i64(10))
      else:
        let sp: Span = ts_tok_span(ts, op_tidx)
        return ts_add_diag(ts, sp, "type mismatch in '" + op_str + "': " + type_name(ts, lt) + " vs " + type_name(ts, rt))
  return ts_set_expr_type(ts, node_idx, to_i64(10))

fn check_logical_binop(ts: TS, node_idx: i64, op_tidx: i64, lt: i64, rt: i64, op_str: string): TS
  if lt >= 0:
    if is_bool_type(ts, lt) == false:
      let sp: Span = ts_tok_span(ts, op_tidx)
      return ts_add_diag(ts, sp, "'" + op_str + "' requires bool operands, got " + type_name(ts, lt))
  if rt >= 0:
    if is_bool_type(ts, rt) == false:
      let sp: Span = ts_tok_span(ts, op_tidx)
      return ts_add_diag(ts, sp, "'" + op_str + "' requires bool operands, got " + type_name(ts, rt))
  return ts_set_expr_type(ts, node_idx, to_i64(10))

// Find an existing TPointer type whose pointee matches, or create a
// new one.  Deduping is required so that `let p: Ptr<i32> = Ptr<i32>::new()` sees the
// same type index on both sides of the assignment (the type
// annotation resolves to the canonical pointer type via
// resolve_ast_type, and addr-of must return the same index).
fn find_or_add_pointer_type(ts: TS, pointee_ti: i64): TypeR
  let i: i64 = 0
  while i < ts.types.length():
    let t: DaoType = ts.types.get(i)
    match t.kind:
      TypeKind::TPointer:
        if t.pointee == pointee_ti:
          return TypeR(ts, i)
    i = i + 1
  // A pointer is named as it is written (ADR_RAW_POINTER_SURFACE.md),
  // so a diagnostic says `Ptr<i32>` where the source said `Ptr<i32>`.
  let ptr_name: string = "Ptr<" + spell_type(ts, pointee_ti, spelling_depth() - 1) + ">"
  return ts_add_type(ts, DaoType(TypeKind::TPointer, to_i64(-1), ptr_name, to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), pointee_ti))

// The generator type yielding `elem_ti`: one per element type, found in
// constant time through the registry's generator index.  An unresolved
// element (-1) still makes a generator, so the function stays a
// generator body; its element compares as unknown (types_equal).
fn find_or_add_generator_type(ts: TS, elem_ti: i64): TypeR
  let key: string = i64_to_string(elem_ti)
  let known: i64 = hm_get_or(ts.reg.made.generators, key, to_i64(-1))
  if known >= 0:
    return TypeR(ts, known)
  let tr: TypeR = ts_add_type(ts, generator_type(elem_ti, "Generator<" + spell_type(ts, elem_ti, spelling_depth() - 1) + ">"))
  let r: TS = tr.ts
  r.reg = reg_with_generators(r.reg, r.reg.made.generators.set(key, tr.type_idx))
  return TypeR(r, tr.type_idx)

// A generator type: its element type in `pointee`.
fn generator_type(elem_ti: i64, name: string): DaoType
  return DaoType(TypeKind::TGenerator, to_i64(-1), name, to_i64(-1), to_i64(-1), to_i64(0), to_i64(-1), elem_ti)

// True if the AST node is an lvalue: identifier, field access, or
// index expression — what an assignment may target.
fn is_lvalue_expr(ts: TS, node_idx: i64): bool
  if node_idx < 0:
    return false
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::IdentE(t):
      return true
    Node::FieldE(o, f):
      return true
    Node::IndexE(o, i):
      return true
  return false

fn check_unary_expr(ts: TS, node_idx: i64, op_tidx: i64, operand: i64): TS
  let r: TS = check_expr(ts, operand)
  let ot: i64 = get_expr_type(r, operand)
  let op_tok: Token = r.tc.toks.get(op_tidx)
  let op_name_str: string = tk_name(op_tok.kind)
  if op_name_str == "Minus":
    if ot >= 0:
      if is_numeric(r, ot):
        return ts_set_expr_type(r, node_idx, ot)
      else:
        let sp: Span = ts_tok_span(r, op_tidx)
        r = ts_add_diag(r, sp, "unary '-' requires numeric operand, got " + type_name(r, ot))
        return r
    return ts_set_expr_type(r, node_idx, ot)
  if op_name_str == "Bang":
    if ot >= 0:
      if is_bool_type(r, ot):
        return ts_set_expr_type(r, node_idx, to_i64(10))
      else:
        let sp: Span = ts_tok_span(r, op_tidx)
        r = ts_add_diag(r, sp, "'not' requires bool operand, got " + type_name(r, ot))
        return r
    return ts_set_expr_type(r, node_idx, to_i64(10))
  return ts_set_expr_type(r, node_idx, ot)

/// The type arguments written at a call, or none: the parser leaves
/// `targs_lp` at -1 where a call was written without them, and reading
/// a list at -1 reads off the front of the index data.
fn read_type_args(ts: TS, targs_lp: i64): Vector<i64>
  if targs_lp < 0:
    return Vector<i64>::new()
  return read_list(ts.tc.idx_data, targs_lp)

/// Whether a call names an operation of `Ptr<T>`, with its receiver
/// checked where it has one — the receiver's type is what says so, and
/// the call is typed from it rather than from a member lookup.
class PtrShape:
  ts: TS
  names_one: bool

fn ptr_call_shape(ts: TS, callee: i64): PtrShape
  let callee_node: Node = ts.tc.nodes.get(callee)
  match callee_node:
    Node::FieldE(obj, field_tidx):
      let r: TS = check_expr(ts, obj)
      let obj_ti: i64 = get_expr_type(r, obj)
      if obj_ti < 0:
        return PtrShape(r, false)
      if obj_ti >= r.types.length():
        return PtrShape(r, false)
      match r.types.get(obj_ti).kind:
        TypeKind::TPointer:
          return PtrShape(r, true)
      return PtrShape(r, false)
    Node::QualNameE(seg_lp, seg_count):
      let segs: Vector<i64> = read_list(ts.tc.idx_data, seg_lp)
      if segs.length() != 2:
        return PtrShape(ts, false)
      if ts_tok_name(ts, segs.get(0)) == "Ptr":
        return PtrShape(ts, true)
      return PtrShape(ts, false)
  return PtrShape(ts, false)

// The operations of the compiler-standard `Ptr<T>`
// (ADR_RAW_POINTER_SURFACE.md): a pointer is read with `get`, written
// with `set`, walked with `offset`, retyped with `cast<U>`, and asked
// `is_null`.  Those are its whole surface — nothing reads or writes a
// pointer without naming one — so they are typed here rather than
// looked up as methods of a declared type.
class PtrCallR:
  ts: TS
  handled: bool

fn check_ptr_method_call(ts: TS, node_idx: i64, callee: i64, args: Vector<i64>, targs_lp: i64): PtrCallR
  let unhandled: PtrCallR = PtrCallR(ts, false)
  let callee_node: Node = ts.tc.nodes.get(callee)
  match callee_node:
    Node::FieldE(obj, field_tidx):
      let obj_ti: i64 = get_expr_type(ts, obj)
      if obj_ti < 0:
        return unhandled
      if obj_ti >= ts.types.length():
        return unhandled
      let obj_type: DaoType = ts.types.get(obj_ti)
      match obj_type.kind:
        TypeKind::TPointer:
          let name: string = ts_tok_name(ts, field_tidx)
          let sp: Span = ts_tok_span(ts, field_tidx)
          let targs: Vector<i64> = read_type_args(ts, targs_lp)
          // Reading, writing and walking a pointer touch memory, so
          // each needs an enclosing `mode unsafe =>` (host
          // `check_ptr_method`); making one, asking `is_null` and
          // casting touch none.
          if name == "get" or name == "set" or name == "offset":
            if ts.ctx.unsafe_depth == 0:
              return PtrCallR(ts_add_diag(ts, sp, "Ptr." + name + " requires 'mode unsafe =>'"), true)
          if name == "get":
            if args.length() != 0:
              return PtrCallR(ts_add_diag(ts, sp, "Ptr.get takes no arguments"), true)
            return PtrCallR(ts_set_expr_type(ts, node_idx, obj_type.pointee), true)
          if name == "is_null":
            if args.length() != 0:
              return PtrCallR(ts_add_diag(ts, sp, "Ptr.is_null takes no arguments"), true)
            return PtrCallR(ts_set_expr_type(ts, node_idx, to_i64(10)), true)
          if name == "set":
            if args.length() != 1:
              return PtrCallR(ts_add_diag(ts, sp, "Ptr.set takes one argument, the value written"), true)
            let value_ti: i64 = get_expr_type(ts, args.get(0))
            let r_set: TS = fit_literal(ts, args.get(0), obj_type.pointee)
            let fitted_ti: i64 = get_expr_type(r_set, args.get(0))
            if fitted_ti >= 0:
              if types_equal(r_set, obj_type.pointee, fitted_ti) == false:
                return PtrCallR(ts_add_diag(r_set, sp, "Ptr.set writes " + type_name(r_set, obj_type.pointee) + ", got " + type_name(r_set, fitted_ti)), true)
            return PtrCallR(ts_set_expr_type(r_set, node_idx, to_i64(11)), true)
          if name == "offset":
            if args.length() != 1:
              return PtrCallR(ts_add_diag(ts, sp, "Ptr.offset takes one argument, how many elements to walk"), true)
            let r_off: TS = fit_literal(ts, args.get(0), to_i64(3))
            let count_ti: i64 = get_expr_type(r_off, args.get(0))
            if count_ti >= 0:
              if is_integer(r_off, count_ti) == false:
                return PtrCallR(ts_add_diag(r_off, sp, "Ptr.offset walks a whole number of elements, got " + type_name(r_off, count_ti)), true)
            return PtrCallR(ts_set_expr_type(r_off, node_idx, obj_ti), true)
          if name == "cast":
            if args.length() != 0:
              return PtrCallR(ts_add_diag(ts, sp, "Ptr.cast takes no arguments, only the type cast to"), true)
            if targs.length() != 1:
              return PtrCallR(ts_add_diag(ts, sp, "Ptr.cast is written with the type cast to, as `cast<T>()`"), true)
            let target_r: TypeR = resolve_ast_type(ts, targs.get(0))
            if target_r.type_idx < 0:
              return PtrCallR(target_r.ts, true)
            let cast_r: TypeR = find_or_add_pointer_type(target_r.ts, target_r.type_idx)
            return PtrCallR(ts_set_expr_type(cast_r.ts, node_idx, cast_r.type_idx), true)
          return PtrCallR(ts_add_diag(ts, sp, "no operation '" + name + "' on " + type_name(ts, obj_ti) + "; a pointer has get, set, offset, cast and is_null"), true)
      return unhandled
    Node::QualNameE(seg_lp, seg_count):
      // `Ptr<T>::new()`: the one way to make a pointer, and the only
      // static of the compiler-standard pointer.
      let segs: Vector<i64> = read_list(ts.tc.idx_data, seg_lp)
      if segs.length() != 2:
        return unhandled
      if ts_tok_name(ts, segs.get(0)) != "Ptr":
        return unhandled
      let member: string = ts_tok_name(ts, segs.get(1))
      let nsp: Span = ts_tok_span(ts, segs.get(1))
      if member != "new":
        return PtrCallR(ts_add_diag(ts, nsp, "no static '" + member + "' on Ptr; a pointer is made by Ptr<T>::new()"), true)
      if args.length() != 0:
        return PtrCallR(ts_add_diag(ts, nsp, "Ptr.new takes no arguments"), true)
      let ntargs: Vector<i64> = read_type_args(ts, targs_lp)
      if ntargs.length() != 1:
        return PtrCallR(ts_add_diag(ts, nsp, "Ptr.new is written with the type pointed to, as `Ptr<T>::new()`"), true)
      let pointee_r: TypeR = resolve_ast_type(ts, ntargs.get(0))
      if pointee_r.type_idx < 0:
        return PtrCallR(pointee_r.ts, true)
      let new_r: TypeR = find_or_add_pointer_type(pointee_r.ts, pointee_r.type_idx)
      return PtrCallR(ts_set_expr_type(new_r.ts, node_idx, new_r.type_idx), true)
  return unhandled

// =========================================================================
// Section 46: Generic call inference and substitution
//
// A call decides the type parameters its callee declares: `identity(5)`
// answers `T` with `i32`, and the result is what the signature says of
// that answer.  What a call decides is held by the parameter's own type
// index, so two parameters that print alike stay apart.
// =========================================================================

/// What a call's arguments have decided, carried with the state they
/// were read from.
class Bound:
  ts: TS
  map: HashMap<i64>

/// Bind what one argument decides: a parameter matched against a type
/// IS that type, and the same parameter matched twice against two types
/// is a conflict, reported where the second argument disagrees (host
/// `infer_type_bindings`).  A match walks into what a type holds, so
/// `Ptr<T>` against `Ptr<i32>` decides `T`.
fn infer_bindings(ts: TS, map: HashMap<i64>, pattern_ti: i64, concrete_ti: i64, span: Span, own: Vector<i64>): Bound
  if pattern_ti < 0:
    return Bound(ts, map)
  if concrete_ti < 0:
    return Bound(ts, map)
  if pattern_ti >= ts.types.length():
    return Bound(ts, map)
  if concrete_ti >= ts.types.length():
    return Bound(ts, map)
  let pt: DaoType = ts.types.get(pattern_ti)
  let ct: DaoType = ts.types.get(concrete_ti)
  match pt.kind:
    TypeKind::TGenericParam:
      // A parameter the callee does not declare is fixed: it names the
      // one type it stands for, whatever sits at its position.
      if decides_param(own, pattern_ti) == false:
        return Bound(ts, map)
      let key: string = i64_to_string(pattern_ti)
      let bound: i64 = hm_get_or(map, key, to_i64(-1))
      if bound < 0:
        return Bound(ts, map.set(key, concrete_ti))
      if types_equal(ts, bound, concrete_ti):
        return Bound(ts, map)
      return Bound(ts_add_diag(ts, span, "conflicting types for generic parameter '" + pt.name + "': " + type_name(ts, bound) + " vs " + type_name(ts, concrete_ti)), map)
    TypeKind::TPointer:
      match ct.kind:
        TypeKind::TPointer:
          return infer_bindings(ts, map, pt.pointee, ct.pointee, span, own)
      return Bound(ts, map)
    TypeKind::TGenerator:
      match ct.kind:
        TypeKind::TGenerator:
          return infer_bindings(ts, map, pt.pointee, ct.pointee, span, own)
      return Bound(ts, map)
    TypeKind::TStruct:
      // `Box<T>` against `Box<i32>` decides `T`: two instantiations of
      // one declaration are matched argument by argument.
      match ct.kind:
        TypeKind::TStruct:
          if pt.decl_node != ct.decl_node:
            return Bound(ts, map)
          if ct.ret_type < 0:
            return Bound(ts, map)
          // A head as the pattern stands for its own parameters:
          // `Node<T>` written inside `class Node<T>` against a
          // `Node<i32>` decides `T`.
          let p_args: ParamIds = ParamIds(ts, stands_for_args(ts, pt.ret_type))
          if pt.ret_type < 0:
            p_args = head_params(ts, pt)
          let c_args: Vector<i64> = stands_for_args(p_args.ts, ct.ret_type)
          if p_args.ids.length() != c_args.length():
            return Bound(p_args.ts, map)
          let walked: Bound = Bound(p_args.ts, map)
          let wi: i64 = 0
          while wi < c_args.length():
            walked = infer_bindings(walked.ts, walked.map, p_args.ids.get(wi), c_args.get(wi), span, own)
            wi = wi + 1
          return walked
      return Bound(ts, map)
  return Bound(ts, map)

/// `ti` with what the call decided in place of the parameters it
/// decided.  A type holding nothing decided is itself, so a signature
/// that mentions no parameter is read unchanged.  A type graph shares
/// its parts, so within one substitution each type is rewritten once
/// (`Subst.done`).
fn substitute_type(ts: TS, map: HashMap<i64>, ti: i64): TypeR
  let done: Subst = substitute_once(ts, map, ti, HashMap<i64>::new())
  return TypeR(done.ts, done.type_idx)

/// One substitution in progress: the tables, the result for the type
/// asked about, and the results so far by type index.
class Subst:
  ts: TS
  type_idx: i64
  done: HashMap<i64>

fn substitute_once(ts: TS, map: HashMap<i64>, ti: i64, done: HashMap<i64>): Subst
  if ti < 0:
    return Subst(ts, ti, done)
  if ti >= ts.types.length():
    return Subst(ts, ti, done)
  // `map` takes a type index to what stands in for it: a parameter a
  // call decided, or a concept's own name in its signatures, which
  // means the conforming type (concept_method_sig).
  let standing_in: i64 = hm_get_or(map, i64_to_string(ti), to_i64(-1))
  if standing_in >= 0:
    return Subst(ts, standing_in, done)
  let key: string = i64_to_string(ti)
  let already: i64 = hm_get_or(done, key, to_i64(-2))
  if already != to_i64(-2):
    return Subst(ts, already, done)
  let t: DaoType = ts.types.get(ti)
  match t.kind:
    TypeKind::TPointer:
      let inner: Subst = substitute_once(ts, map, t.pointee, done)
      if inner.type_idx == t.pointee:
        return Subst(inner.ts, ti, inner.done.set(key, ti))
      let ptr: TypeR = find_or_add_pointer_type(inner.ts, inner.type_idx)
      return Subst(ptr.ts, ptr.type_idx, inner.done.set(key, ptr.type_idx))
    TypeKind::TGenerator:
      let elem: Subst = substitute_once(ts, map, t.pointee, done)
      if elem.type_idx == t.pointee:
        return Subst(elem.ts, ti, elem.done.set(key, ti))
      let gen: TypeR = find_or_add_generator_type(elem.ts, elem.type_idx)
      return Subst(gen.ts, gen.type_idx, elem.done.set(key, gen.type_idx))
    TypeKind::TStruct:
      // An instantiation stands for a head and what it was given, so it
      // is rebuilt from arguments the call decided: `Box<T>` becomes
      // `Box<i32>`.  A head stands for its own parameters
      // (record_own_params) — `Box<T>` written inside `class Box<T>` IS
      // the head — so it is rebuilt the same way once one of them is
      // decided; a class without parameters is itself.
      if t.ret_type < 0:
        return Subst(ts, ti, done)
      if t.ret_type + 1 >= ts.type_info.length():
        return Subst(ts, ti, done)
      let head_ti: i64 = ts.type_info.get(t.ret_type)
      let arg_count: i64 = ts.type_info.get(t.ret_type + 1)
      let moved: bool = false
      let new_args: Vector<i64> = Vector<i64>::new()
      let r_args: Subst = Subst(ts, ti, done)
      let si: i64 = 0
      while si < arg_count:
        let old_arg: i64 = r_args.ts.type_info.get(t.ret_type + 2 + si)
        r_args = substitute_once(r_args.ts, map, old_arg, r_args.done)
        if r_args.type_idx != old_arg:
          moved = true
        new_args = new_args.push(r_args.type_idx)
        si = si + 1
      if moved == false:
        return Subst(r_args.ts, ti, r_args.done.set(key, ti))
      // A rebuild this module cannot make is unresolved, never the type
      // that was standing there: `Box<T>` after a call decided `T` is
      // no answer, and an unresolved type reports no mismatch it cannot
      // justify (the program-level pass owns a foreign head's layout).
      let rebuilt: TypeR = instantiate_generic(r_args.ts, head_ti, new_args)
      if rebuilt.type_idx < 0:
        return Subst(rebuilt.ts, to_i64(-1), r_args.done.set(key, to_i64(-1)))
      return Subst(rebuilt.ts, rebuilt.type_idx, r_args.done.set(key, rebuilt.type_idx))
  return Subst(ts, ti, done)

/// Whether `ti` is a generic class head itself — standing for its own
/// parameters — rather than an instantiation of one (which an alias
/// such as `type IntBox = Box<i32>` names).
fn is_generic_head(ts: TS, ti: i64): bool
  if ti < 0:
    return false
  if ti >= ts.types.length():
    return false
  let t: DaoType = ts.types.get(ti)
  match t.kind:
    TypeKind::TStruct:
      if t.ret_type >= 0 and t.ret_type < ts.type_info.length():
        return ts.type_info.get(t.ret_type) == ti
  return false

/// The parameters a class head stands for, by type index, from the
/// record its type carries (record_own_params) — readable from any
/// module; none for a class without parameters.
fn head_params(ts: TS, head: DaoType): ParamIds
  match head.kind:
    TypeKind::TStruct:
      return ParamIds(ts, stands_for_args(ts, head.ret_type))
  return ParamIds(ts, Vector<i64>::new())

/// The type parameters a declaration declares, by the type index its
/// own body mentions each one by, in order.  A parameter the resolver
/// never bound has no type index, and the list is empty rather than
/// short, so nothing is instantiated against a partial mapping.
class ParamIds:
  ts: TS
  ids: Vector<i64>

fn decl_param_type_ids(ts: TS, tparams_lp: i64): ParamIds
  let none: Vector<i64> = Vector<i64>::new()
  if tparams_lp < 0:
    return ParamIds(ts, none)
  let r: TS = ts
  let tparams: Vector<i64> = read_list(r.tc.idx_data, tparams_lp)
  let ids: Vector<i64> = Vector<i64>::new()
  let i: i64 = 0
  while i < tparams.length():
    let tp_node: Node = r.tc.nodes.get(tparams.get(i))
    match tp_node:
      Node::GenericParamT(tidx, bounds_lp):
        let tsym: i64 = lookup_use(r, tidx)
        if tsym < 0:
          return ParamIds(r, none)
        let gtr: TypeR = generic_param_type(r, tsym, ts_tok_name(r, tidx))
        r = gtr.ts
        ids = ids.push(gtr.type_idx)
    i = i + 1
  if ids.length() != tparams.length():
    return ParamIds(r, none)
  return ParamIds(r, ids)

/// The type parameter list of the declaration a nominal type was
/// declared by, or -1 where it declares none.
fn decl_tparams_lp(ts: TS, decl_idx: i64): i64
  if decl_idx < 0:
    return to_i64(-1)
  if decl_idx >= ts.tc.nodes.length():
    return to_i64(-1)
  match ts.tc.nodes.get(decl_idx):
    Node::ClassDeclD(name_tidx, tparams_lp, fields_lp, methods_lp):
      return tparams_lp
    Node::EnumDeclD(name_tidx, tparams_lp, variants_lp):
      return tparams_lp
  return to_i64(-1)

/// How an instantiation is spelled: the head's name with what it stands
/// for, so `Box<i32>` reads in a diagnostic as it was written.
fn instantiation_name(ts: TS, head_name: string, args: Vector<i64>): string
  return head_name + "<" + spell_args(ts, args, spelling_depth() - 1) + ">"

/// A type spelled to `budget` levels; past them an argument, pointee or
/// element reads `…`.  A spelling is a few tokens however deep the type:
/// a chain of constructions shares its types at every level, and would
/// otherwise double its spelling each time.  Identity is by type index
/// (instantiation_key), never by spelling.
fn spell_type(ts: TS, ti: i64, budget: i64): string
  if ti < 0:
    return "<unknown>"
  if ti >= ts.types.length():
    return "<unknown>"
  if budget <= 0:
    return "…"
  let t: DaoType = ts.types.get(ti)
  match t.kind:
    TypeKind::TPointer:
      return "Ptr<" + spell_type(ts, t.pointee, budget - 1) + ">"
    TypeKind::TGenerator:
      return "Generator<" + spell_type(ts, t.pointee, budget - 1) + ">"
    TypeKind::TStruct:
      if t.ret_type >= 0:
        let head_ti: i64 = ts.type_info.get(t.ret_type)
        if head_ti != ti:
          return ts.types.get(head_ti).name + "<" + spell_args(ts, stands_for_args(ts, t.ret_type), budget - 1) + ">"
  return t.name

/// `args` spelled to `budget` levels each, comma-separated.
fn spell_args(ts: TS, args: Vector<i64>, budget: i64): string
  let spelled: string = ""
  let i: i64 = 0
  while i < args.length():
    if i > 0:
      spelled = spelled + ", "
    spelled = spelled + spell_type(ts, args.get(i), budget)
    i = i + 1
  return spelled

/// How many levels a type's stored spelling shows (spell_type).
fn spelling_depth(): i64 -> to_i64(4)

/// What a type stands for, written to `type_info` as one run: the type
/// it is an instance of, how many arguments, and the arguments — a
/// head's own parameters (an instance of itself), an instantiation's
/// head and what it was given, a function's own parameters.  Any
/// module reads the record; a declaration's AST it cannot.
fn write_stands_for(ts: TS, owner_ti: i64, args: Vector<i64>): TypeR
  let start: i64 = ts.type_info.length()
  let r: TS = ts_push_type_info(ts, owner_ti)
  r = ts_push_type_info(r, args.length())
  r = ts_push_info_run(r, args)
  return TypeR(r, start)

/// The arguments a stands-for record holds; none for -1, or for a
/// record this table does not hold.
fn stands_for_args(ts: TS, record: i64): Vector<i64>
  let args: Vector<i64> = Vector<i64>::new()
  if record < 0:
    return args
  if record + 1 >= ts.type_info.length():
    return args
  let count: i64 = ts.type_info.get(record + 1)
  if record + 2 + count > ts.type_info.length():
    return args
  let i: i64 = 0
  while i < count:
    args = args.push(ts.type_info.get(record + 2 + i))
    i = i + 1
  return args

/// A declaration's own type parameters, made and recorded on its type
/// as what the type stands for: a class head's under `ret_type`, a
/// function's under `pointee`.  A declaration with no parameters, or
/// one whose parameters the resolver never bound, records nothing.
fn record_own_params(ts: TS, ti: i64, tparams_lp: i64): TS
  let params: ParamIds = decl_param_type_ids(ts, tparams_lp)
  let r: TS = params.ts
  if params.ids.length() == 0:
    return r
  let record: TypeR = write_stands_for(r, ti, params.ids)
  r = record.ts
  let t: DaoType = r.types.get(ti)
  match t.kind:
    TypeKind::TStruct:
      t.ret_type = record.type_idx
    TypeKind::TFunction:
      t.pointee = record.type_idx
  r.types = r.types.set(ti, t)
  return r

/// The type parameter list of a callable declaration, or -1 where it
/// declares none.
fn callable_tparams_lp(ts: TS, decl_idx: i64): i64
  if decl_idx < 0:
    return to_i64(-1)
  if decl_idx >= ts.tc.nodes.length():
    return to_i64(-1)
  match ts.tc.nodes.get(decl_idx):
    Node::FnDeclD(name_tidx, tparams_lp, params_lp, ret_node, body_lp):
      return tparams_lp
    Node::ExprFnD(name_tidx, tparams_lp, params_lp, ret_node, body):
      return tparams_lp
    Node::ExternFnD(name_tidx, tparams_lp, params_lp, ret_node):
      return tparams_lp
  return to_i64(-1)

/// A type's nesting, with the tables it was read from.
class Nesting:
  ts: TS
  depth: i64

/// How deeply a type nests: a pointer or generator one more than what
/// it holds, an instantiation one more than its deepest argument, any
/// other type one.  Read once per type (MadeTypes.nesting): a type's
/// arguments never change, and a chain of constructions
/// (`Pair(v, v)` of `Pair(u, u)` of …) shares them at every level.
fn type_nesting(ts: TS, ti: i64): Nesting
  if ti < 0:
    return Nesting(ts, to_i64(0))
  if ti >= ts.types.length():
    return Nesting(ts, to_i64(0))
  let key: string = i64_to_string(ti)
  let known: i64 = hm_get_or(ts.reg.made.nesting, key, to_i64(-1))
  if known >= 0:
    return Nesting(ts, known)
  let r: TS = ts
  let depth: i64 = to_i64(1)
  let t: DaoType = r.types.get(ti)
  match t.kind:
    TypeKind::TPointer:
      let held: Nesting = type_nesting(r, t.pointee)
      r = held.ts
      depth = held.depth + 1
    TypeKind::TGenerator:
      let element: Nesting = type_nesting(r, t.pointee)
      r = element.ts
      depth = element.depth + 1
    TypeKind::TStruct:
      if t.ret_type >= 0:
        if r.type_info.get(t.ret_type) != ti:
          let deepest: Nesting = args_nesting(r, stands_for_args(r, t.ret_type))
          r = deepest.ts
          depth = deepest.depth + 1
  let made: MadeTypes = r.reg.made
  made.nesting = made.nesting.set(key, depth)
  r.reg = reg_with_made(r.reg, made)
  return Nesting(r, depth)

/// The deepest nesting among `args` (type_nesting).
fn args_nesting(ts: TS, args: Vector<i64>): Nesting
  let r: TS = ts
  let deepest: i64 = to_i64(0)
  let i: i64 = 0
  while i < args.length():
    let one: Nesting = type_nesting(r, args.get(i))
    r = one.ts
    if one.depth > deepest:
      deepest = one.depth
    i = i + 1
  return Nesting(r, deepest)

/// Whether an instantiation of `head_ti` with arguments nesting
/// `nesting` deep expands one of the same head being made (`in_progress`,
/// (head, nesting) pairs): a recursion through a type argument.
fn expands_in_progress(in_progress: Vector<i64>, head_ti: i64, nesting: i64): bool
  let i: i64 = 0
  while i < in_progress.length():
    if in_progress.get(i) == head_ti and in_progress.get(i + 1) < nesting:
      return true
    i = i + 2
  return false

/// What an instantiation IS, as a key: the head it came from and the
/// arguments it was given, by type index.  Spelling will not do — two
/// functions each declaring `T` both spell `Box<T>`, and their `T`s are
/// different parameters.
fn instantiation_key(head_ti: i64, args: Vector<i64>): string
  let key: string = "i" + i64_to_string(head_ti)
  let i: i64 = 0
  while i < args.length():
    key = key + ":" + i64_to_string(args.get(i))
    i = i + 1
  return key

/// The type parameters the CALLEE declares, by type index — the only
/// parameters a call may decide.  A parameter of the signature being
/// checked already stands for one type: deciding it here would let an
/// argument retype what that signature promised (host `GenericBinding`).
/// They are read from the record the callee's type carries
/// (record_own_params), so a prelude's `identity(5)` decides its
/// parameter as a local one does.
fn callee_own_params(ts: TS, callee: i64): ParamIds
  let none: Vector<i64> = Vector<i64>::new()
  let sym: i64 = callee_symbol(ts, callee)
  if sym < 0:
    return ParamIds(ts, none)
  let fn_ti: i64 = sym_type_at(ts, sym)
  if fn_ti < 0:
    return ParamIds(ts, none)
  let ft: DaoType = ts.types.get(fn_ti)
  match ft.kind:
    TypeKind::TFunction:
      return ParamIds(ts, stands_for_args(ts, ft.pointee))
  return ParamIds(ts, none)

/// The symbol a callee names: a plain name, a qualified path's last
/// segment, or the method a member expression selects on its receiver.
fn callee_symbol(ts: TS, callee: i64): i64
  if callee < 0:
    return to_i64(-1)
  match ts.tc.nodes.get(callee):
    Node::IdentE(tidx):
      return lookup_use(ts, tidx)
    Node::QualNameE(seg_lp, seg_count):
      let segs: Vector<i64> = read_list(ts.tc.idx_data, seg_lp)
      if segs.length() == 0:
        return to_i64(-1)
      let last: i64 = lookup_use(ts, segs.get(segs.length() - 1))
      if last >= 0:
        return last
      // `Type::method`: the resolver binds the type and leaves the
      // method to the checker, which finds it in the dispatch index as
      // the qualified name itself was typed.
      let head_ti: i64 = qualified_type_head(ts, segs)
      if head_ti < 0:
        return to_i64(-1)
      return find_inherent_method_sym(ts.reg.methods, ts_tok_name(ts, segs.get(1)), head_ti)
    Node::FieldE(obj, field_tidx):
      // A method is found by the receiver's type, the way the access
      // itself was typed, so a generic method decides its parameters
      // like any other callee.
      let obj_ti: i64 = get_expr_type(ts, obj)
      if obj_ti < 0:
        return to_i64(-1)
      return ts_method_for_receiver(ts, ts_tok_name(ts, field_tidx), obj_ti)
  return to_i64(-1)

/// What a method's receiver already decided of the method's class:
/// reached on a `Box<i32>`, the class's `T` stands for `i32` before any
/// argument is read (the host's `receiver_fixes`).  `into` gains those
/// decisions; a receiver that is no instantiation adds none.
fn receiver_decided(ts: TS, callee: i64, into: HashMap<i64>): Bound
  match ts.tc.nodes.get(callee):
    Node::FieldE(obj, field_tidx):
      return instantiation_decided(ts, get_expr_type(ts, obj), into)
  return Bound(ts, into)

/// Whether a method's receiver was instantiated with one of the
/// method's own type parameters (`own`), at any depth of its arguments
/// — the case in which the receiver decides them.
fn receiver_fixes(ts: TS, callee: i64, own: Vector<i64>): bool
  if own.length() == 0:
    return false
  match ts.tc.nodes.get(callee):
    Node::FieldE(obj, field_tidx):
      let obj_ti: i64 = get_expr_type(ts, obj)
      if obj_ti < 0:
        return false
      let t: DaoType = ts.types.get(obj_ti)
      match t.kind:
        TypeKind::TStruct:
          if t.ret_type >= 0:
            let args: Vector<i64> = stands_for_args(ts, t.ret_type)
            let i: i64 = 0
            while i < args.length():
              if type_mentions_any(ts, args.get(i), own):
                return true
              i = i + 1
  return false

/// Whether `ti` is, or holds at any depth, one of `params`.  A type
/// graph shares its parts (a chain of constructions repeats each level
/// twice), so each type is searched once (`Mention.seen`).
fn type_mentions_any(ts: TS, ti: i64, params: Vector<i64>): bool
  return mention_search(ts, ti, params, Mention(HashMap<i64>::new(), false)).found

/// Whether what `decided` maps `keys` to mentions one of `params`.
fn decided_mention_any(ts: TS, decided: HashMap<i64>, keys: Vector<i64>, params: Vector<i64>): bool
  let i: i64 = 0
  while i < keys.length():
    if type_mentions_any(ts, hm_get_or(decided, i64_to_string(keys.get(i)), to_i64(-1)), params):
      return true
    i = i + 1
  return false

/// A search for parameters through a type graph: the types searched so
/// far, and whether one was found.
class Mention:
  seen: HashMap<i64>
  found: bool

fn mention_search(ts: TS, ti: i64, params: Vector<i64>, so_far: Mention): Mention
  if so_far.found:
    return so_far
  if ti < 0:
    return so_far
  if ti >= ts.types.length():
    return so_far
  if decides_param(params, ti):
    return Mention(so_far.seen, true)
  let key: string = i64_to_string(ti)
  if so_far.seen.contains(key):
    return so_far
  let m: Mention = Mention(so_far.seen.set(key, to_i64(1)), false)
  let t: DaoType = ts.types.get(ti)
  match t.kind:
    TypeKind::TPointer:
      return mention_search(ts, t.pointee, params, m)
    TypeKind::TGenerator:
      return mention_search(ts, t.pointee, params, m)
    TypeKind::TStruct:
      if t.ret_type >= 0:
        let args: Vector<i64> = stands_for_args(ts, t.ret_type)
        let i: i64 = 0
        while i < args.length():
          m = mention_search(ts, args.get(i), params, m)
          if m.found:
            return m
          i = i + 1
  return m

/// The parameters an instantiation stands for, each mapped to the
/// argument it was given, added to `into`.
fn instantiation_decided(ts: TS, ti: i64, into: HashMap<i64>): Bound
  if ti < 0:
    return Bound(ts, into)
  if ti >= ts.types.length():
    return Bound(ts, into)
  let t: DaoType = ts.types.get(ti)
  let stands_for: i64 = to_i64(-1)
  match t.kind:
    TypeKind::TStruct:
      stands_for = t.ret_type
  if stands_for < 0:
    return Bound(ts, into)
  if stands_for + 1 >= ts.type_info.length():
    return Bound(ts, into)
  let head_ti: i64 = ts.type_info.get(stands_for)
  let arg_count: i64 = ts.type_info.get(stands_for + 1)
  let params: ParamIds = head_params(ts, ts.types.get(head_ti))
  if params.ids.length() != arg_count:
    return Bound(params.ts, into)
  let m: HashMap<i64> = into
  let i: i64 = 0
  while i < arg_count:
    m = m.set(i64_to_string(params.ids.get(i)), params.ts.type_info.get(stands_for + 2 + i))
    i = i + 1
  return Bound(params.ts, m)

/// The type a two-segment path `Type::member` is headed by, when the
/// resolver bound its first segment to a type; -1 for any other path.
fn qualified_type_head(ts: TS, segs: Vector<i64>): i64
  if segs.length() != 2:
    return to_i64(-1)
  let head_sym: i64 = lookup_use(ts, segs.get(0))
  if head_sym < 0:
    return to_i64(-1)
  if symbol_kind_name(ts.tc.symbols.get(head_sym).kind) != "Type":
    return to_i64(-1)
  return sym_type_at(ts, head_sym)

/// The class a call's type arguments may be written on — the head of
/// `Box<i32>::zero(0)`; -1 for a call written any other way.
fn type_args_head(ts: TS, callee: i64): i64
  match ts.tc.nodes.get(callee):
    Node::QualNameE(seg_lp, seg_count):
      let head_ti: i64 = qualified_type_head(ts, read_list(ts.tc.idx_data, seg_lp))
      if head_ti < 0:
        return to_i64(-1)
      match ts.types.get(head_ti).kind:
        TypeKind::TStruct:
          return head_ti
  return to_i64(-1)

/// The type arguments written at a call, decided for `params` in
/// order and added to `into`.  A count that is not the parameters' is
/// a diagnostic in the host's words, and decides nothing.
fn seed_written_type_args(ts: TS, params: Vector<i64>, written: Vector<i64>, into: HashMap<i64>, span: Span): Bound
  if written.length() != params.length():
    return Bound(ts_add_diag(ts, span, "expected " + i64_to_string(params.length()) + " type argument(s), got " + i64_to_string(written.length())), into)
  let r: TS = ts
  let m: HashMap<i64> = into
  let i: i64 = 0
  while i < written.length():
    let arg: TypeR = resolve_ast_type(r, written.get(i))
    r = arg.ts
    if arg.type_idx >= 0:
      m = m.set(i64_to_string(params.get(i)), arg.type_idx)
    i = i + 1
  return Bound(r, m)

/// Every bound of the parameters something decided, held to what they
/// were decided with: a bound is a conformance obligation, and the
/// place a parameter is decided is where the obligation is met (host
/// `verify_concept_constraints`).  A bound whose concept this module
/// cannot read is left to the program-level pass, as this module's
/// other cross-module guards leave theirs.
fn check_decided_bounds(ts: TS, decided: HashMap<i64>, own: Vector<i64>, span: Span): TS
  let r: TS = ts
  let i: i64 = 0
  while i < own.length():
    let param_ti: i64 = own.get(i)
    let with_ti: i64 = hm_get_or(decided, i64_to_string(param_ti), to_i64(-1))
    if with_ti >= 0:
      if param_ti < r.types.length():
        let pt: DaoType = r.types.get(param_ti)
        if bounds_walkable(r, pt):
          let b: i64 = 0
          while b < pt.info_count:
            let cti: i64 = r.type_info.get(pt.info_lp + b)
            if cti >= 0:
              if ts_conforms(r, with_ti, cti) == false:
                r = ts_add_diag(r, span, "type '" + type_name(r, with_ti) + "' does not satisfy concept '" + type_name(r, cti) + "' required by generic parameter '" + pt.name + "'")
            b = b + 1
    i = i + 1
  return r

/// `Box<i32>`: the class with its parameters replaced by what it was
/// instantiated with, made once per head and arguments — a second
/// `Box<i32>` is the type the first made, so the two compare equal.
///
/// The type is made as a shell — its head and arguments, its name, its
/// index — and indexed at once, so a field of `Node<T>` typed
/// `Ptr<Node<i32>>` asks for `Node<i32>` while `Node<i32>` is being
/// made and finds it.  Its layout (materialize) follows the head's:
/// now when the head's is written, otherwise at the end of the
/// module's declarations pass, by which time every layout is.
fn instantiate_generic(ts: TS, head_ti: i64, args: Vector<i64>): TypeR
  if head_ti < 0:
    return TypeR(ts, to_i64(-1))
  if head_ti >= ts.types.length():
    return TypeR(ts, to_i64(-1))
  let head: DaoType = ts.types.get(head_ti)
  let is_struct: bool = false
  match head.kind:
    TypeKind::TStruct:
      is_struct = true
  if is_struct == false:
    return TypeR(ts, to_i64(-1))
  let params: ParamIds = head_params(ts, head)
  let r: TS = params.ts
  if params.ids.length() == 0:
    return TypeR(r, to_i64(-1))
  if params.ids.length() != args.length():
    return TypeR(r, to_i64(-1))
  // `Box<T>` inside `class Box<T>` is the class itself: the arguments
  // are the parameters the declaration already stands for, and a copy
  // would be a second type with the same fields and none of the
  // methods.
  let is_the_head: bool = true
  let si: i64 = 0
  while si < args.length():
    if args.get(si) != params.ids.get(si):
      is_the_head = false
    si = si + 1
  if is_the_head:
    return TypeR(r, head_ti)
  let key: string = instantiation_key(head_ti, args)
  let known: i64 = hm_get_or(r.reg.made.instantiations, key, to_i64(-1))
  if known >= 0:
    return TypeR(r, known)
  // An instantiation of a head asked for, with deeper arguments, while
  // an instantiation of that head is being made is a recursion through
  // a type argument: `Node<T>` with a field `Ptr<Node<Ptr<T>>>` asks
  // for `Node<Ptr<i32>>` while `Node<i32>` is made, and would ask
  // without end.  Such a field stays unresolved, as the host keeps it
  // unexpanded; an instantiation with arguments no deeper (`Node<U>`
  // from `Node<V>`) is finite and made.
  let deepest: Nesting = args_nesting(r, args)
  r = deepest.ts
  if expands_in_progress(r.reg.made.in_progress, head_ti, deepest.depth):
    return TypeR(r, to_i64(-1))
  let record: TypeR = write_stands_for(r, head_ti, args)
  r = record.ts
  let shell: TypeR = ts_add_type(r, DaoType(TypeKind::TStruct, head.builtin_id, instantiation_name(r, head.name, args), head.decl_node, to_i64(-1), to_i64(0), record.type_idx, to_i64(-1)))
  r = shell.ts
  r.reg = reg_add_instantiation(r.reg, key, shell.type_idx)
  if layout_walkable(r, head):
    return TypeR(materialize(r, shell.type_idx), shell.type_idx)
  let made: MadeTypes = r.reg.made
  made.pending = made.pending.push(shell.type_idx)
  r.reg = reg_with_made(r.reg, made)
  return TypeR(r, shell.type_idx)

/// An instantiation's layout: the head's fields with the arguments in
/// place of the parameters, written as one run, and what the
/// instantiation derives.  Substituting a field can make another
/// instantiation, which appends records of its own — so every field is
/// substituted before any is written, and this instantiation is in
/// progress while they are (the recursion guard above).  One whose
/// layout is written already, or whose head's still is not, is left.
fn materialize(ts: TS, inst_ti: i64): TS
  let t: DaoType = ts.types.get(inst_ti)
  if t.info_lp >= 0:
    return ts
  let head_ti: i64 = ts.type_info.get(t.ret_type)
  let head: DaoType = ts.types.get(head_ti)
  if layout_walkable(ts, head) == false:
    return ts
  let args: Vector<i64> = stands_for_args(ts, t.ret_type)
  let params: ParamIds = head_params(ts, head)
  let r: TS = params.ts
  let decided: HashMap<i64> = HashMap<i64>::new()
  let pi: i64 = 0
  while pi < params.ids.length():
    decided = decided.set(i64_to_string(params.ids.get(pi)), args.get(pi))
    pi = pi + 1
  let deepest: Nesting = args_nesting(r, args)
  r = deepest.ts
  let outer: Vector<i64> = r.reg.made.in_progress
  r.reg = reg_with_in_progress(r.reg, outer.push(head_ti).push(deepest.depth))
  let field_types: Vector<i64> = Vector<i64>::new()
  let fi: i64 = 0
  while fi < head.info_count:
    let sub: TypeR = substitute_type(r, decided, r.type_info.get(head.info_lp + fi * 2 + 1))
    r = sub.ts
    field_types = field_types.push(sub.type_idx)
    fi = fi + 1
  r.reg = reg_with_in_progress(r.reg, outer)
  let info_start: i64 = r.type_info.length()
  let wf: i64 = 0
  while wf < head.info_count:
    r = ts_push_type_info(r, r.type_info.get(head.info_lp + wf * 2))
    r = ts_push_type_info(r, field_types.get(wf))
    wf = wf + 1
  let made: DaoType = r.types.get(inst_ti)
  made.info_lp = info_start
  made.info_count = head.info_count
  r.types = r.types.set(inst_ti, made)
  return derive_instantiation(r, inst_ti)

/// The layouts of the instantiations made before their head's layout
/// was written (`MadeTypes.pending`), once every layout of a module is:
/// an instantiation of a class declared further down, of the class
/// being filled (`Ptr<Node<i32>>` inside `class Node<T>`), or across a
/// cycle of classes.  One whose head belongs to a module not filled yet
/// stays pending; every module's declarations pass drains the list, so
/// it is empty once the pass has run over the program.  Materializing
/// one may make more, which are drained in turn.
fn materialize_pending(ts: TS): TS
  let r: TS = ts
  let pending: Vector<i64> = r.reg.made.pending
  let made: MadeTypes = r.reg.made
  made.pending = Vector<i64>::new()
  r.reg = reg_with_made(r.reg, made)
  let still: Vector<i64> = Vector<i64>::new()
  let i: i64 = 0
  while i < pending.length():
    let inst_ti: i64 = pending.get(i)
    r = materialize(r, inst_ti)
    if r.types.get(inst_ti).info_lp < 0:
      still = still.push(inst_ti)
    i = i + 1
  let after: MadeTypes = r.reg.made
  let j: i64 = 0
  while j < still.length():
    after.pending = after.pending.push(still.get(j))
    j = j + 1
  r.reg = reg_with_made(r.reg, after)
  return r

/// What an instantiation derives, as a declared class does in the
/// derivation pass: a derived concept every field conforms to — as seen
/// from the head's declaring module, which is what the pass asks, not
/// from wherever the instantiation was first made — is the
/// instantiation's, visible everywhere.  Before the pass has run, the
/// program's derived concepts are not known yet and the pass itself
/// indexes the instantiation (index_program_structs).
fn derive_instantiation(ts: TS, ti: i64): TS
  let r: TS = ts
  let t: DaoType = r.types.get(ti)
  let di: i64 = 0
  while di < r.reg.conform.derived_concepts.length():
    let dcti: i64 = r.reg.conform.derived_concepts.get(di)
    let every_field: bool = true
    let fi: i64 = 0
    while fi < t.info_count:
      let fti: i64 = r.type_info.get(t.info_lp + fi * 2 + 1)
      if fti < 0:
        every_field = false
      else:
        if reg_conforms(r.reg, fti, dcti, t.builtin_id) == false:
          every_field = false
      fi = fi + 1
    if every_field:
      r.reg = reg_record_conformance(r.reg, ti, dcti, conform_everywhere())
    di = di + 1
  return r

/// Whether `param_ti` is one of the parameters this call may decide.
fn decides_param(own: Vector<i64>, param_ti: i64): bool
  let i: i64 = 0
  while i < own.length():
    if own.get(i) == param_ti:
      return true
    i = i + 1
  return false

/// The type arguments a call was written with: the list (-1 for none)
/// and whether they were written on the type (`Box<i32>::zero(0)`)
/// rather than for the callee (`identity<string>(x)`) — the host's
/// `type_args_name_the_type`, which decides whose parameters they are.
class WrittenTypeArgs:
  list_lp: i64
  on_type: bool

fn check_call_expr(ts: TS, node_idx: i64, callee: i64, args_lp: i64, targs: WrittenTypeArgs, names_lp: i64): TS
  // A pointer's operations are the compiler's own, not a declared type's
  // methods, so a call that names one is typed here — before the callee
  // is read as a member or a symbol, which would report `get` as a
  // missing field and `Ptr` as an unknown name.
  let named_ptr: PtrShape = ptr_call_shape(ts, callee)
  let args0: Vector<i64> = read_list(named_ptr.ts.tc.idx_data, args_lp)
  if named_ptr.names_one:
    let rp: TS = named_ptr.ts
    let pi: i64 = 0
    while pi < args0.length():
      rp = check_expr(rp, args0.get(pi))
      pi = pi + 1
    let ptr_call: PtrCallR = check_ptr_method_call(rp, node_idx, callee, args0, targs.list_lp)
    if ptr_call.handled:
      return ptr_call.ts
  let r: TS = check_expr(named_ptr.ts, callee)
  let args: Vector<i64> = read_list(r.tc.idx_data, args_lp)
  let ai: i64 = 0
  while ai < args.length():
    r = check_expr(r, args.get(ai))
    ai = ai + 1
  // Try get_expr_type first; if it fails, resolve callee directly
  let callee_ti: i64 = get_expr_type(r, callee)
  if callee_ti < 0:
    // Direct callee resolution (workaround for expr_types loss through call chains)
    let callee_node: Node = r.tc.nodes.get(callee)
    match callee_node:
      Node::IdentE(ct):
        let csym: i64 = lookup_use(r, ct)
        if csym >= 0:
          callee_ti = sym_type_at(r, csym)
      Node::QualNameE(seg_lp2, seg_count2):
        let csegs: Vector<i64> = read_list(r.tc.idx_data, seg_lp2)
        if csegs.length() > 0:
          let csym: i64 = lookup_use(r, csegs.get(0))
          if csym >= 0:
            let csym_obj: Symbol = r.tc.symbols.get(csym)
            // D4: Module-qualified call (e.g. fmt::print(...))
            if symbol_kind_name(csym_obj.kind) == "Module":
              if csegs.length() >= 2:
                let fn_name: string = ts_tok_name(r, csegs.get(1))
                let exp_sym: i64 = tc_export_lookup(r, csym_obj.decl_node, fn_name)
                if exp_sym >= 0:
                  callee_ti = sym_type_at(r, exp_sym)
            else:
              callee_ti = sym_type_at(r, csym)
  if callee_ti < 0:
    return r
  if callee_ti >= r.types.length():
    return r
  let callee_type: DaoType = r.types.get(callee_ti)
  match callee_type.kind:
    TypeKind::TFunction:
      // A dot-call (`obj.m(...)`) is a method call: the method takes
      // `self` (its function type says so), and the receiver fills it.
      // A static method reached through a value is a diagnostic — it is
      // called as `Type::m(...)`, and a receiver is no argument of it.
      let is_method: bool = false
      let callee_node2: Node = r.tc.nodes.get(callee)
      match callee_node2:
        Node::FieldE(mobj, mfield):
          if callee_type.builtin_id == 1:
            is_method = true
          else:
            return ts_add_diag(r, ts_tok_span(r, mfield), "static method '" + ts_tok_name(r, mfield) + "' is called through a value; call it as " + type_name(r, get_expr_type(r, mobj)) + "::" + ts_tok_name(r, mfield) + "(...)")
        Node::QualNameE(q_lp, q_count):
          // A `::` path reaches a type's STATIC methods
          // (CONTRACT_MODULE_SYSTEM.md §6: `b::T::m(...)`).  One that
          // takes `self` is reached on a value instead, so a receiver
          // passed as an ordinary argument is a diagnostic rather than
          // a call that happens to type.
          if callee_type.builtin_id == 1:
            let q_segs: Vector<i64> = read_list(r.tc.idx_data, q_lp)
            if q_segs.length() > 0:
              let last_tidx: i64 = q_segs.get(q_segs.length() - 1)
              return ts_add_diag(r, ts_tok_span(r, last_tidx), "'" + ts_tok_name(r, last_tidx) + "' is an instance method; it is reached on a value, not through '::'")
      let param_offset: i64 = 0
      let expected_args: i64 = callee_type.info_count
      if is_method:
        param_offset = 1
        expected_args = callee_type.info_count - 1
      // A function or method takes its arguments positionally; a named
      // argument belongs to a variant construction
      // (`Enum::Variant(name = value)`, CONTRACT_SYNTAX_SURFACE.md) and
      // is diagnosed here rather than silently taken as positional.
      let names: Vector<i64> = read_list(r.tc.idx_data, names_lp)
      let ni: i64 = 0
      while ni < names.length():
        if names.get(ni) >= 0:
          return ts_add_diag(r, ts_tok_span(r, names.get(ni)), "named argument '" + ts_tok_name(r, names.get(ni)) + "' in a call: a function or method takes its arguments positionally (named arguments construct a variant)")
        ni = ni + 1
      if args.length() != expected_args:
        let sp: Span = ts_node_span(r, callee)
        r = ts_add_diag(r, sp, "arity mismatch: expected " + i64_to_string(expected_args) + " arguments, got " + i64_to_string(args.length()))
        return r
      let ci: i64 = 0
      // Parameter-type checks read the callee's param slots from this
      // module's `type_info`; a callee from a wider module (a prelude
      // function or method) may overrun it, so walk params only when they
      // are in range (fail-closed — a literal argument then keeps its
      // default type; cross-module argument typing is deferred to a later program-level pass).
      let walk_params: bool = fn_params_walkable(r, callee_type)
      // What the arguments decide about the callee's own type
      // parameters, argument by argument: whatever is decided by the
      // time a later argument is read applies to it, so the second
      // argument of `pair(1, x)` is checked against `i32`.
      let own: ParamIds = callee_own_params(r, callee)
      r = own.ts
      // What is decided before any argument is read: the class
      // parameters a receiver already stands for (`b.get()` on a
      // `Box<i32>`), and the type arguments written at the call.  The
      // written ones decide the class's parameters when written on the
      // type (`Box<i32>::zero(0)`) and the callee's own when written
      // for it (`identity<string>(x)`); what they decided no argument
      // may retype, so those parameters leave the open set.
      let decided: HashMap<i64> = HashMap<i64>::new()
      // A receiver instantiated with the method's own parameter
      // (`other: Box<U>` inside `fn bad<U>`) already says what that
      // parameter is: it is fixed for this call (the host's
      // `receiver_fixes`).
      let fixed_by_receiver: bool = false
      if is_method:
        let by_receiver: Bound = receiver_decided(r, callee, decided)
        r = by_receiver.ts
        decided = by_receiver.map
        fixed_by_receiver = receiver_fixes(r, callee, own.ids)
      let open: Vector<i64> = own.ids
      if fixed_by_receiver:
        open = Vector<i64>::new()
      let written: Vector<i64> = read_type_args(r, targs.list_lp)
      if written.length() > 0:
        if targs.on_type:
          // Written on the type (`Box<i32>::zero(0)`): the class's
          // parameters, however many it declares.  A class whose
          // parameters are not readable here takes none.
          let on_type: i64 = type_args_head(r, callee)
          if on_type >= 0:
            let cls: ParamIds = head_params(r, r.types.get(on_type))
            r = cls.ts
            let on_class: Bound = seed_written_type_args(r, cls.ids, written, decided, ts_node_span(r, callee))
            r = on_class.ts
            decided = on_class.map
            // Written WITH the callee's own parameter (`Box<U>::write(…)`
            // inside `fn write<U>`), they say what it stands for: it is
            // fixed for this call (the host's `written_args_fix_the_rest`).
            if decided_mention_any(r, on_class.map, cls.ids, own.ids):
              open = Vector<i64>::new()
        else:
          if own.ids.length() > 0:
            let on_callee: Bound = seed_written_type_args(r, own.ids, written, decided, ts_node_span(r, callee))
            r = on_callee.ts
            decided = on_callee.map
            open = Vector<i64>::new()
      while ci < args.length():
        if walk_params:
          let param_ti: i64 = r.type_info.get(callee_type.info_lp + param_offset + ci)
          let so_far: TypeR = substitute_type(r, decided, param_ti)
          r = so_far.ts
          // A literal argument adopts the parameter's concrete type (host).
          r = fit_literal(r, args.get(ci), so_far.type_idx)
          let arg_ti: i64 = get_expr_type(r, args.get(ci))
          if arg_ti >= 0:
            if param_ti >= 0:
              let asp: Span = ts_node_span(r, args.get(ci))
              if open.length() > 0:
                let bound: Bound = infer_bindings(r, decided, param_ti, arg_ti, asp, open)
                r = bound.ts
                decided = bound.map
              let expected: TypeR = substitute_type(r, decided, param_ti)
              r = expected.ts
              if types_equal(r, arg_ti, expected.type_idx) == false:
                r = ts_add_diag(r, asp, "argument type mismatch: expected " + type_name(r, expected.type_idx) + ", got " + type_name(r, arg_ti))
        ci = ci + 1
      // A bound is a conformance obligation, and what the call decided
      // is what has to meet it.
      if own.ids.length() > 0:
        r = check_decided_bounds(r, decided, own.ids, ts_node_span(r, callee))
      // The result is what the signature says of what the call decided.
      let result: TypeR = substitute_type(r, decided, callee_type.ret_type)
      return ts_set_expr_type(result.ts, node_idx, result.type_idx)
    TypeKind::TStruct:
      // A class is constructed positionally (`Point(1, 2)`); a named
      // argument constructs a variant, never a class.
      let cnames: Vector<i64> = read_list(r.tc.idx_data, names_lp)
      let cni: i64 = 0
      while cni < cnames.length():
        if cnames.get(cni) >= 0:
          return ts_add_diag(r, ts_tok_span(r, cnames.get(cni)), "named argument '" + ts_tok_name(r, cnames.get(cni)) + "' in a constructor: a class is constructed positionally (named arguments construct a variant)")
        cni = cni + 1
      if args.length() != callee_type.info_count:
        let sp: Span = ts_node_span(r, callee)
        r = ts_add_diag(r, sp, "constructor arity mismatch: expected " + i64_to_string(callee_type.info_count) + " fields, got " + i64_to_string(args.length()))
        return r
      let ci: i64 = 0
      // Field-type checks read the struct's layout from this module's
      // `type_info`; a cross-module generic head's layout may overrun it,
      // so walk fields only when the layout is in range (element typing
      // for such heads is deferred to a later program-level pass).  Arity is already checked above.
      let walk_fields: bool = layout_walkable(r, callee_type)
      // A construction decides the class's own parameters from the
      // values it is given: `Box(1)` is a `Box<i32>`.  The class's
      // parameters are the only ones it may decide — a parameter of the
      // signature doing the constructing is already the type it stands
      // for (host `check_construct`).
      let class_params: ParamIds = head_params(r, callee_type)
      r = class_params.ts
      let built: HashMap<i64> = HashMap<i64>::new()
      // Type arguments written at the construction (`Box<i64>(1)`)
      // decide the class's parameters, which no field may then retype.
      let open_params: Vector<i64> = class_params.ids
      let written_args: Vector<i64> = read_type_args(r, targs.list_lp)
      if written_args.length() > 0:
        let on_class: Bound = seed_written_type_args(r, class_params.ids, written_args, built, ts_node_span(r, callee))
        r = on_class.ts
        built = on_class.map
        open_params = Vector<i64>::new()
      while ci < args.length():
        if walk_fields:
          let field_type_idx: i64 = r.type_info.get(callee_type.info_lp + ci * 2 + 1)
          // What the fields before this one decided applies to it, so
          // the second field of `Pair(1, x)` is read as an `i32`.
          let field_now: TypeR = substitute_type(r, built, field_type_idx)
          r = field_now.ts
          r = fit_literal(r, args.get(ci), field_now.type_idx)
          let arg_ti: i64 = get_expr_type(r, args.get(ci))
          if arg_ti >= 0:
            if field_type_idx >= 0:
              let fsp: Span = ts_node_span(r, args.get(ci))
              if open_params.length() > 0:
                let field_bound: Bound = infer_bindings(r, built, field_type_idx, arg_ti, fsp, open_params)
                r = field_bound.ts
                built = field_bound.map
              let expected_field: TypeR = substitute_type(r, built, field_type_idx)
              r = expected_field.ts
              if types_equal(r, arg_ti, expected_field.type_idx) == false:
                r = ts_add_diag(r, fsp, "field type mismatch: expected " + type_name(r, expected_field.type_idx) + ", got " + type_name(r, arg_ti))
        ci = ci + 1
      // The construction IS the instantiation its values decided.  A
      // parameter no field mentions stays the parameter itself, so
      // `Tagged(1)` is a `Tagged<i32, U>` — its own type, not the class
      // it names — and a construction that decided nothing is the class
      // (instantiate_generic).  It is held to no bound: the host
      // verifies constraints where a function's parameters are decided
      // (`verify_concept_constraints`, on the callee's declaration), and
      // a class's constructor declares none.
      if class_params.ids.length() > 0:
        let built_args: Vector<i64> = Vector<i64>::new()
        let bp: i64 = 0
        while bp < class_params.ids.length():
          let class_param: i64 = class_params.ids.get(bp)
          built_args = built_args.push(hm_get_or(built, i64_to_string(class_param), class_param))
          bp = bp + 1
        let made: TypeR = instantiate_generic(r, callee_ti, built_args)
        r = made.ts
        if made.type_idx >= 0:
          return ts_set_expr_type(r, node_idx, made.type_idx)
      return ts_set_expr_type(r, node_idx, callee_ti)
    TypeKind::TEnum:
      // A variant construction, `Enum::Variant(param = value, ..)`: the
      // callee's last segment names the variant, a member of the enum's
      // namespace; its parameters come from the registry by name, so
      // this works in any module (CONTRACT_SYNTAX_SURFACE.md, enum class).
      let variant_name: string = ""
      let callee_node3: Node = r.tc.nodes.get(callee)
      match callee_node3:
        Node::QualNameE(vseg_lp, vseg_count):
          let vsegs: Vector<i64> = read_list(r.tc.idx_data, vseg_lp)
          if vsegs.length() >= 2:
            variant_name = ts_tok_name(r, vsegs.get(vsegs.length() - 1))
      if variant_name != "":
        let names: Vector<i64> = read_list(r.tc.idx_data, names_lp)
        return check_variant_construction(r, node_idx, callee, callee_ti, variant_name, args, names)
      return ts_set_expr_type(r, node_idx, callee_ti)
  return r

// The arguments of `Enum::Variant(...)` against the variant's
// parameters in the registry.  A variant without parameters is written
// bare, never called; one with parameters takes each by name, once,
// with a value of the parameter's type.  Each named argument's
// parameter index is recorded in expr_types under `<expr key>:param`,
// which HIR reads to lower the arguments in declaration order.
fn check_variant_construction(ts: TS, node_idx: i64, callee: i64, enum_ti: i64, variant_name: string, args: Vector<i64>, names: Vector<i64>): TS
  let r: TS = ts
  let sp: Span = ts_node_span(r, callee)
  let vkey: string = i64_to_string(enum_ti) + ":" + variant_name
  let registered: Option<i64> = r.reg.variant_set.get(vkey)
  let param_count: i64 = to_i64(-1)
  match registered:
    Option::Some(n):
      param_count = n
    Option::None:
      // An unknown variant was diagnosed by the callee's own check.
      return r
  if param_count == to_i64(0):
    return ts_add_diag(r, sp, "variant '" + variant_name + "' has no parameters; write it without parentheses")
  let ai: i64 = 0
  while ai < args.length():
    let name_tidx: i64 = names.get(ai)
    if name_tidx < 0:
      let asp: Span = ts_node_span(r, args.get(ai))
      return ts_add_diag(r, asp, "variant '" + variant_name + "' is constructed by parameter name: " + variant_name + "(name = value)")
    let arg_name: string = ts_tok_name(r, name_tidx)
    let pkey: string = vkey + ":" + arg_name
    let param: Option<i64> = r.reg.variant_set.get(pkey)
    match param:
      Option::Some(param_index):
        let aj: i64 = 0
        while aj < ai:
          if names.get(aj) >= 0:
            if ts_tok_name(r, names.get(aj)) == arg_name:
              let dsp: Span = ts_tok_span(r, name_tidx)
              return ts_add_diag(r, dsp, "parameter '" + arg_name + "' of variant '" + variant_name + "' is given twice")
          aj = aj + 1
        let param_ti: i64 = to_i64(-1)
        let ptype: Option<i64> = r.reg.variant_set.get(pkey + ":type")
        match ptype:
          Option::Some(t):
            param_ti = t
          Option::None:
            param_ti = to_i64(-1)
        // A literal argument adopts the parameter's concrete type, as a
        // call argument does (host).
        r = fit_literal(r, args.get(ai), param_ti)
        let arg_ti: i64 = get_expr_type(r, args.get(ai))
        if arg_ti >= 0:
          if param_ti >= 0:
            if types_equal(r, arg_ti, param_ti) == false:
              let vsp: Span = ts_node_span(r, args.get(ai))
              r = ts_add_diag(r, vsp, "parameter '" + arg_name + "' of variant '" + variant_name + "' has type " + type_name(r, param_ti) + ", got " + type_name(r, arg_ti))
        r.reg = reg_with_expr_types(r.reg, r.reg.expr_types.set(expr_id_key(r.tc.module_id, args.get(ai)) + ":param", param_index))
      Option::None:
        let nsp: Span = ts_tok_span(r, name_tidx)
        return ts_add_diag(r, nsp, "variant '" + variant_name + "' has no parameter '" + arg_name + "'")
    ai = ai + 1
  if args.length() != param_count:
    return ts_add_diag(r, sp, "variant '" + variant_name + "' takes " + i64_to_string(param_count) + " parameter(s), got " + i64_to_string(args.length()))
  return ts_set_expr_type(r, node_idx, enum_ti)

fn check_field_expr(ts: TS, node_idx: i64, obj: i64, field_tidx: i64): TS
  let r: TS = check_expr(ts, obj)
  let obj_ti: i64 = get_expr_type(r, obj)
  if obj_ti < 0:
    return r
  if obj_ti >= r.types.length():
    return r
  let obj_type: DaoType = r.types.get(obj_ti)
  match obj_type.kind:
    TypeKind::TStruct:
      let field_name: string = ts_tok_name(r, field_tidx)
      // Field lookup reads the layout's field symbols (program-wide, so
      // another module's struct is read the same way); it is skipped when
      // a cross-module generic head's layout would overrun `type_info`
      // (element typing for such heads is deferred to a later
      // program-level pass).
      let obj_walkable: bool = layout_walkable(r, obj_type)
      if obj_walkable:
        let fi: i64 = 0
        while fi < obj_type.info_count:
          let f_sym: i64 = r.type_info.get(obj_type.info_lp + fi * 2)
          let f_type_idx: i64 = r.type_info.get(obj_type.info_lp + fi * 2 + 1)
          let f_name: string = field_slot_name(r.tc.symbols, f_sym)
          if f_name == field_name:
            return ts_set_expr_type(r, node_idx, f_type_idx)
          fi = fi + 1
      // Try method lookup: look for mangled symbol "StructName.fieldName"
      let msym: i64 = ts_method_for_receiver(r, field_name, obj_ti)
      if msym >= 0:
        let meth_ti: i64 = sym_type_at(r, msym)
        if meth_ti >= 0:
          return ts_set_expr_type(r, node_idx, meth_ti)
      // A derived concept the struct conforms to structurally provides
      // its methods; the concept's signature types the access.
      // Every derived concept providing the member (by name, from the
      // providers index) that the struct conforms to is consulted: one
      // types the access; two is an ambiguity neither conformance
      // outranks, and is diagnosed.
      let provider_cti: i64 = to_i64(-1)
      let provider_fn: i64 = to_i64(-1)
      let providers: Vector<i64> = derived_providers_of(r.reg, field_name)
      let dci: i64 = 0
      while dci + 1 < providers.length():
        let dcti: i64 = providers.get(dci)
        if ts_conforms(r, obj_ti, dcti):
          if provider_cti >= 0:
            return ts_add_diag(r, ts_tok_span(r, field_tidx), "member '" + field_name + "' of type " + type_name(r, obj_ti) + " is provided by more than one derived concept (" + type_name(r, provider_cti) + ", " + type_name(r, dcti) + ")")
          provider_cti = dcti
          provider_fn = providers.get(dci + 1)
        dci = dci + 2
      if provider_cti >= 0:
        return ts_set_concept_member(r, node_idx, provider_fn, provider_cti, obj_ti)
      // A member miss is a diagnostic only when the layout was walkable;
      // a cross-module generic head's fields are unknown here, so leave
      // such an access unresolved rather than falsely reporting.
      if obj_walkable:
        let sp: Span = ts_tok_span(r, field_tidx)
        r = ts_add_diag(r, sp, "no field '" + field_name + "' on type " + type_name(r, obj_ti))
      return r
    TypeKind::TGenericParam:
      // A member access on a type parameter: its bound concepts are the
      // only source of members.  The first bound requiring the member,
      // in declaration order (the host's constraint search), types the
      // access through the concept's method signature (so a
      // call checks arity, argument types, and result against it).  With
      // no bound providing the member the access is a diagnostic.  A
      // bound recorded as -1 (a concept whose type is unreadable in this
      // module) cannot be searched, so an access no readable bound
      // provides stays unresolved rather than falsely reported.
      let m_name: string = ts_tok_name(r, field_tidx)
      let unreadable: bool = false
      if bounds_walkable(r, obj_type):
        let gb: i64 = 0
        while gb < obj_type.info_count:
          let cti: i64 = r.type_info.get(obj_type.info_lp + gb)
          if cti < 0:
            unreadable = true
          else:
            if cti < r.types.length():
              let ct: DaoType = r.types.get(cti)
              if layout_walkable(r, ct):
                let gm: i64 = 0
                while gm < ct.info_count:
                  let gm_fn_ti: i64 = r.type_info.get(ct.info_lp + gm * 2 + 1)
                  if method_type_named(r, gm_fn_ti, m_name):
                    return ts_set_concept_member(r, node_idx, gm_fn_ti, cti, obj_ti)
                  gm = gm + 1
              else:
                unreadable = true
            else:
              unreadable = true
          gb = gb + 1
      if unreadable == false:
        let spg: Span = ts_tok_span(r, field_tidx)
        if obj_type.info_count > 0:
          r = ts_add_diag(r, spg, "no bound of type parameter '" + obj_type.name + "' provides '" + m_name + "'")
        else:
          r = ts_add_diag(r, spg, "'" + m_name + "' on unconstrained type parameter '" + obj_type.name + "'")
      return r
  // Any other receiver (a builtin, a pointer, an enum) has exactly the
  // methods an `extend` visible here gave it (`extend i32 as Show`,
  // the prelude's extends); a member no such extend provides is a
  // diagnostic, as on a struct.
  let member: string = ts_tok_name(r, field_tidx)
  let ext_sym: i64 = ts_method_for_receiver(r, member, obj_ti)
  if ext_sym >= 0:
    let ext_ti: i64 = sym_type_at(r, ext_sym)
    if ext_ti >= 0:
      return ts_set_expr_type(r, node_idx, ext_ti)
  return ts_add_diag(r, ts_tok_span(r, field_tidx), "no method '" + member + "' on type " + type_name(r, obj_ti))

fn check_pipe_expr(ts: TS, node_idx: i64, left: i64, right: i64): TS
  let r: TS = check_expr(ts, left)
  r = check_expr(r, right)
  let lhs_ti: i64 = get_expr_type(r, left)
  let rhs_ti: i64 = get_expr_type(r, right)
  // A pipe target reached across the module boundary can carry a type
  // index past this module's `types`; leave such a pipe unchecked rather
  // than reading out of bounds (as the call and field paths do).
  if rhs_ti >= r.types.length():
    return r
  if rhs_ti >= 0:
    let rhs_type: DaoType = r.types.get(rhs_ti)
    match rhs_type.kind:
      TypeKind::TFunction:
        // RHS must accept at least 1 param, and LHS type must match first param
        if rhs_type.info_count < 1:
          let sp: Span = ts_node_span(r, right)
          r = ts_add_diag(r, sp, "pipe target function takes no arguments")
          return r
        // Check LHS type against first param type.  Read the param slot
        // only when the function's params live in this module's type_info
        // (`info_lp` >= 0 and in range); a cross-module target's slot would
        // index out of bounds (a later program-level pass).
        if lhs_ti >= 0:
          if fn_params_walkable(r, rhs_type):
            let first_param_ti: i64 = r.type_info.get(rhs_type.info_lp)
            // A literal piped in adopts the first parameter's type, as a
            // literal call argument does.
            r = fit_literal(r, left, first_param_ti)
            lhs_ti = get_expr_type(r, left)
            if types_equal(r, lhs_ti, first_param_ti) == false:
              let sp2: Span = ts_node_span(r, left)
              r = ts_add_diag(r, sp2, "pipe argument type mismatch: expected " + type_name(r, first_param_ti) + ", got " + type_name(r, lhs_ti))
        return ts_set_expr_type(r, node_idx, rhs_type.ret_type)
    // RHS not a function
    let sp3: Span = ts_node_span(r, right)
    r = ts_add_diag(r, sp3, "pipe target is not a function")
  return r

// =========================================================================
// Section 44: Statement checking
// =========================================================================

fn check_stmt(ts: TS, node_idx: i64): TS
  if node_idx < 0:
    return ts
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::LetS(name_tidx, type_node, init_node):
      return check_let_stmt(ts, node_idx, name_tidx, type_node, init_node)
    Node::AssignS(target, value):
      return check_assign_stmt(ts, node_idx, target, value)
    Node::IfS(cond, then_lp, else_lp):
      return check_if_stmt(ts, cond, then_lp, else_lp)
    Node::WhileS(cond, body_lp):
      return check_while_stmt(ts, cond, body_lp)
    Node::ResourceS(kind_tidx, name_tidx, body_lp):
      // A `resource memory` block is an allocation domain; its body is
      // checked with the domain nesting recorded (a `yield` inside it is
      // rejected — CONTRACT_EXECUTION_CONTEXTS.md, Resources §8).
      if ts_tok_name(ts, kind_tidx) == "memory":
        let rr: TS = ts
        rr.ctx = ctx_with_resource(rr.ctx, rr.ctx.resource_depth + 1)
        rr = check_body_stmts(rr, body_lp)
        rr.ctx = ctx_with_resource(rr.ctx, rr.ctx.resource_depth - 1)
        return rr
      return check_body_stmts(ts, body_lp)
    Node::ModeS(name_tidx, body_lp):
      // `mode <name> =>` enters one of the canonical modes
      // (CONTRACT_EXECUTION_CONTEXTS.md, Modes: `unsafe`, `gpu`,
      // `parallel`) for its body.  `unsafe` is the context a dereference
      // requires; `gpu` and `parallel` carry no checking rule yet.  Any
      // other name is no mode the language defines, so it is diagnosed
      // fail-closed, and its body is still checked.
      let mode_name: string = ts_tok_name(ts, name_tidx)
      if mode_name == "unsafe":
        let ru: TS = ts
        ru.ctx = ctx_with_unsafe(ru.ctx, ru.ctx.unsafe_depth + 1)
        ru = check_body_stmts(ru, body_lp)
        ru.ctx = ctx_with_unsafe(ru.ctx, ru.ctx.unsafe_depth - 1)
        return ru
      if mode_name == "gpu" or mode_name == "parallel":
        return check_body_stmts(ts, body_lp)
      return check_body_stmts(ts_add_diag(ts, ts_tok_span(ts, name_tidx), "unknown mode '" + mode_name + "'"), body_lp)
    Node::YieldS(yield_tidx, val_node):
      // `yield` is legal only in a generator function (declared
      // `Generator<T>`), never inside a `resource memory` block
      // (CONTRACT_EXECUTION_CONTEXTS.md, Resources law 8), and its value
      // must match `T` (CONTRACT_SYNTAX_SURFACE.md, Generator Functions).
      // The value is checked with no expected type: contextual literal
      // typing is confined to the contexts that explicitly implement it
      // (CONTRACT_TYPECHECKING_BASELINE.md §3), and `yield` is none of
      // them, so a literal keeps its default type.
      let sp_y: Span = ts_node_span(ts, node_idx)
      let ry: TS = ts
      if val_node >= 0:
        ry = check_expr(ry, val_node)
      if ry.ctx.in_generator == 0:
        return ts_add_diag(ry, sp_y, "yield is only valid inside a generator function")
      if ry.ctx.resource_depth > 0:
        ry = ts_add_diag(ry, sp_y, "yield within a resource memory block is invalid")
      if val_node < 0:
        return ry
      if ry.ctx.gen_elem >= 0:
        let yt: i64 = get_expr_type(ry, val_node)
        if yt >= 0:
          if types_equal(ry, yt, ry.ctx.gen_elem) == false:
            ry = ts_add_diag(ry, ts_node_span(ry, val_node), "yield type " + type_name(ry, yt) + " does not match Generator element type " + type_name(ry, ry.ctx.gen_elem))
      return ry
    Node::ForS(var_tidx, iter_node, body_lp):
      return check_for_stmt(ts, var_tidx, iter_node, body_lp)
    Node::ReturnS(val_node):
      return check_return_stmt(ts, val_node)
    Node::BreakS(tidx):
      return check_break_stmt(ts, tidx)
    Node::MatchS(scrut_node, arms_lp):
      return check_match_stmt(ts, scrut_node, arms_lp)
    Node::ExprStmtS(expr_node):
      return check_expr(ts, expr_node)
    Node::ErrorS(t):
      return ts
  return ts

fn check_let_stmt(ts: TS, node_idx: i64, name_tidx: i64, type_node: i64, init_node: i64): TS
  let r: TS = ts
  let annot_ti: i64 = to_i64(-1)
  if type_node >= 0:
    let diags_before: i64 = r.diags.length()
    let tr: TypeR = resolve_annotation(r, type_node, to_i64(-1))
    r = tr.ts
    annot_ti = tr.type_idx
    // An annotation the resolution itself diagnosed is not also unknown.
    if annot_ti < 0:
      if r.diags.length() == diags_before:
        let sp: Span = ts_node_span(r, type_node)
        r = ts_add_diag(r, sp, "unknown type in annotation")
  if init_node >= 0:
    r = check_expr(r, init_node)
    // A literal initializer adopts a concrete annotated type (host).
    if annot_ti >= 0:
      r = fit_literal(r, init_node, annot_ti)
    let init_ti: i64 = get_expr_type(r, init_node)
    if annot_ti >= 0:
      if init_ti >= 0:
        if types_equal(r, annot_ti, init_ti) == false:
          let sp: Span = ts_tok_span(r, name_tidx)
          r = ts_add_diag(r, sp, "type mismatch: cannot assign " + type_name(r, init_ti) + " to " + type_name(r, annot_ti))
  // Register local type
  let local_sym: i64 = member_sym_of(r.reg.index, r.tc.module_id, node_idx, "Local", "")
  if local_sym >= 0:
    if annot_ti >= 0:
      r = ts_set_sym_type(r, local_sym, annot_ti)
    else:
      if init_node >= 0:
        let init_ti2: i64 = get_expr_type(r, init_node)
        if init_ti2 >= 0:
          r = ts_set_sym_type(r, local_sym, init_ti2)
  return r

// Check whether a node is a valid lvalue (assignable target).
fn is_lvalue(ts: TS, node_idx: i64): bool
  if node_idx < 0:
    return false
  let node: Node = ts.tc.nodes.get(node_idx)
  match node:
    Node::IdentE(tidx):
      return true
    Node::FieldE(obj, ftidx):
      return true
    Node::IndexE(obj, idx_expr):
      return true
    Node::UnaryE(op_tidx, operand):
      // Deref (*ptr = val) is an lvalue — Tier B, accept for now
      let tok: Token = ts.tc.toks.get(op_tidx)
      if tok.kind == TK::Star:
        return true
  return false

fn check_assign_stmt(ts: TS, node_idx: i64, target: i64, value: i64): TS
  let r: TS = check_expr(ts, target)
  r = check_expr(r, value)
  // Validate lvalue
  if is_lvalue(r, target) == false:
    let sp: Span = ts_node_span(r, target)
    r = ts_add_diag(r, sp, "invalid assignment target: expected identifier, field, or index expression")
  let target_ti: i64 = get_expr_type(r, target)
  // A literal value adopts the assignment target's concrete type (host
  // `check_assignment` checks the value against the target as expected).
  if target_ti >= 0:
    r = fit_literal(r, value, target_ti)
  let value_ti: i64 = get_expr_type(r, value)
  if target_ti >= 0:
    if value_ti >= 0:
      if types_equal(r, target_ti, value_ti) == false:
        let sp2: Span = ts_node_span(r, target)
        r = ts_add_diag(r, sp2, "type mismatch in assignment: expected " + type_name(r, target_ti) + ", got " + type_name(r, value_ti))
  return r

fn check_if_stmt(ts: TS, cond: i64, then_lp: i64, else_lp: i64): TS
  let r: TS = check_expr(ts, cond)
  let cond_ti: i64 = get_expr_type(r, cond)
  if cond_ti >= 0:
    if is_bool_type(r, cond_ti) == false:
      let sp: Span = ts_node_span(r, cond)
      r = ts_add_diag(r, sp, "condition must be bool, got " + type_name(r, cond_ti))
  r = check_body_stmts(r, then_lp)
  if else_lp >= 0:
    r = check_body_stmts(r, else_lp)
  return r

fn check_while_stmt(ts: TS, cond: i64, body_lp: i64): TS
  let r: TS = check_expr(ts, cond)
  let cond_ti: i64 = get_expr_type(r, cond)
  if cond_ti >= 0:
    if is_bool_type(r, cond_ti) == false:
      let sp: Span = ts_node_span(r, cond)
      r = ts_add_diag(r, sp, "while condition must be bool, got " + type_name(r, cond_ti))
  r = ts_inc_loop_depth(r)
  r = check_body_stmts(r, body_lp)
  r = ts_dec_loop_depth(r)
  return r

fn check_for_stmt(ts: TS, var_tidx: i64, iter_node: i64, body_lp: i64): TS
  let r: TS = check_expr(ts, iter_node)
  r = ts_inc_loop_depth(r)
  r = check_body_stmts(r, body_lp)
  r = ts_dec_loop_depth(r)
  return r

fn check_return_stmt(ts: TS, val_node: i64): TS
  if ts.ctx.in_generator > 0:
    // A generator terminates with a bare `return`; it produces values
    // with `yield`, never with `return value`.
    if val_node < 0:
      return ts
    let rg: TS = check_expr(ts, val_node)
    return ts_add_diag(rg, ts_node_span(rg, val_node), "'return value' is invalid in a generator function; use yield to produce values")
  if val_node < 0:
    if ts.ctx.return_type >= 0:
      if is_void_type(ts, ts.ctx.return_type) == false:
        let sp: Span = Span(to_i64(0), to_i64(1))
        return ts_add_diag(ts, sp, "return with no value in function returning " + type_name(ts, ts.ctx.return_type))
    return ts
  let r: TS = check_expr(ts, val_node)
  // A literal return value adopts the function's concrete return type.
  if r.ctx.return_type >= 0:
    r = fit_literal(r, val_node, r.ctx.return_type)
  let val_ti: i64 = get_expr_type(r, val_node)
  if val_ti >= 0:
    if r.ctx.return_type >= 0:
      if types_equal(r, val_ti, r.ctx.return_type) == false:
        let sp: Span = ts_node_span(r, val_node)
        r = ts_add_diag(r, sp, "return type mismatch: expected " + type_name(r, r.ctx.return_type) + ", got " + type_name(r, val_ti))
  return r

fn check_break_stmt(ts: TS, tidx: i64): TS
  if ts.ctx.loop_depth <= 0:
    let sp: Span = ts_tok_span(ts, tidx)
    return ts_add_diag(ts, sp, "break outside of loop")
  return ts

// A match pattern: `Enum::Variant`, `Enum::Variant(bindings)`, or a
// constant.  A pattern with bindings is checked by its callee -- the
// bindings are names it introduces, no arguments -- and against the
// variant's shape in the registry: a variant without parameters is
// written bare, and a variant with parameters binds one name per
// parameter.  The pattern takes the callee's type.
fn check_pattern(ts: TS, pat_node: i64): TS
  match ts.tc.nodes.get(pat_node):
    Node::CallE(callee, args_lp, arg_count, targs_lp, names_lp, targs_on_type):
      let r: TS = check_expr(ts, callee)
      let callee_ti: i64 = get_expr_type(r, callee)
      if callee_ti < 0:
        return r
      let variant_name: string = ""
      match r.tc.nodes.get(callee):
        Node::QualNameE(seg_lp, seg_count):
          let segs: Vector<i64> = read_list(r.tc.idx_data, seg_lp)
          if segs.length() >= 2:
            variant_name = ts_tok_name(r, segs.get(segs.length() - 1))
      if variant_name != "":
        let registered: Option<i64> = r.reg.variant_set.get(i64_to_string(callee_ti) + ":" + variant_name)
        match registered:
          Option::Some(param_count):
            let sp: Span = ts_node_span(r, callee)
            if param_count == to_i64(0):
              return ts_add_diag(r, sp, "variant '" + variant_name + "' has no parameters; the pattern is written without parentheses")
            let names: Vector<i64> = read_list(r.tc.idx_data, names_lp)
            let ni: i64 = 0
            while ni < names.length():
              if names.get(ni) >= 0:
                let nsp: Span = ts_tok_span(r, names.get(ni))
                return ts_add_diag(r, nsp, "a pattern binds by position: " + variant_name + "(a, b), never by name")
              ni = ni + 1
            let bindings: Vector<i64> = read_list(r.tc.idx_data, args_lp)
            if bindings.length() != param_count:
              return ts_add_diag(r, sp, "variant '" + variant_name + "' takes " + i64_to_string(param_count) + " parameter(s); the pattern binds " + i64_to_string(bindings.length()))
            let bi: i64 = 0
            while bi < bindings.length():
              let bound: Node = r.tc.nodes.get(bindings.get(bi))
              let is_name: bool = false
              match bound:
                Node::IdentE(t2):
                  is_name = true
              if is_name == false:
                let bsp: Span = ts_node_span(r, bindings.get(bi))
                return ts_add_diag(r, bsp, "a pattern binds a name per parameter of '" + variant_name + "': " + variant_name + "(a, b)")
              bi = bi + 1
          Option::None:
            return r
      return ts_set_expr_type(r, pat_node, callee_ti)
    Node::QualNameE(seg_lp, seg_count):
      // A bare variant pattern: only a variant without parameters.
      let r: TS = check_expr(ts, pat_node)
      let pat_ti: i64 = get_expr_type(r, pat_node)
      if pat_ti >= 0:
        let segs: Vector<i64> = read_list(r.tc.idx_data, seg_lp)
        if segs.length() >= 2:
          let bare_name: string = ts_tok_name(r, segs.get(segs.length() - 1))
          let bare: Option<i64> = r.reg.variant_set.get(i64_to_string(pat_ti) + ":" + bare_name)
          match bare:
            Option::Some(param_count):
              if param_count > to_i64(0):
                let bsp: Span = ts_node_span(r, pat_node)
                return ts_add_diag(r, bsp, "variant '" + bare_name + "' takes " + i64_to_string(param_count) + " parameter(s); the pattern binds none")
            Option::None:
              return r
      return r
  return check_expr(ts, pat_node)

fn check_match_stmt(ts: TS, scrut_node: i64, arms_lp: i64): TS
  let r: TS = check_expr(ts, scrut_node)
  let scrut_ti: i64 = get_expr_type(r, scrut_node)
  let arms: Vector<i64> = read_pairs(r.tc.idx_data, arms_lp)
  let i: i64 = 0
  while i < arms.length():
    let pat_node: i64 = arms.get(i)
    let body_lp2: i64 = arms.get(i + 1)
    r = check_pattern(r, pat_node)
    // Compare pattern type against scrutinee type; a literal pattern
    // adopts the scrutinee's concrete integer/float type first, as a
    // literal in any other context does.
    if scrut_ti >= 0:
      r = fit_literal(r, pat_node, scrut_ti)
      let pat_ti: i64 = get_expr_type(r, pat_node)
      if pat_ti >= 0:
        if types_equal(r, scrut_ti, pat_ti) == false:
          let sp: Span = ts_node_span(r, pat_node)
          r = ts_add_diag(r, sp, "match arm pattern type " + type_name(r, pat_ti) + " does not match scrutinee type " + type_name(r, scrut_ti))
    r = check_body_stmts(r, body_lp2)
    i = i + 2
  return r

fn check_body_stmts(ts: TS, list_pos: i64): TS
  if list_pos < 0:
    return ts
  let stmts: Vector<i64> = read_list(ts.tc.idx_data, list_pos)
  let r: TS = ts
  let i: i64 = 0
  while i < stmts.length():
    r = check_stmt(r, stmts.get(i))
    i = i + 1
  return r

// =========================================================================
// Section 45: Pass 2 — Check function bodies
// =========================================================================

fn tc_check_fn_body(ts: TS, decl_idx: i64, name_tidx: i64, params_lp: i64, ret_type_node: i64, body_lp: i64): TS
  let r: TS = ts
  let fn_ti: i64 = to_i64(-1)
  let sym_idx: i64 = find_callable_sym_by_decl(r, decl_idx)
  if sym_idx >= 0:
    fn_ti = sym_type_at(r, sym_idx)
  let old_ctx: CheckCtx = r.ctx
  r = tc_enter_fn_ctx(r, fn_ti)
  // Declare param types
  let pairs: Vector<i64> = read_pairs(r.tc.idx_data, params_lp)
  let pi: i64 = 0
  while pi < pairs.length():
    let p_tidx: i64 = pairs.get(pi)
    let p_type_node: i64 = pairs.get(pi + 1)
    let p_name: string = ts_tok_name(r, p_tidx)
    let p_sym: i64 = find_param_sym(r, decl_idx, p_name)
    if p_sym >= 0:
      let pt_r: TypeR = resolve_ast_type(r, p_type_node)
      r = pt_r.ts
      if pt_r.type_idx >= 0:
        r = ts_set_sym_type(r, p_sym, pt_r.type_idx)
    pi = pi + 2
  r = check_body_stmts(r, body_lp)
  r.ctx = old_ctx
  return r

fn tc_check_expr_fn_body(ts: TS, decl_idx: i64, name_tidx: i64, params_lp: i64, ret_type_node: i64, body_expr: i64): TS
  let r: TS = ts
  let fn_ti: i64 = to_i64(-1)
  let sym_idx: i64 = find_callable_sym_by_decl(r, decl_idx)
  if sym_idx >= 0:
    fn_ti = sym_type_at(r, sym_idx)
  let old_ctx: CheckCtx = r.ctx
  r = tc_enter_fn_ctx(r, fn_ti)
  let pairs: Vector<i64> = read_pairs(r.tc.idx_data, params_lp)
  let pi: i64 = 0
  while pi < pairs.length():
    let p_tidx: i64 = pairs.get(pi)
    let p_type_node: i64 = pairs.get(pi + 1)
    let p_name: string = ts_tok_name(r, p_tidx)
    let p_sym: i64 = find_param_sym(r, decl_idx, p_name)
    if p_sym >= 0:
      let pt_r: TypeR = resolve_ast_type(r, p_type_node)
      r = pt_r.ts
      if pt_r.type_idx >= 0:
        r = ts_set_sym_type(r, p_sym, pt_r.type_idx)
    pi = pi + 2
  r = tc_check_expr_body_value(r, body_expr)
  r.ctx = old_ctx
  return r

// An expression body's value, against the entered return context: the
// body is the function's return, so a literal adopts the return type as
// a `return` value does (check_return_stmt).
fn tc_check_expr_body_value(ts: TS, body_expr: i64): TS
  if ts.ctx.in_generator > 0:
    // The body is the function's value, a `return value`, which is
    // invalid in a generator function (CONTRACT_SYNTAX_SURFACE.md,
    // Generator Functions): a generator produces values only by `yield`.
    let rg: TS = check_expr(ts, body_expr)
    return ts_add_diag(rg, ts_node_span(rg, body_expr), "'return value' is invalid in a generator function; use yield to produce values")
  let r: TS = check_expr(ts, body_expr)
  if r.ctx.return_type >= 0:
    r = fit_literal(r, body_expr, r.ctx.return_type)
  let body_ti: i64 = get_expr_type(r, body_expr)
  if body_ti >= 0:
    if r.ctx.return_type >= 0:
      if types_equal(r, body_ti, r.ctx.return_type) == false:
        let sp: Span = ts_node_span(r, body_expr)
        r = ts_add_diag(r, sp, "expression body type mismatch: expected " + type_name(r, r.ctx.return_type) + ", got " + type_name(r, body_ti))
  return r

// Enter a method's body: its return context from its function type,
// `self` typed as the owner, the other parameters as annotated.
fn tc_enter_method(ts: TS, owner_ti: i64, meth_idx: i64, m_name_tidx: i64, m_params_lp: i64): TS
  let r: TS = ts
  let fn_ti: i64 = to_i64(-1)
  let msym: i64 = callable_sym_of_decl(r, meth_idx)
  if msym >= 0:
    fn_ti = sym_type_at(r, msym)
  r = tc_enter_fn_ctx(r, fn_ti)
  let pairs: Vector<i64> = read_pairs(r.tc.idx_data, m_params_lp)
  let pi: i64 = 0
  while pi < pairs.length():
    let p_tidx: i64 = pairs.get(pi)
    let p_type_node: i64 = pairs.get(pi + 1)
    let p_name: string = ts_tok_name(r, p_tidx)
    let p_sym: i64 = find_param_sym(r, meth_idx, p_name)
    if p_sym >= 0:
      if p_name == "self":
        if owner_ti >= 0:
          r = ts_set_sym_type(r, p_sym, owner_ti)
      else:
        let pt_r: TypeR = resolve_ast_type(r, p_type_node)
        r = pt_r.ts
        if pt_r.type_idx >= 0:
          r = ts_set_sym_type(r, p_sym, pt_r.type_idx)
    pi = pi + 2
  return r

// A block-bodied method of a class or an extend.
fn tc_check_method_body(ts: TS, owner_ti: i64, meth_idx: i64, m_name_tidx: i64, m_params_lp: i64, m_body_lp: i64): TS
  let old_ctx: CheckCtx = ts.ctx
  let r: TS = tc_enter_method(ts, owner_ti, meth_idx, m_name_tidx, m_params_lp)
  r = check_body_stmts(r, m_body_lp)
  r.ctx = old_ctx
  return r

// An expression-bodied method of a class or an extend.
fn tc_check_method_expr_body(ts: TS, owner_ti: i64, meth_idx: i64, m_name_tidx: i64, m_params_lp: i64, m_body_expr: i64): TS
  let old_ctx: CheckCtx = ts.ctx
  let r: TS = tc_enter_method(ts, owner_ti, meth_idx, m_name_tidx, m_params_lp)
  r = tc_check_expr_body_value(r, m_body_expr)
  r.ctx = old_ctx
  return r

// =========================================================================
// Section 44b: Derived conformance (the host's compute_derived_conformances)
// =========================================================================

// The conformance map is keyed by (type, concept, visible-from): an
// `extend` reaches only its declaring module (CONTRACT_MODULE_SYSTEM.md
// §5.1–2), so its entry carries that module id and two modules' extends
// of one type coexist; one in the prelude is seen by every module
// (§5.3), and a derived conformance is a property of the type — both
// carry conform_everywhere().
fn conform_key(ti: i64, concept_ti: i64, from_module: i64): string
  return i64_to_string(ti) + ":" + i64_to_string(concept_ti) + ":" + i64_to_string(from_module)

fn conform_everywhere(): i64 -> to_i64(-1)

// Whether type `ti` conforms to concept `concept_ti` as seen from module
// `from_module` — everywhere, or by an `extend` of that module — two
// constant-time lookups in the conformance map.
fn reg_conforms(reg: Registry, ti: i64, concept_ti: i64, from_module: i64): bool
  if reg.conform.known.contains(conform_key(ti, concept_ti, conform_everywhere())):
    return true
  return reg.conform.known.contains(conform_key(ti, concept_ti, from_module))

// reg_conforms as seen from the module being checked.
fn ts_conforms(ts: TS, ti: i64, concept_ti: i64): bool
  return reg_conforms(ts.reg, ti, concept_ti, ts.tc.module_id)

// Record that `ti` conforms to `concept_ti`, visible from `from_module`
// (a module id, or conform_everywhere()).
fn reg_record_conformance(reg: Registry, ti: i64, concept_ti: i64, from_module: i64): Registry
  let c: Conformance = reg.conform
  return reg_with_conform(reg, Conformance(c.known.set(conform_key(ti, concept_ti, from_module), to_i64(1)), c.derived_concepts, c.subst_cache, c.providers))

fn ts_record_conformance(ts: TS, ti: i64, concept_ti: i64, from_module: i64): TS
  ts.reg = reg_record_conformance(ts.reg, ti, concept_ti, from_module)
  return ts

// Whether the module being checked is a prelude module
// (CONTRACT_MODULE_SYSTEM.md §7), from the program's index.
fn module_in_prelude(ts: TS): bool
  return ts.reg.index.prelude_modules.contains(i64_to_string(ts.tc.module_id))

// Whether declarations of modules `a` and `b` share one resolver
// namespace, where one name declared twice is a duplicate: the same
// module, or two of the prelude's files.
fn same_resolver_namespace(ts: TS, a: i64, b: i64): bool
  if a == b:
    return true
  let pm: HashMap<i64> = ts.reg.index.prelude_modules
  return pm.contains(i64_to_string(a)) and pm.contains(i64_to_string(b))

// Record a `derived concept`, and index it under each member it
// provides together with that member's signature, so a member access
// consults only the concepts providing that name and reads the
// signature directly (provider_key, provider_fn_key).
fn ts_add_derived_concept(ts: TS, concept_ti: i64): TS
  let c: Conformance = ts.reg.conform
  let providers: HashMap<i64> = c.providers
  if concept_ti < ts.types.length():
    let ct: DaoType = ts.types.get(concept_ti)
    if layout_walkable(ts, ct):
      let mi: i64 = 0
      while mi < ct.info_count:
        let fn_ti: i64 = ts.type_info.get(ct.info_lp + mi * 2 + 1)
        let name: string = method_type_name(ts, fn_ti)
        let n: i64 = hm_get_or(providers, name, to_i64(0))
        providers = providers.set(provider_key(name, n), concept_ti)
        providers = providers.set(provider_fn_key(name, n), fn_ti)
        providers = providers.set(name, n + 1)
        mi = mi + 1
  ts.reg = reg_with_conform(ts.reg, Conformance(c.known, c.derived_concepts.push(concept_ti), c.subst_cache, providers))
  return ts

fn provider_key(name: string, j: i64): string
  return name + ":" + i64_to_string(j)

fn provider_fn_key(name: string, j: i64): string
  return name + ":" + i64_to_string(j) + ":fn"

// The derived concepts providing a member named `name`, in
// declaration order, as flat (concept type, member signature) pairs.
fn derived_providers_of(reg: Registry, name: string): Vector<i64>
  let out: Vector<i64> = Vector<i64>::new()
  let n: i64 = hm_get_or(reg.conform.providers, name, to_i64(0))
  let j: i64 = 0
  while j < n:
    out = out.push(hm_get_or(reg.conform.providers, provider_key(name, j), to_i64(-1)))
    out = out.push(hm_get_or(reg.conform.providers, provider_fn_key(name, j), to_i64(-1)))
    j = j + 1
  return out

// A concept type: `builtin_id` records the declaring module, `decl_node`
// its declaration, and the method table (name-token / method-type pairs)
// lives at `info_lp` for `info_count` methods.
fn concept_type(module_id: i64, name: string, decl_idx: i64, info_lp: i64, info_count: i64): DaoType
  return DaoType(TypeKind::TConcept, module_id, name, decl_idx, info_lp, info_count, to_i64(-1), to_i64(-1))

// A function type derived from `ft` with a different parameter table and
// result: `info_lp` / `info_count` locate the parameter type slots.
fn fn_type_with(ft: DaoType, info_lp: i64, info_count: i64, ret: i64): DaoType
  return DaoType(TypeKind::TFunction, ft.builtin_id, ft.name, ft.decl_node, info_lp, info_count, ret, ft.pointee)

// Whether the method type `fn_ti` is the concept method named `name`.  A
// method's type carries its name as "fn <name>", so the match reads the
// shared type table and holds from any module — a method-name token
// indexes the declaring module's token vector and is never read here.
fn method_type_named(ts: TS, fn_ti: i64, name: string): bool
  return method_type_name(ts, fn_ti) == name

// The method name a function type carries (its name is "fn <name>"),
// or "" for no function type.
fn method_type_name(ts: TS, fn_ti: i64): string
  if fn_ti < 0:
    return ""
  if fn_ti >= ts.types.length():
    return ""
  let mt: DaoType = ts.types.get(fn_ti)
  if starts_with(mt.name, "fn "):
    return substring(mt.name, to_i64(3), length(mt.name) - 3)
  return ""

/// A function type with `map` applied to its parameter and result types
/// (substitute_type); the type itself where nothing moved.
fn substitute_fn_type(ts: TS, map: HashMap<i64>, fn_ti: i64): TypeR
  if fn_ti < 0:
    return TypeR(ts, fn_ti)
  if fn_ti >= ts.types.length():
    return TypeR(ts, fn_ti)
  let ft: DaoType = ts.types.get(fn_ti)
  if fn_params_walkable(ts, ft) == false:
    return TypeR(ts, fn_ti)
  let r: TS = ts
  let moved: bool = false
  let slots: Vector<i64> = Vector<i64>::new()
  let pi: i64 = 0
  while pi < ft.info_count:
    let slot: i64 = r.type_info.get(ft.info_lp + pi)
    let sub: TypeR = substitute_type(r, map, slot)
    r = sub.ts
    if sub.type_idx != slot:
      moved = true
    slots = slots.push(sub.type_idx)
    pi = pi + 1
  let ret: TypeR = substitute_type(r, map, ft.ret_type)
  r = ret.ts
  if ret.type_idx != ft.ret_type:
    moved = true
  if moved == false:
    return TypeR(r, fn_ti)
  let start: i64 = r.type_info.length()
  r = ts_push_info_run(r, slots)
  return ts_add_type(r, fn_type_with(ft, start, slots.length(), ret.type_idx))

// The signature a concept method has for receiver type `self_ti`: the
// concept's own name in a parameter or result position — bare, under
// pointers and generators, or as an instantiation's argument
// (`Box<Wrap>`) — means the conforming type (CONTRACT_SYNTAX_SURFACE.md,
// concepts), so it is substituted throughout (substitute_fn_type); a
// signature that names the concept nowhere is returned as is.
// Substituted signatures are interned per (method, concept, receiver)
// so a call site never allocates twice.
fn concept_method_sig(ts: TS, fn_ti: i64, concept_ti: i64, self_ti: i64): TypeR
  let r: TS = ts
  if fn_ti < 0:
    return TypeR(r, fn_ti)
  if fn_ti >= r.types.length():
    return TypeR(r, fn_ti)
  let key: string = i64_to_string(fn_ti) + ":" + i64_to_string(concept_ti) + ":" + i64_to_string(self_ti)
  let cached: i64 = hm_get_or(r.reg.conform.subst_cache, key, to_i64(-1))
  if cached >= 0:
    return TypeR(r, cached)
  let as_self: HashMap<i64> = HashMap<i64>::new().set(i64_to_string(concept_ti), self_ti)
  let sig: TypeR = substitute_fn_type(r, as_self, fn_ti)
  r = sig.ts
  if sig.type_idx == fn_ti:
    return sig
  let c2: Conformance = r.reg.conform
  r.reg = reg_with_conform(r.reg, Conformance(c2.known, c2.derived_concepts, c2.subst_cache.set(key, sig.type_idx), c2.providers))
  return TypeR(r, sig.type_idx)

// Type a member access that concept `concept_ti` provides — through a
// derived conformance or a bound — as the concept method's signature for
// the receiver, and record the providing concept under the access's
// `:concept` key.  No implementation exists to dispatch such a member
// to yet; the lowering passes read that key to reject it fail-closed
// instead of lowering a field access.
fn ts_set_concept_member(ts: TS, node_idx: i64, fn_ti: i64, concept_ti: i64, self_ti: i64): TS
  let sr: TypeR = concept_method_sig(ts, fn_ti, concept_ti, self_ti)
  let r: TS = sr.ts
  r.reg = reg_with_expr_types(r.reg, r.reg.expr_types.set(concept_member_key(r.tc.module_id, node_idx), concept_ti))
  return ts_set_expr_type(r, node_idx, sr.type_idx)

// The expression-table key under which a member access records the
// concept that provides it (see ts_set_concept_member).
fn concept_member_key(module_id: i64, node_idx: i64): string
  return expr_id_key(module_id, node_idx) + ":concept"

// A `derived concept` is conformed to structurally: a class conforms when
// every field's type conforms (explicitly, or itself derived), computed
// to a fixpoint so derivation is transitive and independent of
// declaration order — the host's rule.  A class with an explicit extend
// for the concept keeps that conformance.  (The bootstrap parses no
// inline `as` / `deny` blocks; an extend is the explicit form here.)
//
// Two program-wide steps share the work.  First every module's
// declarations are collected (tc_collect_conformances): each `derived
// concept`, and each `extend <type> as <concept>` resolved into the
// conformance map (the resolver bound the extend's concept name; the
// target type is resolved here).  Then every module's classes and their
// field types are indexed once (index_program_structs), and derivation
// propagates through one worklist over that program-wide index
// (derive_program_conformances), reading only the map.  Collection
// precedes every derivation and derivation precedes every body, so a
// class derives through a concept or extend declared in any module it
// can see, whatever the order the modules are checked in — the
// prelude's files see one another as one namespace.
//
// Whether a field conforms is asked from the class's own module — the
// host's rule: an `extend` in another module is not in scope there
// unless it is the prelude's, so a class never derives through it.
fn tc_collect_conformances(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let extend_visible_from: i64 = r.tc.module_id
  if module_in_prelude(r):
    extend_visible_from = conform_everywhere()
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::ConceptDeclD(name_tidx, tparams_lp, methods_lp, is_derived):
        if is_derived > 0:
          let csym: i64 = type_sym_of_decl(r, decl_idx)
          if csym >= 0:
            let cti: i64 = sym_type_at(r, csym)
            if cti >= 0:
              r = ts_add_derived_concept(r, cti)
      Node::ExtendDeclD(target_type_node, concept_name_tidx, methods_lp):
        let cb_key: string = extend_binding_key(r.tc.file_id, decl_idx)
        let cb_found: Option<i64> = r.tc.concept_bindings.get(cb_key)
        let esym: i64 = to_i64(-1)
        match cb_found:
          Option::Some(sym):
            esym = sym
          Option::None:
            esym = to_i64(-1)
        if esym >= 0:
          // A name after `as` that is no concept, and a concept-valued
          // target, were diagnosed by the satisfaction pass; neither
          // conforms anything.
          let ecti: i64 = concept_named_by(r, sym_type_at(r, esym))
          if ecti >= 0:
            let tr: TypeR = resolve_ast_type(r, target_type_node)
            r = tr.ts
            if tr.type_idx >= 0 and concept_named_by(r, tr.type_idx) < 0:
              r = ts_record_conformance(r, tr.type_idx, ecti, extend_visible_from)
    i = i + 1
  return r

// The program's classes, indexed once for derivation: each class's
// struct type, declaring module (what its fields' conformance is asked
// from), and field types, and a reverse index from a field type to the
// classes carrying a field of that type.
class ClassIndex:
  tis: Vector<i64>       // class k's struct type
  mods: Vector<i64>      // class k's declaring module
  f_start: Vector<i64>   // class k's first slot in f_tis
  f_count: Vector<i64>   // class k's field count
  f_tis: Vector<i64>     // every class's field types, contiguous per class
  deps: HashMap<i64>     // "n:<fti>" → dependents of field type fti; "d:<fti>:<j>" → the j-th one's k

fn class_index_empty(): ClassIndex
  return ClassIndex(Vector<i64>::new(), Vector<i64>::new(), Vector<i64>::new(), Vector<i64>::new(), Vector<i64>::new(), HashMap<i64>::new())

// Every struct in the program's type table — a declared class or an
// instantiation made while signatures were resolved — indexed for
// derivation: its type, its declaring module (an instantiation's is its
// head's), and its field types, read from the layout a single time.
fn index_program_structs(types: Vector<DaoType>, type_info: Vector<i64>): ClassIndex
  let x: ClassIndex = class_index_empty()
  let sti: i64 = 0
  while sti < types.length():
    let st: DaoType = types.get(sti)
    match st.kind:
      TypeKind::TStruct:
        if st.info_lp >= 0 and st.info_lp + st.info_count * 2 <= type_info.length():
          let k: i64 = x.tis.length()
          x.tis = x.tis.push(sti)
          x.mods = x.mods.push(st.builtin_id)
          x.f_start = x.f_start.push(x.f_tis.length())
          x.f_count = x.f_count.push(st.info_count)
          let fi: i64 = 0
          while fi < st.info_count:
            let fti: i64 = type_info.get(st.info_lp + fi * 2 + 1)
            x.f_tis = x.f_tis.push(fti)
            if fti >= 0:
              let nkey: string = "n:" + i64_to_string(fti)
              let n: i64 = hm_get_or(x.deps, nkey, to_i64(0))
              x.deps = x.deps.set("d:" + i64_to_string(fti) + ":" + i64_to_string(n), k)
              x.deps = x.deps.set(nkey, n + 1)
            fi = fi + 1
    sti = sti + 1
  return x

// Derive every indexed class's conformances to every derived concept.
// Per concept: count each class's fields that do not yet conform (one
// pass over its fields), record the classes with none, and propagate
// along the dependency edges — each newly conforming type decrements
// the count of every class carrying a field of that type, once per such
// field; a class is recorded when its count reaches zero.  Every field
// is examined once and every edge once.  A field of unresolved type
// blocks its class (count -1).
fn derive_program_conformances(reg: Registry, idx: ClassIndex): Registry
  let r: Registry = reg
  let di: i64 = 0
  while di < r.conform.derived_concepts.length():
    let dcti: i64 = r.conform.derived_concepts.get(di)
    let pending: Vector<i64> = Vector<i64>::new()
    let queue: Vector<i64> = Vector<i64>::new()
    let k: i64 = 0
    while k < idx.tis.length():
      let cnt: i64 = 0
      let blocked: bool = false
      let fi: i64 = 0
      while fi < idx.f_count.get(k):
        let fti: i64 = idx.f_tis.get(idx.f_start.get(k) + fi)
        if fti < 0:
          blocked = true
        else:
          if reg_conforms(r, fti, dcti, idx.mods.get(k)) == false:
            cnt = cnt + 1
        fi = fi + 1
      if blocked:
        pending = pending.push(to_i64(-1))
      else:
        pending = pending.push(cnt)
      k = k + 1
    // Every count is taken against the conformances known before this
    // concept's derivation starts; only then are the classes with no
    // pending field recorded and queued.  Recording during the count
    // would let a later class omit an already-derived field from its
    // count and still receive that field's decrement.
    let zk: i64 = 0
    while zk < idx.tis.length():
      if pending.get(zk) == 0:
        let zstep: DeriveStep = derive_class(r, idx, zk, dcti, queue)
        r = zstep.reg
        queue = zstep.queue
      zk = zk + 1
    let qi: i64 = 0
    while qi < queue.length():
      let done_ti: i64 = queue.get(qi)
      let dn: i64 = hm_get_or(idx.deps, "n:" + i64_to_string(done_ti), to_i64(0))
      let dj: i64 = 0
      while dj < dn:
        let dep_k: i64 = hm_get_or(idx.deps, "d:" + i64_to_string(done_ti) + ":" + i64_to_string(dj), to_i64(-1))
        // A dependent whose own module's `extend` already conformed this
        // type counted it as conforming; only the others are decremented.
        if dep_k >= 0 and r.conform.known.contains(conform_key(done_ti, dcti, idx.mods.get(dep_k))) == false:
          let p: i64 = pending.get(dep_k)
          if p > 0:
            let p2: i64 = p - 1
            pending = pending.set(dep_k, p2)
            if p2 == 0:
              let dstep: DeriveStep = derive_class(r, idx, dep_k, dcti, queue)
              r = dstep.reg
              queue = dstep.queue
        dj = dj + 1
      qi = qi + 1
    di = di + 1
  return r

// The registries and worklist after a class is recorded as deriving.
class DeriveStep:
  reg: Registry
  queue: Vector<i64>

// Record that class `k` derives `dcti` — visible everywhere, as a
// derivation is a property of the type — and queue it for propagation
// to its dependents.  A class already conforming everywhere (the
// prelude's extend) was counted as conforming by every dependent, so
// there is nothing to record or propagate.
fn derive_class(reg: Registry, idx: ClassIndex, k: i64, dcti: i64, queue: Vector<i64>): DeriveStep
  let sti: i64 = idx.tis.get(k)
  if reg.conform.known.contains(conform_key(sti, dcti, conform_everywhere())):
    return DeriveStep(reg, queue)
  return DeriveStep(reg_record_conformance(reg, sti, dcti, conform_everywhere()), queue.push(sti))

fn hm_get_or(m: HashMap<i64>, key: string, dflt: i64): i64
  let found: Option<i64> = m.get(key)
  match found:
    Option::Some(v):
      return v
    Option::None:
      return dflt
  return dflt

// The conformance-collection pass over a file (tc_collect_conformances).
fn tc_pass_collect(ts: TS, file_node_idx: i64): TS
  let file_node: Node = ts.tc.nodes.get(file_node_idx)
  match file_node:
    Node::FileN(module_decl, imports_lp, decls_lp):
      return tc_collect_conformances(ts, read_list(ts.tc.idx_data, decls_lp))
  return ts

// The concept-satisfaction pass over a file: every extend's methods
// against the concept's requirements, once every module's signatures
// and method tables exist.
fn tc_pass_satisfaction(ts: TS, file_node_idx: i64): TS
  let file_node: Node = ts.tc.nodes.get(file_node_idx)
  match file_node:
    Node::FileN(module_decl, imports_lp, decls_lp):
      return tc_check_concept_satisfaction(ts, read_list(ts.tc.idx_data, decls_lp))
  return ts

// The bodies of a class's or an extend's methods, block- or
// expression-bodied (their bounds were bound with the module's,
// tc_bind_module_bounds).
fn tc_check_owner_methods(ts: TS, owner_decl_idx: i64, methods_lp: i64): TS
  if methods_lp < 0:
    return ts
  let own: TypeR = method_owner(ts, owner_decl_idx)
  let r: TS = own.ts
  let meths: Vector<i64> = read_list(r.tc.idx_data, methods_lp)
  let mi: i64 = 0
  while mi < meths.length():
    let meth_idx: i64 = meths.get(mi)
    let meth_node: Node = r.tc.nodes.get(meth_idx)
    match meth_node:
      Node::FnDeclD(m_name_tidx, m_tparams_lp, m_params_lp, m_ret_type, m_body_lp):
        r = tc_check_method_body(r, own.type_idx, meth_idx, m_name_tidx, m_params_lp, m_body_lp)
      Node::ExprFnD(m_name_tidx, m_tparams_lp, m_params_lp, m_ret_type, m_body_expr):
        r = tc_check_method_expr_body(r, own.type_idx, meth_idx, m_name_tidx, m_params_lp, m_body_expr)
    mi = mi + 1
  return r

fn tc_pass2(ts: TS, file_node_idx: i64): TS
  let file_node: Node = ts.tc.nodes.get(file_node_idx)
  match file_node:
    Node::FileN(module_decl, imports_lp, decls_lp):
      let decls: Vector<i64> = read_list(ts.tc.idx_data, decls_lp)
      let r: TS = ts
      let i: i64 = 0
      while i < decls.length():
        let decl_idx: i64 = decls.get(i)
        let node: Node = r.tc.nodes.get(decl_idx)
        match node:
          Node::FnDeclD(name_tidx, tparams_lp, params_lp, ret_type_node, body_lp):
            r = tc_check_fn_body(r, decl_idx, name_tidx, params_lp, ret_type_node, body_lp)
          Node::ExprFnD(name_tidx, tparams_lp, params_lp, ret_type_node, body_expr):
            r = tc_check_expr_fn_body(r, decl_idx, name_tidx, params_lp, ret_type_node, body_expr)
          Node::ClassDeclD(name_tidx, tparams_lp, fields_lp, methods_lp):
            r = tc_check_owner_methods(r, decl_idx, methods_lp)
          Node::ExtendDeclD(target_type_node, concept_name_tidx, methods_lp):
            r = tc_check_owner_methods(r, decl_idx, methods_lp)
        i = i + 1
      return r
  return ts

/// The bounds of every declaration in the module that takes type
/// parameters — body or none, a class's and an extend's methods and a
/// concept's required methods included — bound to the parameters.
fn tc_bind_module_bounds(ts: TS, decls: Vector<i64>): TS
  let r: TS = ts
  let i: i64 = 0
  while i < decls.length():
    let decl_idx: i64 = decls.get(i)
    let node: Node = r.tc.nodes.get(decl_idx)
    match node:
      Node::FnDeclD(name_tidx, tparams_lp, params_lp, ret_type_node, body_lp):
        r = tc_bind_generic_bounds(r, tparams_lp)
      Node::ExprFnD(name_tidx, tparams_lp, params_lp, ret_type_node, body_expr):
        r = tc_bind_generic_bounds(r, tparams_lp)
      Node::ExternFnD(name_tidx, tparams_lp, params_lp, ret_type_node):
        r = tc_bind_generic_bounds(r, tparams_lp)
      Node::EnumDeclD(name_tidx, tparams_lp, variants_lp):
        r = tc_bind_generic_bounds(r, tparams_lp)
      Node::ClassDeclD(name_tidx, tparams_lp, fields_lp, methods_lp):
        r = tc_bind_generic_bounds(r, tparams_lp)
        r = tc_bind_method_bounds(r, methods_lp)
      Node::ExtendDeclD(target_type_node, concept_name_tidx, methods_lp):
        r = tc_bind_method_bounds(r, methods_lp)
      Node::ConceptDeclD(name_tidx, tparams_lp, methods_lp, is_derived):
        r = tc_bind_generic_bounds(r, tparams_lp)
        r = tc_bind_method_bounds(r, methods_lp)
    i = i + 1
  return r


/// The bounds of each method in `methods_lp` (signature-only,
/// expression-bodied, or block-bodied), or nothing for -1.
fn tc_bind_method_bounds(ts: TS, methods_lp: i64): TS
  if methods_lp < 0:
    return ts
  let r: TS = ts
  let meths: Vector<i64> = read_list(r.tc.idx_data, methods_lp)
  let mi: i64 = 0
  while mi < meths.length():
    match r.tc.nodes.get(meths.get(mi)):
      Node::FnDeclD(m_name_tidx, m_tparams_lp, m_params_lp, m_ret_type, m_body_lp):
        r = tc_bind_generic_bounds(r, m_tparams_lp)
      Node::ExprFnD(m_name_tidx, m_tparams_lp, m_params_lp, m_ret_type, m_body_expr):
        r = tc_bind_generic_bounds(r, m_tparams_lp)
      Node::ExternFnD(m_name_tidx, m_tparams_lp, m_params_lp, m_ret_type):
        r = tc_bind_generic_bounds(r, m_tparams_lp)
    mi = mi + 1
  return r

// =========================================================================
// Section 45a: Per-module concept binding extraction (Task 27 D3)
// =========================================================================

// =========================================================================
// Section 46: Public type checker API
// =========================================================================

// =========================================================================
// Section 46a: Program-level typecheck orchestration (Task 27 D5)
// =========================================================================

// Helper: build per-module TC from Program state.
fn build_module_tc(p: Program, mid: i64): TC
  let sf: SourceFile = program_file_of_module(p, mid)
  let po: ParseOutput = sf.parse_output
  return TC(po.nodes, po.idx, po.toks, sf.source_text, p.resolve.symbols, p.resolve.scopes, p.resolve.uses, sf.file_id, p.resolve.extend_concept_bindings, mid, p.resolve.module_exports)



// The state a program's type check accumulates across its modules: the
// shared type tables, the program-wide registries, and every module's
// diagnostics.
class TcAccum:
  types: Vector<DaoType>
  type_info: Vector<i64>
  sym_types: Vector<i64>
  reg: Registry
  diags: Vector<FileDiagnostic>

// Run one file-level pass over every module in dependency order,
// threading the accumulated state through and folding each module's
// diagnostics in.
fn run_program_pass(p: Program, acc: TcAccum, pass: TcPass): TcAccum
  let a: TcAccum = acc
  let ti: i64 = 0
  while ti < p.graph.topo_order.length():
    let mid: i64 = p.graph.topo_order.get(ti)
    let sf: SourceFile = program_file_of_module(p, mid)
    let ts: TS = ts_new(build_module_tc(p, mid), a.types, a.type_info, a.sym_types, a.reg)
    ts = tc_file_pass(ts, pass, sf.parse_output.root)
    let diags: Vector<FileDiagnostic> = a.diags
    let di: i64 = 0
    while di < ts.diags.length():
      diags = diags.push(FileDiagnostic(sf.file_id, sf.path, ts.diags.get(di)))
      di = di + 1
    a = TcAccum(ts.types, ts.type_info, ts.sym_types, ts.reg, diags)
    ti = ti + 1
  return a

// Run type checking over the full program, one pass at a time over
// every module (TcPass, in order): identities, then — after the
// program's aliases are resolved (tc_resolve_aliases) — every other
// declaration and signature, then concept satisfaction, then the
// conformance map, then program-wide derivation, then bodies.  Every type declared anywhere
// in the program is registered before any signature names it, and every
// derived conformance is known before any body is checked — a function
// in app::main calling core::fmt::print finds its type in sym_types, and
// a class in one prelude file derives through a concept in another.
//
// Concept satisfaction is signature-level only: every required method
// has a matching signature on the implementing type's method set.  Body
// correctness is the bodies pass's.
fn program_run_typecheck(p: Program): Program
  p = program_init_typecheck(p)
  // Seed diagnostics from the resolve pass only (the pre-typecheck
  // baseline), NOT from p.diags which may already include typecheck
  // diagnostics from a prior run. This prevents diagnostic
  // duplication on reentrant calls — same guard pattern as
  // program_init_typecheck's initialized flag.
  let acc: TcAccum = TcAccum(p.typecheck.types, p.typecheck.type_info, p.typecheck.sym_types, reg_with_expr_types(registry_new(p.resolve.symbols, p.graph.modules), p.typecheck.lookup.expr_types), p.resolve.diags)
  acc = run_program_pass(p, acc, TcPass::Shells)
  acc = tc_resolve_aliases(p, acc)
  acc = run_program_pass(p, acc, TcPass::Declarations)
  acc = run_program_pass(p, acc, TcPass::Satisfaction)
  acc = run_program_pass(p, acc, TcPass::Collect)
  // Derivation runs once over every struct in the program at program scope.
  acc = TcAccum(acc.types, acc.type_info, acc.sym_types, derive_program_conformances(acc.reg, index_program_structs(acc.types, acc.type_info)), acc.diags)
  acc = run_program_pass(p, acc, TcPass::Bodies)
  let td: TypeCheckData = TypeCheckData(true, acc.types, acc.type_info, acc.sym_types, ProgramLookup(acc.reg.expr_types, acc.reg.methods, acc.reg.index))
  return Program(p.graph, p.resolve, td, p.hir, acc.diags)

// =========================================================================
// Section 46b: Legacy single-file typecheck adapter
// =========================================================================

// Legacy single-file typecheck adapter.  Routes through the program
// pipeline (build_program → resolve_program → program_run_typecheck)
// and projects a legacy TypeCheckResult for existing callers.
fn typecheck(src: string): TypeCheckResult
  // Legacy single-file adapter. Uses program_init_typecheck for
  // builtin seeding but runs tc_pass1/tc_pass2 directly (not via
  // program_run_typecheck) because the legacy TypeCheckResult needs
  // per-file expr_types which the program orchestrator does not
  // accumulate into TypeCheckData. Multi-module callers should use
  // program_run_typecheck instead.
  let wrapped: string = wrap_test_module(src)
  let inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  inputs = inputs.push(SourceInput("test.dao", wrapped, false))
  let pg: ProgramGraph = build_program(inputs)
  let p: Program = program_from_graph(pg)
  p = program_run_resolve(p)
  p = program_init_typecheck(p)

  // Build per-module TC/TS and run the passes directly (one module:
  // one sweep of each).
  let tc: TC = build_module_tc(p, to_i64(0))
  let sf: SourceFile = program_file_of_module(p, to_i64(0))
  let po: ParseOutput = sf.parse_output
  let ts: TS = ts_new(tc, p.typecheck.types, p.typecheck.type_info, p.typecheck.sym_types, reg_with_expr_types(registry_new(p.resolve.symbols, p.graph.modules), p.typecheck.lookup.expr_types))

  // Collect resolve diagnostics into TS.
  let rdi: i64 = 0
  while rdi < p.resolve.diags.length():
    ts.diags = ts.diags.push(p.resolve.diags.get(rdi).diag)
    rdi = rdi + 1

  ts = tc_pass_shells(ts, po.root)
  let aliased: TcAccum = tc_resolve_aliases(p, TcAccum(ts.types, ts.type_info, ts.sym_types, ts.reg, Vector<FileDiagnostic>::new()))
  ts.types = aliased.types
  ts.type_info = aliased.type_info
  ts.sym_types = aliased.sym_types
  ts.reg = aliased.reg
  ts = tc_pass1(ts, po.root)
  ts = tc_pass_satisfaction(ts, po.root)
  ts = tc_pass_collect(ts, po.root)
  ts.reg = derive_program_conformances(ts.reg, index_program_structs(ts.types, ts.type_info))
  ts = tc_pass2(ts, po.root)

  return TypeCheckResult(ts.types, ts.type_info, ts.reg.expr_types, ts.sym_types, ts.diags, po.nodes.length())
