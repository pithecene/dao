module bootstrap::typecheck_tests
// Test runner for the bootstrap typecheck.  Assembled after the
// shared base and every library it exercises; never compiled
// standalone.

// =========================================================================
// Section 47: Test helpers
// =========================================================================

fn tc_count_diags(result: TypeCheckResult): i64
  return result.diags.length()

// Typecheck `src` and report whether it is free of diagnostics, naming
// the scenario.  Extracted so each literal-fitting case is one line.
fn tc_expect_clean(label: string, src: string): bool
  let res: TypeCheckResult = typecheck(src)
  if tc_count_diags(res) == 0:
    print("PASS " + label)
    return true
  print("FAIL " + label + ": expected 0 diagnostics, got " + i64_to_string(tc_count_diags(res)))
  return false

// Typecheck `src` and report whether it yields exactly `n` diagnostics.
fn tc_expect_diags(label: string, src: string, n: i64): bool
  let res: TypeCheckResult = typecheck(src)
  if tc_count_diags(res) == n:
    print("PASS " + label)
    return true
  print("FAIL " + label + ": expected " + i64_to_string(n) + " diagnostics, got " + i64_to_string(tc_count_diags(res)))
  return false

// Typecheck `src` and report whether it is rejected (at least one
// diagnostic), when the exact count is not the point.
fn tc_expect_rejected(label: string, src: string): bool
  let res: TypeCheckResult = typecheck(src)
  if tc_count_diags(res) >= 1:
    print("PASS " + label)
    return true
  print("FAIL " + label + ": expected a diagnostic, got 0")
  return false

// Typecheck `src` and report whether exactly one diagnostic is raised
// and its message contains `needle`.
fn tc_expect_diag_containing(label: string, src: string, needle: string): bool
  let res: TypeCheckResult = typecheck(src)
  if tc_count_diags(res) == 1:
    if index_of(res.diags.get(to_i64(0)).message, needle) >= 0:
      print("PASS " + label)
      return true
  print("FAIL " + label + ": expected one diagnostic containing '" + needle + "', got " + i64_to_string(tc_count_diags(res)))
  let i: i64 = 0
  while i < res.diags.length():
    print("  diag: " + res.diags.get(i).message)
    i = i + 1
  return false

fn tc_count_types(result: TypeCheckResult): i64
  return result.types.length()

// A dispatch index holding one extend method of type 2 (`i32`) from the
// prelude (symbol 0) and one from module 0 (symbol 1).
fn test_dispatch_index(): HashMap<i64>
  let m: HashMap<i64> = HashMap<i64>::new()
  m = m.set(dispatch_key_extend(to_i64(2), "show", conform_everywhere()), to_i64(0))
  m = m.set(dispatch_key_extend(to_i64(2), "show", to_i64(0)), to_i64(1))
  return m

// Resolve and typecheck a program — the library files `libs` (each
// marked prelude or not) and a main file — and report whether main.dao
// and report whether the file at `in_path` carries exactly `n` error
// diagnostics and every other file none, printing them otherwise.
fn tc_expect_program_errors(label: string, libs: Vector<SourceInput>, main_src: string, in_path: string, n: i64): bool
  let inputs: Vector<SourceInput> = libs.push(SourceInput("main.dao", main_src, false))
  let p: Program = program_from_graph(build_program(inputs))
  p = program_run_resolve(p)
  p = program_run_typecheck(p)
  let errs: i64 = 0
  let lib_errs: i64 = 0
  let i: i64 = 0
  while i < p.diags.length():
    let fd: FileDiagnostic = p.diags.get(i)
    if fd.diag.severity == Severity::Error:
      if fd.path == in_path:
        errs = errs + 1
      else:
        lib_errs = lib_errs + 1
    i = i + 1
  if errs == n and lib_errs == 0:
    print("PASS " + label)
    return true
  print("FAIL " + label + ": expected " + i64_to_string(n) + " errors in " + in_path + " and none elsewhere, got " + i64_to_string(errs) + " and " + i64_to_string(lib_errs))
  let j: i64 = 0
  while j < p.diags.length():
    print("  diag: " + p.diags.get(j).path + ": " + p.diags.get(j).diag.message)
    j = j + 1
  return false

// =========================================================================
// Section 48: Golden type checker tests
// =========================================================================

// The node index of the first method a file's first class declares:
// a program-level test checks that two modules' declarations at one
// index stay apart.
fn first_method_decl_index(po: ParseOutput): i64
  let root: Node = po.nodes.get(po.root)
  match root:
    Node::FileN(md, ilp, dlp):
      let decls: Vector<i64> = read_list(po.idx, dlp)
      let i: i64 = 0
      while i < decls.length():
        let decl: Node = po.nodes.get(decls.get(i))
        match decl:
          Node::ClassDeclD(nt, tp, flp, mlp):
            if mlp >= 0:
              let meths: Vector<i64> = read_list(po.idx, mlp)
              if meths.length() > 0:
                return meths.get(to_i64(0))
        i = i + 1
  return to_i64(-1)

fn main(): i32
  print("=== bootstrap/typecheck: Task 23 — Bootstrap Type Checker ===")
  print("")

  let pass_count: i32 = 0
  let total: i32 = 167

  // Test 1: correct_arithmetic
  let src1: string = "fn main(): i32\n  return 1 + 2\n"
  let r1: TypeCheckResult = typecheck(src1)
  if tc_count_types(r1) > 13:
    print("PASS correct_arithmetic")
    pass_count = pass_count + 1
  else:
    print("FAIL correct_arithmetic: expected > 13 types, got " + i64_to_string(tc_count_types(r1)))

  // Test 2: correct_let
  let src2: string = "fn main(): i32\n  let x: i32 = 42\n  return x\n"
  let r2: TypeCheckResult = typecheck(src2)
  if tc_count_diags(r2) == 0:
    print("PASS correct_let")
    pass_count = pass_count + 1
  else:
    print("FAIL correct_let: expected 0 diagnostics, got " + i64_to_string(tc_count_diags(r2)))

  // Test 3: correct_fn_return
  let src3: string = "fn add(a: i32, b: i32): i32\n  return a + b\n"
  let r3: TypeCheckResult = typecheck(src3)
  if tc_count_diags(r3) == 0:
    print("PASS correct_fn_return")
    pass_count = pass_count + 1
  else:
    print("FAIL correct_fn_return: expected 0 diagnostics, got " + i64_to_string(tc_count_diags(r3)))

  // Test 4: err_type_mismatch
  let src4: string = "fn main(): i32\n  let x: i32 = \"hello\"\n  return 0\n"
  let r4: TypeCheckResult = typecheck(src4)
  if tc_count_diags(r4) >= 1:
    print("PASS err_type_mismatch")
    pass_count = pass_count + 1
  else:
    print("FAIL err_type_mismatch: expected >= 1 diagnostic, got " + i64_to_string(tc_count_diags(r4)))

  // Test 5: err_non_bool_condition
  let src5: string = "fn main(): i32\n  if 42:\n    return 1\n  return 0\n"
  let r5: TypeCheckResult = typecheck(src5)
  if tc_count_diags(r5) >= 1:
    print("PASS err_non_bool_condition")
    pass_count = pass_count + 1
  else:
    print("FAIL err_non_bool_condition: expected >= 1 diagnostic, got " + i64_to_string(tc_count_diags(r5)))

  // Test 6: err_arity_mismatch
  let src6: string = "fn foo(x: i32): i32\n  return x\n\nfn main(): i32\n  return foo(1, 2)\n"
  let r6: TypeCheckResult = typecheck(src6)
  if tc_count_diags(r6) >= 1:
    print("PASS err_arity_mismatch")
    pass_count = pass_count + 1
  else:
    print("FAIL err_arity_mismatch: expected >= 1 diagnostic, got " + i64_to_string(tc_count_diags(r6)))

  // Test 7: err_break_outside_loop
  let src7: string = "fn main(): i32\n  break\n  return 0\n"
  let r7: TypeCheckResult = typecheck(src7)
  if tc_count_diags(r7) >= 1:
    print("PASS err_break_outside_loop")
    pass_count = pass_count + 1
  else:
    print("FAIL err_break_outside_loop: expected >= 1 diagnostic, got " + i64_to_string(tc_count_diags(r7)))

  // Test 8: correct_struct_constructor
  let src8: string = "class Point:\n  x: i32\n  y: i32\n\nfn main(): i32\n  let p: Point = Point(1, 2)\n  return 0\n"
  let r8: TypeCheckResult = typecheck(src8)
  if tc_count_types(r8) >= 15:
    print("PASS correct_struct_constructor")
    pass_count = pass_count + 1
  else:
    print("FAIL correct_struct_constructor: expected >= 15 types, got " + i64_to_string(tc_count_types(r8)))

  // Test 9: correct_field_access
  let src9: string = "class Point:\n  x: i32\n  y: i32\n\nfn get_x(p: Point): i32\n  return p.x\n"
  let r9: TypeCheckResult = typecheck(src9)
  if tc_count_diags(r9) == 0:
    print("PASS correct_field_access")
    pass_count = pass_count + 1
  else:
    print("FAIL correct_field_access: expected 0 diagnostics, got " + i64_to_string(tc_count_diags(r9)))

  // Test 10: correct_enum
  let src10: string = "enum Color:\n  Red\n  Green\n  Blue\n\nfn main(): i32\n  let c = Color::Red\n  return 0\n"
  let r10: TypeCheckResult = typecheck(src10)
  if tc_count_types(r10) >= 14:
    print("PASS correct_enum")
    pass_count = pass_count + 1
  else:
    print("FAIL correct_enum: expected >= 14 types, got " + i64_to_string(tc_count_types(r10)))

  // Test 11: correct_if_else
  let src11: string = "fn abs(x: i32): i32\n  if x > 0:\n    return x\n  else:\n    return 0 - x\n"
  let r11: TypeCheckResult = typecheck(src11)
  if tc_count_diags(r11) == 0:
    print("PASS correct_if_else")
    pass_count = pass_count + 1
  else:
    print("FAIL correct_if_else: expected 0 diagnostics, got " + i64_to_string(tc_count_diags(r11)))

  // Test 12: correct_while
  let src12: string = "fn countdown(n: i32): i32\n  let x: i32 = n\n  while x > 0:\n    x = x - 1\n  return x\n"
  let r12: TypeCheckResult = typecheck(src12)
  if tc_count_diags(r12) == 0:
    print("PASS correct_while")
    pass_count = pass_count + 1
  else:
    print("FAIL correct_while: expected 0 diagnostics, got " + i64_to_string(tc_count_diags(r12)))

  // Test 13: err_return_mismatch
  let src13: string = "fn foo(): i32\n  return \"hello\"\n"
  let r13: TypeCheckResult = typecheck(src13)
  if tc_count_diags(r13) >= 1:
    print("PASS err_return_mismatch")
    pass_count = pass_count + 1
  else:
    print("FAIL err_return_mismatch: expected >= 1 diagnostic, got " + i64_to_string(tc_count_diags(r13)))

  // Test 14: err_unknown_type
  let src14: string = "fn main(): i32\n  let x: Foo = 42\n  return 0\n"
  let r14: TypeCheckResult = typecheck(src14)
  if tc_count_diags(r14) >= 1:
    print("PASS err_unknown_type")
    pass_count = pass_count + 1
  else:
    print("FAIL err_unknown_type: expected >= 1 diagnostic, got " + i64_to_string(tc_count_diags(r14)))

  // Test 15: correct_expr_fn
  let src15: string = "fn double(x: i32): i32 -> x + x\n"
  let r15: TypeCheckResult = typecheck(src15)
  if tc_count_diags(r15) == 0:
    print("PASS correct_expr_fn")
    pass_count = pass_count + 1
  else:
    print("FAIL correct_expr_fn: expected 0 diagnostics, got " + i64_to_string(tc_count_diags(r15)))

  // Test 15a: correct_addr_of — &x on an identifier
  let src15a: string = "fn test(): i32\n  let x: i32 = 1\n  let p: *i32 = &x\n  return 0\n"
  let r15a: TypeCheckResult = typecheck(src15a)
  if tc_count_diags(r15a) == 0:
    print("PASS correct_addr_of")
    pass_count = pass_count + 1
  else:
    print("FAIL correct_addr_of: expected 0 diagnostics, got " + i64_to_string(tc_count_diags(r15a)))

  // Test 15b: correct_deref — *p where p: *i32 produces i32
  let src15b: string = "fn test(): i32\n  let x: i32 = 1\n  let p: *i32 = &x\n  let y: i32 = *p\n  return 0\n"
  let r15b: TypeCheckResult = typecheck(src15b)
  if tc_count_diags(r15b) == 0:
    print("PASS correct_deref")
    pass_count = pass_count + 1
  else:
    print("FAIL correct_deref: expected 0 diagnostics, got " + i64_to_string(tc_count_diags(r15b)))

  // Test 15c: err_deref_non_pointer — *x where x: i32 should diagnose
  let src15c: string = "fn test(): i32\n  let x: i32 = 1\n  let y: i32 = *x\n  return 0\n"
  let r15c: TypeCheckResult = typecheck(src15c)
  let found_deref_err: bool = false
  let d15c: i64 = 0
  while d15c < r15c.diags.length():
    let dd: Diagnostic = r15c.diags.get(d15c)
    if dd.message == "cannot dereference non-pointer type i32":
      found_deref_err = true
    d15c = d15c + 1
  if found_deref_err:
    print("PASS err_deref_non_pointer")
    pass_count = pass_count + 1
  else:
    print("FAIL err_deref_non_pointer: expected non-pointer deref diagnostic")

  // Test 15d: err_addr_of_literal — &42 is not an lvalue
  let src15d: string = "fn test(): i32\n  let p: *i32 = &42\n  return 0\n"
  let r15d: TypeCheckResult = typecheck(src15d)
  let found_lvalue_err: bool = false
  let d15d: i64 = 0
  while d15d < r15d.diags.length():
    let dd2: Diagnostic = r15d.diags.get(d15d)
    if dd2.message == "cannot take address of non-lvalue":
      found_lvalue_err = true
    d15d = d15d + 1
  if found_lvalue_err:
    print("PASS err_addr_of_literal")
    pass_count = pass_count + 1
  else:
    print("FAIL err_addr_of_literal: expected non-lvalue addr-of diagnostic")

  // Test 16: err_assign_to_literal — assignment to non-lvalue
  let src16a: string = "fn test(): i32\n  42 = 1\n  return 0\n"
  let r16a: TypeCheckResult = typecheck(src16a)
  if tc_count_diags(r16a) >= 1:
    print("PASS err_assign_to_literal")
    pass_count = pass_count + 1
  else:
    print("FAIL err_assign_to_literal: expected diagnostic for non-lvalue target")

  // Test 17: err_pipe_type_mismatch — pipe LHS type incompatible with RHS first param
  let src17: string = "fn add_one(x: i32): i32\n  return x + 1\n\nfn test(): i32\n  let x: string = \"hello\" |> add_one\n  return 0\n"
  let r17: TypeCheckResult = typecheck(src17)
  if tc_count_diags(r17) >= 1:
    print("PASS err_pipe_type_mismatch")
    pass_count = pass_count + 1
  else:
    print("FAIL err_pipe_type_mismatch: expected diagnostic for pipe argument type")

  // Test 18: err_match_pattern_type — match arm pattern type != scrutinee type
  let src18: string = "fn test(): i32\n  let x: i32 = 1\n  match x:\n    \"hello\":\n      return 0\n  return 0\n"
  let r18: TypeCheckResult = typecheck(src18)
  if tc_count_diags(r18) >= 1:
    print("PASS err_match_pattern_type")
    pass_count = pass_count + 1
  else:
    print("FAIL err_match_pattern_type: expected diagnostic for pattern type mismatch")

  // Test 19: generic_fn_parses — fn identity<T>(x: T): T typechecks and
  // produces TGenericParam in the type table.
  let src19: string = "fn identity<T>(x: T): T\n  return x\n"
  let r19: TypeCheckResult = typecheck(src19)
  let found_gp: bool = false
  let ti19: i64 = 0
  while ti19 < tc_count_types(r19):
    let t19: DaoType = r19.types.get(ti19)
    match t19.kind:
      TypeKind::TGenericParam:
        found_gp = true
      TypeKind::TFunction:
        found_gp = found_gp
      TypeKind::TStruct:
        found_gp = found_gp
    ti19 = ti19 + 1
  if found_gp:
    print("PASS generic_fn_parses")
    pass_count = pass_count + 1
  else:
    print("FAIL generic_fn_parses: TGenericParam not found in types (count: " + i64_to_string(tc_count_types(r19)) + ")")

  // Test 20: extend method body type-checks
  let src20e: string = "class Foo:\n  x: i32\n\nconcept Printable:\n  fn to_string(self): string\n\nextend Foo as Printable:\n  fn to_string(self): string\n    return \"Foo\"\n"
  let r20e: TypeCheckResult = typecheck(src20e)
  if tc_count_diags(r20e) == 0:
    print("PASS extend_method_typecheck")
    pass_count = pass_count + 1
  else:
    print("FAIL extend_method_typecheck: expected 0 diagnostics, got " + i64_to_string(tc_count_diags(r20e)))

  // Test 21: concept_satisfaction — missing method produces diagnostic
  let src21c: string = "concept Showable:\n  fn show(self): string\n\nclass Foo:\n  x: i32\n\nextend Foo as Showable:\n  fn other(self): i32\n    return self.x\n"
  let r21c: TypeCheckResult = typecheck(src21c)
  if tc_count_diags(r21c) >= 1:
    print("PASS concept_satisfaction_missing_method")
    pass_count = pass_count + 1
  else:
    print("FAIL concept_satisfaction_missing_method: expected diagnostic for missing 'show' method")

  // Test 22: concept_satisfaction — correct extend has no extra diagnostics
  let src22c: string = "concept Showable:\n  fn show(self): string\n\nclass Bar:\n  name: string\n\nextend Bar as Showable:\n  fn show(self): string\n    return self.name\n"
  let r22c: TypeCheckResult = typecheck(src22c)
  // May have some diagnostics from resolution, but should NOT have
  // "does not implement required method" diagnostic
  let has_missing: bool = false
  let di22: i64 = 0
  while di22 < tc_count_diags(r22c):
    let d22: Diagnostic = r22c.diags.get(di22)
    if d22.message == "extend does not implement required method 'show' from concept 'Showable'":
      has_missing = true
    di22 = di22 + 1
  if has_missing == false:
    print("PASS concept_satisfaction_correct")
    pass_count = pass_count + 1
  else:
    print("FAIL concept_satisfaction_correct: got false missing-method diagnostic")

  // Test 23: concept_satisfaction — param type mismatch detected
  let src23c: string = "concept Eqable:\n  fn eq(self, other: i32): bool\n\nclass Baz:\n  val: i32\n\nextend Baz as Eqable:\n  fn eq(self, other: string): bool\n    return false\n"
  let r23c: TypeCheckResult = typecheck(src23c)
  let has_param_mismatch: bool = false
  let di23: i64 = 0
  while di23 < tc_count_diags(r23c):
    let d23: Diagnostic = r23c.diags.get(di23)
    // Check for param type mismatch diagnostic
    if d23.severity == Severity::Error:
      has_param_mismatch = true
    di23 = di23 + 1
  if has_param_mismatch:
    print("PASS concept_satisfaction_param_mismatch")
    pass_count = pass_count + 1
  else:
    print("FAIL concept_satisfaction_param_mismatch: expected param type mismatch diagnostic")

  // Test 24: self_typecheck_smoke
  let self_path: string = "examples/bootstrap_probe/expr_parser.dao"
  if file_exists(self_path):
    let self_src: string = read_file(self_path)
    let self_r: TypeCheckResult = typecheck(self_src)
    let self_types: i64 = tc_count_types(self_r)
    let self_diags: i64 = tc_count_diags(self_r)
    print("  [info] self-typecheck types: " + i64_to_string(self_types))
    print("  [info] self-typecheck diagnostics: " + i64_to_string(self_diags))
    print("  [info] self-typecheck nodes: " + i64_to_string(self_r.node_count))
    if self_types > 13:
      print("PASS self_typecheck_smoke")
      pass_count = pass_count + 1
    else:
      print("FAIL self_typecheck_smoke: too few types (" + i64_to_string(self_types) + ")")
  else:
    print("SKIP self_typecheck_smoke: file not found at " + self_path)

  print("")
  // -----------------------------------------------------------------
  // Task 27 D1a: Program-level typecheck substrate
  // -----------------------------------------------------------------

  // Test d1a_1: program_init_typecheck seeds canonical builtins.
  let p_inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  p_inputs = p_inputs.push(SourceInput("a.dao", "module a\nfn f(): i32 -> 0\n", false))
  let p_pg: ProgramGraph = build_program(p_inputs)
  let p_val: Program = program_from_graph(p_pg)
  let p_r: Program = program_run_resolve(p_val)
  let p_tc: Program = program_init_typecheck(p_r)
  let d1a_1_ok: bool = true
  // Builtins: 13 types (i8..u64, f32, f64, bool, void, string).
  if p_tc.typecheck.types.length() != 13:
    d1a_1_ok = false
  if p_tc.typecheck.initialized != true:
    d1a_1_ok = false
  // i32 should be at index 2 with name "i32".
  if p_tc.typecheck.types.length() > 2:
    let i32_type: DaoType = p_tc.typecheck.types.get(2)
    if i32_type.name != "i32":
      d1a_1_ok = false
  // void at index 11.
  if p_tc.typecheck.types.length() > 11:
    let void_type: DaoType = p_tc.typecheck.types.get(11)
    if void_type.name != "void":
      d1a_1_ok = false
  if d1a_1_ok:
    print("PASS d1a_program_init_typecheck")
    pass_count = pass_count + 1
  else:
    print("FAIL d1a_program_init_typecheck")

  // Test d1a_1b: double-init is a no-op (preserves accumulated state).
  let td_with_expr: TypeCheckData = tc_set_expr_type(p_tc.typecheck, to_i64(0), to_i64(7), to_i64(2))
  let p_tc_with_expr: Program = Program(p_tc.graph, p_tc.resolve, td_with_expr, p_tc.hir, p_tc.diags)
  let p_tc2: Program = program_init_typecheck(p_tc_with_expr)
  let d1a_1b_ok: bool = true
  // expr_types entry should survive the second init call.
  let preserved: i64 = tc_get_expr_type(p_tc2.typecheck, to_i64(0), to_i64(7))
  if preserved != 2:
    d1a_1b_ok = false
  // types count should still be 13 (not doubled).
  if p_tc2.typecheck.types.length() != 13:
    d1a_1b_ok = false
  if d1a_1b_ok:
    print("PASS d1a_double_init_noop")
    pass_count = pass_count + 1
  else:
    print("FAIL d1a_double_init_noop")

  // Test d1a_2: expr_id_key and tc_get/set_expr_type round-trip.
  let td0: TypeCheckData = p_tc.typecheck
  let td1: TypeCheckData = tc_set_expr_type(td0, to_i64(0), to_i64(42), to_i64(2))
  let td2: TypeCheckData = tc_set_expr_type(td1, to_i64(1), to_i64(42), to_i64(11))
  let d1a_2_ok: bool = true
  // Same node_idx 42 in two different modules should be distinct.
  let ty0: i64 = tc_get_expr_type(td2, to_i64(0), to_i64(42))
  let ty1: i64 = tc_get_expr_type(td2, to_i64(1), to_i64(42))
  if ty0 != 2:
    d1a_2_ok = false
  if ty1 != 11:
    d1a_2_ok = false
  // Missing entry returns -1.
  let ty_miss: i64 = tc_get_expr_type(td2, to_i64(99), to_i64(99))
  if ty_miss != to_i64(-1):
    d1a_2_ok = false
  if d1a_2_ok:
    print("PASS d1a_expr_id_round_trip")
    pass_count = pass_count + 1
  else:
    print("FAIL d1a_expr_id_round_trip")

  // -----------------------------------------------------------------
  // Task 27 D3: Resolver-bound concept identity
  // -----------------------------------------------------------------

  // Verify the concept binding flows from resolver → program side table
  // → TC.concept_bindings → tc_check_concept_satisfaction. The concept
  // should be found via its resolved sym_idx (not by name scan), and
  // satisfaction checking should still produce the expected diagnostic
  // when a required method is missing.
  let d3_src: string = "concept Showable:\n  fn show(self): string\n\nclass Msg:\n  text: string\n\nextend Msg as Showable:\n  fn display(self): string -> self.text\n"
  let d3_inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  d3_inputs = d3_inputs.push(SourceInput("d3.dao", "module d3\n" + d3_src, false))
  let d3_pg: ProgramGraph = build_program(d3_inputs)
  let d3_p: Program = program_from_graph(d3_pg)
  d3_p = program_run_resolve(d3_p)
  d3_p = program_init_typecheck(d3_p)

  let d3_ok: bool = true

  // The binding HashMap should have an entry for the extend decl.
  // Walk the single file's extend decls and verify at least one
  // binding resolves via program_extend_concept_sym.
  let d3_sf: SourceFile = program_file_of_module(d3_p, to_i64(0))
  let d3_po: ParseOutput = d3_sf.parse_output
  let d3_found_binding: bool = false
  let d3_root: Node = d3_po.nodes.get(d3_po.root)
  match d3_root:
    Node::FileN(md3, il3, dl3):
      let d3_decls: Vector<i64> = read_list(d3_po.idx, dl3)
      let d3i: i64 = 0
      while d3i < d3_decls.length():
        let d3_didx: i64 = d3_decls.get(d3i)
        let d3_node: Node = d3_po.nodes.get(d3_didx)
        match d3_node:
          Node::ExtendDeclD(t3, c3, m3):
            let d3_sym: i64 = program_extend_concept_sym(d3_p, d3_sf.file_id, d3_didx)
            if d3_sym >= 0:
              d3_found_binding = true
        d3i = d3i + 1
  if d3_found_binding == false:
    d3_ok = false

  // Now run typecheck through the adapter — the extend declares
  // `display` but Showable requires `show`. Should produce a
  // "does not implement required method 'show'" diagnostic, proving
  // concept_satisfaction used the resolver-bound identity.
  let d3_r: TypeCheckResult = typecheck(d3_src)
  let d3_found_diag: bool = false
  let d3_di: i64 = 0
  while d3_di < d3_r.diags.length():
    let d3_d: Diagnostic = d3_r.diags.get(d3_di)
    if d3_d.message == "extend does not implement required method 'show' from concept 'Showable'":
      d3_found_diag = true
    d3_di = d3_di + 1
  if d3_found_diag == false:
    d3_ok = false

  if d3_ok:
    print("PASS d3_concept_binding_identity")
    pass_count = pass_count + 1
  else:
    print("FAIL d3_concept_binding_identity")

  // -----------------------------------------------------------------
  // Regression: multi-extend concept satisfaction (HashMap-in-while)
  // -----------------------------------------------------------------
  // A single module with TWO extend-as-concept blocks.  Before the
  // triples fix, the HashMap-in-while codegen bug caused only the
  // last binding to survive, so the first extend would silently skip
  // concept satisfaction (no diagnostic even when a method is missing).
  //
  // This test verifies that BOTH extends are checked: the first
  // (extend Foo as Showable) is MISSING the required method 'show',
  // so it must produce a diagnostic.  The second (extend Bar as
  // Showable) provides 'show' correctly and should produce no extra
  // diagnostics.

  let me_src: string = "concept Showable:\n  fn show(self): string\n\nclass Foo:\n  x: i32\n\nclass Bar:\n  name: string\n\nextend Foo as Showable:\n  fn other(self): i32\n    return self.x\n\nextend Bar as Showable:\n  fn show(self): string\n    return self.name\n"
  let me_r: TypeCheckResult = typecheck(me_src)
  let me_found: bool = false
  let me_di: i64 = 0
  while me_di < me_r.diags.length():
    let me_d: Diagnostic = me_r.diags.get(me_di)
    if me_d.message == "extend does not implement required method 'show' from concept 'Showable'":
      me_found = true
    me_di = me_di + 1
  if me_found:
    print("PASS multi_extend_concept_satisfaction")
    pass_count = pass_count + 1
  else:
    print("FAIL multi_extend_concept_satisfaction: first extend missing-method not detected")

  // -----------------------------------------------------------------
  // Task 27 D4: Cross-module qualified name typing
  // -----------------------------------------------------------------

  // Test d4_1: cross-module function call types correctly through
  // the Program pipeline (build_program → resolve → typecheck).
  // Two modules: math exports `add`, main imports and calls `math::add(1,2)`.
  let d4_inputs1: Vector<SourceInput> = Vector<SourceInput>::new()
  d4_inputs1 = d4_inputs1.push(SourceInput("math.dao", "module app::math\nfn add(a: i32, b: i32): i32 -> a + b\n", false))
  d4_inputs1 = d4_inputs1.push(SourceInput("main.dao", "module app::main\nimport app::math\nfn f(): i32\n  return math::add(1, 2)\n", false))
  let d4_pg1: ProgramGraph = build_program(d4_inputs1)
  let d4_p1: Program = program_from_graph(d4_pg1)
  d4_p1 = program_run_resolve(d4_p1)
  d4_p1 = program_init_typecheck(d4_p1)
  // Run typecheck on the main module (module_id 1 after math at 0).
  let d4_main_mid: i64 = find_module_by_name(d4_p1.graph.modules, "app::main")
  let d4_sf: SourceFile = program_file_of_module(d4_p1, d4_main_mid)
  let d4_po: ParseOutput = d4_sf.parse_output
  let d4_tc: TC = TC(d4_po.nodes, d4_po.idx, d4_po.toks, d4_sf.source_text, d4_p1.resolve.symbols, d4_p1.resolve.scopes, d4_p1.resolve.uses, d4_sf.file_id, d4_p1.resolve.extend_concept_bindings, d4_main_mid, d4_p1.resolve.module_exports)
  let d4_ts: TS = ts_new(d4_tc, d4_p1.typecheck.types, d4_p1.typecheck.type_info, d4_p1.typecheck.sym_types, registry_new(d4_p1.resolve.symbols, d4_p1.graph.modules))
  // Run pass1 on math first (to register the exported function type).
  let d4_math_mid: i64 = find_module_by_name(d4_p1.graph.modules, "app::math")
  let d4_math_sf: SourceFile = program_file_of_module(d4_p1, d4_math_mid)
  let d4_math_po: ParseOutput = d4_math_sf.parse_output
  let d4_math_tc: TC = TC(d4_math_po.nodes, d4_math_po.idx, d4_math_po.toks, d4_math_sf.source_text, d4_p1.resolve.symbols, d4_p1.resolve.scopes, d4_p1.resolve.uses, d4_math_sf.file_id, d4_p1.resolve.extend_concept_bindings, d4_math_mid, d4_p1.resolve.module_exports)
  let d4_math_ts: TS = ts_new(d4_math_tc, d4_p1.typecheck.types, d4_p1.typecheck.type_info, d4_p1.typecheck.sym_types, registry_new(d4_p1.resolve.symbols, d4_p1.graph.modules))
  d4_math_ts = tc_pass_shells(d4_math_ts, d4_math_po.root)
  d4_math_ts = tc_pass1(d4_math_ts, d4_math_po.root)
  // Now run both passes on main using math's accumulated types/sym_types.
  d4_ts = ts_new(d4_tc, d4_math_ts.types, d4_math_ts.type_info, d4_math_ts.sym_types, reg_with_variant_set(registry_new(d4_p1.resolve.symbols, d4_p1.graph.modules), d4_math_ts.reg.variant_set))
  d4_ts = tc_pass_shells(d4_ts, d4_po.root)
  d4_ts = tc_pass1(d4_ts, d4_po.root)
  d4_ts = tc_pass2(d4_ts, d4_po.root)

  let d4_1_ok: bool = true
  // Should have no type errors (math::add(1,2) should resolve and type-check).
  let d4_err_count: i64 = 0
  let d4_di: i64 = 0
  while d4_di < d4_ts.diags.length():
    d4_err_count = d4_err_count + 1
    d4_di = d4_di + 1
  if d4_err_count > 0:
    d4_1_ok = false
  if d4_1_ok:
    print("PASS d4_cross_module_call")
    pass_count = pass_count + 1
  else:
    print("FAIL d4_cross_module_call: got " + i64_to_string(d4_err_count) + " diagnostic(s)")

  // Test d4_2: missing export produces a clear diagnostic.
  let d4_inputs2: Vector<SourceInput> = Vector<SourceInput>::new()
  d4_inputs2 = d4_inputs2.push(SourceInput("a.dao", "module lib::a\nfn secret(): i32 -> 42\n", false))
  d4_inputs2 = d4_inputs2.push(SourceInput("b.dao", "module app::b\nimport lib::a\nfn f(): i32\n  return a::nonexistent()\n", false))
  let d4_pg2: ProgramGraph = build_program(d4_inputs2)
  let d4_p2: Program = program_from_graph(d4_pg2)
  d4_p2 = program_run_resolve(d4_p2)
  d4_p2 = program_init_typecheck(d4_p2)
  let d4_b_mid: i64 = find_module_by_name(d4_p2.graph.modules, "app::b")
  let d4_b_sf: SourceFile = program_file_of_module(d4_p2, d4_b_mid)
  let d4_b_po: ParseOutput = d4_b_sf.parse_output
  let d4_b_tc: TC = TC(d4_b_po.nodes, d4_b_po.idx, d4_b_po.toks, d4_b_sf.source_text, d4_p2.resolve.symbols, d4_p2.resolve.scopes, d4_p2.resolve.uses, d4_b_sf.file_id, d4_p2.resolve.extend_concept_bindings, d4_b_mid, d4_p2.resolve.module_exports)
  // Run pass1 on lib::a first.
  let d4_a_mid: i64 = find_module_by_name(d4_p2.graph.modules, "lib::a")
  let d4_a_sf: SourceFile = program_file_of_module(d4_p2, d4_a_mid)
  let d4_a_po: ParseOutput = d4_a_sf.parse_output
  let d4_a_tc: TC = TC(d4_a_po.nodes, d4_a_po.idx, d4_a_po.toks, d4_a_sf.source_text, d4_p2.resolve.symbols, d4_p2.resolve.scopes, d4_p2.resolve.uses, d4_a_sf.file_id, d4_p2.resolve.extend_concept_bindings, d4_a_mid, d4_p2.resolve.module_exports)
  let d4_a_ts: TS = ts_new(d4_a_tc, d4_p2.typecheck.types, d4_p2.typecheck.type_info, d4_p2.typecheck.sym_types, registry_new(d4_p2.resolve.symbols, d4_p2.graph.modules))
  d4_a_ts = tc_pass_shells(d4_a_ts, d4_a_po.root)
  d4_a_ts = tc_pass1(d4_a_ts, d4_a_po.root)
  // Now typecheck app::b.
  let d4_b_ts: TS = ts_new(d4_b_tc, d4_a_ts.types, d4_a_ts.type_info, d4_a_ts.sym_types, reg_with_variant_set(registry_new(d4_p2.resolve.symbols, d4_p2.graph.modules), d4_a_ts.reg.variant_set))
  d4_b_ts = tc_pass_shells(d4_b_ts, d4_b_po.root)
  d4_b_ts = tc_pass1(d4_b_ts, d4_b_po.root)
  d4_b_ts = tc_pass2(d4_b_ts, d4_b_po.root)

  let d4_2_ok: bool = false
  let d4_2di: i64 = 0
  while d4_2di < d4_b_ts.diags.length():
    let d4_2d: Diagnostic = d4_b_ts.diags.get(d4_2di)
    if d4_2d.message == "no exported symbol 'nonexistent' in module 'a'":
      d4_2_ok = true
    d4_2di = d4_2di + 1
  if d4_2_ok:
    print("PASS d4_missing_export_diagnostic")
    pass_count = pass_count + 1
  else:
    print("FAIL d4_missing_export_diagnostic")

  // Test d4_3: mod::Enum::NotAVariant produces a variant-not-found diagnostic.
  let d4_inputs3: Vector<SourceInput> = Vector<SourceInput>::new()
  d4_inputs3 = d4_inputs3.push(SourceInput("c.dao", "module lib::colors\nenum Color:\n  Red\n  Blue\n", false))
  d4_inputs3 = d4_inputs3.push(SourceInput("d.dao", "module app::d\nimport lib::colors\nfn f(): i32\n  let x: i32 = colors::Color::NotAColor\n  return 0\n", false))
  let d4_pg3: ProgramGraph = build_program(d4_inputs3)
  let d4_p3: Program = program_from_graph(d4_pg3)
  d4_p3 = program_run_resolve(d4_p3)
  d4_p3 = program_init_typecheck(d4_p3)
  // Run pass1 on lib::colors (registers enum + variants).
  let d4_c_mid: i64 = find_module_by_name(d4_p3.graph.modules, "lib::colors")
  let d4_c_sf: SourceFile = program_file_of_module(d4_p3, d4_c_mid)
  let d4_c_po: ParseOutput = d4_c_sf.parse_output
  let d4_c_tc: TC = TC(d4_c_po.nodes, d4_c_po.idx, d4_c_po.toks, d4_c_sf.source_text, d4_p3.resolve.symbols, d4_p3.resolve.scopes, d4_p3.resolve.uses, d4_c_sf.file_id, d4_p3.resolve.extend_concept_bindings, d4_c_mid, d4_p3.resolve.module_exports)
  let d4_c_ts: TS = ts_new(d4_c_tc, d4_p3.typecheck.types, d4_p3.typecheck.type_info, d4_p3.typecheck.sym_types, registry_new(d4_p3.resolve.symbols, d4_p3.graph.modules))
  d4_c_ts = tc_pass_shells(d4_c_ts, d4_c_po.root)
  d4_c_ts = tc_pass1(d4_c_ts, d4_c_po.root)
  // Run pass1+pass2 on app::d with colors' variant_set.
  let d4_d_mid: i64 = find_module_by_name(d4_p3.graph.modules, "app::d")
  let d4_d_sf: SourceFile = program_file_of_module(d4_p3, d4_d_mid)
  let d4_d_po: ParseOutput = d4_d_sf.parse_output
  let d4_d_tc: TC = TC(d4_d_po.nodes, d4_d_po.idx, d4_d_po.toks, d4_d_sf.source_text, d4_p3.resolve.symbols, d4_p3.resolve.scopes, d4_p3.resolve.uses, d4_d_sf.file_id, d4_p3.resolve.extend_concept_bindings, d4_d_mid, d4_p3.resolve.module_exports)
  let d4_d_ts: TS = ts_new(d4_d_tc, d4_c_ts.types, d4_c_ts.type_info, d4_c_ts.sym_types, reg_with_variant_set(registry_new(d4_p3.resolve.symbols, d4_p3.graph.modules), d4_c_ts.reg.variant_set))
  d4_d_ts = tc_pass_shells(d4_d_ts, d4_d_po.root)
  d4_d_ts = tc_pass1(d4_d_ts, d4_d_po.root)
  d4_d_ts = tc_pass2(d4_d_ts, d4_d_po.root)
  let d4_3_ok: bool = false
  let d4_3di: i64 = 0
  while d4_3di < d4_d_ts.diags.length():
    let d4_3d: Diagnostic = d4_d_ts.diags.get(d4_3di)
    if d4_3d.message == "'NotAColor' is not a variant of enum 'Color'":
      d4_3_ok = true
    d4_3di = d4_3di + 1
  if d4_3_ok:
    print("PASS d4_invalid_variant_diagnostic")
    pass_count = pass_count + 1
  else:
    print("FAIL d4_invalid_variant_diagnostic")

  // -----------------------------------------------------------------
  // Task 27 D5: Program-level typecheck orchestration
  // -----------------------------------------------------------------

  // Test d5_1: Cross-module function call through program_run_typecheck.
  // Two modules: math exports `add`, main calls `math::add(1, 2)`.
  // program_run_typecheck runs pass1 on both modules then pass2 on
  // both — the cross-module call types correctly because math's
  // function type is registered in pass1 before main's body is
  // checked in pass2.
  let d5_inputs1: Vector<SourceInput> = Vector<SourceInput>::new()
  d5_inputs1 = d5_inputs1.push(SourceInput("math.dao", "module app::math\nfn add(a: i32, b: i32): i32 -> a + b\n", false))
  d5_inputs1 = d5_inputs1.push(SourceInput("main.dao", "module app::main\nimport app::math\nfn f(): i32\n  return math::add(1, 2)\n", false))
  let d5_pg1: ProgramGraph = build_program(d5_inputs1)
  let d5_p1: Program = program_from_graph(d5_pg1)
  d5_p1 = program_run_resolve(d5_p1)
  d5_p1 = program_run_typecheck(d5_p1)
  let d5_1_ok: bool = true
  // Count typecheck-origin diagnostics. Resolve diagnostics are the
  // baseline in p.resolve.diags; anything in p.diags beyond that
  // count is from typecheck. A well-typed cross-module call should
  // produce zero typecheck diagnostics.
  let d5_1_resolve_count: i64 = d5_p1.resolve.diags.length()
  if d5_p1.diags.length() > d5_1_resolve_count:
    d5_1_ok = false
  // Check: types should include builtins (13) plus at least the
  // function types for add and f.
  if d5_p1.typecheck.types.length() <= 13:
    d5_1_ok = false
  if d5_1_ok:
    print("PASS d5_cross_module_typecheck")
    pass_count = pass_count + 1
  else:
    print("FAIL d5_cross_module_typecheck")

  // Test d5_2: Canonical type identity across modules.
  // Both modules reference i32 — the type index should be the same
  // canonical builtin (index 2) in the program type table.
  let d5_inputs2: Vector<SourceInput> = Vector<SourceInput>::new()
  d5_inputs2 = d5_inputs2.push(SourceInput("a.dao", "module mod_a\nfn fa(): i32 -> 1\n", false))
  d5_inputs2 = d5_inputs2.push(SourceInput("b.dao", "module mod_b\nfn fb(): i32 -> 2\n", false))
  let d5_pg2: ProgramGraph = build_program(d5_inputs2)
  let d5_p2: Program = program_from_graph(d5_pg2)
  d5_p2 = program_run_resolve(d5_p2)
  d5_p2 = program_run_typecheck(d5_p2)
  let d5_2_ok: bool = true
  // Both fa and fb should have function types with ret_type == 2 (i32).
  // Since builtins are seeded once (D1a), the i32 index is canonical.
  if d5_p2.typecheck.types.length() <= 13:
    d5_2_ok = false
  // The canonical i32 type at index 2 should have name "i32".
  if d5_p2.typecheck.types.length() > 2:
    let d5_i32: DaoType = d5_p2.typecheck.types.get(2)
    if d5_i32.name != "i32":
      d5_2_ok = false
  if d5_2_ok:
    print("PASS d5_canonical_type_identity")
    pass_count = pass_count + 1
  else:
    print("FAIL d5_canonical_type_identity")

  // Test d5_3: Program-level expr_types are populated after
  // program_run_typecheck. Verify tc_get_expr_type returns a valid
  // type for an expression node in a typechecked module.
  let d5_inputs3: Vector<SourceInput> = Vector<SourceInput>::new()
  d5_inputs3 = d5_inputs3.push(SourceInput("e.dao", "module expr_test\nfn f(): i32 -> 1 + 2\n", false))
  let d5_pg3: ProgramGraph = build_program(d5_inputs3)
  let d5_p3: Program = program_from_graph(d5_pg3)
  d5_p3 = program_run_resolve(d5_p3)
  d5_p3 = program_run_typecheck(d5_p3)
  let d5_3_ok: bool = false
  // Scan all node indices in module 0 for any expression with a type.
  let d5_3_mid: i64 = to_i64(0)
  let d5_3_sf: SourceFile = program_file_of_module(d5_p3, d5_3_mid)
  let d5_3_ni: i64 = 0
  while d5_3_ni < d5_3_sf.parse_output.nodes.length():
    let d5_3_ti: i64 = tc_get_expr_type(d5_p3.typecheck, d5_3_mid, d5_3_ni)
    if d5_3_ti >= 0:
      d5_3_ok = true
    d5_3_ni = d5_3_ni + 1
  if d5_3_ok:
    print("PASS d5_program_expr_types_populated")
    pass_count = pass_count + 1
  else:
    print("FAIL d5_program_expr_types_populated")

  // -----------------------------------------------------------------
  // Task 27 D9/D10: On-disk multi-file test corpus
  // -----------------------------------------------------------------

  // Test d10_1: Three-file smoke test loaded from testdata.
  let smoke_base: string = "testdata/bootstrap/multifile/smoke/"
  let smoke_ok: bool = false
  if file_exists(smoke_base + "core_fmt.dao"):
    let smoke_inputs: Vector<SourceInput> = Vector<SourceInput>::new()
    smoke_inputs = smoke_inputs.push(SourceInput("core_fmt.dao", read_file(smoke_base + "core_fmt.dao"), false))
    smoke_inputs = smoke_inputs.push(SourceInput("app_math.dao", read_file(smoke_base + "app_math.dao"), false))
    smoke_inputs = smoke_inputs.push(SourceInput("app_main.dao", read_file(smoke_base + "app_main.dao"), false))
    let smoke_pg: ProgramGraph = build_program(smoke_inputs)
    let smoke_p: Program = program_from_graph(smoke_pg)
    smoke_p = program_run_resolve(smoke_p)
    smoke_p = program_run_typecheck(smoke_p)
    // Verify: 3 modules in topo order, types registered beyond builtins,
    // no typecheck-origin diagnostics beyond the resolve baseline.
    let smoke_tc_ok: bool = true
    if smoke_p.graph.topo_order.length() != 3:
      smoke_tc_ok = false
    if smoke_p.typecheck.types.length() <= 13:
      smoke_tc_ok = false
    if smoke_p.diags.length() > smoke_p.resolve.diags.length():
      smoke_tc_ok = false
    if smoke_tc_ok:
      smoke_ok = true
  if smoke_ok:
    print("PASS d10_three_file_smoke")
    pass_count = pass_count + 1
  else:
    if file_exists(smoke_base + "core_fmt.dao"):
      print("FAIL d10_three_file_smoke")
    else:
      print("SKIP d10_three_file_smoke: fixtures not found at " + smoke_base)

  // Test d10_2: Cross-module enum variant from on-disk fixtures.
  let enum_base: string = "testdata/bootstrap/multifile/cross_module_enum/"
  let enum_ok: bool = false
  if file_exists(enum_base + "colors.dao"):
    let enum_inputs: Vector<SourceInput> = Vector<SourceInput>::new()
    enum_inputs = enum_inputs.push(SourceInput("colors.dao", read_file(enum_base + "colors.dao"), false))
    enum_inputs = enum_inputs.push(SourceInput("user.dao", read_file(enum_base + "user.dao"), false))
    let enum_pg: ProgramGraph = build_program(enum_inputs)
    let enum_p: Program = program_from_graph(enum_pg)
    enum_p = program_run_resolve(enum_p)
    enum_p = program_run_typecheck(enum_p)
    // Verify: 2 modules, no typecheck errors beyond resolve baseline.
    if enum_p.graph.topo_order.length() == 2:
      if enum_p.diags.length() <= enum_p.resolve.diags.length():
        enum_ok = true
  if enum_ok:
    print("PASS d10_cross_module_enum")
    pass_count = pass_count + 1
  else:
    if file_exists(enum_base + "colors.dao"):
      print("FAIL d10_cross_module_enum")
    else:
      print("SKIP d10_cross_module_enum: fixtures not found at " + enum_base)

  // Test d10_3: Cross-module import with class export.
  // Verifies that importing a module with a class declaration
  // completes the program typecheck pipeline cleanly.
  //
  // NOTE: This does NOT yet test extend-method isolation (Task 26
  // §6.5) because verifying that extend methods are NOT visible
  // across modules requires dot-call semantics (e.g.
  // some_value.extended_method() producing an "unknown method"
  // diagnostic in the importing module). Dot-call method dispatch
  // is Task 28 scope. The D2 owner_module_id filter enforces
  // isolation at the symbol-table level — it was verified via
  // inline tests in D2 and D4.
  let ext_base: string = "testdata/bootstrap/multifile/extend_isolation/"
  let ext_ok: bool = false
  if file_exists(ext_base + "provider.dao"):
    let ext_inputs: Vector<SourceInput> = Vector<SourceInput>::new()
    ext_inputs = ext_inputs.push(SourceInput("provider.dao", read_file(ext_base + "provider.dao"), false))
    ext_inputs = ext_inputs.push(SourceInput("consumer.dao", read_file(ext_base + "consumer.dao"), false))
    let ext_pg: ProgramGraph = build_program(ext_inputs)
    let ext_p: Program = program_from_graph(ext_pg)
    ext_p = program_run_resolve(ext_p)
    ext_p = program_run_typecheck(ext_p)
    if ext_p.graph.topo_order.length() == 2:
      if ext_p.diags.length() <= ext_p.resolve.diags.length():
        ext_ok = true
  if ext_ok:
    print("PASS d10_cross_module_class_export")
    pass_count = pass_count + 1
  else:
    if file_exists(ext_base + "provider.dao"):
      print("FAIL d10_cross_module_class_export")
    else:
      print("SKIP d10_cross_module_class_export: fixtures not found at " + ext_base)

  // -----------------------------------------------------------------
  // Regression: concept satisfaction on builtin types in program mode
  // -----------------------------------------------------------------
  // Task 27 known gap: `extend <builtin> as Concept:` was reported to
  // produce a spurious "does not implement required method" diagnostic
  // when run through program_run_typecheck.  The gap was implicitly
  // fixed by PR #238 (concept bindings HashMap → triples).  This test
  // locks in the fix across the three extend-on-builtin shapes:
  //   1. Local concept + extend in same module.
  //   2. Concept in one module, extend in another: the concept is the
  //      prelude's, visible unqualified everywhere (an import binds
  //      only its module name, CONTRACT_MODULE_SYSTEM.md §3, §7).
  //   3. Multiple builtins extended in one module.
  let cb_inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  cb_inputs = cb_inputs.push(SourceInput("a.dao", "module case_a\n\nconcept Showable:\n  fn show(self): string\n\nextend i32 as Showable:\n  fn show(self): string\n    return \"i32\"\n", false))
  cb_inputs = cb_inputs.push(SourceInput("stdlib/core/c.dao", "module core::concepts\nconcept Printable:\n  fn to_string(self): string\n", true))
  cb_inputs = cb_inputs.push(SourceInput("p.dao", "module case_b::impl\n\nextend i64 as Printable:\n  fn to_string(self): string\n    return \"i64\"\n", false))
  cb_inputs = cb_inputs.push(SourceInput("m.dao", "module case_c\n\nconcept Named:\n  fn name(self): string\n\nextend i32 as Named:\n  fn name(self): string\n    return \"i32\"\n\nextend bool as Named:\n  fn name(self): string\n    return \"bool\"\n\nextend string as Named:\n  fn name(self): string\n    return \"string\"\n", false))
  let cb_pg: ProgramGraph = build_program(cb_inputs)
  let cb_p: Program = program_from_graph(cb_pg)
  cb_p = program_run_resolve(cb_p)
  // Resolve must succeed cleanly.  Without this guard, a resolver
  // regression (e.g. a cross-module import breaking) would silently
  // weaken this test: extend decls would never register, concept
  // satisfaction would never fire, and the typecheck-origin diag
  // count below would still be zero.
  let cb_resolve_diags: i64 = cb_p.resolve.diags.length()
  cb_p = program_run_typecheck(cb_p)
  // Count typecheck-origin diagnostics (exclude resolve baseline).
  let cb_typecheck_diags: i64 = cb_p.diags.length() - cb_resolve_diags
  let cb_found_spurious: bool = false
  let cb_di: i64 = cb_resolve_diags
  while cb_di < cb_p.diags.length():
    let fd: FileDiagnostic = cb_p.diags.get(cb_di)
    if fd.diag.message == "extend does not implement required method 'show' from concept 'Showable'":
      cb_found_spurious = true
    cb_di = cb_di + 1
  if cb_resolve_diags > 0:
    print("FAIL concept_sat_builtin_program: " + i64_to_string(cb_resolve_diags) + " resolve diagnostic(s) — test premise broken")
  else:
    if cb_found_spurious:
      print("FAIL concept_sat_builtin_program: spurious missing-method diagnostic")
    else:
      if cb_typecheck_diags == 0:
        print("PASS concept_sat_builtin_program")
        pass_count = pass_count + 1
      else:
        print("FAIL concept_sat_builtin_program: " + i64_to_string(cb_typecheck_diags) + " unexpected typecheck diagnostic(s)")

  // -----------------------------------------------------------------
  // Qualified variant access: Enum::Variant on a local enum
  // -----------------------------------------------------------------

  // Test 44: a two-segment variant access types as the enum and a
  // construction of a payload variant types as the enum.
  let src44: string = "enum class Shape:\n  Circle(r: i32)\n  Dot\n\nfn main(): i32\n  let d: Shape = Shape::Dot\n  let c: Shape = Shape::Circle(r = 3)\n  return 0\n"
  let r44: TypeCheckResult = typecheck(src44)
  if tc_count_diags(r44) == 0:
    print("PASS qualified_variant_types")
    pass_count = pass_count + 1
  else:
    print("FAIL qualified_variant_types: expected 0 diagnostics, got " + i64_to_string(tc_count_diags(r44)))

  // Test 45: a name that is no variant of the enum is diagnosed.
  let src45: string = "enum Color:\n  Red\n  Green\n\nfn main(): i32\n  let c: Color = Color::Blue\n  return 0\n"
  let r45: TypeCheckResult = typecheck(src45)
  if tc_count_diags(r45) == 1:
    print("PASS qualified_variant_unknown")
    pass_count = pass_count + 1
  else:
    print("FAIL qualified_variant_unknown: expected 1 diagnostic, got " + i64_to_string(tc_count_diags(r45)))

  // Test 46: qualified variants as match patterns check against the
  // scrutinee's type, with and without bindings; a binding is no
  // argument, so the construction rule leaves it alone.  (The binding
  // itself is the resolver's deferral: its one "unknown name" is the
  // only diagnostic expected.)
  let src46: string = "enum class Shape:\n  Circle(r: i32)\n  Dot\n\nfn pick(s: Shape): i32\n  match s:\n    Shape::Circle(r):\n      return 1\n    Shape::Dot:\n      return 2\n  return 0\n"
  let r46: TypeCheckResult = typecheck(src46)
  let construction_diag: bool = false
  let di46: i64 = 0
  while di46 < r46.diags.length():
    if index_of(r46.diags.get(di46).message, "constructed by parameter name") >= 0:
      construction_diag = true
    di46 = di46 + 1
  if tc_count_diags(r46) <= 1 and construction_diag == false:
    print("PASS qualified_variant_pattern")
    pass_count = pass_count + 1
  else:
    print("FAIL qualified_variant_pattern: expected at most the binding's resolver diagnostic, got " + i64_to_string(tc_count_diags(r46)))
    let dj46: i64 = 0
    while dj46 < r46.diags.length():
      print("  diag: " + r46.diags.get(dj46).message)
      dj46 = dj46 + 1

  // Test 47: constructions that miss the variant's shape are diagnosed,
  // once per site: no arguments for a field, a positional argument, a
  // name that is no field, a field given twice, a fieldless variant
  // with an argument.
  let src47: string = "enum class Shape:\n  Circle(r: i32)\n  Dot\n\nfn main(): i32\n  let a: Shape = Shape::Circle()\n  let b: Shape = Shape::Circle(3)\n  let c: Shape = Shape::Circle(q = 3)\n  let d: Shape = Shape::Circle(r = 3, r = 4)\n  let e: Shape = Shape::Dot(1)\n  let f: Shape = Shape::Dot()\n  return 0\n"
  let r47: TypeCheckResult = typecheck(src47)
  if tc_count_diags(r47) == 6:
    print("PASS qualified_variant_shape")
    pass_count = pass_count + 1
  else:
    print("FAIL qualified_variant_shape: expected 6 diagnostics, got " + i64_to_string(tc_count_diags(r47)))
    let di47: i64 = 0
    while di47 < r47.diags.length():
      print("  diag: " + r47.diags.get(di47).message)
      di47 = di47 + 1

  // Test 49: pattern shapes: a parameterless variant with parentheses, a
  // literal where a binding goes, the wrong number of bindings, a
  // payload variant bare, and a binding by name are each diagnosed.
  let src49: string = "enum class Shape:\n  Circle(r: i32)\n  Dot\n\nfn pick(s: Shape): i32\n  match s:\n    Shape::Dot():\n      return 1\n    Shape::Circle(1):\n      return 2\n    Shape::Circle(a, b):\n      return 3\n    Shape::Circle:\n      return 4\n    Shape::Circle(r = x):\n      return 5\n  return 0\n"
  let r49: TypeCheckResult = typecheck(src49)
  let shape_diags: i64 = 0
  let dk49: i64 = 0
  while dk49 < r49.diags.length():
    let m49: string = r49.diags.get(dk49).message
    if index_of(m49, "written without parentheses") >= 0 or index_of(m49, "binds a name per parameter") >= 0 or index_of(m49, "the pattern binds") >= 0 or index_of(m49, "binds by position") >= 0:
      shape_diags = shape_diags + 1
    dk49 = dk49 + 1
  if shape_diags == 5:
    print("PASS pattern_shapes_diagnosed")
    pass_count = pass_count + 1
  else:
    print("FAIL pattern_shapes_diagnosed: expected 5 shape diagnostics, got " + i64_to_string(shape_diags))
    let dj49: i64 = 0
    while dj49 < r49.diags.length():
      print("  diag: " + r49.diags.get(dj49).message)
      dj49 = dj49 + 1

  // Test 48: a named argument's value must have the field's type.
  let src48: string = "enum class Shape:\n  Circle(r: i32)\n  Dot\n\nfn main(): i32\n  let a: Shape = Shape::Circle(r = true)\n  return 0\n"
  let r48: TypeCheckResult = typecheck(src48)
  if tc_count_diags(r48) == 1:
    print("PASS qualified_variant_field_type")
    pass_count = pass_count + 1
  else:
    print("FAIL qualified_variant_field_type: expected 1 diagnostic, got " + i64_to_string(tc_count_diags(r48)))

  // Test 49: a symbol declared into the prelude scope is visible from
  // any module (CONTRACT_MODULE_SYSTEM.md §7.2); one declared in an
  // ordinary module is visible from that module only.
  let prelude_sym: Symbol = Symbol(SymbolKind::Method, "i32.show", to_i64(0), prelude_scope_idx(), to_i64(7))
  let module_sym: Symbol = Symbol(SymbolKind::Method, "i32.show", to_i64(0), prelude_scope_idx() + to_i64(1), to_i64(0))
  let vis_ok: bool = false
  if sym_visible_in_module(prelude_sym, to_i64(1)):
    if sym_visible_in_module(module_sym, to_i64(0)):
      if sym_visible_in_module(module_sym, to_i64(1)) == false:
        vis_ok = true
  if vis_ok:
    print("PASS prelude_method_visibility")
    pass_count = pass_count + 1
  else:
    print("FAIL prelude_method_visibility")

  // Test 50: a module's own extend of a type shadows the prelude's for
  // that module; another module sees only the prelude's; an unknown
  // name is none.
  let shadow_ok: bool = false
  if find_method_sym_for_receiver(test_dispatch_index(), to_i64(0), "show", to_i64(2)) == to_i64(1):
    if find_method_sym_for_receiver(test_dispatch_index(), to_i64(1), "show", to_i64(2)) == to_i64(0):
      if find_method_sym_for_receiver(test_dispatch_index(), to_i64(0), "hash", to_i64(2)) == to_i64(-1):
        shadow_ok = true
  if shadow_ok:
    print("PASS module_method_shadows_prelude")
    pass_count = pass_count + 1
  else:
    print("FAIL module_method_shadows_prelude")

  // Test 51: end to end — a module's `class Box` with `fn m(): i32`
  // shadows the prelude's `class Box` with `fn m(): bool`; the dot call
  // types as the module's method, whichever module resolves first.
  // `pad` keeps the two class declarations at different node indices:
  // the type checker still identifies a declaration by node index
  // without file provenance (the closure audit's typecheck frontier),
  // which is not what this test measures.
  let sb_inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  sb_inputs = sb_inputs.push(SourceInput("stdlib/core/box.dao", "module core::box\nclass Box:\n  n: i32\n  fn m(self): bool\n    return true\n", true))
  sb_inputs = sb_inputs.push(SourceInput("main.dao", "module app::main\nfn pad(): i32 -> 0\nclass Box:\n  n: i32\n  fn m(self): i32\n    return self.n\nfn f(): i32\n  let b: Box = Box(1)\n  return b.m()\n", false))
  let sb_p: Program = program_from_graph(build_program(sb_inputs))
  sb_p = program_run_resolve(sb_p)
  sb_p = program_run_typecheck(sb_p)
  let sb_errors: i64 = 0
  let sb_i: i64 = 0
  while sb_i < sb_p.diags.length():
    let sb_fd: FileDiagnostic = sb_p.diags.get(sb_i)
    if sb_fd.path == "main.dao":
      sb_errors = sb_errors + 1
    sb_i = sb_i + 1
  if sb_errors == 0:
    print("PASS shadowed_class_method_types_as_module")
    pass_count = pass_count + 1
  else:
    print("FAIL shadowed_class_method_types_as_module: " + i64_to_string(sb_errors) + " diagnostics in main.dao")
    let sb_j: i64 = 0
    while sb_j < sb_p.diags.length():
      print("  diag: " + sb_p.diags.get(sb_j).path + ": " + sb_p.diags.get(sb_j).diag.message)
      sb_j = sb_j + 1

  // Test 52: the receiver's type, not its name, picks the method: a
  // value of the prelude's `Box` answers with the prelude's `m` (bool)
  // even where this module declares its own `Box` whose `m` is i32.
  let qb_inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  qb_inputs = qb_inputs.push(SourceInput("stdlib/core/box.dao", "module core::box\nclass Box:\n  n: i32\n  fn m(self): bool\n    return true\n\nfn make_box(): Box\n  return Box(1)\n", true))
  qb_inputs = qb_inputs.push(SourceInput("main.dao", "module app::main\nfn pad(): i32 -> 0\nclass Box:\n  n: i32\n  fn m(self): i32\n    return self.n\nfn f(): bool\n  return make_box().m()\nfn g(): i32\n  return Box(2).m()\n", false))
  let qb_p: Program = program_from_graph(build_program(qb_inputs))
  qb_p = program_run_resolve(qb_p)
  qb_p = program_run_typecheck(qb_p)
  let qb_errors: i64 = 0
  let qb_i: i64 = 0
  while qb_i < qb_p.diags.length():
    if qb_p.diags.get(qb_i).path == "main.dao":
      qb_errors = qb_errors + 1
    qb_i = qb_i + 1
  if qb_errors == 0:
    print("PASS qualified_receiver_picks_its_own_method")
    pass_count = pass_count + 1
  else:
    print("FAIL qualified_receiver_picks_its_own_method: " + i64_to_string(qb_errors) + " diagnostics in main.dao")
    let qb_j: i64 = 0
    while qb_j < qb_p.diags.length():
      print("  diag: " + qb_p.diags.get(qb_j).path + ": " + qb_p.diags.get(qb_j).diag.message)
      qb_j = qb_j + 1

  // Test 53: an `extend` is not the type's own method: where the
  // prelude extends `Box` with `pick(): bool` and this module extends
  // it with `pick(): i32`, this module's wins (§5, §7.2) — the
  // receiver's owner picks only a method declared with the type.
  let xb_inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  xb_inputs = xb_inputs.push(SourceInput("stdlib/core/box.dao", "module core::box\nconcept PickB:\n  fn pick(self): bool\n\nclass Box:\n  n: i32\n\nfn make_box(): Box\n  return Box(1)\n\nextend Box as PickB:\n  fn pick(self): bool\n    return true\n", true))
  xb_inputs = xb_inputs.push(SourceInput("main.dao", "module app::main\nconcept PickI:\n  fn pick(self): i32\n\nextend Box as PickI:\n  fn pick(self): i32\n    return 7\n\nfn f(): i32\n  return make_box().pick()\n", false))
  let xb_p: Program = program_from_graph(build_program(xb_inputs))
  xb_p = program_run_resolve(xb_p)
  xb_p = program_run_typecheck(xb_p)
  let xb_errors: i64 = 0
  let xb_i: i64 = 0
  while xb_i < xb_p.diags.length():
    if xb_p.diags.get(xb_i).path == "main.dao":
      xb_errors = xb_errors + 1
    xb_i = xb_i + 1
  if xb_errors == 0:
    print("PASS module_extend_wins_over_prelude_extend")
    pass_count = pass_count + 1
  else:
    print("FAIL module_extend_wins_over_prelude_extend: " + i64_to_string(xb_errors) + " diagnostics in main.dao")
    let xb_j: i64 = 0
    while xb_j < xb_p.diags.length():
      print("  diag: " + xb_p.diags.get(xb_j).path + ": " + xb_p.diags.get(xb_j).diag.message)
      xb_j = xb_j + 1

  // Test 54: a declaration index is file-local — two modules'
  // declarations share one freely (these two classes have the same
  // shape, so both methods sit at the same index), and each must keep
  // its own signature rather than the other's.
  let ci_inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  ci_inputs = ci_inputs.push(SourceInput("a.dao", "module app::a\nclass Box:\n  n: i32\n  fn pick(self): i32\n    return self.n\n", false))
  ci_inputs = ci_inputs.push(SourceInput("b.dao", "module app::b\nclass Cup:\n  n: bool\n  fn pick(self): bool\n    return self.n\n", false))
  let ci_pg: ProgramGraph = build_program(ci_inputs)
  let ci_p: Program = program_from_graph(ci_pg)
  ci_p = program_run_resolve(ci_p)
  ci_p = program_run_typecheck(ci_p)
  let ci_a_idx: i64 = to_i64(-1)
  let ci_b_idx: i64 = to_i64(-1)
  let ci_fi: i64 = 0
  while ci_fi < ci_pg.files.length():
    let ci_sf: SourceFile = ci_pg.files.get(ci_fi)
    if ci_sf.path == "a.dao":
      ci_a_idx = first_method_decl_index(ci_sf.parse_output)
    if ci_sf.path == "b.dao":
      ci_b_idx = first_method_decl_index(ci_sf.parse_output)
    ci_fi = ci_fi + 1
  let ci_errors: i64 = 0
  let ci_i: i64 = 0
  while ci_i < ci_p.diags.length():
    ci_errors = ci_errors + 1
    ci_i = ci_i + 1
  let ci_collides: bool = false
  if ci_a_idx >= 0:
    if ci_a_idx == ci_b_idx:
      ci_collides = true
  if ci_collides:
    if ci_errors == 0:
      print("PASS colliding_decl_indices_stay_apart")
      pass_count = pass_count + 1
    else:
      print("FAIL colliding_decl_indices_stay_apart: " + i64_to_string(ci_errors) + " diagnostics")
      let ci_j: i64 = 0
      while ci_j < ci_p.diags.length():
        print("  diag: " + ci_p.diags.get(ci_j).path + ": " + ci_p.diags.get(ci_j).diag.message)
        ci_j = ci_j + 1
  else:
    print("FAIL colliding_decl_indices_stay_apart: the fixture declares no colliding methods (a=" + i64_to_string(ci_a_idx) + " b=" + i64_to_string(ci_b_idx) + "); retune it")

  // -----------------------------------------------------------------
  // Contextual integer-literal typing: a literal adopts a concrete
  // integer type from its context (annotated let, return, binary peer,
  // call argument, assignment) and defaults to i32 absent one.  Fitting
  // moves only a literal, never a named integer.
  // -----------------------------------------------------------------
  if tc_expect_clean("literal_adopts_annotated_i64", "fn f(): i64\n  let x: i64 = 1\n  return x\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("literal_fits_binary_peer_on_right", "fn f(n: i64): i64\n  return n + 1\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("literal_fits_binary_peer_on_left", "fn f(n: i64): i64\n  return 1 + n\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("literal_fits_comparison_peer", "fn f(n: i64): bool\n  return n == 0\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("literal_adopts_call_argument_type", "fn take(x: i64): i64\n  return x\n\nfn g(): i64\n  return take(1)\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("literal_adopts_return_type", "fn f(): i64\n  return 0\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("literal_adopts_assignment_target", "fn f(): i64\n  let x: i64 = 0\n  x = 1\n  return x\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("literal_defaults_to_i32", "fn f(): i32\n  let x: i32 = 1\n  return x\n"):
    pass_count = pass_count + 1
  // Fitting moves only a literal: two named integers of different width
  // still mismatch.
  if tc_expect_diags("named_integers_of_different_width_mismatch", "fn f(a: i64, b: i32): i64\n  return a + b\n", to_i64(1)):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // Static / factory method calls (`Type::method`): a static method is
  // typed by its signature, not read as zero-argument construction, and
  // its return type flows.
  // -----------------------------------------------------------------
  // A static factory `Cell::new()` types clean and is not read as
  // zero-argument construction of the 1-field Cell.
  if tc_expect_clean("static_factory_new", "class Cell:\n  n: i32\n  fn new(): Cell\n    return Cell(0)\n\nfn f(): i32\n  let c: Cell = Cell::new()\n  return 0\n"):
    pass_count = pass_count + 1
  // A static method with a parameter checks its argument (and fits a
  // literal to the parameter type).
  if tc_expect_clean("static_method_arg", "class Cell:\n  n: i64\n  fn of(v: i64): Cell\n    return Cell(v)\n\nfn f(): i32\n  let c: Cell = Cell::of(1)\n  return 0\n"):
    pass_count = pass_count + 1
  // The factory's return type flows: assigning `Cell::new()` to a
  // wrongly-typed local still diagnoses (the result is a Cell).
  if tc_expect_diags("static_factory_return_type_flows", "class Cell:\n  n: i32\n  fn new(): Cell\n    return Cell(0)\n\nfn f(): i32\n  let x: i32 = Cell::new()\n  return x\n", to_i64(1)):
    pass_count = pass_count + 1

  // A static `Type::method` reaches only the resolved type's own method:
  // a module-local `Box` with no `make` must not borrow the prelude
  // `Box`'s static `make` through a same-named-mangle match.
  let shadow_inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  shadow_inputs = shadow_inputs.push(SourceInput("stdlib/core/box.dao", "module core::box\nclass Box:\n  n: i32\n  fn make(): Box\n    return Box(0)\n", true))
  shadow_inputs = shadow_inputs.push(SourceInput("main.dao", "module app::main\nclass Box:\n  n: i32\nfn f(): i32\n  let b: Box = Box::make()\n  return 0\n", false))
  let shadow_p: Program = program_from_graph(build_program(shadow_inputs))
  shadow_p = program_run_resolve(shadow_p)
  shadow_p = program_run_typecheck(shadow_p)
  let shadow_errors: i64 = 0
  let shadow_i: i64 = 0
  while shadow_i < shadow_p.diags.length():
    let shadow_fd: FileDiagnostic = shadow_p.diags.get(shadow_i)
    if shadow_fd.path == "main.dao":
      shadow_errors = shadow_errors + 1
    shadow_i = shadow_i + 1
  if shadow_errors > 0:
    print("PASS static_call_respects_type_shadowing")
    pass_count = pass_count + 1
  else:
    print("FAIL static_call_respects_type_shadowing: local Box::make borrowed the prelude's static method (0 diagnostics in main.dao)")

  // -----------------------------------------------------------------
  // A unary-negated literal fits its context like a bare literal, and a
  // literal fits a match arm's scrutinee type and a pipe target's first
  // parameter.
  // -----------------------------------------------------------------
  if tc_expect_clean("negated_literal_fits_return", "fn f(): i64\n  return -1\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("negated_literal_fits_annotation", "fn f(): i64\n  let x: i64 = -1\n  return x\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("literal_pattern_fits_scrutinee", "fn f(): i32\n  let n: i64 = 5\n  match n:\n    0:\n      return 0\n  return 1\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("literal_fits_pipe_target_param", "fn take(x: i64): i64\n  return x\n\nfn g(): i64\n  let r: i64 = 1 |> take\n  return r\n"):
    pass_count = pass_count + 1

  // Generic parameter bounds carry meaning: a bound concept's methods are
  // available on the parameter and type the call through the concept's
  // signature; a bound must name a concept in scope; an unconstrained
  // parameter provides no members.
  if tc_expect_clean("bound_method_available", "concept Printable:\n  fn to_string(self): string\n\nfn show<T: Printable>(x: T): string\n  return x.to_string()\n"):
    pass_count = pass_count + 1
  if tc_expect_diags("bound_unknown_concept", "fn f<T: Nope>(x: T): T\n  return x\n", 1):
    pass_count = pass_count + 1
  if tc_expect_diags("bound_not_a_concept", "class Point:\n  x: i64\n\nfn f<T: Point>(x: T): T\n  return x\n", 1):
    pass_count = pass_count + 1
  if tc_expect_diags("bound_self_reference_rejected", "fn f<T: T>(x: T): T\n  return x\n", 1):
    pass_count = pass_count + 1
  if tc_expect_diags("extern_bound_unknown_concept", "extern fn f<T: Nope>(x: T): T\n", 1):
    pass_count = pass_count + 1
  if tc_expect_diags("method_bound_unknown_concept", "class C:\n  x: i64\n  fn m<T: Nope>(self): i64\n    return 1\n", 1):
    pass_count = pass_count + 1
  if tc_expect_diags("concept_method_bound_unknown_concept", "concept K:\n  fn m<T: Nope>(self): i64\n", 1):
    pass_count = pass_count + 1
  if tc_expect_diags("expr_method_bound_unknown_concept", "class C:\n  x: i64\n  fn m<T: Nope>(self): i64 -> 1\n", 1):
    pass_count = pass_count + 1
  if tc_expect_diags("bound_generic_class_head_rejected", "class Box<T>:\n  v: T\n\nfn f<U: Box<i64>>(x: U): U\n  return x\n", 1):
    pass_count = pass_count + 1
  if tc_expect_clean("bound_generic_concept_head_accepted", "concept Iter<T>:\n  fn next(self): T\n\nfn f<U: Iter<i64>>(x: U): U\n  return x\n"):
    pass_count = pass_count + 1
  // A `derived concept` is conformed to structurally (every field
  // conforms), transitively, and provides its methods to the class.
  if tc_expect_clean("derived_conformance_dispatch", "derived concept Show:\n  fn show(self): string\n\nextend i64 as Show:\n  fn show(self): string\n    return \"n\"\n\nclass P:\n  x: i64\n  y: i64\n\nfn f(p: P): string\n  return p.show()\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("derived_conformance_transitive", "derived concept Show:\n  fn show(self): string\n\nextend i64 as Show:\n  fn show(self): string\n    return \"n\"\n\nclass P:\n  x: i64\n\nclass W:\n  p: P\n\nfn f(w: W): string\n  return w.show()\n"):
    pass_count = pass_count + 1
  let r_dnc: TypeCheckResult = typecheck("derived concept Show:\n  fn show(self): string\n\nclass R:\n  s: string\n\nclass Q:\n  r: R\n\nfn f(q: Q): string\n  return q.show()\n")
  if tc_count_diags(r_dnc) >= 1:
    print("PASS derived_conformance_blocked_by_field")
    pass_count = pass_count + 1
  else:
    print("FAIL derived_conformance_blocked_by_field: expected >= 1 diagnostic, got 0")
  // A class declared after a field's class must count that field against
  // the conformances known before derivation began: P derives first, and W
  // (field p: P, field s: string) must still be blocked by `string`.
  let r_ddc: TypeCheckResult = typecheck("derived concept Show:\n  fn show(self): string\n\nextend i64 as Show:\n  fn show(self): string\n    return \"n\"\n\nclass P:\n  x: i64\n\nclass W:\n  p: P\n  s: string\n\nfn f(w: W): string\n  return w.show()\n")
  if tc_count_diags(r_ddc) >= 1:
    print("PASS derived_conformance_no_double_count")
    pass_count = pass_count + 1
  else:
    print("FAIL derived_conformance_no_double_count: expected >= 1 diagnostic, got 0")
  // A concept's own name in its method signatures means the conforming
  // type: an extend implements `o: Eq` as `o: i32`, and through a
  // derived conformance or a bound `o: Eq` accepts the receiver's type.
  // Anywhere else a concept is not a type (the host's rule).
  if tc_expect_clean("derived_signature_substitutes_concept", "derived concept Eq:\n  fn eq(self, o: Eq): bool\n\nextend i32 as Eq:\n  fn eq(self, o: i32): bool\n    return true\n\nclass P:\n  x: i32\n\nfn f(a: P, b: P): bool\n  return a.eq(b)\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("extend_signature_names_concept", "concept Eq:\n  fn eq(self, o: Eq): bool\n\nextend i32 as Eq:\n  fn eq(self, o: Eq): bool\n    return true\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("concept_is_not_a_type", "concept Eq:\n  fn eq(self, o: Eq): bool\n\nfn f(a: Eq): bool\n  let b: *Eq = &a\n  return true\n"):
    pass_count = pass_count + 1
  // Every concept's identity is registered before any signature is
  // resolved, so the rule holds whatever the declaration order.
  if tc_expect_rejected("concept_is_not_a_type_declared_later", "fn f(a: Eq): bool\n  return true\n\nconcept Eq:\n  fn eq(self, o: Eq): bool\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("other_concept_in_signature_declared_later", "concept A:\n  fn f(self, o: B): bool\n\nconcept B:\n  fn g(self): bool\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("bound_signature_substitutes_concept", "concept Eq:\n  fn eq(self, o: Eq): bool\n\nfn same<T: Eq>(a: T, b: T): bool\n  return a.eq(b)\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("bound_signature_substitutes_pointer_to_concept", "concept Eq:\n  fn same(self, o: *Eq): bool\n\nfn f<T: Eq>(a: T, p: *T): bool\n  return a.same(p)\n"):
    pass_count = pass_count + 1
  // Two bounds requiring one member: the first bound in declaration
  // order types the access, as the host's constraint search does, so
  // reordering the bounds changes the signature the body is checked
  // against.
  if tc_expect_clean("first_bound_types_shared_member", "concept A:\n  fn f(self): i32\n\nconcept B:\n  fn f(self): bool\n\nfn g<T: A + B>(x: T): i32\n  return x.f()\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("first_bound_types_shared_member_reordered", "concept A:\n  fn f(self): i32\n\nconcept B:\n  fn f(self): bool\n\nfn g<T: B + A>(x: T): i32\n  return x.f()\n"):
    pass_count = pass_count + 1
  // A class derives a concept through the `extend`s in scope in its own
  // module (the host's rule, CONTRACT_MODULE_SYSTEM.md §5): an import
  // does not bring a module's extends along, so a class in `main` does
  // not derive through `lib`'s extend — but it does through the
  // prelude's, which every module sees with no import, whatever the
  // input order.  Conformance state threads across the program's
  // modules, and a concept method is matched by its type's name, which
  // any module can read.
  let dc_lib: string = "module app::lib\nderived concept Show:\n  fn show(self): string\n\nextend i32 as Show:\n  fn show(self): string\n    return \"n\"\n"
  let dc_main: string = "module app::main\nimport app::lib\n\nclass P:\n  x: i32\n\nfn f(p: P): string\n  return p.show()\n"
  if tc_expect_program_errors("derived_conformance_needs_visible_extend", Vector<SourceInput>::new().push(SourceInput("lib.dao", dc_lib, false)), dc_main, "main.dao", 1):
    pass_count = pass_count + 1
  let dc_prelude: string = "module core::show\nderived concept Show:\n  fn show(self): string\n\nextend i32 as Show:\n  fn show(self): string\n    return \"n\"\n"
  let dc_user: string = "module app::main\n\nclass P:\n  x: i32\n\nfn f(p: P): string\n  return p.show()\n"
  if tc_expect_program_errors("derived_conformance_through_prelude_extend", Vector<SourceInput>::new().push(SourceInput("stdlib/core/show.dao", dc_prelude, true)), dc_user, "main.dao", 0):
    pass_count = pass_count + 1
  // The prelude's files see one another as one namespace: a class in
  // one prelude file derives through a concept and extend declared in
  // another, whichever is checked first (collection precedes derivation).
  let dc_pre_class: string = "module core::a\n\nclass P:\n  x: i32\n"
  let dc_pre_user: string = "module app::main\n\nfn f(p: P): string\n  return p.show()\n"
  if tc_expect_program_errors("derived_conformance_across_prelude_files", Vector<SourceInput>::new().push(SourceInput("stdlib/core/a.dao", dc_pre_class, true)).push(SourceInput("stdlib/core/z.dao", dc_prelude, true)), dc_pre_user, "main.dao", 0):
    pass_count = pass_count + 1
  // Two modules each extending one type as one concept conform it in
  // each of them: a class in either derives.
  let dc_show_only: string = "module core::show\nderived concept Show:\n  fn show(self): string\n"
  let dc_lib_a: string = "module app::a\nextend i32 as Show:\n  fn show(self): string\n    return \"a\"\n\nclass PA:\n  x: i32\n\nfn fa(p: PA): string\n  return p.show()\n"
  let dc_lib_b: string = "module app::b\nextend i32 as Show:\n  fn show(self): string\n    return \"b\"\n\nclass PB:\n  x: i32\n\nfn fb(p: PB): string\n  return p.show()\n"
  if tc_expect_program_errors("conformance_per_module_extends", Vector<SourceInput>::new().push(SourceInput("stdlib/core/show.dao", dc_show_only, true)).push(SourceInput("a.dao", dc_lib_a, false)).push(SourceInput("b.dao", dc_lib_b, false)), "module app::main\nimport app::a\nimport app::b\n", "main.dao", 0):
    pass_count = pass_count + 1
  // Every derivation precedes every body: a body in an earlier prelude
  // file dispatches through a class, concept, and extend declared in a
  // later one; and an extend in an earlier file satisfies a concept
  // declared in a later one (the requirement's name is read off its
  // type, never through this file's tokens).
  let dc_pre_body: string = "module core::a\n\nfn render(p: P): string\n  return p.show()\n"
  let dc_pre_all: string = "module core::z\nderived concept Show:\n  fn show(self): string\n\nextend i32 as Show:\n  fn show(self): string\n    return \"n\"\n\nclass P:\n  x: i32\n"
  if tc_expect_program_errors("derivation_precedes_bodies", Vector<SourceInput>::new().push(SourceInput("stdlib/core/a.dao", dc_pre_body, true)).push(SourceInput("stdlib/core/z.dao", dc_pre_all, true)), "module app::main\n", "main.dao", 0):
    pass_count = pass_count + 1
  let dc_pre_extend: string = "module core::a\n\nextend i32 as Show:\n  fn show(self): string\n    return \"n\"\n"
  if tc_expect_program_errors("satisfaction_across_prelude_files", Vector<SourceInput>::new().push(SourceInput("stdlib/core/a.dao", dc_pre_extend, true)).push(SourceInput("stdlib/core/z.dao", dc_show_only, true)), "module app::main\n", "main.dao", 0):
    pass_count = pass_count + 1
  // Satisfaction is checked once every module's method tables exist: an
  // extend in an earlier prelude file is held to a concept declared in a
  // later one.
  let dc_pre_bad_extend: string = "module core::a\n\nextend i32 as Show:\n  fn show(self): i64\n    return 1\n"
  if tc_expect_program_errors("satisfaction_holds_across_prelude_files", Vector<SourceInput>::new().push(SourceInput("stdlib/core/a.dao", dc_pre_bad_extend, true)).push(SourceInput("stdlib/core/z.dao", dc_show_only, true)), "module app::main\n", "stdlib/core/a.dao", 1):
    pass_count = pass_count + 1
  // Another module's struct is read through its field symbols: a field
  // access types, and a missing field is diagnosed, across the module
  // boundary.
  let dc_point: string = "module app::lib\n\nclass P:\n  x: i32\n"
  if tc_expect_program_errors("foreign_field_access_typed", Vector<SourceInput>::new().push(SourceInput("lib.dao", dc_point, false)), "module app::main\nimport app::lib\n\nfn f(p: lib::P): bool\n  return p.x\n", "main.dao", 1):
    pass_count = pass_count + 1
  if tc_expect_program_errors("foreign_field_missing_diagnosed", Vector<SourceInput>::new().push(SourceInput("lib.dao", dc_point, false)), "module app::main\nimport app::lib\n\nfn f(p: lib::P): i32\n  return p.y\n", "main.dao", 1):
    pass_count = pass_count + 1
  // Every identity precedes every alias and signature: an alias and an
  // enum declared in a later prelude file resolve in an earlier one's
  // signatures, so those signatures carry their meaning.
  let dc_alias_user: string = "module core::a\nderived concept Show:\n  fn show(self, n: Number): bool\n\nextend i32 as Show:\n  fn show(self, n: Number): bool\n    return true\n"
  let dc_alias_decl: string = "module core::z\ntype Number = i32\n"
  if tc_expect_program_errors("alias_across_prelude_files_types_signature", Vector<SourceInput>::new().push(SourceInput("stdlib/core/a.dao", dc_alias_user, true)).push(SourceInput("stdlib/core/z.dao", dc_alias_decl, true)), "module app::main\n\nclass P:\n  x: i32\n\nfn f(p: P): bool\n  return p.show(true)\n", "main.dao", 1):
    pass_count = pass_count + 1
  let dc_enum_user: string = "module core::a\nfn pick(c: Color): i32\n  return 0\n"
  let dc_enum_decl: string = "module core::z\nenum Color:\n  Red\n  Blue\n"
  if tc_expect_program_errors("enum_across_prelude_files_types_signature", Vector<SourceInput>::new().push(SourceInput("stdlib/core/a.dao", dc_enum_user, true)).push(SourceInput("stdlib/core/z.dao", dc_enum_decl, true)), "module app::main\n\nfn f(): i32\n  return pick(1)\n", "main.dao", 1):
    pass_count = pass_count + 1
  // A generic concept head is no type either.
  if tc_expect_rejected("generic_concept_annotation_rejected", "derived concept C<T>:\n  fn f(self): bool\n\nextern fn consume(x: C<i32>): bool\n"):
    pass_count = pass_count + 1
  // A receiver's own method is found through the type's declaring module,
  // which the type records: a module's `Box` shadowing the prelude's at
  // the same declaration index answers with its own `get`.
  let dc_pre_box: string = "module core::box\nclass Box:\n  n: i32\n  fn get(self): bool\n    return true\n"
  let dc_user_box: string = "module app::main\nclass Box:\n  n: i32\n  fn get(self): i32\n    return 1\n\nfn f(b: Box): i32\n  return b.get()\n"
  if tc_expect_program_errors("shadowing_class_keeps_its_own_method", Vector<SourceInput>::new().push(SourceInput("stdlib/core/box.dao", dc_pre_box, true)), dc_user_box, "main.dao", 0):
    pass_count = pass_count + 1
  // An extend's `self` is the type its target annotation resolves to in
  // the extend's own module, not a same-named type elsewhere.
  let dc_pre_ext: string = "module core::p\nconcept Show:\n  fn show(self): i32\n\nclass P:\n  x: i32\n\nextend P as Show:\n  fn show(self): i32\n    return self.x\n"
  if tc_expect_program_errors("extend_self_is_resolved_target", Vector<SourceInput>::new().push(SourceInput("stdlib/core/p.dao", dc_pre_ext, true)), "module app::main\nclass P:\n  x: bool\n", "main.dao", 0):
    pass_count = pass_count + 1
  if tc_expect_rejected("concept_in_generic_argument_rejected", "concept C:\n  fn f(self): bool\n\nclass Box<T>:\n  v: T\n\nextern fn consume(x: Box<C>): bool\n"):
    pass_count = pass_count + 1
  // The concept's own name applied to its parameters is its self form:
  // `C<T>` in C's signatures means the conforming type.
  if tc_expect_clean("applied_self_concept_substitutes", "concept C<T>:\n  fn copy(self): C<T>\n\nfn f<U: C<i32>>(x: U): U\n  return x.copy()\n"):
    pass_count = pass_count + 1
  // A same-named type's own method is never a candidate for another
  // receiver, and an extend's method answers only for the type it
  // extends: main's `P`, deriving `Show`, is not answered by the
  // prelude's `P.show`.
  let dc_pre_pshow: string = "module core::p\nderived concept Show:\n  fn show(self): string\n\nextend i32 as Show:\n  fn show(self): string\n    return \"n\"\n\nclass P:\n  n: i32\n  fn show(self): bool\n    return true\n"
  if tc_expect_program_errors("other_type_method_never_answers", Vector<SourceInput>::new().push(SourceInput("stdlib/core/p.dao", dc_pre_pshow, true)), "module app::main\nclass P:\n  x: i32\n\nfn f(p: P): string\n  return p.show()\n", "main.dao", 0):
    pass_count = pass_count + 1
  // The applied self form keeps its pointer wrappers: `*C<T>` is `*U`.
  if tc_expect_clean("applied_self_pointer_kept", "concept C<T>:\n  fn same(self, o: *C<T>): bool\n\nfn f<U: C<i32>>(x: U, p: *U): bool\n  return x.same(p)\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("applied_self_pointer_not_erased", "concept C<T>:\n  fn same(self, o: *C<T>): bool\n\nfn f<U: C<i32>>(x: U): bool\n  return x.same(x)\n"):
    pass_count = pass_count + 1
  // A qualified concept name inside a generic argument is no type.
  if tc_expect_program_errors("qualified_concept_in_generic_argument_rejected", Vector<SourceInput>::new().push(SourceInput("lib.dao", "module app::lib\nconcept C:\n  fn f(self): bool\n", false)), "module app::main\nimport app::lib\n\nclass Box<T>:\n  v: T\n\nextern fn consume(x: Box<lib::C>): bool\n", "main.dao", 1):
    pass_count = pass_count + 1
  // Satisfaction takes the target type's own methods and extends, never
  // a same-named type's: the prelude's `P.required` does not satisfy
  // main's `extend P as C`.
  let dc_pre_req: string = "module core::p\nclass P:\n  n: i32\n  fn required(self): bool\n    return true\n"
  if tc_expect_program_errors("satisfaction_uses_target_type", Vector<SourceInput>::new().push(SourceInput("stdlib/core/p.dao", dc_pre_req, true)), "module app::main\nconcept C:\n  fn required(self): bool\n\nclass P:\n  x: i32\n\nextend P as C:\n  fn other(self): bool\n    return true\n", "main.dao", 1):
    pass_count = pass_count + 1
  // A parameter symbol is found in its own module: two modules' methods
  // at one declaration index each bind their own `self`.
  let dc_pre_get: string = "module core::box\nclass Box:\n  x: i32\n  fn get(self): i32\n    return self.x\n"
  if tc_expect_program_errors("self_bound_per_module", Vector<SourceInput>::new().push(SourceInput("stdlib/core/box.dao", dc_pre_get, true)), "module app::main\nclass Box:\n  x: i32\n  fn get(self): bool\n    return self.x\n", "main.dao", 1):
    pass_count = pass_count + 1
  // An extend's method has a receiver (the host's validate_receiver):
  // one without `self` first is diagnosed.
  if tc_expect_rejected("extend_method_requires_self", "concept Factory:\n  fn make(): i32\n\nextend i32 as Factory:\n  fn make(): i32\n    return 1\n"):
    pass_count = pass_count + 1
  // A method's own type parameter shadowing the concept's is a
  // different parameter: `C<T>` with that `T` is not the self form.
  if tc_expect_rejected("applied_self_shadowed_param_rejected", "concept C<T>:\n  fn copy<T>(self): C<T>\n"):
    pass_count = pass_count + 1
  // Expression-bodied methods of a class and of an extend are registered
  // and their bodies checked like block-bodied ones.
  if tc_expect_clean("expr_method_registered", "class C:\n  x: i64\n  fn get(self): i64 -> self.x\n\nfn f(c: C): i64\n  return c.get()\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("expr_method_body_checked", "class C:\n  x: i64\n  fn get(self): bool -> self.x\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("expr_extend_method_registered", "concept Show:\n  fn show(self): string\n\nextend i32 as Show:\n  fn show(self): string -> \"n\"\n\nfn f(n: i32): string\n  return n.show()\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("expr_extend_method_body_checked", "concept Show:\n  fn show(self): string\n\nextend i32 as Show:\n  fn show(self): string -> 1\n"):
    pass_count = pass_count + 1
  // The applied self form's arguments may name no concept.
  if tc_expect_rejected("applied_self_with_concept_argument_rejected", "concept Other:\n  fn g(self): bool\n\nconcept C<T>:\n  fn f(self, x: C<Other>): bool\n"):
    pass_count = pass_count + 1
  // The self name inside another generic hides no other concept there,
  // in either argument order.
  if tc_expect_rejected("concept_beside_self_in_generic_rejected", "concept Other:\n  fn g(self): bool\n\nclass Pair<A, B>:\n  a: A\n  b: B\n\nconcept C:\n  fn f(self, x: Pair<C, Other>): bool\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("concept_before_self_in_generic_rejected", "concept Other:\n  fn g(self): bool\n\nclass Pair<A, B>:\n  a: A\n  b: B\n\nconcept C:\n  fn f(self, x: Pair<Other, C>): bool\n"):
    pass_count = pass_count + 1
  // The applied self form applies the concept's own type parameters, in
  // order: any other application (a different count, a concrete
  // argument, the parameters reordered) is rejected.
  if tc_expect_rejected("applied_self_arity_nongeneric_rejected", "concept C:\n  fn f(self, o: C<i32>): bool\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("applied_self_arity_mismatch_rejected", "concept C<T>:\n  fn f(self, o: C<T, T>): bool\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("applied_self_concrete_argument_rejected", "concept C<T>:\n  fn copy(self): C<bool>\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("applied_self_reordered_params_rejected", "concept C<A, B>:\n  fn swap(self): C<B, A>\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("applied_self_two_params_accepted", "concept C<A, B>:\n  fn same(self, o: C<A, B>): bool\n"):
    pass_count = pass_count + 1
  // Alias chains resolve whatever their declaration order, within a file
  // and across prelude files; a cycle is diagnosed.
  if tc_expect_clean("alias_chain_forward", "type Count = Number\ntype Number = i32\n\nfn f(n: Count): Number\n  return n\n"):
    pass_count = pass_count + 1
  if tc_expect_program_errors("alias_chain_across_prelude_files", Vector<SourceInput>::new().push(SourceInput("stdlib/core/a.dao", "module core::a\ntype Count = Number\n", true)).push(SourceInput("stdlib/core/z.dao", "module core::z\ntype Number = i32\n", true)), "module app::main\n\nfn f(n: Count): i32\n  return n\n", "main.dao", 0):
    pass_count = pass_count + 1
  if tc_expect_rejected("alias_cycle_rejected", "type A = B\ntype B = A\n"):
    pass_count = pass_count + 1
  // An extend written through an alias answers for the type the alias
  // names: dispatch matches the receiver's type, never a spelling.
  if tc_expect_clean("extend_through_alias_dispatches", "concept Show:\n  fn show(self): string\n\nclass P:\n  x: i32\n\ntype Alias = P\n\nextend Alias as Show:\n  fn show(self): string\n    return \"p\"\n\nfn f(p: P): string\n  return p.show()\n"):
    pass_count = pass_count + 1
  // A requirement taking `self` is not met by a class's static method.
  if tc_expect_rejected("static_method_does_not_satisfy_receiver_requirement", "concept C:\n  fn required(self): bool\n\nclass P:\n  x: i32\n  fn required(flag: bool): bool\n    return flag\n\nextend P as C:\n  fn other(self): bool\n    return true\n"):
    pass_count = pass_count + 1
  // A static requirement compares every parameter (there is no `self`
  // to skip): a static implementation of another shape is diagnosed.
  if tc_expect_rejected("static_requirement_compares_all_params", "concept F:\n  fn make(n: i32): bool\n\nclass P:\n  x: i32\n  fn make(n: bool): bool\n    return n\n\nextend P as F:\n  fn other(self): bool\n    return true\n"):
    pass_count = pass_count + 1
  // One type answers one name once: an extend through an alias of an
  // already extended type conflicts, never silently replaces.
  if tc_expect_rejected("extend_through_alias_conflicts", "concept C:\n  fn f(self): i32\n\nclass P:\n  x: i32\n\ntype Alias = P\n\nextend P as C:\n  fn f(self): bool\n    return true\n\nextend Alias as C:\n  fn f(self): i32\n    return 1\n"):
    pass_count = pass_count + 1
  // A builtin receiver has the methods an extend gave it: the call is
  // typed by the method's signature.
  if tc_expect_rejected("builtin_receiver_extend_method_typed", "concept Show:\n  fn show(self): string\n\nextend i32 as Show:\n  fn show(self): string -> \"n\"\n\nfn f(n: i32): bool\n  return n.show()\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("builtin_receiver_missing_method_diagnosed", "concept Show:\n  fn show(self): string\n\nextend i32 as Show:\n  fn show(self): string -> \"n\"\n\nfn f(n: i32): string\n  return n.shwo()\n"):
    pass_count = pass_count + 1
  // Two derived concepts a class conforms to that both provide a member
  // are an ambiguity, in either declaration order: the conformances are
  // otherwise valid (one `i32.f` satisfies both concepts' `f`), and the
  // ambiguity is diagnosed at the access.
  let amb_a_first: string = "derived concept A:\n  fn f(self): i32\n\nderived concept B:\n  fn f(self): i32\n  fn g(self): i32\n\nclass P:\n  x: i32\n\nextend i32 as A:\n  fn f(self): i32 -> 1\n\nextend i32 as B:\n  fn g(self): i32 -> 2\n\nfn h(p: P): i32\n  return p.f()\n"
  let amb_b_first: string = "derived concept B:\n  fn f(self): i32\n  fn g(self): i32\n\nderived concept A:\n  fn f(self): i32\n\nclass P:\n  x: i32\n\nextend i32 as B:\n  fn g(self): i32 -> 2\n\nextend i32 as A:\n  fn f(self): i32 -> 1\n\nfn h(p: P): i32\n  return p.f()\n"
  if tc_expect_diag_containing("ambiguous_derived_member_rejected", amb_a_first, "provided by more than one derived concept"):
    pass_count = pass_count + 1
  if tc_expect_diag_containing("ambiguous_derived_member_rejected_reversed", amb_b_first, "provided by more than one derived concept"):
    pass_count = pass_count + 1
  // A static method is called as `Type::m(...)`, never through a value.
  if tc_expect_rejected("static_method_via_instance_rejected", "class C:\n  x: i32\n  fn make(): i32 -> 7\n\nfn f(c: C): i32\n  return c.make()\n"):
    pass_count = pass_count + 1
  if tc_expect_clean("static_method_via_type_accepted", "class C:\n  x: i32\n  fn make(): i32 -> 7\n\nfn f(): i32\n  return C::make()\n"):
    pass_count = pass_count + 1
  // A qualified call of an instance method checks its receiver argument.
  if tc_expect_rejected("qualified_call_checks_receiver", "class C:\n  x: i32\n  fn get(self): i32 -> self.x\n\nfn f(): i32\n  return C::get(true)\n"):
    pass_count = pass_count + 1
  // `::` reaches a type's statics; an instance method is reached on a
  // value, whatever is passed for its `self`.
  if tc_expect_diag_containing("qualified_call_of_instance_method_rejected", "class C:\n  x: i32\n  fn get(self): i32 -> self.x\n\nfn f(c: C): i32\n  return C::get(c)\n", "is an instance method"):
    pass_count = pass_count + 1
  // The name after `as` must name a concept in scope.
  if tc_expect_rejected("extend_unknown_concept_rejected", "extend i32 as Missing:\n  fn show(self): string -> \"n\"\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("extend_non_concept_rejected", "class Q:\n  x: i32\n\nextend i32 as Q:\n  fn show(self): string -> \"n\"\n"):
    pass_count = pass_count + 1
  // Extends of distinct pointer targets declare distinct methods.
  if tc_expect_clean("pointer_receiver_extends_distinct", "concept Show:\n  fn show(self): string\n\nextend *i32 as Show:\n  fn show(self): string -> \"a\"\n\nextend *i64 as Show:\n  fn show(self): string -> \"b\"\n"):
    pass_count = pass_count + 1
  // An invalid extend does not hide the one after it: both are checked.
  if tc_expect_diags("consecutive_extends_each_checked", "concept Show:\n  fn show(self): string\n\nextend i32 as Missing:\n  fn show(self): string -> \"n\"\n\nextend i64 as Show:\n  fn other(self): string -> \"m\"\n", 2):
    pass_count = pass_count + 1
  // Extends of two imported, same-named types declare distinct methods.
  if tc_expect_program_errors("qualified_receiver_extends_distinct", Vector<SourceInput>::new().push(SourceInput("a.dao", "module app::a\nclass P:\n  x: i32\n", false)).push(SourceInput("b.dao", "module app::b\nclass P:\n  x: i32\n", false)), "module app::main\nimport app::a\nimport app::b\n\nconcept Show:\n  fn show(self): string\n\nextend a::P as Show:\n  fn show(self): string -> \"a\"\n\nextend b::P as Show:\n  fn show(self): string -> \"b\"\n", "main.dao", 0):
    pass_count = pass_count + 1
  // A value's name is no namespace: `c::make` with `c` a parameter is
  // diagnosed, called or taken as a value.
  if tc_expect_rejected("value_prefix_static_call_rejected", "class C:\n  x: i32\n  fn make(): i32 -> 7\n\nfn f(c: C): i32\n  return c::make()\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("value_prefix_method_reference_rejected", "class C:\n  x: i32\n  fn make(): i32 -> 7\n\nfn f(c: C): i32\n  let g = c::make\n  return 0\n"):
    pass_count = pass_count + 1
  // A function or method call takes positional arguments: a named one is
  // diagnosed, reordered or unknown alike.
  if tc_expect_rejected("named_argument_on_function_rejected", "fn sub(a: i32, b: i32): i32 -> a - b\n\nfn f(): i32\n  return sub(b = 1, a = 2)\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("named_argument_on_static_method_rejected", "class C:\n  x: i32\n  fn sub(a: i32, b: i32): i32 -> a - b\n\nfn f(): i32\n  return C::sub(nope = 1, a = 2)\n"):
    pass_count = pass_count + 1
  // An extend may not redefine a type's own method (dispatch would
  // always prefer the type's), through an alias or directly.
  if tc_expect_rejected("extend_redefining_inherent_method_rejected", "concept C:\n  fn f(self): i32\n\nclass P:\n  x: i32\n  fn f(self): i32 -> 1\n\ntype Alias = P\n\nextend Alias as C:\n  fn f(self): bool -> true\n"):
    pass_count = pass_count + 1
  // A class is constructed positionally: a named argument is diagnosed.
  if tc_expect_rejected("named_argument_on_constructor_rejected", "class C:\n  x: i32\n  y: i32\n\nfn f(): i32\n  let c: C = C(y = 1, x = 2)\n  return 0\n"):
    pass_count = pass_count + 1
  // A qualified member the type does not have is diagnosed, called or
  // taken as a value.
  if tc_expect_rejected("missing_static_member_call_rejected", "class C:\n  x: i32\n\nfn f(): i32\n  let c: C = C::missing(1)\n  return 0\n"):
    pass_count = pass_count + 1
  if tc_expect_rejected("missing_static_member_value_rejected", "class C:\n  x: i32\n\nfn f(): i32\n  let g = C::missing\n  return 0\n"):
    pass_count = pass_count + 1
  // A literal argument of a variant adopts the parameter's type.
  if tc_expect_clean("variant_literal_argument_fits", "enum class Pair:\n  Both(a: i64, b: i64)\n\nfn f(): i32\n  let p: Pair = Pair::Both(b = 2, a = 1)\n  return 0\n"):
    pass_count = pass_count + 1
  // A type's own method registered after an extend of it in an earlier
  // prelude file, written through an alias, conflicts with that extend,
  // whatever the file order: the checker's one diagnostic.
  if tc_expect_program_errors("inherent_after_prelude_extend_conflicts", Vector<SourceInput>::new().push(SourceInput("stdlib/core/a.dao", "module core::a\nconcept C:\n  fn f(self): i32\n\ntype Alias = P\n\nextend Alias as C:\n  fn f(self): i32 -> 2\n", true)).push(SourceInput("stdlib/core/z.dao", "module core::z\nclass P:\n  x: i32\n  fn f(self): i32 -> 1\n", true)), "module app::main\n", "stdlib/core/z.dao", 1):
    pass_count = pass_count + 1
  // Spelled with the type's own name, the two methods share a mangled
  // name in the prelude's namespace: the resolver's duplicate
  // declaration reports it, once.
  if tc_expect_program_errors("inherent_after_prelude_extend_reported_once", Vector<SourceInput>::new().push(SourceInput("stdlib/core/a.dao", "module core::a\nconcept C:\n  fn f(self): i32\n\nextend P as C:\n  fn f(self): i32 -> 2\n", true)).push(SourceInput("stdlib/core/z.dao", "module core::z\nclass P:\n  x: i32\n  fn f(self): i32 -> 1\n", true)), "module app::main\n", "stdlib/core/z.dao", 1):
    pass_count = pass_count + 1
  // A module's extend of a prelude class shares the class method's
  // mangled name but shadows it in its own namespace, so the resolver
  // reports nothing: the conflict is the checker's, reported in the
  // module.
  if tc_expect_program_errors("module_extend_of_prelude_method_conflicts", Vector<SourceInput>::new().push(SourceInput("stdlib/core/z.dao", "module core::z\nclass P:\n  x: i32\n  fn f(self): i32 -> 1\n", true)), "module app::main\nconcept C:\n  fn f(self): i32\n\nextend P as C:\n  fn f(self): i32 -> 2\n", "main.dao", 1):
    pass_count = pass_count + 1
  // A concept is not a receiver type: `extend C as C` is diagnosed and
  // records no conformance.
  if tc_expect_rejected("extend_target_concept_rejected", "concept C:\n  fn ok(self): bool\n\nextend C as C:\n  fn ok(self): bool\n    return true\n"):
    pass_count = pass_count + 1
  // Concept identities precede every signature: a signature in an
  // earlier prelude file naming a concept declared in a later one is
  // diagnosed there.
  let dc_pre_sig: string = "module core::a\n\nextern fn f(x: Eq): bool\n"
  let dc_pre_concept: string = "module core::z\nconcept Eq:\n  fn eq(self, o: Eq): bool\n"
  if tc_expect_program_errors("concept_is_not_a_type_across_prelude_files", Vector<SourceInput>::new().push(SourceInput("stdlib/core/a.dao", dc_pre_sig, true)).push(SourceInput("stdlib/core/z.dao", dc_pre_concept, true)), "module app::main\n", "stdlib/core/a.dao", 1):
    pass_count = pass_count + 1
  // A class its own module also extends explicitly still derives — the
  // derivation is the type's, visible to a consuming module's class.
  let dc_both: string = "module app::lib\nderived concept Show:\n  fn show(self): string\n\nextend i32 as Show:\n  fn show(self): string\n    return \"n\"\n\nclass P:\n  x: i32\n\nextend P as Show:\n  fn show(self): string\n    return \"p\"\n"
  let dc_wrap: string = "module app::main\nimport app::lib\n\nclass W:\n  p: lib::P\n\nfn f(w: W): string\n  return w.show()\n"
  if tc_expect_program_errors("derived_conformance_survives_local_extend", Vector<SourceInput>::new().push(SourceInput("lib.dao", dc_both, false)), dc_wrap, "main.dao", 0):
    pass_count = pass_count + 1
  let r_unc: TypeCheckResult = typecheck("fn f<T>(x: T): string\n  return x.to_string()\n")
  if tc_count_diags(r_unc) >= 1:
    print("PASS unconstrained_param_member_rejected")
    pass_count = pass_count + 1
  else:
    print("FAIL unconstrained_param_member_rejected: expected >= 1 diagnostic, got 0")

  // -----------------------------------------------------------------
  // Summary
  // -----------------------------------------------------------------

  print("--- results ---")
  print(i32_to_string(pass_count) + " / " + i32_to_string(total) + " passed")
  print("")

  // Tier B deferrals (documented, not silently omitted):
  //   - Generic type parameters, inference, substitution
  //   - Concept / extend / derived conformance
  //   - Method tables and method dispatch
  //   - Lambda contextual typing
  //   - List literal type inference
  //   - Try operator (requires generic Option/Result)
  //   - Deref / addr-of unary operators
  //   - Index expressions
  //   - Mode blocks; resource-block domain semantics (bodies are checked)
  //   - Yield / Generator checking
  //   - C ABI type validation
  //   - Structural function type comparison
  //   - For-loop element type inference from iterables

  return 0

