module bootstrap::llvm_tests
// Test runner for the bootstrap llvm.  Assembled after the
// shared base and every library it exercises; never compiled
// standalone.

// =========================================================================
// Section 99: Tests
// =========================================================================

// Substring match helper.
fn contains_substring(haystack: string, needle: string): bool
  let nlen: i64 = length(needle)
  let hlen: i64 = length(haystack)
  if nlen > hlen:
    return false
  let i: i64 = to_i64(0)
  while i + nlen <= hlen:
    if substring(haystack, i, nlen) == needle:
      return true
    i = i + to_i64(1)
  return false

// Write a fixture's IR for bootstrap/validate_ir.sh: the text to
// bootstrap/llvm/out/<name>.ll, and the exit code the program is
// expected to produce to <name>.exit when the fixture has a main with a
// known result (a negative expectation means validate only).  The
// directory is created by the harness.  Returns the number of artifacts
// that could not be written, so a failed write fails the suite instead
// of leaving a stale or missing file for validation to miss.
fn emit_ir(name: string, result: LlvmTextResult, expected_exit: i32): i32
  if result.ok == false:
    return 0
  let path: string = "bootstrap/llvm/out/" + name + ".ll"
  if write_llvm_text(result, path) == false:
    print("FAIL " + name + ": could not write " + path)
    return 1
  if expected_exit >= 0:
    let exit_path: string = "bootstrap/llvm/out/" + name + ".exit"
    if write_file(exit_path, expected_exit.to_string()) == false:
      print("FAIL " + name + ": could not write " + exit_path)
      return 1
  return 0

fn diags_text(diags: Vector<Diagnostic>): string
  let out: Builder = Builder::new()
  let i: i64 = to_i64(0)
  while i < diags.length():
    out = out.push(diags.get(i).message + "\n")
    i = i + to_i64(1)
  return out.to_string()

fn check_contains(result: LlvmTextResult, needle: string, test_name: string): bool
  if contains_substring(result.text, needle):
    return true
  print("FAIL " + test_name + ": expected substring '" + needle + "' not found")
  print("--- emitted text ---")
  print(result.text)
  print("--- end ---")
  return false


// =========================================================================
// Closure probe: feed one assembled bootstrap program through one stage
// of the bootstrap pipeline and record what that stage says.  Opt-in --
// runs only when bootstrap/llvm/out/.closure_probe exists; its content
// is "<program>\t<stage>" (bootstrap/audit_closure.sh runs one process
// per program and stage: a Dao panic aborts the process and must not
// hide the other lines, and the bootstrap frees nothing, so a stage's
// cost can only be measured alone).  The probe process does nothing
// else.  The stage's columns are appended to bootstrap/llvm/out/closure.txt:
//   <program>\t<stage>=<diagnostics>...
// ("parse" writes lex= and parse=, "typecheck" writes resolve= and
// typecheck=; the script merges the stages into the program's line and
// adds peak memory, time, and the earliest failing stage's first
// diagnostic).  "probe: <program> stage=<stage>", the counts, and each
// stage's first diagnostic go to stderr, which is not buffered, so a
// killed process still shows where it died.
// =========================================================================

// Report a stage's diagnostics on stderr (at most `limit`), one per line,
// so the audit can histogram what each stage rejects.
fn closure_report_diags(name: string, stage: string, diags: Vector<Diagnostic>, limit: i64): void
  closure_report_diags_from(name, stage, diags, to_i64(0), limit)

// The same from index `from`: a pass whose list begins with an earlier
// pass's diagnostics reports only its own.
fn closure_report_diags_from(name: string, stage: string, diags: Vector<Diagnostic>, from: i64, limit: i64): void
  let i: i64 = from
  while i < diags.length():
    if i - from >= limit:
      return
    eprint("probe: " + name + " diag " + stage + ": " + diags.get(i).message)
    i = i + to_i64(1)

// One file's share of the diagnostics the program pipeline attaches
// from index `from` on (a later pass appends to an earlier pass's
// list): with the prelude in the program the list carries every
// file's, and a column is one file's.
class DiagTally:
  count: i64
  first: string

fn closure_tally_by_path(diags: Vector<FileDiagnostic>, from: i64, path: string): DiagTally
  let n: i64 = 0
  let first: string = ""
  let i: i64 = from
  while i < diags.length():
    let fd: FileDiagnostic = diags.get(i)
    if fd.path == path:
      if n == to_i64(0):
        first = fd.diag.message
      n = n + to_i64(1)
    i = i + to_i64(1)
  return DiagTally(n, first)

// The same as closure_report_diags_from, for one file's diagnostics
// among those the program pipeline attaches.
fn closure_report_file_diags(name: string, stage: string, diags: Vector<FileDiagnostic>, from: i64, limit: i64, path: string): void
  let reported: i64 = 0
  let i: i64 = from
  while i < diags.length():
    if reported >= limit:
      return
    let fd: FileDiagnostic = diags.get(i)
    if fd.path == path:
      eprint("probe: " + name + " diag " + stage + ": " + fd.diag.message)
      reported = reported + to_i64(1)
    i = i + to_i64(1)

// The prelude the audit gives the program pipeline: the file list it
// writes beside the marker, one path per line in path order.  The
// probe has no directory listing, so membership is explicit input
// (CONTRACT_MODULE_SYSTEM.md §7.1); no list, no prelude.
fn closure_prelude_inputs(): Vector<SourceInput>
  let inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  if file_exists("bootstrap/llvm/out/.closure_prelude") == false:
    return inputs
  let listing: string = read_file("bootstrap/llvm/out/.closure_prelude")
  let start: i64 = 0
  while start < length(listing):
    let rest: string = substring(listing, start, length(listing) - start)
    let nl: i64 = index_of(rest, "\n")
    let line: string = rest
    if nl >= to_i64(0):
      line = substring(rest, to_i64(0), nl)
      start = start + nl + to_i64(1)
    else:
      start = length(listing)
    if length(line) > to_i64(0):
      inputs = inputs.push(SourceInput(line, read_file(line), true))
  return inputs

// One stage per process, from source: the bootstrap frees nothing, so
// a stage's cost can only be measured alone.  `parse` reports the
// lexer's and the parser's counts (the parser's list begins with the
// lexer's), `typecheck` the resolver's and the type checker's (one
// program pipeline, run once), and `hir`, `mir`, `llvm` their own.
// Each pass's list begins with what it was handed, so a pass's own
// diagnostics are the tail past that baseline -- counted, reported,
// and used for the first diagnostic.
// A compiler program resolved and type-checked with the prelude, and
// the resolve and typecheck columns it reports.
class ProbedProgram:
  program: Program
  typed: ProgramTyped
  cols: string

// The program pipeline, with the prelude, through typecheck: the columns
// count the compiler program's own diagnostics, by path.  Each stage runs
// in its own domain: its scratch is reclaimed at the exit and the result
// is copied out.  `report` is false where a later stage only needs the
// checked program: resolve and typecheck report in their own probe, once.
fn closure_program_checked(name: string, path: string, src: string, report: bool): ProbedProgram
  let inputs: Vector<SourceInput> = closure_prelude_inputs()
  inputs = inputs.push(SourceInput(path, wrap_test_module(src), false))
  let pg: ProgramGraph = program_graph_empty()
  resource memory graph =>
    pg = build_program(inputs)
  let p: Program = program_from_graph(pg)
  resource memory resolve =>
    p = program_run_resolve(p)
  let pt: ProgramTyped = ProgramTyped(p, registry_new(p.resolve.symbols, p.graph.modules))
  resource memory typecheck =>
    pt = program_check(p)
  p = pt.program
  if report == false:
    return ProbedProgram(p, pt, "")
  let carried_into_resolve: i64 = pg.diags.length()
  closure_report_file_diags(name, "resolve", p.resolve.diags, carried_into_resolve, to_i64(50), path)
  let cols: string = closure_stage_file_column(name, "resolve", p.resolve.diags, carried_into_resolve, path)
  let carried_into_typecheck: i64 = p.resolve.diags.length()
  closure_report_file_diags(name, "typecheck", p.diags, carried_into_typecheck, to_i64(50), path)
  cols = cols + closure_stage_file_column(name, "typecheck", p.diags, carried_into_typecheck, path)
  return ProbedProgram(p, pt, cols)

fn closure_probe_stage(name: string, path: string, stage: string): string
  if file_exists(path) == false:
    return name + "\tmissing=" + path + "\n"
  let src: string = read_file(path)
  let cols: string = ""
  eprint("probe: " + name + " stage=" + stage)
  if stage == "parse":
    let lexed: LexResult = lex_result_empty()
    resource memory lex =>
      lexed = lex(src)
    let lex_n: i64 = lexed.diagnostics.length()
    closure_report_diags(name, "lex", lexed.diagnostics, to_i64(50))
    cols = cols + closure_stage_column(name, "lex", lexed.diagnostics, to_i64(0))
    let parsed: ParseOutput = parse_output_empty()
    resource memory parse =>
      parsed = parse(src)
    closure_report_diags_from(name, "parse", parsed.diags, lex_n, to_i64(50))
    cols = cols + closure_stage_column(name, "parse", parsed.diags, lex_n)
  if stage == "typecheck":
    let checked: ProbedProgram = closure_program_checked(name, path, src, true)
    cols = cols + checked.cols
  if stage == "hir":
    // HIR lowers the program the checker typed, prelude included, as
    // typecheck does; the column counts what lowering adds for the
    // compiler program's own file, by path.
    let checked: ProbedProgram = closure_program_checked(name, path, src, false)
    let p: Program = checked.program
    let carried_into_hir: i64 = p.diags.length()
    resource memory hir =>
      p = program_run_hir(p)
    closure_report_file_diags(name, "hir", p.diags, carried_into_hir, to_i64(50), path)
    cols = cols + closure_stage_file_column(name, "hir", p.diags, carried_into_hir, path)
  if stage == "mir":
    // MIR lowers the program the checker typed, prelude included, from
    // HIR it lowers itself; the column counts what HIR and MIR add for
    // the compiler program's own file, by path (HIR adds nothing there
    // on a closed program; its own column says so).
    let checked: ProbedProgram = closure_program_checked(name, path, src, false)
    let carried_into_mir: i64 = checked.program.diags.length()
    let pm: ProgramMir = ProgramMir(checked.program, mir_result_empty())
    resource memory mir =>
      pm = program_run_mir(checked.program)
    closure_report_file_diags(name, "mir", pm.program.diags, carried_into_mir, to_i64(50), path)
    cols = cols + closure_stage_file_column(name, "mir", pm.program.diags, carried_into_mir, path)
    // Monomorphization over the whole program, prelude included: what it
    // could not make concrete (its diagnostics are the program's, not one
    // file's).
    let carried_into_mono: i64 = pm.mir.diags.length()
    let pc: ProgramConcrete = ProgramConcrete(pm.program, pm.mir)
    resource memory mono =>
      pc = program_monomorphize(checked.typed, pm)
    closure_report_diags_from(name, "mono", pc.mir.diags, carried_into_mono, to_i64(50))
    cols = cols + closure_stage_column(name, "mono", pc.mir.diags, carried_into_mono)
  if stage == "llvm":
    // The whole program, prelude included, through the backend: what it
    // reports beyond what MIR and monomorphization carried in, and the
    // module written beside the probe for the audit to link and run.
    let checked: ProbedProgram = closure_program_checked(name, path, src, false)
    let pm: ProgramMir = ProgramMir(checked.program, mir_result_empty())
    resource memory mir =>
      pm = program_run_mir(checked.program)
    let pc: ProgramConcrete = ProgramConcrete(pm.program, pm.mir)
    resource memory mono =>
      pc = program_monomorphize(checked.typed, pm)
    let carried_into_llvm: i64 = pc.mir.diags.length()
    let ll: LlvmTextResult = llvm_text_result_empty()
    resource memory llvm =>
      ll = lower_mir_to_llvm_text(MirBackendInput(pc.mir, pc.program.resolve.symbols, pc.program.typecheck.types, pc.program.typecheck.type_info, Vector<Token>::new(), "", pc.program.graph.files))
    closure_report_diags_from(name, "llvm", ll.diags, carried_into_llvm, to_i64(50))
    cols = cols + closure_stage_column(name, "llvm", ll.diags, carried_into_llvm)
    if ll.ok:
      let wrote: bool = write_llvm_text(ll, "bootstrap/llvm/out/" + name + ".program.ll")
  return name + cols + "\n"

// "\t<stage>=<count>", announcing the count and the stage's first
// diagnostic on stderr (which survives a later stage's crash).
fn closure_stage_column(name: string, stage: string, diags: Vector<Diagnostic>, from: i64): string
  let n: i64 = diags.length() - from
  eprint("probe: " + name + " " + stage + "=" + i64_to_string(n))
  if n > to_i64(0):
    eprint("probe: " + name + " first " + stage + ": " + diags.get(from).message)
  return "\t" + stage + "=" + i64_to_string(n)

fn closure_stage_file_column(name: string, stage: string, diags: Vector<FileDiagnostic>, from: i64, path: string): string
  let tally: DiagTally = closure_tally_by_path(diags, from, path)
  eprint("probe: " + name + " " + stage + "=" + i64_to_string(tally.count))
  if tally.count > to_i64(0):
    eprint("probe: " + name + " first " + stage + ": " + tally.first)
  return "\t" + stage + "=" + i64_to_string(tally.count)

// The prelude group alone through the program pipeline, for the
// audit's prelude section.  One line per file after resolve --
// "probe: prelude file<TAB><path><TAB>parse=N<TAB>resolve=M<TAB>first=<message>"
// -- and one per file after typecheck --
// "probe: prelude typecheck<TAB><path><TAB><K><TAB><message>" -- so a
// type checker that dies over a prelude body leaves the parse and
// resolve columns behind.
fn closure_probe_prelude(): string
  let inputs: Vector<SourceInput> = closure_prelude_inputs()
  eprint("probe: prelude files=" + i64_to_string(inputs.length()))
  let pg: ProgramGraph = program_graph_empty()
  resource memory graph =>
    pg = build_program(inputs)
  let p: Program = program_from_graph(pg)
  resource memory resolve =>
    p = program_run_resolve(p)
  let carried_into_resolve: i64 = pg.diags.length()
  let i: i64 = 0
  while i < inputs.length():
    let path: string = inputs.get(i).path
    let parsed: DiagTally = closure_tally_by_path(pg.diags, to_i64(0), path)
    let resolved: DiagTally = closure_tally_by_path(p.resolve.diags, carried_into_resolve, path)
    let first: string = parsed.first
    if parsed.count == to_i64(0):
      first = resolved.first
    eprint("probe: prelude file\t" + path + "\tparse=" + i64_to_string(parsed.count) + "\tresolve=" + i64_to_string(resolved.count) + "\tfirst=" + first)
    i = i + to_i64(1)
  resource memory typecheck =>
    p = program_run_typecheck(p)
  let carried_into_typecheck: i64 = p.resolve.diags.length()
  i = to_i64(0)
  while i < inputs.length():
    let path: string = inputs.get(i).path
    let typed: DiagTally = closure_tally_by_path(p.diags, carried_into_typecheck, path)
    eprint("probe: prelude typecheck\t" + path + "\t" + i64_to_string(typed.count) + "\t" + typed.first)
    i = i + to_i64(1)
  // The prelude lowered to HIR, then MIR, as a program's is: what each
  // adds, per file.  MIR lowers from HIR of its own, so the checked
  // program is kept for it.
  let checked: Program = p
  let carried_into_hir: i64 = p.diags.length()
  resource memory hir =>
    p = program_run_hir(p)
  i = to_i64(0)
  while i < inputs.length():
    let path: string = inputs.get(i).path
    let lowered: DiagTally = closure_tally_by_path(p.diags, carried_into_hir, path)
    eprint("probe: prelude hir\t" + path + "\t" + i64_to_string(lowered.count) + "\t" + lowered.first)
    i = i + to_i64(1)
  let carried_into_mir: i64 = p.diags.length()
  let pm: ProgramMir = ProgramMir(checked, mir_result_empty())
  resource memory mir =>
    pm = program_run_mir(checked)
  i = to_i64(0)
  while i < inputs.length():
    let path: string = inputs.get(i).path
    let mir_added: DiagTally = closure_tally_by_path(pm.program.diags, carried_into_mir, path)
    eprint("probe: prelude mir\t" + path + "\t" + i64_to_string(mir_added.count) + "\t" + mir_added.first)
    i = i + to_i64(1)
  return "prelude\tfiles=" + i64_to_string(inputs.length()) + "\n"

// The marker holds "<program>\t<stage>"; the program "prelude" is the
// prelude group alone.
fn closure_probe(marker: string): void
  let tab: i64 = index_of(marker, "\t")
  if tab < to_i64(0):
    eprint("probe: marker must be <program>, a tab, and a stage; got '" + marker + "'")
    return
  let which: string = substring(marker, to_i64(0), tab)
  let stage: string = substring(marker, tab + to_i64(1), length(marker) - tab - to_i64(1))
  let line: string = ""
  if which == "prelude":
    line = closure_probe_prelude()
  else:
    line = closure_probe_stage(which, "bootstrap/" + which + "/" + which + ".gen.dao", stage)
  let previous: string = ""
  if file_exists("bootstrap/llvm/out/closure.txt"):
    previous = read_file("bootstrap/llvm/out/closure.txt")
  let wrote: bool = write_file("bootstrap/llvm/out/closure.txt", previous + line)
  print(line)

fn main(): i32
  // Opt-in probe (bootstrap/audit_closure.sh): the process does only
  // the probe, so its memory is one stage's and nothing else's.
  if file_exists("bootstrap/llvm/out/.closure_probe"):
    closure_probe(read_file("bootstrap/llvm/out/.closure_probe"))
    return 0
  print("=== bootstrap/llvm: Tier A LLVM backend ===")
  print("")

  let pass_count: i32 = 0
  let total: i32 = 39
  let write_failures: i32 = 0

  // -----------------------------------------------------------------
  // Test 1: minimal_define — fn main(): i32 -> 0 emits define + entry + ret
  // -----------------------------------------------------------------
  let src1: string = "fn main(): i32\n  return 0\n"
  let r1: LlvmTextResult = lower_source_to_llvm_text(src1)
  write_failures = write_failures + emit_ir("minimal_define", r1, 0)
  if r1.ok:
    let a: bool = check_contains(r1, "define i32 @main", "minimal_define")
    let b: bool = check_contains(r1, "entry:", "minimal_define")
    let c: bool = check_contains(r1, "ret i32 0", "minimal_define")
    if a:
      if b:
        if c:
          print("PASS minimal_define")
          pass_count = pass_count + 1
  else:
    print("FAIL minimal_define: ok=false")

  // -----------------------------------------------------------------
  // Test 2: let_store_load — let x = 1; return x
  // -----------------------------------------------------------------
  let src2: string = "fn main(): i32\n  let x: i32 = 1\n  return x\n"
  let r2: LlvmTextResult = lower_source_to_llvm_text(src2)
  write_failures = write_failures + emit_ir("let_store_load", r2, 1)
  if r2.ok:
    let a: bool = check_contains(r2, "alloca i32", "let_store_load")
    let b: bool = check_contains(r2, "store i32 1", "let_store_load")
    let c: bool = check_contains(r2, "load i32", "let_store_load")
    let d: bool = check_contains(r2, "ret i32", "let_store_load")
    if a:
      if b:
        if c:
          if d:
            print("PASS let_store_load")
            pass_count = pass_count + 1
  else:
    print("FAIL let_store_load: ok=false")

  // -----------------------------------------------------------------
  // Test 3: int_arithmetic — let x = 1 + 2 * 3
  // -----------------------------------------------------------------
  let src3: string = "fn main(): i32\n  let x: i32 = 1 + 2 * 3\n  return x\n"
  let r3: LlvmTextResult = lower_source_to_llvm_text(src3)
  write_failures = write_failures + emit_ir("int_arithmetic", r3, 7)
  if r3.ok:
    // Signed arithmetic is checked (the host's overflow intrinsics).
    let a: bool = check_contains(r3, "@llvm.smul.with.overflow.i32(i32 2, i32 3)", "int_arithmetic")
    let b: bool = check_contains(r3, "@llvm.sadd.with.overflow.i32(i32 1,", "int_arithmetic")
    if a:
      if b:
        print("PASS int_arithmetic")
        pass_count = pass_count + 1
  else:
    print("FAIL int_arithmetic: ok=false")

  // -----------------------------------------------------------------
  // Test 4: int_comparison — let b = x < 5
  // -----------------------------------------------------------------
  let src4: string = "fn f(x: i32): bool\n  return x < 5\n"
  let r4: LlvmTextResult = lower_source_to_llvm_text(src4)
  write_failures = write_failures + emit_ir("int_comparison", r4, -1)
  if r4.ok:
    let a: bool = check_contains(r4, "icmp slt i32", "int_comparison")
    let b: bool = check_contains(r4, "ret i1", "int_comparison")
    if a:
      if b:
        print("PASS int_comparison")
        pass_count = pass_count + 1
  else:
    print("FAIL int_comparison: ok=false")

  // -----------------------------------------------------------------
  // Test 5: param_seeding — fn f(x: i32): i32 -> x must seed param slot
  // -----------------------------------------------------------------
  let src5: string = "fn f(x: i32): i32\n  return x\n"
  let r5: LlvmTextResult = lower_source_to_llvm_text(src5)
  write_failures = write_failures + emit_ir("param_seeding", r5, -1)
  if r5.ok:
    let a: bool = check_contains(r5, "define i32 @f(i32 %arg0)", "param_seeding")
    let b: bool = check_contains(r5, "%slot0 = alloca i32", "param_seeding")
    let c: bool = check_contains(r5, "store i32 %arg0, ptr %slot0", "param_seeding")
    let d: bool = check_contains(r5, "load i32, ptr %slot0", "param_seeding")
    if a:
      if b:
        if c:
          if d:
            print("PASS param_seeding")
            pass_count = pass_count + 1
  else:
    print("FAIL param_seeding: ok=false")

  // -----------------------------------------------------------------
  // Test 6: extern_declare — extern fn puts emits declare
  // -----------------------------------------------------------------
  let src6: string = "extern fn puts(s: string): i32\n\nfn main(): i32\n  return 0\n"
  let r6: LlvmTextResult = lower_source_to_llvm_text(src6)
  write_failures = write_failures + emit_ir("extern_declare", r6, 0)
  if r6.ok:
    let a: bool = check_contains(r6, "declare i32 @puts(ptr %arg0)", "extern_declare")
    let b: bool = check_contains(r6, "define i32 @main()", "extern_declare")
    if a:
      if b:
        print("PASS extern_declare")
        pass_count = pass_count + 1
  else:
    print("FAIL extern_declare: ok=false")

  // -----------------------------------------------------------------
  // Test 7: call_extern — call to a user function
  // -----------------------------------------------------------------
  let src7: string = "fn add(a: i32, b: i32): i32\n  return a + b\n\nfn main(): i32\n  return add(1, 2)\n"
  let r7: LlvmTextResult = lower_source_to_llvm_text(src7)
  write_failures = write_failures + emit_ir("call_extern", r7, 3)
  if r7.ok:
    let a: bool = check_contains(r7, "define i32 @add(i32 %arg0, i32 %arg1)", "call_extern")
    let b: bool = check_contains(r7, "call i32 @add(", "call_extern")
    if a:
      if b:
        print("PASS call_extern")
        pass_count = pass_count + 1
  else:
    print("FAIL call_extern: ok=false")

  // -----------------------------------------------------------------
  // Test 8: if_else_cfg — conditional branch emits cond_br + then/else/merge
  // -----------------------------------------------------------------
  let src8: string = "fn f(x: i32): i32\n  if x > 0:\n    return 1\n  else:\n    return 2\n"
  let r8: LlvmTextResult = lower_source_to_llvm_text(src8)
  write_failures = write_failures + emit_ir("if_else_cfg", r8, -1)
  if r8.ok:
    let a: bool = check_contains(r8, "icmp sgt i32", "if_else_cfg")
    let b: bool = check_contains(r8, "br i1 ", "if_else_cfg")
    let c: bool = check_contains(r8, "bb1:", "if_else_cfg")
    let d: bool = check_contains(r8, "bb2:", "if_else_cfg")
    if a:
      if b:
        if c:
          if d:
            print("PASS if_else_cfg")
            pass_count = pass_count + 1
  else:
    print("FAIL if_else_cfg: ok=false")

  // -----------------------------------------------------------------
  // Test 9: while_cfg — while loop emits header/body/exit + back-edge
  // -----------------------------------------------------------------
  let src9: string = "fn f(n: i32): i32\n  let i: i32 = 0\n  while i < n:\n    i = i + 1\n  return i\n"
  let r9: LlvmTextResult = lower_source_to_llvm_text(src9)
  write_failures = write_failures + emit_ir("while_cfg", r9, -1)
  if r9.ok:
    let a: bool = check_contains(r9, "br label %bb", "while_cfg")
    let b: bool = check_contains(r9, "icmp slt i32", "while_cfg")
    let c: bool = check_contains(r9, "br i1 ", "while_cfg")
    if a:
      if b:
        if c:
          print("PASS while_cfg")
          pass_count = pass_count + 1
  else:
    print("FAIL while_cfg: ok=false")

  // -----------------------------------------------------------------
  // Test 10: string_global — a string literal is a private global and a
  // `%dao.string` value `{ bytes, length }`, passed to a call by pointer
  // (the host's string ABI).
  // -----------------------------------------------------------------
  let src10: string = "extern fn puts(s: string): i32\n\nfn main(): i32\n  return puts(\"hi\")\n"
  let r10: LlvmTextResult = lower_source_to_llvm_text(src10)
  write_failures = write_failures + emit_ir("string_global", r10, -1)
  if r10.ok:
    let a: bool = check_contains(r10, "@.str.0 = private unnamed_addr constant", "string_global")
    let b: bool = check_contains(r10, "c\"hi\\00\"", "string_global")
    let c: bool = check_contains(r10, "insertvalue %dao.string", "string_global")
    if a:
      if b:
        if c:
          print("PASS string_global")
          pass_count = pass_count + 1
  else:
    print("FAIL string_global: ok=false")

  // -----------------------------------------------------------------
  // Test 11: deterministic_repeat — byte-identical across runs
  // -----------------------------------------------------------------
  let src11: string = "fn main(): i32\n  let x: i32 = 1 + 2\n  return x\n"
  let r11a: LlvmTextResult = lower_source_to_llvm_text(src11)
  write_failures = write_failures + emit_ir("deterministic_repeat", r11a, 3)
  let r11b: LlvmTextResult = lower_source_to_llvm_text(src11)
  // Two identical failures are equal too; only two successful
  // lowerings prove determinism (and leave an artifact to validate).
  if r11a.ok and r11b.ok:
    if r11a.text == r11b.text:
      print("PASS deterministic_repeat")
      pass_count = pass_count + 1
    else:
      print("FAIL deterministic_repeat: byte drift across runs")
  else:
    print("FAIL deterministic_repeat: ok=false")

  // -----------------------------------------------------------------
  // Test 12: struct_field_read — struct field access emits GEP + load
  // -----------------------------------------------------------------
  let src12: string = "class P:\n  x: i32\n  y: i32\n\nfn get_x(p: P): i32\n  return p.x\n"
  let r12: LlvmTextResult = lower_source_to_llvm_text(src12)
  write_failures = write_failures + emit_ir("struct_field_read", r12, -1)
  if r12.ok:
    let a: bool = check_contains(r12, "%struct.P = type { i32, i32 }", "struct_field_read")
    // Field read on an SSA struct value → extractvalue (NOT GEP —
    // GEP needs a pointer, but MIR gives us a loaded struct value).
    let b: bool = check_contains(r12, "extractvalue %struct.P", "struct_field_read")
    let c: bool = check_contains(r12, "ret i32", "struct_field_read")
    let d: bool = true
    if a:
      if b:
        if c:
          if d:
            print("PASS struct_field_read")
            pass_count = pass_count + 1
  else:
    print("FAIL struct_field_read: ok=false")
    let di: i64 = to_i64(0)
    while di < r12.diags.length():
      print("  diag: " + r12.diags.get(di).message)
      di = di + to_i64(1)

  // -----------------------------------------------------------------
  // Test 13: struct_construction — P(1, 2) emits alloca + GEP stores
  // -----------------------------------------------------------------
  let src13: string = "class P:\n  x: i32\n  y: i32\n\nfn main(): i32\n  let p: P = P(1, 2)\n  return p.x\n"
  let r13: LlvmTextResult = lower_source_to_llvm_text(src13)
  write_failures = write_failures + emit_ir("struct_construction", r13, 1)
  if r13.ok:
    let a: bool = check_contains(r13, "%struct.P = type { i32, i32 }", "struct_construction")
    let b: bool = check_contains(r13, "getelementptr inbounds %struct.P", "struct_construction")
    let c: bool = check_contains(r13, "store i32 1", "struct_construction")
    let d: bool = check_contains(r13, "store i32 2", "struct_construction")
    if a:
      if b:
        if c:
          if d:
            print("PASS struct_construction")
            pass_count = pass_count + 1
  else:
    print("FAIL struct_construction: ok=false")
    let di: i64 = to_i64(0)
    while di < r13.diags.length():
      print("  diag: " + r13.diags.get(di).message)
      di = di + to_i64(1)

  // -----------------------------------------------------------------
  // Test 14: struct_call_arg — passing a struct to a function call
  // -----------------------------------------------------------------
  // Exercises the struct-typed call-edge path: the argument type in
  // the emitted `call` must be `%struct.P`, NOT `<unsupported>`.
  let src14: string = "class P:\n  x: i32\n  y: i32\n\nfn take(p: P): i32\n  return p.x\n\nfn main(): i32\n  let p: P = P(3, 4)\n  return take(p)\n"
  let r14: LlvmTextResult = lower_source_to_llvm_text(src14)
  write_failures = write_failures + emit_ir("struct_call_arg", r14, 3)
  if r14.ok:
    let a: bool = check_contains(r14, "define i32 @take(%struct.P", "struct_call_arg")
    let b: bool = check_contains(r14, "call i32 @take(%struct.P", "struct_call_arg")
    let c: bool = true
    if contains_substring(r14.text, "<unsupported>"):
      c = false
      print("FAIL struct_call_arg: emitted IR contains <unsupported> marker")
    if a:
      if b:
        if c:
          print("PASS struct_call_arg")
          pass_count = pass_count + 1
  else:
    print("FAIL struct_call_arg: ok=false")
    let di: i64 = to_i64(0)
    while di < r14.diags.length():
      print("  diag: " + r14.diags.get(di).message)
      di = di + to_i64(1)

  // -----------------------------------------------------------------
  // Test 15: struct_return — returning a struct from a function
  // -----------------------------------------------------------------
  // Exercises the struct-typed return-edge path: the function
  // signature and `ret` must use `%struct.P`, NOT `<unsupported>`.
  let src15: string = "class P:\n  x: i32\n  y: i32\n\nfn make(): P\n  return P(5, 6)\n\nfn main(): i32\n  let p: P = make()\n  return p.x\n"
  let r15: LlvmTextResult = lower_source_to_llvm_text(src15)
  write_failures = write_failures + emit_ir("struct_return", r15, 5)
  if r15.ok:
    let a: bool = check_contains(r15, "define %struct.P @make()", "struct_return")
    let b: bool = check_contains(r15, "ret %struct.P", "struct_return")
    let c: bool = check_contains(r15, "call %struct.P @make()", "struct_return")
    let d: bool = true
    if contains_substring(r15.text, "<unsupported>"):
      d = false
      print("FAIL struct_return: emitted IR contains <unsupported> marker")
    if a:
      if b:
        if c:
          if d:
            print("PASS struct_return")
            pass_count = pass_count + 1
  else:
    print("FAIL struct_return: ok=false")
    let di: i64 = to_i64(0)
    while di < r15.diags.length():
      print("  diag: " + r15.diags.get(di).message)
      di = di + to_i64(1)

  // -----------------------------------------------------------------
  // Test 15b: class_method_define — a class's own method reaches LLVM
  // as a named define with its declared return type, and a dot call
  // reaches it.  A method's symbol is a `Method`, not a `Function`;
  // a declaration lowering that looked only for `Function` gave the
  // method a void return and an anonymous define.
  // -----------------------------------------------------------------
  let src15b: string = "class Box:\n  n: i32\n  fn pick(self): i32\n    return self.n\n\nfn main(): i32\n  let b: Box = Box(7)\n  return b.pick()\n"
  let r15b: LlvmTextResult = lower_source_to_llvm_text(src15b)
  write_failures = write_failures + emit_ir("class_method_define", r15b, 7)
  if r15b.ok:
    let a15b: bool = check_contains(r15b, "define i32 @Box.pick(", "class_method_define")
    let b15b: bool = check_contains(r15b, "call i32 @Box.pick(", "class_method_define")
    let c15b: bool = true
    if contains_substring(r15b.text, "<unsupported>"):
      c15b = false
      print("FAIL class_method_define: emitted IR contains <unsupported> marker")
    if a15b:
      if b15b:
        if c15b:
          print("PASS class_method_define")
          pass_count = pass_count + 1
  else:
    print("FAIL class_method_define: ok=false")
    let d15b: i64 = to_i64(0)
    while d15b < r15b.diags.length():
      print("  diag: " + r15b.diags.get(d15b).message)
      d15b = d15b + to_i64(1)

  // -----------------------------------------------------------------
  // Test 16: nested_struct_registration — a struct containing another
  // -----------------------------------------------------------------
  // Exercises recursive `bs_ensure_struct_def` — when the outer
  // struct is registered, the inner struct must be registered too.
  // Otherwise module serialization emits `%struct.Outer = type
  // { %struct.Inner }` without defining `%struct.Inner`, producing
  // invalid IR.
  let src16: string = "class Inner:\n  v: i32\n\nclass Outer:\n  inner: Inner\n\nfn main(): i32\n  let o: Outer = Outer(Inner(42))\n  return 0\n"
  let r16: LlvmTextResult = lower_source_to_llvm_text(src16)
  write_failures = write_failures + emit_ir("nested_struct_registration", r16, 0)
  if r16.ok:
    let a: bool = check_contains(r16, "%struct.Inner = type { i32 }", "nested_struct_registration")
    let b: bool = check_contains(r16, "%struct.Outer = type { %struct.Inner }", "nested_struct_registration")
    let c: bool = true
    if contains_substring(r16.text, "<bug:"):
      c = false
      print("FAIL nested_struct_registration: emitted IR contains <bug:...> marker")
    if a:
      if b:
        if c:
          print("PASS nested_struct_registration")
          pass_count = pass_count + 1
  else:
    print("FAIL nested_struct_registration: ok=false")
    let di: i64 = to_i64(0)
    while di < r16.diags.length():
      print("  diag: " + r16.diags.get(di).message)
      di = di + to_i64(1)

  // -----------------------------------------------------------------
  // Test 17: write_ll_artifact — lower source → .ll artifact on disk
  // -----------------------------------------------------------------
  // The artifact joins the others under bootstrap/llvm/out/, where
  // bootstrap/validate_ir.sh compiles it with clang, links it against
  // the runtime, runs it, and checks the exit code (42).
  let e2e_src: string = "fn main(): i32\n  return 42\n"
  let e2e_r: LlvmTextResult = lower_source_to_llvm_text(e2e_src)
  write_failures = write_failures + emit_ir("write_ll_artifact", e2e_r, 42)
  if e2e_r.ok:
    print("PASS write_ll_artifact (lowering ok)")
    pass_count = pass_count + 1
  else:
    print("FAIL write_ll_artifact: ok=false")

  // -----------------------------------------------------------------
  // Test 18: fallthrough_rejected — a non-void function whose entry
  // block ends without a value is an error, not `unreachable`
  // -----------------------------------------------------------------
  let ft_src: string = "fn f(x: i32): i32\n  let y: i32 = x\n"
  let ft_r: LlvmTextResult = lower_source_to_llvm_text(ft_src)
  if ft_r.ok:
    print("FAIL fallthrough_rejected: a function falling off its end was lowered")
  else:
    if contains_substring(diags_text(ft_r.diags), "without returning a value"):
      print("PASS fallthrough_rejected")
      pass_count = pass_count + 1
    else:
      print("FAIL fallthrough_rejected: rejected, but not for falling off the end")
      print(diags_text(ft_r.diags))

  // -----------------------------------------------------------------
  // Test 19: nested_total_if — every arm of a nested if/else returns;
  // the inner merge block branches to the outer one, and neither is
  // reachable, so both end in `unreachable` and the function is accepted
  // -----------------------------------------------------------------
  let nt_src: string = "fn main(): i32\n  let x: i32 = 7\n  if x > 0:\n    if x > 5:\n      return 1\n    else:\n      return 2\n  else:\n    return 3\n"
  let nt_r: LlvmTextResult = lower_source_to_llvm_text(nt_src)
  write_failures = write_failures + emit_ir("nested_total_if", nt_r, 1)
  if nt_r.ok:
    print("PASS nested_total_if")
    pass_count = pass_count + 1
  else:
    print("FAIL nested_total_if: a function whose every arm returns was rejected")
    print(diags_text(nt_r.diags))

  // Test 21: a rejection upstream — a satisfaction mismatch the checker
  // diagnosed — fails the backend result: no `ok`, the diagnostic
  // carried, nothing emitted as if it were sound.
  let src21: string = "derived concept Show:\n  fn f(self): i32\n\nextend i32 as Show:\n  fn f(self): bool -> true\n\nfn main(): i32\n  return 0\n"
  let r21: LlvmTextResult = lower_source_to_llvm_text(src21)
  if r21.ok == false and r21.diags.length() >= 1:
    print("PASS upstream_rejection_fails_backend")
    pass_count = pass_count + 1
  else:
    print("FAIL upstream_rejection_fails_backend: expected ok=false with the checker's diagnostic, got ok=" + bool_to_string(r21.ok) + " and " + i64_to_string(r21.diags.length()) + " diagnostics")

  // Test 22: an upstream warning travels with the backend result but
  // leaves an otherwise sound module `ok`.
  let in22: MirBackendInput = lower_to_mir_backend_input("fn main(): i32\n  return 0\n")
  let mir22: MirResult = in22.mir
  mir22.diags = mir22.diags.push(make_warning(Span(to_i64(0), to_i64(1)), "upstream warning"))
  in22.mir = mir22
  let r22: LlvmTextResult = lower_mir_to_llvm_text(in22)
  if r22.ok and r22.diags.length() == to_i64(1):
    print("PASS upstream_warning_keeps_backend_ok")
    pass_count = pass_count + 1
  else:
    print("FAIL upstream_warning_keeps_backend_ok: expected ok=true with the warning carried, got ok=" + bool_to_string(r22.ok) + " and " + i64_to_string(r22.diags.length()) + " diagnostics")

  // Test 23: a generator function with no `yield` lowers too: its init
  // returns the handle, its resume only marks it done.
  let r23: LlvmTextResult = lower_source_to_llvm_text("fn g(): Generator<i64>\n  return\n\nfn main(): i32\n  return 0\n")
  write_failures = write_failures + emit_ir("empty_generator", r23, 0)
  if r23.ok and check_contains(r23, "define %dao.generator @g()", "empty_generator") and check_contains(r23, "define void @g.resume(ptr %frame)", "empty_generator"):
    print("PASS empty_generator")
    pass_count = pass_count + 1
  else:
    print("FAIL empty_generator: " + diags_text(r23.diags))

  // Test 24: an instantiation's struct is named as it is spelled and
  // by its identity, in quotes, since `<` is no unquoted LLVM
  // identifier character.
  let src24: string = "class Tag<T>:\n  n: i32\n\nfn main(): i32\n  let t: Tag<i32> = Tag<i32>(1)\n  return t.n\n"
  let r24: LlvmTextResult = lower_source_to_llvm_text(src24)
  write_failures = write_failures + emit_ir("instantiated_struct_name", r24, 1)
  if r24.ok:
    if check_contains(r24, "%\"struct.Tag<i32>#", "instantiated_struct_name"):
      if check_contains(r24, "\" = type { i32 }", "instantiated_struct_name"):
        print("PASS instantiated_struct_name")
        pass_count = pass_count + 1
  else:
    print("FAIL instantiated_struct_name: backend not ok")
    let d24: i64 = 0
    while d24 < r24.diags.length():
      print("  diag: " + r24.diags.get(d24).message)
      d24 = d24 + 1

  // Test 25: overloads by arity are two functions, the later named with
  // its arity (the host's `g$2`), and the program runs.
  let r25: LlvmTextResult = lower_source_to_llvm_text("fn g(n: i32): i32 -> n\nfn g(a: i32, b: i32): i32 -> a + b\n\nfn main(): i32 -> g(1) + g(1, 2) - 4\n")
  write_failures = write_failures + emit_ir("arity_overloads", r25, 0)
  if r25.ok:
    if check_contains(r25, "@g$2(", "arity_overloads"):
      print("PASS arity_overloads")
      pass_count = pass_count + 1
  else:
    print("FAIL arity_overloads: backend not ok")

  // Test 26: a call of a generic function names its specialization
  // (monomorphization), which the backend emits and the program runs.
  let r26: LlvmTextResult = lower_source_to_llvm_text("fn id<T>(x: T): T -> x\n\nfn main(): i32 -> id(1) - 1\n")
  write_failures = write_failures + emit_ir("generic_call_specialized", r26, 0)
  if r26.ok and check_contains(r26, "id$i32", "generic_call_specialized"):
    print("PASS generic_call_specialized")
    pass_count = pass_count + 1
  else:
    print("FAIL generic_call_specialized: " + diags_text(r26.diags))
  // An extern beside a template: the backend's scan for template
  // references reads the extern's (empty) block list, not a stray offset.
  let r26b: LlvmTextResult = lower_source_to_llvm_text("extern fn ext(x: i32): i32\n\nfn id<T>(x: T): T -> x\n\nfn main(): i32 -> 0\n")
  if r26b.ok:
    print("PASS extern_beside_template")
    pass_count = pass_count + 1
  else:
    print("FAIL extern_beside_template: " + diags_text(r26b.diags))

  // Test 29: comparing strings compares their contents (the runtime's
  // __dao_eq_string), never their addresses.
  let r29: LlvmTextResult = lower_source_to_llvm_text("fn f(s: string): i32\n  if s == \"x\":\n    return 1\n  return 0\n")
  if r29.ok and contains_substring(r29.text, "@__dao_eq_string") and contains_substring(r29.text, "icmp eq ptr") == false:
    print("PASS string_comparison_by_contents")
    pass_count = pass_count + 1
  else:
    print("FAIL string_comparison_by_contents: " + diags_text(r29.diags))

  // Test 28: an enum's tag is an integer constant: a classification enum
  // is its `i32` tag (the host's): the comparison runs, exiting 1.
  let r28: LlvmTextResult = lower_source_to_llvm_text("enum E:\n  A\n\nfn main(): i32\n  if E::A == E::A:\n    return 1\n  return 0\n")
  write_failures = write_failures + emit_ir("enum_tag_constant", r28, 1)
  if r28.ok:
    print("PASS enum_tag_constant")
    pass_count = pass_count + 1
  else:
    print("FAIL enum_tag_constant: " + diags_text(r28.diags))

  // Test 27: field stores and `break` run: 5 + 7 + 4 - 16 exits 0.
  let r27: LlvmTextResult = lower_source_to_llvm_text("class In:\n  v: i32\n\nclass Out:\n  a: i32\n  inner: In\n\nfn main(): i32\n  let o: Out = Out(1, In(2))\n  o.a = 5\n  o.inner.v = 7\n  let n: i32 = 0\n  while true:\n    if n > 3:\n      break\n    n = n + 1\n  return o.a + o.inner.v + n - 16\n")
  write_failures = write_failures + emit_ir("field_store_and_break", r27, 0)
  if r27.ok:
    print("PASS field_store_and_break")
    pass_count = pass_count + 1
  else:
    print("FAIL field_store_and_break: backend not ok: " + diags_text(r27.diags))

  // Test 32: a specialization whose name LLVM cannot take bare
  // (`tag$Ptr<i32>`) is quoted, and the module is valid IR.
  let r32: LlvmTextResult = lower_source_to_llvm_text("fn tag<T>(): i32 -> 0\n\nfn main(): i32 -> tag<Ptr<i32>>()\n")
  write_failures = write_failures + emit_ir("quoted_specialization_name", r32, 0)
  if r32.ok and check_contains(r32, "@\"tag$Ptr<i32>\"", "quoted_specialization_name"):
    print("PASS quoted_specialization_name")
    pass_count = pass_count + 1
  else:
    print("FAIL quoted_specialization_name: " + diags_text(r32.diags))
  // Test 31: a call through a bound compiles and runs once its generic
  // function is specialized: call(5) - 5 exits 0.
  let r31: LlvmTextResult = lower_source_to_llvm_text("concept Shows:\n  fn show(self): i32\n\nextend i32 as Shows:\n  fn show(self): i32 -> self\n\nfn call<T: Shows>(x: T): i32 -> x.show()\n\nfn main(): i32 -> call(5) - 5\n")
  write_failures = write_failures + emit_ir("bound_call_specialized", r31, 0)
  if r31.ok:
    print("PASS bound_call_specialized")
    pass_count = pass_count + 1
  else:
    print("FAIL bound_call_specialized: " + diags_text(r31.diags))

  // Test 33: a program of two modules lowers whole, each function read
  // with its own module's tokens, and runs: add(40, 2) - 42 exits 0.
  let prog33: Vector<SourceInput> = Vector<SourceInput>::new()
  prog33 = prog33.push(SourceInput("core_util.dao", "module core::util\n\nfn add(a: i32, b: i32): i32\n  let sum: i32 = a + b\n  return sum\n", true))
  prog33 = prog33.push(SourceInput("main.dao", "module app::main\n\nfn main(): i32\n  let x: i32 = add(40, 2)\n  return x - 42\n", false))
  let r33: LlvmTextResult = lower_program_to_llvm_text(prog33)
  write_failures = write_failures + emit_ir("two_module_program", r33, 0)
  if r33.ok and check_contains(r33, "define i32 @add(", "two_module_program"):
    print("PASS two_module_program")
    pass_count = pass_count + 1
  else:
    print("FAIL two_module_program: " + diags_text(r33.diags))

  // Test 34: every builtin width lowers (unsigned by its width), and an
  // enum with payloads is `{ i32, [N x iK] }` sized by its largest
  // payload (the host's layout): Rect's i64 makes one i64 slot.
  let r34: LlvmTextResult = lower_source_to_llvm_text("enum class Shape:\n  Circle(r: i32)\n  Rect(w: i64)\n\nfn widths(a: u8, b: i16, c: u32, s: Shape): i64 -> 0\n\nfn main(): i32 -> 0\n")
  write_failures = write_failures + emit_ir("type_universe", r34, 0)
  if r34.ok and check_contains(r34, "(i8 %arg0, i16 %arg1, i32 %arg2, %enum.Shape %arg3)", "type_universe") and check_contains(r34, "%enum.Shape = type { i32, [1 x i64] }", "type_universe"):
    print("PASS type_universe")
    pass_count = pass_count + 1
  else:
    print("FAIL type_universe: " + diags_text(r34.diags))

  // Test 35: a payload-bearing enum is built, matched and read through
  // its layout: Rect(w = 3, h = 4) has area 12, and the program exits 0.
  let r35: LlvmTextResult = lower_source_to_llvm_text("enum class Shape:\n  Circle(r: i32)\n  Rect(w: i32, h: i32)\n\nfn area(s: Shape): i32\n  match s:\n    Shape::Circle(r):\n      return r * r * 3\n    Shape::Rect(w, h):\n      return w * h\n  return 0\n\nfn main(): i32\n  let s: Shape = Shape::Rect(h = 4, w = 3)\n  return area(s) - 12\n")
  write_failures = write_failures + emit_ir("enum_payload_roundtrip", r35, 0)
  if r35.ok:
    print("PASS enum_payload_roundtrip")
    pass_count = pass_count + 1
  else:
    print("FAIL enum_payload_roundtrip: " + diags_text(r35.diags))

  // Test 36: pointers — allocated by the runtime, cast, walked, written
  // and read through (`p.offset(1).set(5)`, `.get()`), sized by
  // `size_of<i64>()`: the program exits 0.
  // The runtime's allocator is declared by a prelude module: its `__dao_`
  // name is reserved to the prelude.
  let prog36: Vector<SourceInput> = Vector<SourceInput>::new()
  prog36 = prog36.push(SourceInput("core_memory.dao", "module core::memory\n\nextern fn __dao_mem_alloc(size: i64, align: i64): Ptr<void>\n\nfn size_of<T>(): i64\n  let r: i64 = 0\n  return r\n", true))
  prog36 = prog36.push(SourceInput("main.dao", "module app::main\n\nfn main(): i32\n  let got: i64 = 0\n  mode unsafe =>\n    let raw: Ptr<void> = __dao_mem_alloc(size_of<i64>() * 2, 8)\n    let p: Ptr<i64> = raw.cast<i64>()\n    p.offset(1).set(5)\n    got = p.offset(1).get()\n  if got == 5:\n    return 0\n  return 1\n", false))
  let r36: LlvmTextResult = lower_program_to_llvm_text(prog36)
  write_failures = write_failures + emit_ir("pointer_roundtrip", r36, 0)
  if r36.ok and check_contains(r36, "getelementptr i64", "pointer_roundtrip"):
    print("PASS pointer_roundtrip")
    pass_count = pass_count + 1
  else:
    print("FAIL pointer_roundtrip: " + diags_text(r36.diags))

  // Test 37: signed `+` is checked (the host's overflow intrinsic and
  // trap); an unsigned comparison is unsigned (`ult`); the program runs.
  let r37: LlvmTextResult = lower_source_to_llvm_text("fn below(a: u32, b: u32): bool -> a < b\n\nfn main(): i32\n  let x: i32 = 40 + 2\n  if below(to_u32(1), to_u32(2)):\n    return x - 42\n  return 1\n\nfn to_u32(n: i32): u32\n  return 0\n")
  write_failures = write_failures + emit_ir("checked_and_unsigned", r37, -1)
  if r37.ok and check_contains(r37, "@llvm.sadd.with.overflow.i32", "checked_and_unsigned") and check_contains(r37, "icmp ult i32", "checked_and_unsigned"):
    print("PASS checked_and_unsigned")
    pass_count = pass_count + 1
  else:
    print("FAIL checked_and_unsigned: " + diags_text(r37.diags))

  // Test 38: strings compare and concatenate through the runtime
  // (__dao_eq_string, __dao_str_concat): "ab" + "c" == "abc", exit 0.
  let r38: LlvmTextResult = lower_source_to_llvm_text("fn main(): i32\n  let s: string = \"ab\" + \"c\"\n  if s == \"abc\":\n    return 0\n  return 1\n")
  write_failures = write_failures + emit_ir("string_operators", r38, 0)
  if r38.ok and check_contains(r38, "@__dao_eq_string", "string_operators") and check_contains(r38, "@__dao_str_concat", "string_operators"):
    print("PASS string_operators")
    pass_count = pass_count + 1
  else:
    print("FAIL string_operators: " + diags_text(r38.diags))

  // Test 39: a generator runs as the host's does: its frame allocated by
  // init, driven by resume through a `for`, freed at the loop's end;
  // 0 + 1 + 2 = 3, and the program exits 0.
  let r39: LlvmTextResult = lower_source_to_llvm_text("fn count(n: i32): Generator<i32>\n  let i: i32 = 0\n  while i < n:\n    yield i\n    i = i + 1\n\nfn main(): i32\n  let total: i32 = 0\n  for x in count(3):\n    total = total + x\n  return total - 3\n")
  write_failures = write_failures + emit_ir("generator_runs", r39, 0)
  if r39.ok and check_contains(r39, "@__dao_gen_alloc", "generator_runs") and check_contains(r39, "@count.resume", "generator_runs"):
    print("PASS generator_runs")
    pass_count = pass_count + 1
  else:
    print("FAIL generator_runs: " + diags_text(r39.diags))

  // -----------------------------------------------------------------
  // Summary
  // -----------------------------------------------------------------
  print("")
  print(i32_to_string(pass_count) + " / " + i32_to_string(total) + " tests passed")
  if write_failures > 0:
    print(i32_to_string(write_failures) + " IR artifact(s) could not be written")
  if pass_count == total and write_failures == 0:
    print("ALL TESTS PASSED")
    return 0
  print("SOME TESTS FAILED")
  return 1


