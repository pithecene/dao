module bootstrap::llvm::impl
// bootstrap/llvm/impl.dao — bootstrap LLVM backend.
//
// Lowers bootstrap MIR (Task 29) into deterministic textual LLVM IR
// via a minimal, backend-private Dao-side LLVM mini-IR and text
// serializer.  Closes the Tier A frontend-to-IR-to-text pipeline:
//
//   lex → parse → resolve → typecheck → HIR → MIR → LLVM text
//
// See docs/task_specs/TASK_30_BOOTSTRAP_LLVM_BACKEND.md for the
// authoritative Tier A spec.
//
// Tier A (Task 30):
//   alloca-everything SSA strategy (no mem2reg), primitive scalar
//   types only, extern/define functions, calls, control flow
//   (if/else, while), string literals as private globals.
//
// Tier B slices landed in this file:
//   - struct layout + field access: `%struct.Name` type defs,
//     struct construction via alloca+GEP stores, field reads via
//     `extractvalue`, struct-typed call and return edges.
//
// Still deferred: enum payloads, monomorphization, generators,
// mode/resource hooks, lambdas, try, for-over-iterable, index,
// break/continue, LLVM C API, llc/clang CI validation.

// =========================================================================
// Section 80: LLVM mini-IR node model
// =========================================================================

// LLVM type.  Tier A primitives (TASK_30 §5.2) + Tier B struct.
enum LlType:
  LlI8
  LlI16
  LlI32
  LlI64
  LlF32
  LlF64
  LlI1
  LlVoid
  LlPtr              // opaque pointer: `Ptr<T>`, a function value
  LlStr              // `%dao.string = { ptr, i64 }` (the host's string)
  LlStruct           // struct type — name resolved from BS side table
  LlUnsupported      // fail-closed sentinel

// Instruction payload variants.  Strictly what Task 29 MIR demands.
enum class LlInstKind:
  // Memory
  LlAlloca(ty_text: string)
  LlStore(ptr_name: string, value_text: string, value_ty_text: string)
  LlLoad(ptr_name: string, ty_text: string)

  // Integer / float arithmetic.  `op` is already the LLVM mnemonic
  // ("add", "sub", "mul", "sdiv", "srem", "fadd", ...).
  LlBinOp(op: string, lhs_text: string, rhs_text: string, ty: LlType)

  // Integer unary negation → sub 0, x (emitted via LlBinOp with
  // op="sub", lhs_text="0").  Float unary negation uses LlFNeg.
  LlFNeg(operand_text: string, ty: LlType)

  // i1 logical not → xor %x, true (op="xor", rhs_text="true", ty=LlI1).
  // No dedicated variant; reuses LlBinOp.

  // Comparisons.  `pred` is the LLVM predicate ("eq", "slt", "oeq", ...).
  LlICmp(pred: string, lhs_text: string, rhs_text: string, operand_ty: LlType)
  LlFCmp(pred: string, lhs_text: string, rhs_text: string, operand_ty: LlType)

  // Direct function call.  `callee` is the textual "@name" form.
  // args are stored as (text, type) pairs via arg_list_lp in LlInst.
  LlCall(callee: string, arg_list_lp: i64, arg_count: i64, ret_ty_text: string)

  // String global materialization: getelementptr into a [N x i8]
  // private global, yielding ptr.
  LlGepString(global_name: string, length: i64)

  // Struct field access (Tier B): GEP into a struct pointer at
  // field_index (used by struct constructor path to get field addrs).
  LlGepField(ptr_text: string, struct_ty_text: string, field_index: i64)

  // Struct field read from a SSA struct value (Tier B): extractvalue
  // works directly on loaded / constructed / returned struct values.
  LlExtractValue(agg_text: string, agg_ty_text: string, field_index: i64)

  // Terminators
  LlRet(value_text: string, value_ty_text: string, has_value: i64)
  LlBr(target_label: string)
  LlCondBr(cond_text: string, then_label: string, else_label: string)
  // An instruction whose right-hand side is already written out
  // (`insertvalue …`, a conversion): what the named kinds above do not
  // cover, spelled once where it is made.
  LlText(rhs: string)
  LlUnreachable

// A single instruction.  `result_name` is "%N" for value-producing
// instructions, empty string for effect-only or terminators.
// Type information lives in the LlInstKind payload (text form),
// which is the single source of truth for serialization.
class LlInst:
  kind: LlInstKind
  result_name: string

// A basic block.
class LlBlock:
  label: string         // "entry", "bb1", ...
  insts: Vector<LlInst>

// Function param info.  `ty_text` is the struct-aware LLVM type
// text (e.g. "i32" or "%struct.P") — the single source of truth
// for serialization.
class LlParam:
  name: string          // "%arg0", "%arg1", ...
  ty_text: string

// A function definition or extern declaration.  `ret_ty_text` is
// the struct-aware LLVM return type text.
class LlFunction:
  name: string          // mangled, with leading "@"
  ret_ty_text: string
  params: Vector<LlParam>
  blocks: Vector<LlBlock>
  is_extern: i64        // 1 = declare, 0 = define

// A module-level global.  Tier A only uses these for string literals.
class LlGlobal:
  name: string          // e.g. "@.str.0"
  bytes: string         // raw UTF-8 payload (without trailing NUL)
  length: i64           // byte length including trailing NUL

// Root node for an LLVM module.
class LlModule:
  globals: Vector<LlGlobal>
  functions: Vector<LlFunction>
  extern_decls: Vector<LlFunction>  // emitted before define's

// =========================================================================
// Section 81: Backend result / input shapes
// =========================================================================

fn llvm_text_result_empty(): LlvmTextResult -> LlvmTextResult("", Vector<Diagnostic>::new(), false)

class LlvmTextResult:
  text: string
  diags: Vector<Diagnostic>
  ok: bool

// Backend public input shape (see TASK_30 §7).  Bundles the MIR
// arenas with the resolver symbol table, the program-level type
// universe, and the token/source buffer needed to decode MirBinary
// op tokens and extract MirConstFloat / MirConstString lexemes.
// `MirResult` alone does not carry any of these.
class MirBackendInput:
  mir: MirResult
  symbols: Vector<Symbol>
  types: Vector<DaoType>
  type_info: Vector<i64>
  toks: Vector<Token>
  src: string
  files: Vector<SourceFile>   // every module's source, for a MirProgram root

// =========================================================================
// Section 82: Type lowering (MIR type_idx → LlType → textual form)
// =========================================================================
//
// Tier A primitive set per TASK_30 §5.2:
//   i32 → i32, i64 → i64, f32 → float, f64 → double,
//   bool → i1, void → void, string → ptr
//
// Everything else (i8, i16, u8..u64, struct, enum, pointer, fn,
// generic param, concept, generator) is fail-closed: the caller receives
// LlUnsupported and must surface a diagnostic.

// Returns the LlType for a MIR type index.  Returns LlUnsupported
// for any type not in the Tier A primitive set.  Callers MUST check
// for LlUnsupported and emit a diagnostic via `bs_check_supported_type`
// to satisfy the fail-closed contract (TASK_30 §9.2 / §13).
fn ll_type_from_mir(types: Vector<DaoType>, type_idx: i64): LlType
  if type_idx < 0:
    return LlType::LlVoid
  if type_idx >= types.length():
    return LlType::LlUnsupported
  let t: DaoType = types.get(type_idx)
  match t.kind:
    TypeKind::TVoid:
      return LlType::LlVoid
    TypeKind::TString:
      return LlType::LlStr
    TypeKind::TPointer:
      return LlType::LlPtr
    TypeKind::TFunction:
      return LlType::LlPtr
    TypeKind::TStruct:
      return LlType::LlStruct
    TypeKind::TGenerator:
      return LlType::LlStruct
    TypeKind::TBuiltin:
      // register_builtins (typecheck): i8=0 i16=1 i32=2 i64=3 u8=4 u16=5
      // u32=6 u64=7 f32=8 f64=9 bool=10; an unsigned integer is its
      // width's integer (the operation says how it is read).
      let id: i64 = t.builtin_id
      if id == to_i64(0) or id == to_i64(4):
        return LlType::LlI8
      if id == to_i64(1) or id == to_i64(5):
        return LlType::LlI16
      if id == to_i64(2) or id == to_i64(6):
        return LlType::LlI32
      if id == to_i64(3) or id == to_i64(7):
        return LlType::LlI64
      if id == to_i64(8):
        return LlType::LlF32
      if id == to_i64(9):
        return LlType::LlF64
      if id == to_i64(10):
        return LlType::LlI1
      return LlType::LlUnsupported
  return LlType::LlUnsupported

// The LLVM type of an enum: a classification enum is its tag, `i32`; one
// with a payload is `{ i32, [N x iK] }` (the host's layout), which is an
// aggregate here.
fn ll_type_of(bs: BS, type_idx: i64): LlType
  if type_idx >= 0 and type_idx < bs.types.length():
    let t: DaoType = bs.types.get(type_idx)
    match t.kind:
      TypeKind::TEnum:
        if ll_enum_has_payload(bs.type_info, t):
          return LlType::LlStruct
        return LlType::LlI32
  return ll_type_from_mir(bs.types, type_idx)

// Whether an enum has a variant that carries a payload (per variant:
// name, payload count, then (name, type) per value).
fn ll_enum_has_payload(info: Vector<i64>, t: DaoType): bool
  let at: i64 = t.info_lp
  let vi: i64 = to_i64(0)
  while vi < t.info_count:
    let count: i64 = info.get(at + to_i64(1))
    if count > to_i64(0):
      return true
    at = at + to_i64(2) + count * to_i64(2)
    vi = vi + to_i64(1)
  return false

// Serialize an LlType to its textual LLVM form.  Primitive-only
// by construction: callers must use `bs_type_text(types, type_idx)`
// for any type_idx that might be a struct, because `LlStruct`
// carries no name of its own.  The `LlStruct` / `LlUnsupported`
// arms return a loud placeholder so any accidental caller shows
// up immediately in emitted IR rather than producing subtly
// wrong text downstream.
fn ll_type_text(ty: LlType): string
  match ty:
    LlType::LlI8:
      return "i8"
    LlType::LlI16:
      return "i16"
    LlType::LlStr:
      return "%dao.string"
    LlType::LlI32:
      return "i32"
    LlType::LlI64:
      return "i64"
    LlType::LlF32:
      return "float"
    LlType::LlF64:
      return "double"
    LlType::LlI1:
      return "i1"
    LlType::LlVoid:
      return "void"
    LlType::LlPtr:
      return "ptr"
    LlType::LlStruct:
      // Caller bug — use bs_type_text instead.  Left as a loud
      // marker because silent <struct> would leak into IR.
      return "<bug:ll_type_text-of-LlStruct-use-bs_type_text>"
    LlType::LlUnsupported:
      return "<unsupported>"
  return "<unsupported>"

fn ll_type_is_float(ty: LlType): bool
  match ty:
    LlType::LlF32:
      return true
    LlType::LlF64:
      return true
  return false

fn ll_type_is_int(ty: LlType): bool
  match ty:
    LlType::LlI8:
      return true
    LlType::LlI16:
      return true
    LlType::LlI32:
      return true
    LlType::LlI64:
      return true
    LlType::LlI1:
      return true
  return false

// =========================================================================
// Section 82b: Struct type definitions (Tier B)
// =========================================================================

// Tracked struct type definition for LLVM emission.
class LlStructDef:
  name: string              // Dao class name, e.g. "P"
  ll_name: string           // LLVM name, e.g. "%struct.P"
  field_ty_texts: Vector<string>  // LLVM type text per field
  mir_type_idx: i64         // key for dedup

// Return the LLVM type text for a MIR type_idx, including struct
// names.  For primitives, delegates to ll_type_text.  For structs,
// returns "%struct.Name".
// The LLVM name of the struct type for the Dao type at `type_idx`: an
// unquoted identifier keeps letters, digits, `_`, `.` and `$`; an
// instantiation's spelling (`Tag<i32>`) has more, and LLVM takes any
// name in quotes.  Two instantiations can spell alike (`Tag<T>` under
// two binders), so a quoted name ends in the type's index, its identity.
fn bs_struct_name(name: string, type_idx: i64): string
  let plain: bool = true
  let i: i64 = 0
  while i < length(name):
    let c: i32 = char_at(name, i)
    let ok: bool = false
    if c >= 48 and c <= 57:
      ok = true
    if c >= 65 and c <= 90:
      ok = true
    if c >= 97 and c <= 122:
      ok = true
    if c == 95 or c == 46 or c == 36:
      ok = true
    if ok == false:
      plain = false
    i = i + 1
  if plain:
    return "%struct." + name
  return "%\"struct." + name + "#" + i64_to_string(type_idx) + "\""

fn bs_type_text(types: Vector<DaoType>, type_idx: i64): string
  if type_idx < 0:
    return "void"
  if type_idx >= types.length():
    return "<unsupported>"
  let t: DaoType = types.get(type_idx)
  match t.kind:
    TypeKind::TStruct:
      return bs_struct_name(t.name, type_idx)
  return ll_type_text(ll_type_from_mir(types, type_idx))

// The LLVM type text of the Dao type at `type_idx`, as the host lowers
// it: a payload-bearing enum is its named layout struct, a generator
// `%dao.generator`; everything else as bs_type_text.
fn bs_ty(bs: BS, type_idx: i64): string
  if type_idx >= 0 and type_idx < bs.types.length():
    let t: DaoType = bs.types.get(type_idx)
    match t.kind:
      TypeKind::TEnum:
        if ll_enum_has_payload(bs.type_info, t):
          return bs_named_type("enum.", t.name, type_idx)
        return "i32"
      TypeKind::TGenerator:
        return "%dao.generator"
  return bs_type_text(bs.types, type_idx)

// Size and alignment, in bytes, of a value of the Dao type at `ti` as
// the x86-64 data layout lays it out (what the host reads from LLVM's
// DataLayout to size an enum's payload).
class SizeAlign:
  size: i64
  align: i64

fn ll_round_up(n: i64, align: i64): i64
  if align <= to_i64(1):
    return n
  return ((n + align - to_i64(1)) / align) * align

fn ll_size_align(bs: BS, ti: i64): SizeAlign
  if ti < 0 or ti >= bs.types.length():
    return SizeAlign(to_i64(0), to_i64(1))
  let t: DaoType = bs.types.get(ti)
  match t.kind:
    TypeKind::TString:
      return SizeAlign(to_i64(16), to_i64(8))
    TypeKind::TGenerator:
      return SizeAlign(to_i64(16), to_i64(8))
    TypeKind::TPointer:
      return SizeAlign(to_i64(8), to_i64(8))
    TypeKind::TFunction:
      return SizeAlign(to_i64(8), to_i64(8))
    TypeKind::TStruct:
      let size: i64 = to_i64(0)
      let align: i64 = to_i64(1)
      let fi: i64 = to_i64(0)
      while fi < t.info_count:
        let f: SizeAlign = ll_size_align(bs, bs.type_info.get(t.info_lp + fi * to_i64(2) + to_i64(1)))
        size = ll_round_up(size, f.align) + f.size
        if f.align > align:
          align = f.align
        fi = fi + to_i64(1)
      return SizeAlign(ll_round_up(size, align), align)
    TypeKind::TEnum:
      if ll_enum_has_payload(bs.type_info, t) == false:
        return SizeAlign(to_i64(4), to_i64(4))
      let payload: SizeAlign = ll_enum_payload_size(bs, t)
      let size: i64 = ll_round_up(to_i64(4), payload.align) + ll_enum_slots(payload) * payload.align
      return SizeAlign(ll_round_up(size, payload.align), payload.align)
  match ll_type_from_mir(bs.types, ti):
    LlType::LlI8:
      return SizeAlign(to_i64(1), to_i64(1))
    LlType::LlI1:
      return SizeAlign(to_i64(1), to_i64(1))
    LlType::LlI16:
      return SizeAlign(to_i64(2), to_i64(2))
    LlType::LlI32:
      return SizeAlign(to_i64(4), to_i64(4))
    LlType::LlF32:
      return SizeAlign(to_i64(4), to_i64(4))
    LlType::LlI64:
      return SizeAlign(to_i64(8), to_i64(8))
    LlType::LlF64:
      return SizeAlign(to_i64(8), to_i64(8))
  return SizeAlign(to_i64(0), to_i64(1))

// The largest variant payload's size, and the largest alignment among
// them, at least the tag's (the host's enum layout).
fn ll_enum_payload_size(bs: BS, t: DaoType): SizeAlign
  let max_size: i64 = to_i64(0)
  let max_align: i64 = to_i64(4)
  let at: i64 = t.info_lp
  let vi: i64 = to_i64(0)
  while vi < t.info_count:
    let count: i64 = bs.type_info.get(at + to_i64(1))
    if count > to_i64(0):
      let size: i64 = to_i64(0)
      let align: i64 = to_i64(1)
      let pi: i64 = to_i64(0)
      while pi < count:
        let f: SizeAlign = ll_size_align(bs, bs.type_info.get(at + to_i64(2) + pi * to_i64(2) + to_i64(1)))
        size = ll_round_up(size, f.align) + f.size
        if f.align > align:
          align = f.align
        pi = pi + to_i64(1)
      size = ll_round_up(size, align)
      if size > max_size:
        max_size = size
      if align > max_align:
        max_align = align
    at = at + to_i64(2) + count * to_i64(2)
    vi = vi + to_i64(1)
  return SizeAlign(max_size, max_align)

// How many alignment-sized slots hold the payload (at least one).
fn ll_enum_slots(payload: SizeAlign): i64
  let n: i64 = (payload.size + payload.align - to_i64(1)) / payload.align
  if n == to_i64(0):
    return to_i64(1)
  return n

// The LLVM name of a named type, `%<prefix><name>`, quoted with the
// type's index when the name has characters an identifier cannot hold.
fn bs_named_type(prefix: string, name: string, type_idx: i64): string
  if llvm_ident_is_plain(name):
    return "%" + prefix + name
  return "%\"" + prefix + name + "#" + i64_to_string(type_idx) + "\""

// =========================================================================
// Section 83: Symbol mangling (placeholder — TASK_30 §9)
// =========================================================================
//
// Tier A mangling: replace "::" in a qualified symbol name with "_"
// and prefix with "@".  NOT stable; NOT an ABI.  Will be replaced
// wholesale when a real mangling contract lands.

fn mangle_symbol_name(raw: string): string
  // "app::math::add" → "@app_math_add"
  // Per TASK_30 §9: replace each "::" pair with a single "_".
  let out: Builder = Builder::new().push("@")
  let i: i64 = to_i64(0)
  let n: i64 = length(raw)
  while i < n:
    let ch: string = substring(raw, i, to_i64(1))
    if ch == ":":
      // Peek ahead — if the next char is also ":", consume both and
      // emit a single "_".  Otherwise emit the lone ":" literally
      // (shouldn't appear in well-formed qualified names but safe).
      if i + to_i64(1) < n:
        let next: string = substring(raw, i + to_i64(1), to_i64(1))
        if next == ":":
          out = out.push("_")
          i = i + to_i64(2)
        else:
          out = out.push(ch)
          i = i + to_i64(1)
      else:
        out = out.push(ch)
        i = i + to_i64(1)
    else:
      out = out.push(ch)
      i = i + to_i64(1)
  // A name LLVM cannot take bare — a specialization's `tag$Ptr<i32>` —
  // is quoted, as the host's are.
  let body: string = substring(out.to_string(), to_i64(1), length(out.to_string()) - to_i64(1))
  if llvm_ident_is_plain(body) == false:
    return "@\"" + body + "\""
  return out.to_string()

// Whether LLVM takes `s` as an identifier unquoted: letters, digits and
// `_ . $ -`, not starting with a digit.
fn llvm_ident_is_plain(s: string): bool
  let i: i64 = to_i64(0)
  while i < length(s):
    let ch: string = substring(s, i, to_i64(1))
    if index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.$-", ch) < to_i64(0):
      return false
    i = i + to_i64(1)
  return true

fn mangle_function_sym(symbols: Vector<Symbol>, sym_idx: i64): string
  if sym_idx < 0:
    return ""
  if sym_idx >= symbols.length():
    return ""
  let s: Symbol = symbols.get(sym_idx)
  return mangle_symbol_name(s.name)

// =========================================================================
// Section 84: Backend lowering state
// =========================================================================
//
// `BS` threads the read-only MIR/symbol/type/token inputs plus the
// mutable mini-IR output.  Mutating-field style per the post-#248
// bootstrap convention.
//
// Bootstrap Dao's HashMap is HashMap<i64> only, so string-valued
// lookups (MIR node idx → "%N" text, etc.) use parallel Vector
// side tables with linear scan.  Functions are small; this is
// fine for Tier A.

class BS:
  // Inputs (read-only).
  mir_nodes: Vector<MirNode>
  mir_idx: Vector<i64>
  symbols: Vector<Symbol>
  types: Vector<DaoType>
  type_info: Vector<i64>
  toks: Vector<Token>
  src: string

  // Output.
  globals: Vector<LlGlobal>
  functions: Vector<LlFunction>
  extern_decls: Vector<LlFunction>
  diags: Vector<Diagnostic>

  // Per-function lowering state (reset between functions).
  // Value side table: maps MirInst node idx → result text (either
  // "%N" for LLVM-instruction results, or an inline constant text
  // like "42" / "1.500000e+00" / "true" for folded constants) and
  // its LLVM type text.  Linear-scan lookup via `bs_get_value_*`.
  val_keys: Vector<i64>
  val_texts: Vector<string>
  val_tys: Vector<string>

  // MirLocal node idx → alloca slot name ("%slot0", etc.) + slot type text.
  slot_keys: Vector<i64>
  slot_names: Vector<string>
  slot_tys: Vector<string>

  // MirBlock node idx → textual label ("entry" / "bb1" / ...).
  block_keys: Vector<i64>
  block_labels: Vector<string>

  // Next value counter (per function) — "%0", "%1", ...
  next_value: i64

  // Globals counter — "@.str.0", "@.str.1", ...
  next_global: i64

  // Extern-declare dedup: list of mangled names already emitted.
  extern_emitted: Vector<string>

  // Call arg bundles — LlInstKind::LlCall stores an index into this
  // list rather than carrying Vector<string>/Vector<LlType> inline
  // (enum-class variants over vectors are expensive to thread).
  call_arg_bundles: Vector<CallArgs>

  // Struct type definitions — module-level, populated on first use.
  struct_defs: Vector<LlStructDef>

  // Flag: set when lowering has emitted a diagnostic that makes
  // the whole backend result `ok = false`.
  had_error: i64

  // Where each keyed entry of the side tables above sits, so a lookup
  // is a hash probe rather than a scan (a compiler-sized function has
  // thousands of values).
  index: BsIndex

  // The program's source files, for the tokens of the module whose
  // functions are being lowered (`toks` / `src` above).
  files: Vector<SourceFile>

  // Allocas a function's body needs beyond its locals (a string passed
  // by pointer), placed in its entry block so a loop does not grow the
  // stack.
  entry_allocas: Vector<LlInst>

  // The generator frame a resume function is lowering against; its frame
  // is "" in any other function.
  gen: GenCtx

// A generator's resume function in progress: the frame pointer, the
// frame's type, and how many yields it has lowered so far.
class GenCtx:
  frame: string
  frame_ty: string
  yields: i64

// Positions in BS's side tables, by key: a value's and a block label's
// by MIR node, a slot's by MirLocal node, an extern's and a struct's by
// name / type index.
class BsIndex:
  values: HashMap<i64>
  slots: HashMap<i64>
  labels: HashMap<i64>
  externs: HashMap<i64>
  structs: HashMap<i64>

fn bs_index_empty(): BsIndex
  return BsIndex(HashMap<i64>::new(), HashMap<i64>::new(), HashMap<i64>::new(), HashMap<i64>::new(), HashMap<i64>::new())

fn bs_new(input: MirBackendInput): BS
  return BS(
    input.mir.mir_nodes,
    input.mir.mir_idx,
    input.symbols,
    input.types,
    input.type_info,
    input.toks,
    input.src,
    Vector<LlGlobal>::new(),
    Vector<LlFunction>::new(),
    Vector<LlFunction>::new(),
    Vector<Diagnostic>::new(),
    Vector<i64>::new(),
    Vector<string>::new(),
    Vector<string>::new(),
    Vector<i64>::new(),
    Vector<string>::new(),
    Vector<string>::new(),
    Vector<i64>::new(),
    Vector<string>::new(),
    to_i64(0),
    to_i64(0),
    Vector<string>::new(),
    Vector<CallArgs>::new(),
    Vector<LlStructDef>::new(),
    to_i64(0),
    bs_index_empty(),
    input.files,
    Vector<LlInst>::new(),
    GenCtx("", "", to_i64(0)))

fn bs_reset_fn_state(bs: BS): BS
  bs.val_keys = Vector<i64>::new()
  bs.val_texts = Vector<string>::new()
  bs.val_tys = Vector<string>::new()
  bs.slot_keys = Vector<i64>::new()
  bs.slot_names = Vector<string>::new()
  bs.slot_tys = Vector<string>::new()
  bs.block_keys = Vector<i64>::new()
  bs.block_labels = Vector<string>::new()
  bs.next_value = to_i64(0)
  bs.entry_allocas = Vector<LlInst>::new()
  bs.gen = GenCtx("", "", to_i64(0))
  bs.index = BsIndex(HashMap<i64>::new(), HashMap<i64>::new(), HashMap<i64>::new(), bs.index.externs, bs.index.structs)
  return bs

// Fail-closed type check: if ty is LlUnsupported, emit a diagnostic
// and set had_error.  Returns the updated BS.
fn bs_check_supported_type(bs: BS, ty: LlType, context: string): BS
  match ty:
    LlType::LlUnsupported:
      bs = bs_error(bs, "bootstrap llvm backend encountered unsupported type kind in " + context)
  return bs

class FreshR:
  bs: BS
  name: string

// Returns both the updated BS (with incremented counter) and the
// new SSA name.  Must be called as:
//   let fr: FreshR = bs_fresh_value(bs); bs = fr.bs; let n = fr.name
// because Dao class field mutation does not persist across function
// call boundaries — the counter update only takes effect when the
// caller re-binds `bs` from the returned FreshR.
fn bs_fresh_value(bs: BS): FreshR
  let n: i64 = bs.next_value
  bs.next_value = n + to_i64(1)
  return FreshR(bs, "%" + i64_to_string(n))

// A fresh named value (`%<stem>.<n>`): LLVM requires the unnamed `%N`
// to be defined in order, so a value placed out of order — an entry-block
// temporary, a label within a block — takes a name instead.
fn bs_fresh_named(bs: BS, stem: string): FreshR
  let n: i64 = bs.next_global
  bs.next_global = n + to_i64(1)
  return FreshR(bs, "%" + stem + "." + i64_to_string(n))

fn bs_error(bs: BS, msg: string): BS
  bs.diags = bs.diags.push(make_error(Span(to_i64(0), to_i64(1)), msg))
  bs.had_error = to_i64(1)
  return bs

// Value side-table helpers.
fn bs_set_value(bs: BS, mir_idx: i64, text: string, ty_text: string): BS
  bs.index.values = bs.index.values.set(i64_to_string(mir_idx), bs.val_keys.length())
  bs.val_keys = bs.val_keys.push(mir_idx)
  bs.val_texts = bs.val_texts.push(text)
  bs.val_tys = bs.val_tys.push(ty_text)
  return bs

fn bs_get_value_text(bs: BS, mir_idx: i64): string
  let at: i64 = hm_get_or(bs.index.values, i64_to_string(mir_idx), to_i64(-1))
  if at < 0:
    return ""
  return bs.val_texts.get(at)

fn bs_get_value_ty(bs: BS, mir_idx: i64): string
  let at: i64 = hm_get_or(bs.index.values, i64_to_string(mir_idx), to_i64(-1))
  if at < 0:
    return ""
  return bs.val_tys.get(at)

// Slot side-table helpers (MirLocal node idx → alloca name + ty text).
fn bs_set_slot(bs: BS, local_node_idx: i64, slot_name: string, ty_text: string): BS
  bs.index.slots = bs.index.slots.set(i64_to_string(local_node_idx), bs.slot_keys.length())
  bs.slot_keys = bs.slot_keys.push(local_node_idx)
  bs.slot_names = bs.slot_names.push(slot_name)
  bs.slot_tys = bs.slot_tys.push(ty_text)
  return bs

fn bs_get_slot_name(bs: BS, local_node_idx: i64): string
  let at: i64 = hm_get_or(bs.index.slots, i64_to_string(local_node_idx), to_i64(-1))
  if at < 0:
    return ""
  return bs.slot_names.get(at)

fn bs_get_slot_ty(bs: BS, local_node_idx: i64): string
  let at: i64 = hm_get_or(bs.index.slots, i64_to_string(local_node_idx), to_i64(-1))
  if at < 0:
    return ""
  return bs.slot_tys.get(at)

// Slot position-indexed lookup for MirLocal local_slot_index.  Task 29
// MirLoad/MirStore reference locals by slot index (0..param_count..locals.length()),
// NOT by node index.  We keep the slot list in declaration order so
// the index into slot_names matches the MirLocal slot index.
fn bs_slot_name_by_index(bs: BS, slot_idx: i64): string
  if slot_idx < 0:
    return ""
  if slot_idx >= bs.slot_names.length():
    return ""
  return bs.slot_names.get(slot_idx)

// The MIR type of a local slot, from its MirLocal node.
fn bs_slot_type_idx(bs: BS, slot_idx: i64): i64
  if slot_idx < 0 or slot_idx >= bs.slot_keys.length():
    return to_i64(-1)
  match bs.mir_nodes.get(bs.slot_keys.get(slot_idx)):
    MirNode::MirLocal(sym, type_idx, is_param):
      return type_idx
  return to_i64(-1)

fn bs_slot_ty_by_index(bs: BS, slot_idx: i64): string
  if slot_idx < 0:
    return ""
  if slot_idx >= bs.slot_tys.length():
    return ""
  return bs.slot_tys.get(slot_idx)

// Block label side-table helpers (MirBlock node idx → label text).
fn bs_set_block_label(bs: BS, block_node_idx: i64, label: string): BS
  bs.index.labels = bs.index.labels.set(i64_to_string(block_node_idx), bs.block_keys.length())
  bs.block_keys = bs.block_keys.push(block_node_idx)
  bs.block_labels = bs.block_labels.push(label)
  return bs

fn bs_get_block_label(bs: BS, block_node_idx: i64): string
  let at: i64 = hm_get_or(bs.index.labels, i64_to_string(block_node_idx), to_i64(-1))
  if at < 0:
    return ""
  return bs.block_labels.get(at)

// Extern-declare dedup.
fn bs_has_extern(bs: BS, name: string): bool
  return bs.index.externs.contains(name)

fn bs_mark_extern(bs: BS, name: string): BS
  bs.index.externs = bs.index.externs.set(name, bs.extern_emitted.length())
  bs.extern_emitted = bs.extern_emitted.push(name)
  return bs

// Ensure a struct type definition is registered for the given MIR
// type_idx.  Returns the LLVM struct name (e.g. "%struct.P").
// Idempotent — checks dedup before adding.
fn bs_ensure_struct_def(bs: BS, type_idx: i64): BS
  // Already registered?  (Dedup check runs first so cyclic /
  // mutually-referential struct graphs terminate — we push a
  // placeholder before recursing into field types.)
  if bs.index.structs.contains(i64_to_string(type_idx)):
    return bs
  // Push a placeholder entry first so that recursive struct field
  // registration sees this type as already present and doesn't
  // recurse back into it.
  let t: DaoType = bs.types.get(type_idx)
  // The generator handle is a declared type of the module prologue.
  match t.kind:
    TypeKind::TGenerator:
      return bs
  let ll_name: string = bs_ty(bs, type_idx)
  let slot_idx: i64 = bs.struct_defs.length()
  bs.index.structs = bs.index.structs.set(i64_to_string(type_idx), slot_idx)
  bs.struct_defs = bs.struct_defs.push(LlStructDef(t.name, ll_name, Vector<string>::new(), type_idx))
  // An enum's layout: its tag and the payload slots (the host's).
  let field_tys: Vector<string> = Vector<string>::new()
  let is_enum: bool = false
  match t.kind:
    TypeKind::TEnum:
      is_enum = true
  if is_enum:
    let payload: SizeAlign = ll_enum_payload_size(bs, t)
    field_tys = field_tys.push("i32")
    field_tys = field_tys.push("[" + i64_to_string(ll_enum_slots(payload)) + " x i" + i64_to_string(payload.align * to_i64(8)) + "]")
  // A class's fields.  Every field whose type is another aggregate
  // registers its definition too — otherwise module serialization can
  // emit a reference to an undefined named type (invalid IR).
  let fi: i64 = to_i64(0)
  while is_enum == false and fi < t.info_count:
    let field_type_idx: i64 = bs.type_info.get(t.info_lp + fi * to_i64(2) + to_i64(1))
    let field_kind: LlType = ll_type_of(bs, field_type_idx)
    match field_kind:
      LlType::LlStruct:
        bs = bs_ensure_struct_def(bs, field_type_idx)
    field_tys = field_tys.push(bs_ty(bs, field_type_idx))
    fi = fi + to_i64(1)
  // Re-read the placeholder entry and update its field_tys.  The
  // placeholder may have moved if a recursive call pushed more
  // entries, but slot_idx is stable (append-only vector).
  let existing: LlStructDef = bs.struct_defs.get(slot_idx)
  existing.field_ty_texts = field_tys
  bs.struct_defs = bs.struct_defs.set(slot_idx, existing)
  return bs

// =========================================================================
// Section 86: MIR list helpers
// =========================================================================
//
// Task 29 MIR uses the same list convention as HIR (items first,
// count at list_pos, items at [list_pos - count, list_pos)).

fn read_mir_list(mir_idx: Vector<i64>, list_pos: i64): Vector<i64>
  let result: Vector<i64> = Vector<i64>::new()
  if list_pos < to_i64(0):
    return result
  if list_pos >= mir_idx.length():
    return result
  let count: i64 = mir_idx.get(list_pos)
  let start: i64 = list_pos - count
  let i: i64 = to_i64(0)
  while i < count:
    result = result.push(mir_idx.get(start + i))
    i = i + to_i64(1)
  return result

// Read a token lexeme from the source buffer.
fn bs_tok_lex(bs: BS, tok_idx: i64): string
  if tok_idx < 0:
    return ""
  if tok_idx >= bs.toks.length():
    return ""
  let t: Token = bs.toks.get(tok_idx)
  return substring(bs.src, t.offset, t.len)

// =========================================================================
// Section 87: Op-token → LLVM mnemonic dispatch
// =========================================================================
//
// MirBinary carries an op_tok pointing at the original binary
// operator token.  Task 30 dispatches off that token kind, plus the
// already-resolved operand type, to pick the correct LLVM op.

// =========================================================================
// Section 88: MIR → LlInst lowering
// =========================================================================

// Lower a MirFunction parameter list into ordered LlParam list.
class ParamsR:
  bs: BS
  params: Vector<LlParam>

fn bs_lower_params(bs: BS, params_raw: Vector<i64>, param_count: i64): ParamsR
  let out: Vector<LlParam> = Vector<LlParam>::new()
  let i: i64 = to_i64(0)
  while i < param_count:
    let local_node_idx: i64 = params_raw.get(i)
    let node: MirNode = bs.mir_nodes.get(local_node_idx)
    match node:
      MirNode::MirLocal(sym, type_idx, is_param):
        let ty: LlType = ll_type_of(bs, type_idx)
        bs = bs_check_supported_type(bs, ty, "function parameter")
        let ty_txt: string = bs_ty(bs, type_idx)
        match ty:
          LlType::LlStruct:
            bs = bs_ensure_struct_def(bs, type_idx)
          LlType::LlStr:
            // A string is passed by pointer, for the C ABI (the host's).
            ty_txt = "ptr"
        out = out.push(LlParam("%arg" + i64_to_string(i), ty_txt))
    i = i + to_i64(1)
  return ParamsR(bs, out)

// Lower a single MirNode instruction into the current LlBlock's
// inst list.  Returns the updated BS and updated inst list.

// =========================================================================
// Section 87b: Aggregate (struct) lowering helpers
// =========================================================================
//
// Keep aggregate-specific lowering policy out of the main
// bs_lower_inst match so future aggregate features (nested
// structs, enum payloads, etc.) have a dedicated seam.

// Lower a struct constructor call: emit alloca + per-field GEP
// stores + load of the complete struct value.  Returns the updated
// BS, the updated inst list, and the SSA name of the loaded struct
// value (which the caller registers in the value side table).
class StructCtorR:
  bs: BS
  insts: Vector<LlInst>
  value_name: string
  ty_text: string

fn bs_lower_struct_ctor(bs: BS, insts: Vector<LlInst>, type_idx: i64, arg_list_lp: i64): StructCtorR
  let struct_ty_text: string = bs_ty(bs, type_idx)
  bs = bs_ensure_struct_def(bs, type_idx)
  let args_raw: Vector<i64> = read_mir_list(bs.mir_idx, arg_list_lp)
  // Alloca for the temp struct.
  let fr_tmp: FreshR = bs_fresh_value(bs)
  bs = fr_tmp.bs
  let tmp_name: string = fr_tmp.name
  let alloca_inst: LlInst = LlInst(
    LlInstKind::LlAlloca(ty_text = struct_ty_text), tmp_name)
  insts = insts.push(alloca_inst)
  // GEP + store each field.
  let fi: i64 = to_i64(0)
  while fi < args_raw.length():
    let arg_idx: i64 = args_raw.get(fi)
    let arg_text: string = bs_get_value_text(bs, arg_idx)
    let arg_ty_text: string = bs_get_value_ty(bs, arg_idx)
    let fr_gep: FreshR = bs_fresh_value(bs)
    bs = fr_gep.bs
    let gep_name: string = fr_gep.name
    let gep_inst: LlInst = LlInst(
      LlInstKind::LlGepField(ptr_text = tmp_name, struct_ty_text = struct_ty_text, field_index = fi),
      gep_name)
    insts = insts.push(gep_inst)
    let store_inst: LlInst = LlInst(
      LlInstKind::LlStore(ptr_name = gep_name, value_text = arg_text, value_ty_text = arg_ty_text),
      "")
    insts = insts.push(store_inst)
    fi = fi + to_i64(1)
  // Load the complete struct value.
  let fr_load: FreshR = bs_fresh_value(bs)
  bs = fr_load.bs
  let load_name: string = fr_load.name
  let load_inst: LlInst = LlInst(
    LlInstKind::LlLoad(ptr_name = tmp_name, ty_text = struct_ty_text),
    load_name)
  insts = insts.push(load_inst)
  return StructCtorR(bs, insts, load_name, struct_ty_text)

// The address of a MIR place: its local's slot, then one GEP per field
// step of its path, with the LLVM type of what it addresses.  A step
// this backend does not lower (a pointer's deref, an unresolved field)
// fails the module, and the result's name is "".
class PlacePtrR:
  bs: BS
  insts: Vector<LlInst>
  ptr_name: string
  ty_text: string

fn bs_place_pointer(bs: BS, insts: Vector<LlInst>, local_idx: i64, path_lp: i64, what: string): PlacePtrR
  let slot_name: string = bs_slot_name_by_index(bs, local_idx)
  if slot_name == "":
    return PlacePtrR(bs_error(bs, "bootstrap llvm backend: " + what + " references unknown local slot " + i64_to_string(local_idx)), insts, "", "")
  let ptr_name: string = slot_name
  let ty_text: string = bs_slot_ty_by_index(bs, local_idx)
  let path: Vector<i64> = read_mir_list(bs.mir_idx, path_lp)
  if path.length() == 0:
    return PlacePtrR(bs, insts, ptr_name, ty_text)
  let cur_ti: i64 = bs_slot_type_idx(bs, local_idx)
  let pi: i64 = to_i64(0)
  while pi < path.length():
    let field: i64 = path.get(pi)
    if cur_ti < 0 or cur_ti >= bs.types.length():
      return PlacePtrR(bs_error(bs, "bootstrap llvm backend: " + what + " path has no struct type"), insts, "", "")
    let owner: DaoType = bs.types.get(cur_ti)
    // A deref step: the place so far holds a pointer; what it addresses
    // is the place from here on.
    if field == mir_deref_step():
      let loaded: FreshR = bs_fresh_value(bs)
      bs = loaded.bs
      insts = insts.push(LlInst(LlInstKind::LlLoad(ptr_name = ptr_name, ty_text = "ptr"), loaded.name))
      ptr_name = loaded.name
      cur_ti = owner.pointee
    else:
      if field < 0 or field >= owner.info_count:
        return PlacePtrR(bs_error(bs, "bootstrap llvm backend: " + what + " path step " + i64_to_string(field) + " into " + owner.name + " is not lowered"), insts, "", "")
      bs = bs_ensure_struct_def(bs, cur_ti)
      let fr_gep: FreshR = bs_fresh_value(bs)
      bs = fr_gep.bs
      insts = insts.push(LlInst(LlInstKind::LlGepField(ptr_text = ptr_name, struct_ty_text = bs_ty(bs, cur_ti), field_index = field), fr_gep.name))
      ptr_name = fr_gep.name
      cur_ti = bs.type_info.get(owner.info_lp + field * to_i64(2) + to_i64(1))
    pi = pi + to_i64(1)
  return PlacePtrR(bs, insts, ptr_name, bs_ty(bs, cur_ti))

class LowerStepR:
  bs: BS
  insts: Vector<LlInst>

fn bs_lower_inst(bs: BS, insts: Vector<LlInst>, mir_node_idx: i64, fn_ret_ty_text: string): LowerStepR
  let node: MirNode = bs.mir_nodes.get(mir_node_idx)
  match node:
    // ---------- constants (inlined as operand text) ----------
    MirNode::MirConstInt(value, type_idx):
      let ty: LlType = ll_type_of(bs, type_idx)
      // An enum's tag is an integer of a type this backend does not lower.
      bs = bs_check_supported_type(bs, ty, "integer constant")
      bs = bs_set_value(bs, mir_node_idx, i64_to_string(value), ll_type_text(ty))
      return LowerStepR(bs, insts)
    MirNode::MirConstBool(value, type_idx):
      let v: string = "false"
      if value > 0:
        v = "true"
      bs = bs_set_value(bs, mir_node_idx, v, "i1")
      return LowerStepR(bs, insts)
    MirNode::MirConstFloat(tok, type_idx):
      let lex: string = bs_tok_lex(bs, tok)
      let ty: LlType = ll_type_of(bs, type_idx)
      bs = bs_set_value(bs, mir_node_idx, lex, ll_type_text(ty))
      return LowerStepR(bs, insts)
    MirNode::MirConstString(tok, type_idx):
      // Emit a module-global and materialize via GEP.
      let raw: string = bs_tok_lex(bs, tok)
      // Decode Dao escapes and re-escape for LLVM IR c"..." form.
      let decoded: StrDecode = decode_string_literal(raw)
      let nbytes: i64 = decoded.byte_count  // includes trailing NUL
      let gname: string = "@.str." + i64_to_string(bs.next_global)
      bs.next_global = bs.next_global + to_i64(1)
      bs.globals = bs.globals.push(LlGlobal(gname, decoded.llvm_payload, nbytes))
      // A string value is `{ bytes, length }` (the host's %dao.string);
      // the length leaves out the terminating NUL.
      let with_ptr: FreshR = bs_fresh_value(bs)
      bs = with_ptr.bs
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "insertvalue %dao.string undef, ptr " + gname + ", 0"), with_ptr.name))
      let with_len: FreshR = bs_fresh_value(bs)
      bs = with_len.bs
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "insertvalue %dao.string " + with_ptr.name + ", i64 " + i64_to_string(nbytes - to_i64(1)) + ", 1"), with_len.name))
      bs = bs_set_value(bs, mir_node_idx, with_len.name, "%dao.string")
      return LowerStepR(bs, insts)

    // ---------- memory ----------
    MirNode::MirLoad(local_idx, path_lp, path_count, type_idx):
      let at: PlacePtrR = bs_place_pointer(bs, insts, local_idx, path_lp, "MirLoad")
      bs = at.bs
      insts = at.insts
      if at.ptr_name == "":
        return LowerStepR(bs, insts)
      let ty_text: string = bs_ty(bs, type_idx)
      let fr_ld: FreshR = bs_fresh_value(bs)
      bs = fr_ld.bs
      let result: string = fr_ld.name
      insts = insts.push(LlInst(LlInstKind::LlLoad(ptr_name = at.ptr_name, ty_text = ty_text), result))
      bs = bs_set_value(bs, mir_node_idx, result, ty_text)
      return LowerStepR(bs, insts)

    MirNode::MirStore(local_idx, path_lp, path_count, value_node):
      let at: PlacePtrR = bs_place_pointer(bs, insts, local_idx, path_lp, "MirStore")
      bs = at.bs
      insts = at.insts
      if at.ptr_name == "":
        return LowerStepR(bs, insts)
      let val_text: string = bs_get_value_text(bs, value_node)
      insts = insts.push(LlInst(LlInstKind::LlStore(ptr_name = at.ptr_name, value_text = val_text, value_ty_text = at.ty_text), ""))
      return LowerStepR(bs, insts)

    // ---------- binary / unary ----------
    MirNode::MirBinary(op_tok, lhs, rhs, type_idx):
      // A comparison `match` synthesized has no source token: it is `==`.
      let tk: Token = Token(TK::EqEq, to_i64(0), to_i64(0))
      if op_tok != synthesized_equality_op():
        tk = bs.toks.get(op_tok)
      return bs_lower_binary(bs, insts, mir_node_idx, tk_name(tk.kind), lhs, rhs)

    MirNode::MirUnary(op_tok, operand, type_idx):
      let tk: Token = bs.toks.get(op_tok)
      let operand_text: string = bs_get_value_text(bs, operand)
      let ty: LlType = ll_type_of(bs, type_idx)
      let fr_un: FreshR = bs_fresh_value(bs)
      bs = fr_un.bs
      let result: string = fr_un.name
      if tk_name(tk.kind) == "Minus":
        if ll_type_is_float(ty):
          let inst: LlInst = LlInst(
            LlInstKind::LlFNeg(operand_text = operand_text, ty = ty),
            result)
          insts = insts.push(inst)
        else:
          // sub 0, x
          let inst: LlInst = LlInst(
            LlInstKind::LlBinOp(op = "sub", lhs_text = "0", rhs_text = operand_text, ty = ty),
            result)
          insts = insts.push(inst)
        bs = bs_set_value(bs, mir_node_idx, result, ll_type_text(ty))
        return LowerStepR(bs, insts)
      if tk_name(tk.kind) == "Bang":
        // xor %x, true  (on i1)
        let inst: LlInst = LlInst(
          LlInstKind::LlBinOp(op = "xor", lhs_text = operand_text, rhs_text = "true", ty = LlType::LlI1),
          result)
        insts = insts.push(inst)
        bs = bs_set_value(bs, mir_node_idx, result, "i1")
        return LowerStepR(bs, insts)
      bs = bs_error(bs, "bootstrap llvm backend: unsupported unary op " + tk_name(tk.kind))
      return LowerStepR(bs, insts)

    // ---------- calls ----------
    MirNode::MirFnRef(sym, type_idx):
      // Not a real LLVM instruction — the callee is materialized
      // inline as the mangled name.  Record the mapping so the
      // subsequent MirCall picks it up via bs_get_value_text.
      let name: string = mangle_function_sym(bs.symbols, sym)
      if name == "":
        bs = bs_error(bs, "bootstrap llvm backend cannot mangle anonymous symbol")
        return LowerStepR(bs, insts)
      bs = bs_set_value(bs, mir_node_idx, name, "ptr")
      return LowerStepR(bs, insts)

    MirNode::MirConstruct(arg_list_lp, arg_count, type_idx):
      let cr: StructCtorR = bs_lower_struct_ctor(bs, insts, type_idx, arg_list_lp)
      bs = cr.bs
      insts = cr.insts
      bs = bs_set_value(bs, mir_node_idx, cr.value_name, cr.ty_text)
      return LowerStepR(bs, insts)

    MirNode::MirCall(callee, arg_list_lp, arg_count, type_idx, subst):
      // A compiler intrinsic (`size_of$T`, `align_of$T`) has no body to
      // call: it is the size or alignment of the type the call decided
      // (the host's lower_builtin_call).
      let intrinsic: string = bs_intrinsic_of(bs, callee)
      if intrinsic != "":
        if subst < 0 or subst + to_i64(2) >= bs.type_info.length():
          bs = bs_error(bs, "bootstrap llvm backend: intrinsic '" + intrinsic + "' is called with no type decided")
          return LowerStepR(bs, insts)
        let measured: SizeAlign = ll_size_align(bs, bs.type_info.get(subst + to_i64(2)))
        let answer: i64 = measured.size
        if intrinsic == "align_of":
          answer = measured.align
        bs = bs_set_value(bs, mir_node_idx, i64_to_string(answer), "i64")
        return LowerStepR(bs, insts)
      let callee_text: string = bs_get_value_text(bs, callee)
      if callee_text == "":
        bs = bs_error(bs, "bootstrap llvm backend: MirCall callee has no mangled name (expected MirFnRef)")
        return LowerStepR(bs, insts)
      let ret_ty: LlType = ll_type_of(bs, type_idx)
      let ret_ty_text: string = bs_ty(bs, type_idx)
      let args_raw: Vector<i64> = read_mir_list(bs.mir_idx, arg_list_lp)
      let arg_entry: CallArgs = CallArgs(Vector<string>::new(), Vector<string>::new())
      let ai: i64 = to_i64(0)
      while ai < args_raw.length():
        let a_idx: i64 = args_raw.get(ai)
        let a_text: string = bs_get_value_text(bs, a_idx)
        let a_ty_text: string = bs_get_value_ty(bs, a_idx)
        // A string argument is passed by pointer (the host's C ABI): kept
        // in an entry-block temporary for the call.
        if a_ty_text == "%dao.string":
          let tmp: FreshR = bs_fresh_named(bs, "str.arg")
          bs = tmp.bs
          bs.entry_allocas = bs.entry_allocas.push(LlInst(LlInstKind::LlAlloca(ty_text = "%dao.string"), tmp.name))
          insts = insts.push(LlInst(LlInstKind::LlStore(ptr_name = tmp.name, value_text = a_text, value_ty_text = a_ty_text), ""))
          a_text = tmp.name
          a_ty_text = "ptr"
        arg_entry.arg_texts = arg_entry.arg_texts.push(a_text)
        arg_entry.arg_ty_texts = arg_entry.arg_ty_texts.push(a_ty_text)
        ai = ai + to_i64(1)
      let bundle_idx: i64 = bs.call_arg_bundles.length()
      bs.call_arg_bundles = bs.call_arg_bundles.push(arg_entry)

      let result: string = ""
      let needs_result: bool = true
      match ret_ty:
        LlType::LlVoid:
          needs_result = false
      if needs_result:
        let fr_call: FreshR = bs_fresh_value(bs)
        bs = fr_call.bs
        result = fr_call.name
      let inst: LlInst = LlInst(
        LlInstKind::LlCall(callee = callee_text, arg_list_lp = bundle_idx, arg_count = args_raw.length(), ret_ty_text = ret_ty_text),
        result)
      insts = insts.push(inst)
      if result != "":
        bs = bs_set_value(bs, mir_node_idx, result, ret_ty_text)
      return LowerStepR(bs, insts)

    MirNode::MirFieldAccess(obj, field_tok, field_index, type_idx):
      if field_index < 0:
        bs = bs_error(bs, "bootstrap llvm backend: MirFieldAccess has unresolved field_index (-1)")
        return LowerStepR(bs, insts)
      // `obj` is an SSA struct VALUE (from MirLoad, from a struct
      // constructor call, or from a returning-struct call).  Use
      // `extractvalue` rather than GEP — GEP requires a pointer,
      // which we don't have here.  Task 29 MIR lowers identifier
      // reads to MirLoad, so obj is always a loaded struct value
      // at this point.
      let obj_text: string = bs_get_value_text(bs, obj)
      let obj_ty_text: string = bs_get_value_ty(bs, obj)
      let field_ty: LlType = ll_type_of(bs, type_idx)
      let field_ty_text: string = bs_ty(bs, type_idx)
      let fr_ev: FreshR = bs_fresh_value(bs)
      bs = fr_ev.bs
      let result: string = fr_ev.name
      let inst: LlInst = LlInst(
        LlInstKind::LlExtractValue(agg_text = obj_text, agg_ty_text = obj_ty_text, field_index = field_index),
        result)
      insts = insts.push(inst)
      bs = bs_set_value(bs, mir_node_idx, result, field_ty_text)
      return LowerStepR(bs, insts)

    MirNode::MirErrorExpr(tok):
      bs = bs_error(bs, "bootstrap llvm backend rejects MirErrorExpr sentinel")
      return LowerStepR(bs, insts)

    // ---------- terminators ----------
    MirNode::MirReturn(value, has_value):
      // A generator's `return` ends it: done, and back to the consumer.
      if bs.gen.frame != "":
        let done_at: FreshR = bs_fresh_value(bs)
        bs = done_at.bs
        insts = insts.push(LlInst(LlInstKind::LlGepField(ptr_text = bs.gen.frame, struct_ty_text = bs.gen.frame_ty, field_index = to_i64(1)), done_at.name))
        insts = insts.push(LlInst(LlInstKind::LlStore(ptr_name = done_at.name, value_text = "true", value_ty_text = "i1"), ""))
        insts = insts.push(LlInst(LlInstKind::LlRet(value_text = "", value_ty_text = "void", has_value = to_i64(0)), ""))
        return LowerStepR(bs, insts)
      if has_value > 0:
        let val_text: string = bs_get_value_text(bs, value)
        let val_ty_text: string = bs_get_value_ty(bs, value)
        let inst: LlInst = LlInst(
          LlInstKind::LlRet(value_text = val_text, value_ty_text = val_ty_text, has_value = to_i64(1)),
          "")
        insts = insts.push(inst)
      else:
        if fn_ret_ty_text == "void":
          let inst: LlInst = LlInst(
            LlInstKind::LlRet(value_text = "", value_ty_text = "void", has_value = to_i64(0)),
            "")
          insts = insts.push(inst)
        else:
          // A valueless return in a non-void function ends either a block
          // no path reaches (the merge block after an if/else whose arms
          // both return) or a genuine fall-through.  `ret void` is invalid
          // IR in a non-void function either way; `unreachable` is right
          // for the first case, and the block loop rejects the second by
          // checking whether any branch reaches the block.
          let dead: LlInst = LlInst(LlInstKind::LlUnreachable, "")
          insts = insts.push(dead)
      return LowerStepR(bs, insts)

    MirNode::MirBr(target_block):
      let label: string = bs_get_block_label(bs, target_block)
      let inst: LlInst = LlInst(
        LlInstKind::LlBr(target_label = label),
        "")
      insts = insts.push(inst)
      return LowerStepR(bs, insts)

    MirNode::MirCondBr(cond, then_block, else_block):
      let cond_text: string = bs_get_value_text(bs, cond)
      let then_label: string = bs_get_block_label(bs, then_block)
      let else_label: string = bs_get_block_label(bs, else_block)
      let inst: LlInst = LlInst(
        LlInstKind::LlCondBr(cond_text = cond_text, then_label = then_label, else_label = else_label),
        "")
      insts = insts.push(inst)
      return LowerStepR(bs, insts)
    // ---------- generators (the host's lower_generator_resume / iter) ----------
    MirNode::MirYield(value):
      // Store the value in the frame's yield slot, note where to resume,
      // and return to the consumer; resumption continues from here.
      if bs.gen.frame == "":
        bs = bs_error(bs, "bootstrap llvm backend: yield outside a generator")
        return LowerStepR(bs, insts)
      bs.gen.yields = bs.gen.yields + to_i64(1)
      let k: string = i64_to_string(bs.gen.yields)
      let slot_at: FreshR = bs_fresh_value(bs)
      bs = slot_at.bs
      insts = insts.push(LlInst(LlInstKind::LlGepField(ptr_text = bs.gen.frame, struct_ty_text = bs.gen.frame_ty, field_index = to_i64(2)), slot_at.name))
      insts = insts.push(LlInst(LlInstKind::LlStore(ptr_name = slot_at.name, value_text = bs_get_value_text(bs, value), value_ty_text = bs_get_value_ty(bs, value)), ""))
      let state_at: FreshR = bs_fresh_value(bs)
      bs = state_at.bs
      insts = insts.push(LlInst(LlInstKind::LlGepField(ptr_text = bs.gen.frame, struct_ty_text = bs.gen.frame_ty, field_index = to_i64(0)), state_at.name))
      insts = insts.push(LlInst(LlInstKind::LlStore(ptr_name = state_at.name, value_text = k, value_ty_text = "i32"), ""))
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "ret void"), ""))
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "resume." + k + ":"), ""))
      return LowerStepR(bs, insts)
    MirNode::MirIterInit(source, type_idx):
      // The handle's frame is the iterator; its first resume runs the
      // generator to its first yield.
      let gen_val: string = bs_get_value_text(bs, source)
      let frame: FreshR = bs_fresh_value(bs)
      bs = frame.bs
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "extractvalue %dao.generator " + gen_val + ", 0"), frame.name))
      let resume: FreshR = bs_fresh_value(bs)
      bs = resume.bs
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "extractvalue %dao.generator " + gen_val + ", 1"), resume.name))
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "call void " + resume.name + "(ptr " + frame.name + ")"), ""))
      bs = bs_set_value(bs, mir_node_idx, frame.name, "ptr")
      bs = bs_set_value(bs, bs_resume_key(mir_node_idx), resume.name, "ptr")
      return LowerStepR(bs, insts)
    MirNode::MirIterHasNext(iter, type_idx):
      let done_at: FreshR = bs_fresh_value(bs)
      bs = done_at.bs
      insts = insts.push(LlInst(LlInstKind::LlGepField(ptr_text = bs_get_value_text(bs, iter), struct_ty_text = bs_frame_view(bs, iter), field_index = to_i64(1)), done_at.name))
      let done: FreshR = bs_fresh_value(bs)
      bs = done.bs
      insts = insts.push(LlInst(LlInstKind::LlLoad(ptr_name = done_at.name, ty_text = "i1"), done.name))
      let has_next: FreshR = bs_fresh_value(bs)
      bs = has_next.bs
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "xor i1 " + done.name + ", true"), has_next.name))
      bs = bs_set_value(bs, mir_node_idx, has_next.name, "i1")
      return LowerStepR(bs, insts)
    MirNode::MirIterNext(iter, type_idx):
      // The value in the yield slot, then a resume to the next yield.
      let slot_at: FreshR = bs_fresh_value(bs)
      bs = slot_at.bs
      insts = insts.push(LlInst(LlInstKind::LlGepField(ptr_text = bs_get_value_text(bs, iter), struct_ty_text = bs_frame_view(bs, iter), field_index = to_i64(2)), slot_at.name))
      let elem_ty: string = bs_ty(bs, type_idx)
      let got: FreshR = bs_fresh_value(bs)
      bs = got.bs
      insts = insts.push(LlInst(LlInstKind::LlLoad(ptr_name = slot_at.name, ty_text = elem_ty), got.name))
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "call void " + bs_get_value_text(bs, bs_resume_key(iter)) + "(ptr " + bs_get_value_text(bs, iter) + ")"), ""))
      bs = bs_set_value(bs, mir_node_idx, got.name, elem_ty)
      return LowerStepR(bs, insts)
    MirNode::MirIterDestroy(iter):
      let one_ptr: Vector<string> = Vector<string>::new()
      bs = bs_declare_hook(bs, "@__dao_gen_free", "void", one_ptr.push("ptr"))
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "call void @__dao_gen_free(ptr " + bs_get_value_text(bs, iter) + ")"), ""))
      return LowerStepR(bs, insts)

    // ---------- regions ----------
    MirNode::MirModeEnter(name_tok):
      // `mode unsafe` gates what the checker accepts; it emits nothing
      // (the host's).  Any other mode has no lowering yet.
      if bs_tok_lex(bs, name_tok) != "unsafe":
        bs = bs_error(bs, "mode '" + bs_tok_lex(bs, name_tok) + "' lowering not yet supported")
      return LowerStepR(bs, insts)
    MirNode::MirModeExit(name_tok):
      return LowerStepR(bs, insts)
    MirNode::MirResourceEnter(kind_tok, name_tok):
      // A memory domain is the runtime's (runtime/core/dao_abi.h).
      if bs_tok_lex(bs, kind_tok) != "memory":
        bs = bs_error(bs, "resource '" + bs_tok_lex(bs, kind_tok) + "' lowering not yet supported")
        return LowerStepR(bs, insts)
      bs = bs_declare_hook(bs, "@__dao_mem_resource_enter", "ptr", Vector<string>::new())
      let domain: FreshR = bs_fresh_value(bs)
      bs = domain.bs
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "call ptr @__dao_mem_resource_enter()"), domain.name))
      bs = bs_set_value(bs, mir_node_idx, domain.name, "ptr")
      return LowerStepR(bs, insts)
    MirNode::MirResourceExit(kind_tok, name_tok, handle):
      if bs_tok_lex(bs, kind_tok) != "memory":
        return LowerStepR(bs, insts)
      let one_ptr: Vector<string> = Vector<string>::new()
      bs = bs_declare_hook(bs, "@__dao_mem_resource_exit", "void", one_ptr.push("ptr"))
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "call void @__dao_mem_resource_exit(ptr " + bs_get_value_text(bs, handle) + ")"), ""))
      return LowerStepR(bs, insts)

    // ---------- pointers (the host's lower_ptr_op) ----------
    MirNode::MirPtrOp(op, pointer, argument, type_idx):
      if op == ptr_op_new():
        bs = bs_set_value(bs, mir_node_idx, "null", "ptr")
        return LowerStepR(bs, insts)
      if op == ptr_op_cast():
        // Opaque pointers carry no pointee: the cast is the value itself.
        bs = bs_set_value(bs, mir_node_idx, bs_get_value_text(bs, pointer), "ptr")
        return LowerStepR(bs, insts)
      if op == ptr_op_is_null():
        let is_null: FreshR = bs_fresh_value(bs)
        bs = is_null.bs
        insts = insts.push(LlInst(LlInstKind::LlText(rhs = "icmp eq ptr " + bs_get_value_text(bs, pointer) + ", null"), is_null.name))
        bs = bs_set_value(bs, mir_node_idx, is_null.name, "i1")
        return LowerStepR(bs, insts)
      if op == ptr_op_offset():
        let pointee: i64 = to_i64(-1)
        if type_idx >= 0 and type_idx < bs.types.length():
          pointee = bs.types.get(type_idx).pointee
        let element: string = bs_ty(bs, pointee)
        if element == "void":
          bs = bs_error(bs, "Ptr.offset is invalid on 'Ptr<void>', which has no element size")
          return LowerStepR(bs, insts)
        match ll_type_of(bs, pointee):
          LlType::LlStruct:
            bs = bs_ensure_struct_def(bs, pointee)
        let walked: FreshR = bs_fresh_value(bs)
        bs = walked.bs
        insts = insts.push(LlInst(LlInstKind::LlText(rhs = "getelementptr " + element + ", ptr " + bs_get_value_text(bs, pointer) + ", " + bs_get_value_ty(bs, argument) + " " + bs_get_value_text(bs, argument)), walked.name))
        bs = bs_set_value(bs, mir_node_idx, walked.name, "ptr")
        return LowerStepR(bs, insts)
      bs = bs_error(bs, "bootstrap llvm backend: Ptr.get / Ptr.set reach the backend as load / store")
      return LowerStepR(bs, insts)

    // ---------- enums (the host's lower_enum_*) ----------
    MirNode::MirEnumConstruct(variant, arg_list_lp, arg_count, type_idx):
      // Built in memory: the tag at field 0, the variant's payload as its
      // own struct over the payload slots at field 1, then loaded whole.
      bs = bs_ensure_struct_def(bs, type_idx)
      let enum_ty: string = bs_ty(bs, type_idx)
      let tmp: FreshR = bs_fresh_named(bs, "enum.tmp")
      bs = tmp.bs
      bs.entry_allocas = bs.entry_allocas.push(LlInst(LlInstKind::LlAlloca(ty_text = enum_ty), tmp.name))
      let tag_at: FreshR = bs_fresh_value(bs)
      bs = tag_at.bs
      insts = insts.push(LlInst(LlInstKind::LlGepField(ptr_text = tmp.name, struct_ty_text = enum_ty, field_index = to_i64(0)), tag_at.name))
      insts = insts.push(LlInst(LlInstKind::LlStore(ptr_name = tag_at.name, value_text = i64_to_string(variant), value_ty_text = "i32"), ""))
      let payload_ty: string = bs_payload_struct(bs, type_idx, variant)
      let payload_at: FreshR = bs_fresh_value(bs)
      bs = payload_at.bs
      insts = insts.push(LlInst(LlInstKind::LlGepField(ptr_text = tmp.name, struct_ty_text = enum_ty, field_index = to_i64(1)), payload_at.name))
      let values: Vector<i64> = read_mir_list(bs.mir_idx, arg_list_lp)
      let vi: i64 = to_i64(0)
      while vi < values.length():
        let field_at: FreshR = bs_fresh_value(bs)
        bs = field_at.bs
        insts = insts.push(LlInst(LlInstKind::LlGepField(ptr_text = payload_at.name, struct_ty_text = payload_ty, field_index = vi), field_at.name))
        insts = insts.push(LlInst(LlInstKind::LlStore(ptr_name = field_at.name, value_text = bs_get_value_text(bs, values.get(vi)), value_ty_text = bs_get_value_ty(bs, values.get(vi))), ""))
        vi = vi + to_i64(1)
      let whole: FreshR = bs_fresh_value(bs)
      bs = whole.bs
      insts = insts.push(LlInst(LlInstKind::LlLoad(ptr_name = tmp.name, ty_text = enum_ty), whole.name))
      bs = bs_set_value(bs, mir_node_idx, whole.name, enum_ty)
      return LowerStepR(bs, insts)

    MirNode::MirEnumDiscriminant(value, type_idx):
      // A classification enum's value is its tag; a payload-bearing
      // one's tag is field 0.
      if bs_get_value_ty(bs, value) == "i32":
        bs = bs_set_value(bs, mir_node_idx, bs_get_value_text(bs, value), "i32")
        return LowerStepR(bs, insts)
      let tag: FreshR = bs_fresh_value(bs)
      bs = tag.bs
      insts = insts.push(LlInst(LlInstKind::LlExtractValue(agg_text = bs_get_value_text(bs, value), agg_ty_text = bs_get_value_ty(bs, value), field_index = to_i64(0)), tag.name))
      bs = bs_set_value(bs, mir_node_idx, tag.name, "i32")
      return LowerStepR(bs, insts)

    MirNode::MirEnumPayload(value, variant, field, type_idx):
      // Stored, then read through the variant's payload struct.
      let enum_ty: string = bs_get_value_ty(bs, value)
      let enum_ti: i64 = bs_value_enum_type(bs, value)
      let tmp: FreshR = bs_fresh_named(bs, "enum.ext")
      bs = tmp.bs
      bs.entry_allocas = bs.entry_allocas.push(LlInst(LlInstKind::LlAlloca(ty_text = enum_ty), tmp.name))
      insts = insts.push(LlInst(LlInstKind::LlStore(ptr_name = tmp.name, value_text = bs_get_value_text(bs, value), value_ty_text = enum_ty), ""))
      let payload_at: FreshR = bs_fresh_value(bs)
      bs = payload_at.bs
      insts = insts.push(LlInst(LlInstKind::LlGepField(ptr_text = tmp.name, struct_ty_text = enum_ty, field_index = to_i64(1)), payload_at.name))
      let field_at: FreshR = bs_fresh_value(bs)
      bs = field_at.bs
      insts = insts.push(LlInst(LlInstKind::LlGepField(ptr_text = payload_at.name, struct_ty_text = bs_payload_struct(bs, enum_ti, variant), field_index = field), field_at.name))
      let read: FreshR = bs_fresh_value(bs)
      bs = read.bs
      let field_ty: string = bs_ty(bs, type_idx)
      insts = insts.push(LlInst(LlInstKind::LlLoad(ptr_name = field_at.name, ty_text = field_ty), read.name))
      bs = bs_set_value(bs, mir_node_idx, read.name, field_ty)
      return LowerStepR(bs, insts)
  // An instruction with no lowering here fails the module rather than
  // vanishing from it.
  bs = bs_error(bs, "bootstrap llvm backend: unsupported MIR instruction " + mir_node_kind(node))
  return LowerStepR(bs, insts)

// A binary operator as the host lowers it (lower_binary): strings
// through the runtime; floats IEEE; unsigned integers by the unsigned
// forms; signed `+ - *` checked, trapping on overflow.
fn bs_lower_binary(bs: BS, insts: Vector<LlInst>, mir_node_idx: i64, op: string, lhs: i64, rhs: i64): LowerStepR
  let lhs_text: string = bs_get_value_text(bs, lhs)
  let rhs_text: string = bs_get_value_text(bs, rhs)
  let ty_text: string = bs_get_value_ty(bs, lhs)
  let operand_ti: i64 = mir_value_type(bs.mir_nodes, lhs)
  let unsigned: bool = ll_is_unsigned(bs.types, operand_ti)
  let is_float: bool = ty_text == "float" or ty_text == "double"
  if ty_text == "%dao.string":
    return bs_lower_string_binary(bs, insts, mir_node_idx, op, lhs_text, rhs_text)
  // Comparisons.
  let pred: string = ll_cmp_pred(op, is_float, unsigned)
  if pred != "":
    let result: FreshR = bs_fresh_value(bs)
    bs = result.bs
    let cmp: string = "icmp "
    if is_float:
      cmp = "fcmp "
    insts = insts.push(LlInst(LlInstKind::LlText(rhs = cmp + pred + " " + ty_text + " " + lhs_text + ", " + rhs_text), result.name))
    bs = bs_set_value(bs, mir_node_idx, result.name, "i1")
    return LowerStepR(bs, insts)
  // Signed + - * are checked.
  if is_float == false and unsigned == false and ty_text != "i1":
    let intrinsic: string = ""
    if op == "Plus":
      intrinsic = "sadd"
    if op == "Minus":
      intrinsic = "ssub"
    if op == "Star":
      intrinsic = "smul"
    if intrinsic != "":
      return bs_checked_op(bs, insts, mir_node_idx, intrinsic, ty_text, lhs_text, rhs_text)
  let instr: string = ll_arith_instr(op, is_float, unsigned)
  if instr == "":
    bs = bs_error(bs, "bootstrap llvm backend: unsupported binary op " + op + " on " + ty_text)
    return LowerStepR(bs, insts)
  let result: FreshR = bs_fresh_value(bs)
  bs = result.bs
  insts = insts.push(LlInst(LlInstKind::LlText(rhs = instr + " " + ty_text + " " + lhs_text + ", " + rhs_text), result.name))
  bs = bs_set_value(bs, mir_node_idx, result.name, ty_text)
  return LowerStepR(bs, insts)

// `@llvm.<op>.with.overflow`: the result, and a branch to a trap when it
// overflowed (the host's emit_checked_signed_op).  The trap and the
// continuation are labels inside the current block's instruction list.
fn bs_checked_op(bs: BS, insts: Vector<LlInst>, mir_node_idx: i64, op: string, ty: string, lhs: string, rhs: string): LowerStepR
  let intrinsic: string = "@llvm." + op + ".with.overflow." + ty
  let two: Vector<string> = Vector<string>::new()
  two = two.push(ty)
  two = two.push(ty)
  bs = bs_declare_hook(bs, intrinsic, "{ " + ty + ", i1 }", two)
  bs = bs_declare_hook(bs, "@llvm.trap", "void", Vector<string>::new())
  let pair: FreshR = bs_fresh_value(bs)
  bs = pair.bs
  insts = insts.push(LlInst(LlInstKind::LlText(rhs = "call { " + ty + ", i1 } " + intrinsic + "(" + ty + " " + lhs + ", " + ty + " " + rhs + ")"), pair.name))
  let value: FreshR = bs_fresh_value(bs)
  bs = value.bs
  let result: string = value.name
  insts = insts.push(LlInst(LlInstKind::LlText(rhs = "extractvalue { " + ty + ", i1 } " + pair.name + ", 0"), result))
  let over: FreshR = bs_fresh_value(bs)
  bs = over.bs
  insts = insts.push(LlInst(LlInstKind::LlText(rhs = "extractvalue { " + ty + ", i1 } " + pair.name + ", 1"), over.name))
  // Labels take no value number (LLVM numbers unnamed values without gaps).
  let n: string = i64_to_string(bs.next_global)
  bs.next_global = bs.next_global + to_i64(1)
  insts = insts.push(LlInst(LlInstKind::LlText(rhs = "br i1 " + over.name + ", label %overflow.trap." + n + ", label %overflow.cont." + n), ""))
  insts = insts.push(LlInst(LlInstKind::LlText(rhs = "overflow.trap." + n + ":"), ""))
  insts = insts.push(LlInst(LlInstKind::LlText(rhs = "call void @llvm.trap()"), ""))
  insts = insts.push(LlInst(LlInstKind::LlText(rhs = "unreachable"), ""))
  insts = insts.push(LlInst(LlInstKind::LlText(rhs = "overflow.cont." + n + ":"), ""))
  bs = bs_set_value(bs, mir_node_idx, result, ty)
  return LowerStepR(bs, insts)

// `==` / `!=` on strings through __dao_eq_string, `+` through
// __dao_str_concat; both take their strings by pointer.
fn bs_lower_string_binary(bs: BS, insts: Vector<LlInst>, mir_node_idx: i64, op: string, lhs: string, rhs: string): LowerStepR
  let at_l: FreshR = bs_fresh_named(bs, "str.lhs")
  bs = at_l.bs
  let at_r: FreshR = bs_fresh_named(bs, "str.rhs")
  bs = at_r.bs
  bs.entry_allocas = bs.entry_allocas.push(LlInst(LlInstKind::LlAlloca(ty_text = "%dao.string"), at_l.name))
  bs.entry_allocas = bs.entry_allocas.push(LlInst(LlInstKind::LlAlloca(ty_text = "%dao.string"), at_r.name))
  insts = insts.push(LlInst(LlInstKind::LlStore(ptr_name = at_l.name, value_text = lhs, value_ty_text = "%dao.string"), ""))
  insts = insts.push(LlInst(LlInstKind::LlStore(ptr_name = at_r.name, value_text = rhs, value_ty_text = "%dao.string"), ""))
  let two_ptrs: Vector<string> = Vector<string>::new()
  two_ptrs = two_ptrs.push("ptr")
  two_ptrs = two_ptrs.push("ptr")
  let result: FreshR = bs_fresh_value(bs)
  bs = result.bs
  if op == "Plus":
    bs = bs_declare_hook(bs, "@__dao_str_concat", "%dao.string", two_ptrs)
    insts = insts.push(LlInst(LlInstKind::LlText(rhs = "call %dao.string @__dao_str_concat(ptr " + at_l.name + ", ptr " + at_r.name + ")"), result.name))
    bs = bs_set_value(bs, mir_node_idx, result.name, "%dao.string")
    return LowerStepR(bs, insts)
  if op == "EqEq" or op == "BangEq":
    bs = bs_declare_hook(bs, "@__dao_eq_string", "i1", two_ptrs)
    insts = insts.push(LlInst(LlInstKind::LlText(rhs = "call i1 @__dao_eq_string(ptr " + at_l.name + ", ptr " + at_r.name + ")"), result.name))
    if op == "BangEq":
      let negated: FreshR = bs_fresh_value(bs)
      bs = negated.bs
      insts = insts.push(LlInst(LlInstKind::LlText(rhs = "xor i1 " + result.name + ", true"), negated.name))
      bs = bs_set_value(bs, mir_node_idx, negated.name, "i1")
      return LowerStepR(bs, insts)
    bs = bs_set_value(bs, mir_node_idx, result.name, "i1")
    return LowerStepR(bs, insts)
  bs = bs_error(bs, "unsupported operator on string type")
  return LowerStepR(bs, insts)

// Whether the Dao type at `ti` is an unsigned integer (u8..u64).
fn ll_is_unsigned(types: Vector<DaoType>, ti: i64): bool
  if ti < 0 or ti >= types.length():
    return false
  let t: DaoType = types.get(ti)
  match t.kind:
    TypeKind::TBuiltin:
      return t.builtin_id >= to_i64(4) and t.builtin_id <= to_i64(7)
  return false

// A comparison's predicate (the host's: IEEE `une` for `!=` on floats),
// or "" for an operator that is no comparison.
fn ll_cmp_pred(op: string, is_float: bool, unsigned: bool): string
  if is_float:
    if op == "EqEq":
      return "oeq"
    if op == "BangEq":
      return "une"
    if op == "Lt":
      return "olt"
    if op == "LtEq":
      return "ole"
    if op == "Gt":
      return "ogt"
    if op == "GtEq":
      return "oge"
    return ""
  if op == "EqEq":
    return "eq"
  if op == "BangEq":
    return "ne"
  let sign: string = "s"
  if unsigned:
    sign = "u"
  if op == "Lt":
    return sign + "lt"
  if op == "LtEq":
    return sign + "le"
  if op == "Gt":
    return sign + "gt"
  if op == "GtEq":
    return sign + "ge"
  return ""

// The instruction of an arithmetic or logical operator, "" for none.
fn ll_arith_instr(op: string, is_float: bool, unsigned: bool): string
  if is_float:
    if op == "Plus":
      return "fadd"
    if op == "Minus":
      return "fsub"
    if op == "Star":
      return "fmul"
    if op == "Slash":
      return "fdiv"
    if op == "Percent":
      return "frem"
    return ""
  if op == "Plus":
    return "add"
  if op == "Minus":
    return "sub"
  if op == "Star":
    return "mul"
  if op == "KwAnd":
    return "and"
  if op == "KwOr":
    return "or"
  if unsigned:
    if op == "Slash":
      return "udiv"
    if op == "Percent":
      return "urem"
    return ""
  if op == "Slash":
    return "sdiv"
  if op == "Percent":
    return "srem"
  return ""

// The value-table key under which an iterator's resume function is kept
// beside its frame: negative, so it is no MIR node's.
fn bs_resume_key(iter_node: i64): i64
  return to_i64(-2) - iter_node

// The consumer's view of a generator frame's header, `{ i32 state,
// i1 done, T yield_slot }`, for the iterator made at `iter`.
fn bs_frame_view(bs: BS, iter: i64): string
  let gen_ti: i64 = mir_value_type(bs.mir_nodes, iter)
  let elem: i64 = to_i64(-1)
  if gen_ti >= 0 and gen_ti < bs.types.length():
    elem = bs.types.get(gen_ti).pointee
  return "{ i32, i1, " + bs_ty(bs, elem) + " }"

// Declare a runtime hook once, with its canonical signature (the host's
// llvm_runtime_hooks).
fn bs_declare_hook(bs: BS, name: string, ret_ty: string, param_tys: Vector<string>): BS
  if bs_has_extern(bs, name):
    return bs
  let params: Vector<LlParam> = Vector<LlParam>::new()
  let i: i64 = to_i64(0)
  while i < param_tys.length():
    params = params.push(LlParam("%arg" + i64_to_string(i), param_tys.get(i)))
    i = i + to_i64(1)
  bs.extern_decls = bs.extern_decls.push(LlFunction(name, ret_ty, params, Vector<LlBlock>::new(), to_i64(1)))
  return bs_mark_extern(bs, name)

// "size_of" / "align_of" when the callee is a specialization of that
// prelude intrinsic; "" otherwise.
fn bs_intrinsic_of(bs: BS, callee: i64): string
  match bs.mir_nodes.get(callee):
    MirNode::MirFnRef(sym, ti):
      if sym >= 0 and sym < bs.symbols.length():
        let name: string = bs.symbols.get(sym).name
        if index_of(name, "size_of$") == to_i64(0):
          return "size_of"
        if index_of(name, "align_of$") == to_i64(0):
          return "align_of"
  return ""

// The literal struct type of one variant's payload: `{ T0, T1, ... }`.
fn bs_payload_struct(bs: BS, enum_ti: i64, variant: i64): string
  let out: string = "{ "
  if enum_ti >= 0 and enum_ti < bs.types.length():
    let t: DaoType = bs.types.get(enum_ti)
    let at: i64 = t.info_lp
    let vi: i64 = to_i64(0)
    while vi < t.info_count:
      let count: i64 = bs.type_info.get(at + to_i64(1))
      if vi == variant:
        let pi: i64 = to_i64(0)
        while pi < count:
          if pi > to_i64(0):
            out = out + ", "
          out = out + bs_ty(bs, bs.type_info.get(at + to_i64(2) + pi * to_i64(2) + to_i64(1)))
          pi = pi + to_i64(1)
      at = at + to_i64(2) + count * to_i64(2)
      vi = vi + to_i64(1)
  return out + " }"

// The Dao enum type of a value an instruction produced (MIR types it).
fn bs_value_enum_type(bs: BS, value: i64): i64
  return mir_value_type(bs.mir_nodes, value)

// =========================================================================
// Section 88b: Helpers pulled out of instruction lowering
// =========================================================================

// Reverse of ll_type_text — used when we've stashed a type as text
// and need to resolve back to LlType for a new instruction.
fn ll_type_text_to_lltype(t: string): LlType
  if t == "i32":
    return LlType::LlI32
  if t == "i64":
    return LlType::LlI64
  if t == "float":
    return LlType::LlF32
  if t == "double":
    return LlType::LlF64
  if t == "i1":
    return LlType::LlI1
  if t == "void":
    return LlType::LlVoid
  if t == "ptr":
    return LlType::LlPtr
  return LlType::LlUnsupported

// Call argument bundles live in a side table on BS because
// LlInstKind::LlCall stores only an index into the bundle list,
// and Dao's enum-class variants cannot hold Vector<string> directly
// without additional boxing overhead.  Indexing is deterministic.
class CallArgs:
  arg_texts: Vector<string>
  arg_ty_texts: Vector<string>

// Decode a Dao string literal token (with surrounding quotes) into:
//   (1) the LLVM IR c"..." payload (with LLVM-style hex escapes for
//       non-printable bytes and literal backslashes / quotes), and
//   (2) the decoded byte count (for the [N x i8] array length,
//       including the trailing NUL).
//
// Dao escape sequences per spec/grammar/dao.lex and
// compiler/frontend/lexer/lexer_test.cpp:
//   \\  →  backslash    (1 byte)
//   \"  →  double quote (1 byte)
//   \n  →  newline      (1 byte)
//   \t  →  tab          (1 byte)
//   \r  →  carriage ret (1 byte)
//   \0  →  NUL          (1 byte)
//
// LLVM IR c"..." escaping: non-printable bytes use \XX hex;
// literal backslash is \5C; literal double-quote is \22.

class StrDecode:
  llvm_payload: string    // ready for c"...\00" wrapping
  byte_count: i64         // decoded byte count INCLUDING trailing NUL

fn decode_string_literal(raw: string): StrDecode
  let n: i64 = length(raw)
  // Strip surrounding quotes.
  let start: i64 = to_i64(0)
  let end: i64 = n
  if n >= to_i64(2):
    if substring(raw, to_i64(0), to_i64(1)) == "\"":
      if substring(raw, n - to_i64(1), to_i64(1)) == "\"":
        start = to_i64(1)
        end = n - to_i64(1)
  let out: Builder = Builder::new()
  let bytes: i64 = to_i64(0)
  let i: i64 = start
  while i < end:
    let ch: string = substring(raw, i, to_i64(1))
    if ch == "\\":
      // Escape sequence — peek at next char.
      if i + to_i64(1) < end:
        let esc: string = substring(raw, i + to_i64(1), to_i64(1))
        if esc == "\\":
          out = out.push("\\5C")
          bytes = bytes + to_i64(1)
          i = i + to_i64(2)
        else:
          if esc == "\"":
            out = out.push("\\22")
            bytes = bytes + to_i64(1)
            i = i + to_i64(2)
          else:
            if esc == "n":
              out = out.push("\\0A")
              bytes = bytes + to_i64(1)
              i = i + to_i64(2)
            else:
              if esc == "t":
                out = out.push("\\09")
                bytes = bytes + to_i64(1)
                i = i + to_i64(2)
              else:
                if esc == "r":
                  out = out.push("\\0D")
                  bytes = bytes + to_i64(1)
                  i = i + to_i64(2)
                else:
                  if esc == "0":
                    out = out.push("\\00")
                    bytes = bytes + to_i64(1)
                    i = i + to_i64(2)
                  else:
                    // Unknown escape — emit literal backslash + char.
                    out = out.push("\\5C" + esc)
                    bytes = bytes + to_i64(2)
                    i = i + to_i64(2)
      else:
        // Trailing lone backslash — emit as hex.
        out = out.push("\\5C")
        bytes = bytes + to_i64(1)
        i = i + to_i64(1)
    else:
      if ch == "\"":
        // Unescaped quote inside — hex-escape for LLVM.
        out = out.push("\\22")
        bytes = bytes + to_i64(1)
        i = i + to_i64(1)
      else:
        out = out.push(ch)
        bytes = bytes + to_i64(1)
        i = i + to_i64(1)
  // +1 for trailing NUL.
  return StrDecode(out.to_string(), bytes + to_i64(1))

// Check whether an LlInst is a terminator (ret / br / cond_br).
fn ll_inst_is_unreachable(inst: LlInst): bool
  match inst.kind:
    LlInstKind::LlUnreachable:
      return true
  return false

// The blocks one block branches to.
fn mir_block_targets(bs: BS, block_node_idx: i64): Vector<i64>
  let targets: Vector<i64> = Vector<i64>::new()
  let mb: MirNode = bs.mir_nodes.get(block_node_idx)
  match mb:
    MirNode::MirBlock(block_id, inst_list_lp, inst_count):
      let insts_raw: Vector<i64> = read_mir_list(bs.mir_idx, inst_list_lp)
      let ii: i64 = to_i64(0)
      while ii < insts_raw.length():
        let inst: MirNode = bs.mir_nodes.get(insts_raw.get(ii))
        match inst:
          MirNode::MirBr(target_block):
            targets = targets.push(target_block)
          MirNode::MirCondBr(cond, then_block, else_block):
            targets = targets.push(then_block)
            targets = targets.push(else_block)
        ii = ii + to_i64(1)
  return targets

// The blocks a path from the entry block reaches, by walking branches
// transitively.  Being a branch target is not enough: a merge block no
// path reaches can still branch on to the next merge block (nested
// if/else whose arms all return), and that target is dead too.
//
// Size bound: MIR opens a block per arm and merge point of a
// function's `if`/`while` bodies, so a function has as many blocks as
// it has branches -- tens, not thousands -- and the membership scans
// below cost blocks x edges of that size.  A scan is also what Dao's
// value semantics make cheap: Vector.set and HashMap.set copy their
// storage, so an indexed table would cost the same order and allocate
// per update besides.
fn mir_reachable_blocks(bs: BS, blocks_raw: Vector<i64>): Vector<i64>
  let reachable: Vector<i64> = Vector<i64>::new()
  if blocks_raw.length() == to_i64(0):
    return reachable
  reachable = reachable.push(blocks_raw.get(to_i64(0)))
  let next: i64 = to_i64(0)
  while next < reachable.length():
    let targets: Vector<i64> = mir_block_targets(bs, reachable.get(next))
    let ti: i64 = to_i64(0)
    while ti < targets.length():
      if i64_vector_contains(reachable, targets.get(ti)) == false:
        reachable = reachable.push(targets.get(ti))
      ti = ti + to_i64(1)
    next = next + to_i64(1)
  return reachable

fn i64_vector_contains(xs: Vector<i64>, x: i64): bool
  let i: i64 = to_i64(0)
  while i < xs.length():
    if xs.get(i) == x:
      return true
    i = i + to_i64(1)
  return false

fn ll_inst_is_terminator(inst: LlInst): bool
  match inst.kind:
    LlInstKind::LlRet(v, t, h):
      return true
    LlInstKind::LlBr(target):
      return true
    LlInstKind::LlCondBr(c, tl, el):
      return true
    LlInstKind::LlUnreachable:
      return true
  return false

// =========================================================================
// Section 89: Function lowering (prologue + blocks)
// =========================================================================

fn bs_lower_function(bs: BS, mir_fn_idx: i64): BS
  let node: MirNode = bs.mir_nodes.get(mir_fn_idx)
  match node:
    MirNode::MirFunction(fn_sym, ret_type, param_count, local_list_lp, local_count, block_list_lp, block_count, is_extern_i):
      bs = bs_reset_fn_state(bs)

      let name: string = mangle_function_sym(bs.symbols, fn_sym)
      if name == "":
        bs = bs_error(bs, "bootstrap llvm backend cannot mangle anonymous symbol")
        return bs

      let ret_ty: LlType = ll_type_of(bs, ret_type)
      bs = bs_check_supported_type(bs, ret_ty, "function return type")
      let ret_ty_text: string = bs_ty(bs, ret_type)
      // Register struct def if the return type is a struct.
      match ret_ty:
        LlType::LlStruct:
          bs = bs_ensure_struct_def(bs, ret_type)

      // Read the local node list.  First `param_count` are params.
      let locals_raw: Vector<i64> = read_mir_list(bs.mir_idx, local_list_lp)

      // Declare param LlParams for the LlFunction signature.
      let params_r: ParamsR = bs_lower_params(bs, locals_raw, param_count)
      bs = params_r.bs
      let params: Vector<LlParam> = params_r.params

      // Extern declarations: no body, no blocks.
      if is_extern_i > to_i64(0):
        if bs_has_extern(bs, name):
          return bs
        let llfn: LlFunction = LlFunction(
          name, ret_ty_text, params, Vector<LlBlock>::new(), to_i64(1))
        bs.extern_decls = bs.extern_decls.push(llfn)
        bs = bs_mark_extern(bs, name)
        return bs

      // A generator lowers to its init and resume functions.
      if ret_type >= 0 and ret_type < bs.types.length():
        match bs.types.get(ret_type).kind:
          TypeKind::TGenerator:
            return bs_lower_generator(bs, name, fn_sym, ret_type, params, param_count, locals_raw, block_list_lp)

      // ----- normal function body -----

      // Pre-assign slot names for every MirLocal in declaration order
      // so MirLoad/MirStore (which reference slot *indices*, not node
      // indices) resolve deterministically.  Slot index `i` maps to
      // `%slotI` with the local's declared type.
      let li: i64 = to_i64(0)
      while li < locals_raw.length():
        let local_node_idx: i64 = locals_raw.get(li)
        let ln: MirNode = bs.mir_nodes.get(local_node_idx)
        match ln:
          MirNode::MirLocal(lsym, ltype_idx, lis_param):
            let slot_name: string = "%slot" + i64_to_string(li)
            let slot_ty: LlType = ll_type_of(bs, ltype_idx)
            bs = bs_check_supported_type(bs, slot_ty, "local slot")
            // Use bs_type_text for struct-aware type names.
            let slot_ty_text: string = bs_ty(bs, ltype_idx)
            // Register struct defs for struct-typed locals.
            match slot_ty:
              LlType::LlStruct:
                bs = bs_ensure_struct_def(bs, ltype_idx)
            bs = bs_set_slot(bs, local_node_idx, slot_name, slot_ty_text)
        li = li + to_i64(1)

      // Pre-assign block labels (MirBlock node idx → "entry"/"bbN").
      let blocks_raw: Vector<i64> = read_mir_list(bs.mir_idx, block_list_lp)
      let bi: i64 = to_i64(0)
      while bi < blocks_raw.length():
        let block_node_idx: i64 = blocks_raw.get(bi)
        let label: string = "entry"
        if bi > to_i64(0):
          label = "bb" + i64_to_string(bi)
        bs = bs_set_block_label(bs, block_node_idx, label)
        bi = bi + to_i64(1)

      // ----- entry block prologue -----
      //
      // Alloca every local, in declaration order.  Then seed every
      // param slot from its incoming LLVM argument.  This is
      // TASK_30 §5.4 / §10.3 — the seeding is mandatory because
      // Task 29 lowers param reads to MirLoad(slot).
      let entry_insts: Vector<LlInst> = Vector<LlInst>::new()

      let ai: i64 = to_i64(0)
      while ai < locals_raw.length():
        let local_node_idx: i64 = locals_raw.get(ai)
        let slot_name: string = bs_slot_name_by_index(bs, ai)
        let slot_ty_text: string = bs_slot_ty_by_index(bs, ai)
        let slot_ty: LlType = ll_type_text_to_lltype(slot_ty_text)
        let alloca_inst: LlInst = LlInst(
          LlInstKind::LlAlloca(ty_text = slot_ty_text),
          slot_name)
        entry_insts = entry_insts.push(alloca_inst)
        ai = ai + to_i64(1)

      // Param seeding: for each MirLocal with is_param=1 (first
      // param_count slots), store the incoming %argN into %slotN.
      let pi: i64 = to_i64(0)
      while pi < param_count:
        let slot_name: string = bs_slot_name_by_index(bs, pi)
        let slot_ty_text: string = bs_slot_ty_by_index(bs, pi)
        let arg_name: string = "%arg" + i64_to_string(pi)
        // A string parameter arrives as a pointer to the string.
        if slot_ty_text == "%dao.string":
          let loaded: FreshR = bs_fresh_value(bs)
          bs = loaded.bs
          entry_insts = entry_insts.push(LlInst(LlInstKind::LlLoad(ptr_name = arg_name, ty_text = slot_ty_text), loaded.name))
          arg_name = loaded.name
        let store_inst: LlInst = LlInst(
          LlInstKind::LlStore(ptr_name = slot_name, value_text = arg_name, value_ty_text = slot_ty_text),
          "")
        entry_insts = entry_insts.push(store_inst)
        pi = pi + to_i64(1)

      // ----- lower MIR blocks -----
      //
      // First block's instructions are appended to entry_insts (so
      // the prologue lives with the body).  Subsequent blocks get
      // their own fresh LlBlock.
      let lowered: BlocksR = bs_lower_blocks(bs, blocks_raw, entry_insts, ret_ty_text, name)
      bs = lowered.bs
      let ll_blocks: Vector<LlBlock> = lowered.blocks

      // The body's extra allocas lead the entry block.
      if bs.entry_allocas.length() > to_i64(0) and ll_blocks.length() > to_i64(0):
        let entry: LlBlock = ll_blocks.get(to_i64(0))
        let led: Vector<LlInst> = bs.entry_allocas
        let ei: i64 = to_i64(0)
        while ei < entry.insts.length():
          led = led.push(entry.insts.get(ei))
          ei = ei + to_i64(1)
        ll_blocks = ll_blocks.set(to_i64(0), LlBlock(entry.label, led))
      let llfn: LlFunction = LlFunction(name, ret_ty_text, params, ll_blocks, to_i64(0))
      bs.functions = bs.functions.push(llfn)
      return bs
  return bs

// A generator, as the host lowers one (lower_generator_init / _resume):
// a frame `{ i32 state, i1 done, T yield_slot, locals... }`; `name`
// allocates it, seeds its parameters and returns the handle
// `{ frame, name.resume }`; `name.resume(frame)` runs the body from the
// frame's state to its next yield or its end, every local a field of
// the frame.
fn bs_lower_generator(bs: BS, name: string, fn_sym: i64, gen_ti: i64, params: Vector<LlParam>, param_count: i64, locals_raw: Vector<i64>, block_list_lp: i64): BS
  let base: string = bs.symbols.get(fn_sym).name
  let frame_ty: string = "%\"dao.gen." + base + "\""
  let resume_name: string = llvm_suffixed(name, ".resume")
  // The frame's type.
  let fields: Vector<string> = Vector<string>::new()
  fields = fields.push("i32")
  fields = fields.push("i1")
  fields = fields.push(bs_ty(bs, bs.types.get(gen_ti).pointee))
  let li: i64 = to_i64(0)
  while li < locals_raw.length():
    match bs.mir_nodes.get(locals_raw.get(li)):
      MirNode::MirLocal(lsym, lti, lis_param):
        match ll_type_of(bs, lti):
          LlType::LlStruct:
            bs = bs_ensure_struct_def(bs, lti)
        fields = fields.push(bs_ty(bs, lti))
    li = li + to_i64(1)
  bs.struct_defs = bs.struct_defs.push(LlStructDef("dao.gen." + base, frame_ty, fields, to_i64(-1)))
  let one_i64s: Vector<string> = Vector<string>::new()
  one_i64s = one_i64s.push("i64")
  one_i64s = one_i64s.push("i64")
  bs = bs_declare_hook(bs, "@__dao_gen_alloc", "ptr", one_i64s)

  // Init: allocate the frame, state 0, not done, parameters in place.
  let init: Vector<LlInst> = Vector<LlInst>::new()
  init = init.push(LlInst(LlInstKind::LlText(rhs = "getelementptr " + frame_ty + ", ptr null, i64 1"), "%size.at"))
  init = init.push(LlInst(LlInstKind::LlText(rhs = "ptrtoint ptr %size.at to i64"), "%size"))
  init = init.push(LlInst(LlInstKind::LlText(rhs = "getelementptr { i8, " + frame_ty + " }, ptr null, i64 0, i32 1"), "%align.at"))
  init = init.push(LlInst(LlInstKind::LlText(rhs = "ptrtoint ptr %align.at to i64"), "%align"))
  init = init.push(LlInst(LlInstKind::LlText(rhs = "call ptr @__dao_gen_alloc(i64 %size, i64 %align)"), "%frame"))
  init = init.push(LlInst(LlInstKind::LlGepField(ptr_text = "%frame", struct_ty_text = frame_ty, field_index = to_i64(0)), "%state.at"))
  init = init.push(LlInst(LlInstKind::LlStore(ptr_name = "%state.at", value_text = "0", value_ty_text = "i32"), ""))
  init = init.push(LlInst(LlInstKind::LlGepField(ptr_text = "%frame", struct_ty_text = frame_ty, field_index = to_i64(1)), "%done.at"))
  init = init.push(LlInst(LlInstKind::LlStore(ptr_name = "%done.at", value_text = "false", value_ty_text = "i1"), ""))
  let pi: i64 = to_i64(0)
  while pi < param_count:
    let field_ty: string = fields.get(to_i64(3) + pi)
    let arg: string = "%arg" + i64_to_string(pi)
    if field_ty == "%dao.string":
      // A string parameter arrives as a pointer to the string.
      init = init.push(LlInst(LlInstKind::LlLoad(ptr_name = arg, ty_text = field_ty), arg + ".val"))
      arg = arg + ".val"
    init = init.push(LlInst(LlInstKind::LlGepField(ptr_text = "%frame", struct_ty_text = frame_ty, field_index = to_i64(3) + pi), "%param.at" + i64_to_string(pi)))
    init = init.push(LlInst(LlInstKind::LlStore(ptr_name = "%param.at" + i64_to_string(pi), value_text = arg, value_ty_text = field_ty), ""))
    pi = pi + to_i64(1)
  init = init.push(LlInst(LlInstKind::LlText(rhs = "insertvalue %dao.generator undef, ptr %frame, 0"), "%handle.frame"))
  init = init.push(LlInst(LlInstKind::LlText(rhs = "insertvalue %dao.generator %handle.frame, ptr " + resume_name + ", 1"), "%handle"))
  init = init.push(LlInst(LlInstKind::LlRet(value_text = "%handle", value_ty_text = "%dao.generator", has_value = to_i64(1)), ""))
  let init_blocks: Vector<LlBlock> = Vector<LlBlock>::new()
  bs.functions = bs.functions.push(LlFunction(name, "%dao.generator", params, init_blocks.push(LlBlock("entry", init)), to_i64(0)))

  // Resume: every local a field of the frame; dispatch on the state.
  bs = bs_reset_fn_state(bs)
  bs.gen = GenCtx("%frame", frame_ty, to_i64(0))
  let entry: Vector<LlInst> = Vector<LlInst>::new()
  let lj: i64 = to_i64(0)
  while lj < locals_raw.length():
    let slot: string = "%slot" + i64_to_string(lj)
    bs = bs_set_slot(bs, locals_raw.get(lj), slot, fields.get(to_i64(3) + lj))
    entry = entry.push(LlInst(LlInstKind::LlGepField(ptr_text = "%frame", struct_ty_text = frame_ty, field_index = to_i64(3) + lj), slot))
    lj = lj + to_i64(1)
  let blocks_raw: Vector<i64> = read_mir_list(bs.mir_idx, block_list_lp)
  let bi: i64 = to_i64(0)
  let yields: i64 = to_i64(0)
  while bi < blocks_raw.length():
    bs = bs_set_block_label(bs, blocks_raw.get(bi), "bb" + i64_to_string(bi))
    match bs.mir_nodes.get(blocks_raw.get(bi)):
      MirNode::MirBlock(bid, inst_list_lp, ic):
        let insts: Vector<i64> = read_mir_list(bs.mir_idx, inst_list_lp)
        let ii: i64 = to_i64(0)
        while ii < insts.length():
          match bs.mir_nodes.get(insts.get(ii)):
            MirNode::MirYield(v):
              yields = yields + to_i64(1)
          ii = ii + to_i64(1)
    bi = bi + to_i64(1)
  entry = entry.push(LlInst(LlInstKind::LlGepField(ptr_text = "%frame", struct_ty_text = frame_ty, field_index = to_i64(0)), "%state.at"))
  entry = entry.push(LlInst(LlInstKind::LlLoad(ptr_name = "%state.at", ty_text = "i32"), "%state"))
  let cases: string = "switch i32 %state, label %gen.unreachable [ i32 0, label %bb0"
  let yi: i64 = to_i64(1)
  while yi <= yields:
    cases = cases + " i32 " + i64_to_string(yi) + ", label %resume." + i64_to_string(yi)
    yi = yi + to_i64(1)
  entry = entry.push(LlInst(LlInstKind::LlText(rhs = cases + " ]"), ""))
  let lowered: BlocksR = bs_lower_blocks(bs, blocks_raw, Vector<LlInst>::new(), "void", resume_name)
  bs = lowered.bs
  // A state no yield set: the generator is done.
  let unreachable: Vector<LlInst> = Vector<LlInst>::new()
  unreachable = unreachable.push(LlInst(LlInstKind::LlGepField(ptr_text = "%frame", struct_ty_text = frame_ty, field_index = to_i64(1)), "%done.at"))
  unreachable = unreachable.push(LlInst(LlInstKind::LlStore(ptr_name = "%done.at", value_text = "true", value_ty_text = "i1"), ""))
  unreachable = unreachable.push(LlInst(LlInstKind::LlRet(value_text = "", value_ty_text = "void", has_value = to_i64(0)), ""))
  let led: Vector<LlInst> = bs.entry_allocas
  let ei: i64 = to_i64(0)
  while ei < entry.length():
    led = led.push(entry.get(ei))
    ei = ei + to_i64(1)
  let resume_blocks: Vector<LlBlock> = Vector<LlBlock>::new()
  resume_blocks = resume_blocks.push(LlBlock("entry", led))
  let rb: i64 = to_i64(0)
  while rb < lowered.blocks.length():
    resume_blocks = resume_blocks.push(lowered.blocks.get(rb))
    rb = rb + to_i64(1)
  resume_blocks = resume_blocks.push(LlBlock("gen.unreachable", unreachable))
  let frame_param: Vector<LlParam> = Vector<LlParam>::new()
  bs.functions = bs.functions.push(LlFunction(resume_name, "void", frame_param.push(LlParam("%frame", "ptr")), resume_blocks, to_i64(0)))
  bs.gen = GenCtx("", "", to_i64(0))
  return bs

// `@name` with `suffix` appended to the name, inside its quotes if any.
fn llvm_suffixed(name: string, suffix: string): string
  if length(name) > to_i64(1) and substring(name, length(name) - to_i64(1), to_i64(1)) == "\"":
    return substring(name, to_i64(0), length(name) - to_i64(1)) + suffix + "\""
  return name + suffix

// Lower a function's MIR blocks, each into its own LlBlock labelled as
// bs_set_block_label named it; `lead` opens the first block's
// instructions (the prologue), and the first block keeps the first
// MIR block's label.
class BlocksR:
  bs: BS
  blocks: Vector<LlBlock>

fn bs_lower_blocks(bs: BS, blocks_raw: Vector<i64>, lead: Vector<LlInst>, ret_ty_text: string, name: string): BlocksR
  let entry_insts: Vector<LlInst> = lead
  let ll_blocks: Vector<LlBlock> = Vector<LlBlock>::new()

  let reachable_blocks: Vector<i64> = mir_reachable_blocks(bs, blocks_raw)
  let block_i: i64 = to_i64(0)
  while block_i < blocks_raw.length():
    let block_node_idx: i64 = blocks_raw.get(block_i)
    let mb: MirNode = bs.mir_nodes.get(block_node_idx)
    match mb:
      MirNode::MirBlock(block_id, inst_list_lp, inst_count):
        let insts_raw: Vector<i64> = read_mir_list(bs.mir_idx, inst_list_lp)
        let this_insts: Vector<LlInst> = Vector<LlInst>::new()
        if block_i == to_i64(0):
          this_insts = entry_insts
        let ii: i64 = to_i64(0)
        while ii < insts_raw.length():
          let mir_inst_idx: i64 = insts_raw.get(ii)
          let step: LowerStepR = bs_lower_inst(bs, this_insts, mir_inst_idx, ret_ty_text)
          bs = step.bs
          this_insts = step.insts
          ii = ii + to_i64(1)
        // Validate that the block ends with a terminator (TASK_30 §13).
        let label: string = bs_get_block_label(bs, block_node_idx)
        if this_insts.length() == to_i64(0):
          bs = bs_error(bs, "bootstrap llvm backend expected block terminator in block " + label)
        else:
          let last: LlInst = this_insts.get(this_insts.length() - to_i64(1))
          if ll_inst_is_terminator(last) == false:
            bs = bs_error(bs, "bootstrap llvm backend expected block terminator in block " + label)
          // An `unreachable` end is only right in a block no path
          // reaches; in a reachable block it is a non-void function
          // falling off its end.
          if ll_inst_is_unreachable(last):
            if i64_vector_contains(reachable_blocks, block_node_idx):
              bs = bs_error(bs, "bootstrap llvm backend rejects function '" + name + "': block " + label + " ends without returning a value")
        ll_blocks = ll_blocks.push(LlBlock(label, this_insts))
    block_i = block_i + to_i64(1)
  return BlocksR(bs, ll_blocks)

// =========================================================================
// Section 89b: Top-level module lowering
// =========================================================================

fn lower_mir_to_ll_module(bs: BS, root: i64): BS
  // Honor the MIR root contract: MirResult.root points at a MirModule
  // node.  Walk its concrete function list in deterministic order
  // rather than scanning the entire arena; its templates have no code
  // until an instantiation names them.
  if root < 0:
    bs = bs_error(bs, "bootstrap llvm backend: MirResult.root is negative")
    return bs
  if root >= bs.mir_nodes.length():
    bs = bs_error(bs, "bootstrap llvm backend: MirResult.root out of bounds")
    return bs
  let root_node: MirNode = bs.mir_nodes.get(root)
  match root_node:
    MirNode::MirModule(file_id, fn_list_lp, fn_count, template_list_lp, template_count):
      return bs_lower_module_fns(bs, fn_list_lp)
    MirNode::MirProgram(module_list_lp, module_count):
      // A whole program: every module's functions, each read with its
      // own module's tokens.
      let modules: Vector<i64> = read_mir_list(bs.mir_idx, module_list_lp)
      let mi: i64 = to_i64(0)
      while mi < modules.length():
        match bs.mir_nodes.get(modules.get(mi)):
          MirNode::MirModule(mfile, mfn_lp, mfn_count, mtl, mtc):
            if mfile < 0 or mfile >= bs.files.length():
              return bs_error(bs, "bootstrap llvm backend: a module's file " + i64_to_string(mfile) + " is not in the program")
            let sf: SourceFile = bs.files.get(mfile)
            bs.toks = sf.parse_output.toks
            bs.src = sf.source_text
            bs = bs_lower_module_fns(bs, mfn_lp)
        mi = mi + to_i64(1)
      return bs
  bs = bs_error(bs, "bootstrap llvm backend: MirResult.root is neither a MirProgram nor a MirModule")
  return bs

fn bs_lower_module_fns(bs: BS, fn_list_lp: i64): BS
  let fn_indices: Vector<i64> = read_mir_list(bs.mir_idx, fn_list_lp)
  let i: i64 = to_i64(0)
  while i < fn_indices.length():
    bs = bs_lower_function(bs, fn_indices.get(i))
    i = i + to_i64(1)
  return bs

// =========================================================================
// Section 90: LlModule → textual LLVM IR serialization
// =========================================================================

fn serialize_ll_type(ty: LlType): string
  return ll_type_text(ty)

fn serialize_alloca(ty_text: string): string
  return "alloca " + ty_text

fn serialize_store(ptr: string, value_text: string, ty_text: string): string
  return "store " + ty_text + " " + value_text + ", ptr " + ptr

fn serialize_load(ptr: string, ty_text: string): string
  return "load " + ty_text + ", ptr " + ptr

fn serialize_binop(op: string, lhs: string, rhs: string, ty: LlType): string
  return op + " " + serialize_ll_type(ty) + " " + lhs + ", " + rhs

fn serialize_fneg(operand: string, ty: LlType): string
  return "fneg " + serialize_ll_type(ty) + " " + operand

fn serialize_icmp(pred: string, lhs: string, rhs: string, ty: LlType): string
  return "icmp " + pred + " " + serialize_ll_type(ty) + " " + lhs + ", " + rhs

fn serialize_fcmp(pred: string, lhs: string, rhs: string, ty: LlType): string
  return "fcmp " + pred + " " + serialize_ll_type(ty) + " " + lhs + ", " + rhs

fn serialize_call(callee: string, args: CallArgs, ret_ty_text: string): string
  let out: Builder = Builder::new().push("call " + ret_ty_text + " " + callee + "(")
  let i: i64 = to_i64(0)
  while i < args.arg_texts.length():
    if i > to_i64(0):
      out = out.push(", ")
    out = out.push(args.arg_ty_texts.get(i) + " " + args.arg_texts.get(i))
    i = i + to_i64(1)
  out = out.push(")")
  return out.to_string()

fn serialize_gep_string(gname: string, length_incl_nul: i64): string
  return "getelementptr inbounds [" + i64_to_string(length_incl_nul) + " x i8], ptr " + gname + ", i64 0, i64 0"

fn serialize_ret(value_text: string, ty_text: string, has_value: i64): string
  if has_value > to_i64(0):
    return "ret " + ty_text + " " + value_text
  return "ret void"

fn serialize_br(target: string): string
  return "br label %" + target

fn serialize_cond_br(cond: string, then_label: string, else_label: string): string
  return "br i1 " + cond + ", label %" + then_label + ", label %" + else_label

fn serialize_inst(bs: BS, inst: LlInst): string
  let rhs: string = ""
  match inst.kind:
    LlInstKind::LlAlloca(ty_text):
      rhs = serialize_alloca(ty_text)
    LlInstKind::LlStore(ptr, value_text, value_ty_text):
      rhs = serialize_store(ptr, value_text, value_ty_text)
    LlInstKind::LlLoad(ptr, ty_text):
      rhs = serialize_load(ptr, ty_text)
    LlInstKind::LlBinOp(op, lhs, rhs_text, ty):
      rhs = serialize_binop(op, lhs, rhs_text, ty)
    LlInstKind::LlFNeg(operand, ty):
      rhs = serialize_fneg(operand, ty)
    LlInstKind::LlICmp(pred, lhs, rhs_text, op_ty):
      rhs = serialize_icmp(pred, lhs, rhs_text, op_ty)
    LlInstKind::LlFCmp(pred, lhs, rhs_text, op_ty):
      rhs = serialize_fcmp(pred, lhs, rhs_text, op_ty)
    LlInstKind::LlCall(callee, bundle_idx, arg_count, ret_ty_text):
      let args: CallArgs = bs.call_arg_bundles.get(bundle_idx)
      rhs = serialize_call(callee, args, ret_ty_text)
    LlInstKind::LlGepString(gname, len):
      rhs = serialize_gep_string(gname, len)
    LlInstKind::LlGepField(ptr_text, struct_ty_text, fidx):
      rhs = "getelementptr inbounds " + struct_ty_text + ", ptr " + ptr_text + ", i32 0, i32 " + i64_to_string(fidx)
    LlInstKind::LlExtractValue(agg_text, agg_ty_text, fidx):
      rhs = "extractvalue " + agg_ty_text + " " + agg_text + ", " + i64_to_string(fidx)
    LlInstKind::LlRet(value_text, ty_text, has_value):
      rhs = serialize_ret(value_text, ty_text, has_value)
    LlInstKind::LlBr(target):
      rhs = serialize_br(target)
    LlInstKind::LlCondBr(cond, then_label, else_label):
      rhs = serialize_cond_br(cond, then_label, else_label)
    LlInstKind::LlUnreachable:
      rhs = "unreachable"
    LlInstKind::LlText(text):
      rhs = text
  if inst.result_name != "":
    return "  " + inst.result_name + " = " + rhs
  return "  " + rhs

fn serialize_block(bs: BS, blk: LlBlock): string
  let out: Builder = Builder::new().push(blk.label + ":\n")
  let i: i64 = to_i64(0)
  while i < blk.insts.length():
    out = out.push(serialize_inst(bs, blk.insts.get(i)) + "\n")
    i = i + to_i64(1)
  return out.to_string()

fn serialize_params(params: Vector<LlParam>): string
  let out: Builder = Builder::new()
  let i: i64 = to_i64(0)
  while i < params.length():
    if i > to_i64(0):
      out = out.push(", ")
    let p: LlParam = params.get(i)
    out = out.push(p.ty_text + " " + p.name)
    i = i + to_i64(1)
  return out.to_string()

fn serialize_function(bs: BS, llfn: LlFunction): string
  if llfn.is_extern > to_i64(0):
    return "declare " + llfn.ret_ty_text + " " + llfn.name + "(" + serialize_params(llfn.params) + ")\n"
  let out: Builder = Builder::new().push("define " + llfn.ret_ty_text + " " + llfn.name + "(" + serialize_params(llfn.params) + ") {\n")
  let i: i64 = to_i64(0)
  while i < llfn.blocks.length():
    out = out.push(serialize_block(bs, llfn.blocks.get(i)))
    i = i + to_i64(1)
  out = out.push("}\n")
  return out.to_string()

fn serialize_global(g: LlGlobal): string
  // Emit as: @.str.N = private unnamed_addr constant [LEN x i8] c"bytes\00"
  return g.name + " = private unnamed_addr constant [" + i64_to_string(g.length) + " x i8] c\"" + g.bytes + "\\00\"\n"

fn serialize_module(bs: BS): string
  let out: Builder = Builder::new()
  // The runtime's own types (runtime/core/dao_abi.h): a string, a
  // generator handle.
  out = out.push("%dao.string = type { ptr, i64 }\n%dao.generator = type { ptr, ptr }\n\n")
  // Struct type definitions first.
  let si: i64 = to_i64(0)
  while si < bs.struct_defs.length():
    let sd: LlStructDef = bs.struct_defs.get(si)
    out = out.push(sd.ll_name + " = type { ")
    let fi: i64 = to_i64(0)
    while fi < sd.field_ty_texts.length():
      if fi > to_i64(0):
        out = out.push(", ")
      out = out.push(sd.field_ty_texts.get(fi))
      fi = fi + to_i64(1)
    out = out.push(" }\n")
    si = si + to_i64(1)
  if bs.struct_defs.length() > to_i64(0):
    out = out.push("\n")
  // Globals next.
  let gi: i64 = to_i64(0)
  while gi < bs.globals.length():
    out = out.push(serialize_global(bs.globals.get(gi)))
    gi = gi + to_i64(1)
  if bs.globals.length() > to_i64(0):
    out = out.push("\n")
  // Extern declares next.
  let ei: i64 = to_i64(0)
  while ei < bs.extern_decls.length():
    out = out.push(serialize_function(bs, bs.extern_decls.get(ei)))
    ei = ei + to_i64(1)
  if bs.extern_decls.length() > to_i64(0):
    out = out.push("\n")
  // Function definitions last.
  let fi: i64 = to_i64(0)
  while fi < bs.functions.length():
    out = out.push(serialize_function(bs, bs.functions.get(fi)))
    if fi + to_i64(1) < bs.functions.length():
      out = out.push("\n")
    fi = fi + to_i64(1)
  return out.to_string()

// =========================================================================
// Section 91: Public API
// =========================================================================

fn lower_mir_to_llvm_text(input: MirBackendInput): LlvmTextResult
  let bs: BS = bs_new(input)
  // Every diagnostic of the stages before the backend travels with the
  // result; an error fails it, so a construct the checker, HIR, or MIR
  // rejected is never emitted as if it were sound.  A warning or note
  // is carried without failing the result.
  let ui: i64 = to_i64(0)
  while ui < input.mir.diags.length():
    let ud: Diagnostic = input.mir.diags.get(ui)
    bs.diags = bs.diags.push(ud)
    if ud.severity == Severity::Error:
      bs.had_error = to_i64(1)
    ui = ui + to_i64(1)
  // The module's code must be concrete: a call of a generic function
  // names a template that is never emitted.
  let template_refs: Vector<Diagnostic> = mir_template_refs(input.mir, input.symbols, input.mir.root)
  let ti: i64 = to_i64(0)
  while ti < template_refs.length():
    bs.diags = bs.diags.push(template_refs.get(ti))
    bs.had_error = to_i64(1)
    ti = ti + to_i64(1)
  // Each stage in its own domain: its scratch is reclaimed at the exit and the result is copied out.
  resource memory lowering =>
    bs = lower_mir_to_ll_module(bs, input.mir.root)
  let text: string = ""
  resource memory serializing =>
    text = serialize_module(bs)
  let ok: bool = true
  if bs.had_error > to_i64(0):
    ok = false
  return LlvmTextResult(text, bs.diags, ok)

// Convenience adapter: run the bootstrap pipeline on a bare snippet
// (same wrap/run-pipeline path as Task 29's lower_to_mir, but keep
// symbols/types/tokens/src for the backend) and then lower to LLVM
// text.  Used by tests.
fn lower_to_mir_backend_input(src: string): MirBackendInput
  let wrapped: string = wrap_test_module(src)
  let inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  inputs = inputs.push(SourceInput("test.dao", wrapped, false))
  let pg: ProgramGraph = program_graph_empty()
  resource memory graph =>
    pg = build_program(inputs)
  let p: Program = program_from_graph(pg)
  // Each stage in its own domain: its scratch is reclaimed at the exit and the result is copied out.
  resource memory resolve =>
    p = program_run_resolve(p)
  let pt: ProgramTyped = ProgramTyped(p, registry_new(p.resolve.symbols, p.graph.modules))
  resource memory typecheck =>
    pt = program_check(p)
  let pm: ProgramMir = ProgramMir(pt.program, mir_result_empty())
  resource memory mir =>
    pm = program_run_mir(pt.program)
  // Concrete before the backend sees it: every call of a generic
  // function names its specialization (Task 43).
  let pc: ProgramConcrete = ProgramConcrete(pm.program, pm.mir)
  resource memory mono =>
    pc = program_monomorphize(pt, pm)
  let r: MirResult = pc.mir
  let sf: SourceFile = program_file_of_module(pc.program, to_i64(0))
  let po: ParseOutput = sf.parse_output
  return MirBackendInput(MirResult(r.mir_nodes, r.mir_idx, r.diags, mir_only_module(r)), pc.program.resolve.symbols, pc.program.typecheck.types, pc.program.typecheck.type_info, po.toks, sf.source_text, pc.program.graph.files)

// A whole program to LLVM text: every module, checked, lowered to MIR,
// made concrete (Task 43) and lowered here, each function with its own
// module's tokens.
fn lower_program_to_llvm_text(inputs: Vector<SourceInput>): LlvmTextResult
  let pg: ProgramGraph = program_graph_empty()
  resource memory graph =>
    pg = build_program(inputs)
  let p: Program = program_from_graph(pg)
  resource memory resolve =>
    p = program_run_resolve(p)
  let pt: ProgramTyped = ProgramTyped(p, registry_new(p.resolve.symbols, p.graph.modules))
  resource memory typecheck =>
    pt = program_check(p)
  let pm: ProgramMir = ProgramMir(pt.program, mir_result_empty())
  resource memory mir =>
    pm = program_run_mir(pt.program)
  let pc: ProgramConcrete = ProgramConcrete(pm.program, pm.mir)
  resource memory mono =>
    pc = program_monomorphize(pt, pm)
  let input: MirBackendInput = MirBackendInput(pc.mir, pc.program.resolve.symbols, pc.program.typecheck.types, pc.program.typecheck.type_info, Vector<Token>::new(), "", pc.program.graph.files)
  return lower_mir_to_llvm_text(input)

fn lower_source_to_llvm_text(src: string): LlvmTextResult
  let input: MirBackendInput = lower_to_mir_backend_input(src)
  return lower_mir_to_llvm_text(input)

fn write_llvm_text(result: LlvmTextResult, path: string): bool
  return write_file(path, result.text)
