module bootstrap::parser

import bootstrap::lexer

// Canonical AST arena, parser state, and recursive-descent parser for the
// self-hosted Dao compiler pipeline.

// =========================================================================
// Section 6: AST node definitions
// =========================================================================
//
// Single arena enum with all node kinds. Children referenced by index
// into nodes vector. Variable-length children use a shared idx list.
//
// Tier B deferrals: function types (fn(T): R as a type), `where` clauses.
// (GenericParamT with its concept bounds, `derived concept`, concept,
// extend, resource, `mode` blocks, and `yield` are parsed and preserved;
// generic parameter bounds `<T: A + B>` are resolved; mode/yield are
// carried into HIR fail-closed, rejected at MIR in Tier A.)

enum class Node:
  // --- Expressions ---
  IntLitE(tok: i64)
  FloatLitE(tok: i64)
  StringLitE(tok: i64)
  BoolLitE(tok: i64)
  IdentE(tok: i64)
  QualNameE(seg_lp: i64, seg_count: i64)
  BinaryE(op: i64, left: i64, right: i64)
  UnaryE(op: i64, operand: i64)
  // `targs_on_type`: the type arguments were written on the type
  // (`Box<i32>::zero(0)`) rather than for the callee (`f<i32>(x)`).
  CallE(callee: i64, args_lp: i64, arg_count: i64, targs_lp: i64, names_lp: i64, targs_on_type: bool)
  IndexE(obj: i64, idx: i64)
  FieldE(obj: i64, field: i64)
  PipeE(left: i64, right: i64)
  TryE(operand: i64)
  LambdaE(params_lp: i64, param_count: i64, body: i64)
  ListLitE(elems_lp: i64, elem_count: i64)
  ErrorE(tok: i64)
  // --- Types ---
  NamedT(tok: i64)
  GenericT(name: i64, args_lp: i64, arg_count: i64)
  // A generic type parameter.  `bounds` is a list_pos of bound type
  // nodes (`<T: A + B>`, `<T: core::Printable>`), or -1 when the
  // parameter is unbounded.  The resolver resolves each bound as a type;
  // the type checker records the bound concepts on the parameter's
  // TGenericParam type and derives method availability from them.
  GenericParamT(tok: i64, bounds: i64)
  ErrorT(tok: i64)
  // --- Statements ---
  LetS(name: i64, typ: i64, init: i64)
  AssignS(target: i64, value: i64)
  IfS(cond: i64, then_lp: i64, else_lp: i64)
  WhileS(cond: i64, body_lp: i64)
  ResourceS(kind: i64, name: i64, body_lp: i64)
  // `mode <name> =>` block (host ModeBlock).  Parsed, preserved, and
  // carried into HIR fail-closed; lowering waits for a later task.
  ModeS(name: i64, body_lp: i64)
  // `yield <expr>` (host YieldStatement): its keyword token locates it.
  // Same fail-closed posture.
  YieldS(tok: i64, value: i64)
  ForS(var_tok: i64, iter: i64, body_lp: i64)
  ReturnS(value: i64)
  BreakS(tok: i64)
  MatchS(scrutinee: i64, arms_lp: i64)
  ExprStmtS(expr: i64)
  ErrorS(tok: i64)
  // --- Declarations ---
  FnDeclD(name: i64, tparams: i64, params: i64, ret: i64, body: i64)
  ExternFnD(name: i64, tparams: i64, params: i64, ret: i64)
  ExprFnD(name: i64, tparams: i64, params: i64, ret: i64, body: i64)
  ClassDeclD(name: i64, tparams: i64, fields: i64, methods: i64)
  EnumDeclD(name: i64, tparams: i64, variants: i64)
  TypeAliasD(name: i64, typ: i64)
  // A concept declaration.  `derived` is 1 for `derived concept` (the
  // conformance is auto-derived, host `ConceptDecl::is_derived`), 0 for a
  // plain `concept`.  The marker is preserved, never silently erased.
  ConceptDeclD(name: i64, tparams: i64, methods: i64, is_derived: i64)
  ExtendDeclD(target: i64, concept_name: i64, methods: i64)
  ErrorD(tok: i64)
  // --- Module / Import ---
  ModuleDeclN(path_lp: i64, seg_count: i64)
  ImportDeclN(path_lp: i64, seg_count: i64)
  // --- File ---
  FileN(module_decl: i64, imports_lp: i64, decls_lp: i64)

// =========================================================================
// Section 7: Parser state and result types
// =========================================================================

class PC:
  toks: Vector<lexer::Token>
  src: string

class PS:
  pos: i64
  nodes: Vector<Node>
  idx: Vector<i64>
  diags: Vector<Diagnostic>

class PR:
  ps: PS
  node: i64

fn parse_output_empty(): ParseOutput
  return ParseOutput(Vector<lexer::Token>::new(), "", Vector<Node>::new(), Vector<i64>::new(), Vector<Diagnostic>::new(), to_i64(-1))

class ParseOutput:
  toks: Vector<lexer::Token>
  src: string
  nodes: Vector<Node>
  idx: Vector<i64>
  diags: Vector<Diagnostic>
  root: i64

// =========================================================================
// Section 8: Parser state helpers
// =========================================================================

fn ps_set_pos(ps: PS, p: i64): PS
  return PS(p, ps.nodes, ps.idx, ps.diags)

fn ps_set_nodes(ps: PS, n: Vector<Node>): PS
  return PS(ps.pos, n, ps.idx, ps.diags)

fn ps_set_idx(ps: PS, ix: Vector<i64>): PS
  return PS(ps.pos, ps.nodes, ix, ps.diags)

fn ps_set_diags(ps: PS, d: Vector<Diagnostic>): PS
  return PS(ps.pos, ps.nodes, ps.idx, d)

fn tk_eq(a: lexer::TK, b: lexer::TK): bool -> lexer::tk_name(a) == lexer::tk_name(b)

fn peek_is(pc: PC, ps: PS, kind: lexer::TK): bool -> tk_eq(peek_kind(pc, ps), kind)

fn ps_advance(pc: PC, ps: PS): PS
  if ps.pos >= pc.toks.length():
    return ps
  let tok: lexer::Token = pc.toks.get(ps.pos)
  if tk_eq(tok.kind, lexer::TK::Eof):
    return ps
  return ps_set_pos(ps, ps.pos + 1)

fn ps_add_node(ps: PS, n: Node): PR
  let ni: i64 = ps.nodes.length()
  let ns: Vector<Node> = ps.nodes.push(n)
  return PR(ps_set_nodes(ps, ns), ni)

fn ps_add_diag(ps: PS, span: Span, msg: string): PS
  let d: Diagnostic = make_error(span, msg)
  return ps_set_diags(ps, ps.diags.push(d))

fn idx_push(ps: PS, val: i64): PS
  return ps_set_idx(ps, ps.idx.push(val))

fn peek_kind(pc: PC, ps: PS): lexer::TK
  if ps.pos >= pc.toks.length():
    return lexer::TK::Eof
  let tok: lexer::Token = pc.toks.get(ps.pos)
  return tok.kind

fn peek_tok(pc: PC, ps: PS): lexer::Token
  if ps.pos >= pc.toks.length():
    return lexer::Token(lexer::TK::Eof, to_i64(0), to_i64(0))
  return pc.toks.get(ps.pos)

fn at_end(pc: PC, ps: PS): bool
  return peek_is(pc, ps, lexer::TK::Eof)

fn tok_span(pc: PC, ps: PS): Span
  let tok: lexer::Token = peek_tok(pc, ps)
  return Span(tok.offset, tok.len)

fn expect(pc: PC, ps: PS, kind: lexer::TK): PS
  if peek_is(pc, ps, kind):
    return ps_advance(pc, ps)
  let sp: Span = tok_span(pc, ps)
  return ps_add_diag(ps, sp, "expected " + lexer::tk_name(kind) + ", got " + lexer::tk_name(peek_kind(pc, ps)))

fn match_tok(pc: PC, ps: PS, kind: lexer::TK): PS
  if peek_is(pc, ps, kind):
    return ps_advance(pc, ps)
  return ps

fn skip_newlines(pc: PC, ps: PS): PS
  let cur: PS = ps
  let done: bool = false
  while done == false:
    if peek_is(pc, cur, lexer::TK::Newline):
      cur = ps_advance(pc, cur)
    else:
      done = true
  return cur

// flush_list: push collected items contiguously to idx, then push count.
// Returns the list_pos (position of the count entry) and updated PS.
// This ensures list elements are contiguous even when sub-parses
// interleave their own idx entries during collection.
class FlushResult:
  ps: PS
  list_pos: i64

fn flush_list(ps: PS, items: Vector<i64>): FlushResult
  let cur: PS = ps
  let i: i64 = 0
  while i < items.length():
    cur = idx_push(cur, items.get(i))
    i = i + 1
  let lp: i64 = cur.idx.length()
  cur = idx_push(cur, items.length())
  return FlushResult(cur, lp)

// The items of the list `flush_list` wrote at `lp`: its count sits at
// `lp`, the items just before it.

fn read_list(idx_data: Vector<i64>, lp: i64): Vector<i64>
  let count: i64 = idx_data.get(lp)
  let result: Vector<i64> = Vector<i64>::new()
  let i: i64 = 0
  while i < count:
    result = result.push(idx_data.get(lp - count + i))
    i = i + 1
  return result

// flush_pairs: push collected pairs contiguously to idx, then push count.
// items contains [a0, b0, a1, b1, ...] — count is number of pairs.
fn flush_pairs(ps: PS, items: Vector<i64>, pair_count: i64): FlushResult
  let cur: PS = ps
  let i: i64 = 0
  while i < items.length():
    cur = idx_push(cur, items.get(i))
    i = i + 1
  let lp: i64 = cur.idx.length()
  cur = idx_push(cur, pair_count)
  return FlushResult(cur, lp)

fn tok_text(pc: PC, tidx: i64): string
  let tok: lexer::Token = pc.toks.get(tidx)
  if tok.len <= 0:
    return ""
  return substring(pc.src, tok.offset, tok.len)

// =========================================================================
// Section 9: Error recovery helpers
// =========================================================================

fn is_decl_sync_token(k: lexer::TK): bool
  if tk_eq(k, lexer::TK::KwFn) or tk_eq(k, lexer::TK::KwClass) or tk_eq(k, lexer::TK::KwEnum):
    return true
  if tk_eq(k, lexer::TK::KwExtern) or tk_eq(k, lexer::TK::KwType) or tk_eq(k, lexer::TK::Dedent):
    return true
  return false

fn sync_to_decl(pc: PC, ps: PS): PS
  let cur: PS = ps
  while at_end(pc, cur) == false:
    if is_decl_sync_token(peek_kind(pc, cur)):
      return cur
    cur = ps_advance(pc, cur)
  return cur

fn sync_to_stmt(pc: PC, ps: PS): PS
  let cur: PS = ps
  let done: bool = false
  while done == false:
    if at_end(pc, cur):
      done = true
    else:
      let k: lexer::TK = peek_kind(pc, cur)
      if tk_eq(k, lexer::TK::Newline):
        done = true
      else:
        if tk_eq(k, lexer::TK::Dedent):
          done = true
        else:
          cur = ps_advance(pc, cur)
  return cur

// =========================================================================
// Section 10: Type parsing
// =========================================================================

fn parse_type(pc: PC, ps: PS): PR
  // A pointer is written `Ptr<T>`, which is a generic type like any
  // other here; the type checker reads that head as the pointer it
  // names (ADR_RAW_POINTER_SURFACE.md).  The sigil it replaced is
  // reported where it stands rather than read as something else.
  if peek_is(pc, ps, lexer::TK::Star):
    let star_sp: Span = tok_span(pc, ps)
    let ps_star: PS = ps_add_diag(ps, star_sp, "'*T' is no Dao syntax; spell a pointer type 'Ptr<T>'")
    let pointee: PR = parse_type(pc, ps_advance(pc, ps_star))
    return ps_add_node(pointee.ps, Node::ErrorT(tok = ps.pos))
  return parse_named_type(pc, ps)

fn parse_named_type(pc: PC, ps: PS): PR
  if peek_is(pc, ps, lexer::TK::Identifier) == false:
    let sp: Span = tok_span(pc, ps)
    let ps2: PS = ps_add_diag(ps, sp, "expected type name")
    let ps3: PS = ps_advance(pc, ps2)
    return ps_add_node(ps3, Node::ErrorT(tok = ps.pos))

  let name_tidx: i64 = ps.pos
  let ps2: PS = ps_advance(pc, ps)

  // Check for qualified type: Name::Name (module::Type)
  if peek_is(pc, ps2, lexer::TK::ColonColon):
    // Build a QualNameE node to represent the qualified type path.
    let seg_toks: Vector<i64> = Vector<i64>::new()
    seg_toks = seg_toks.push(name_tidx)
    let cur: PS = ps2
    let qual_done: bool = false
    while qual_done == false:
      if peek_is(pc, cur, lexer::TK::ColonColon):
        cur = ps_advance(pc, cur)
        let tidx: i64 = cur.pos
        cur = expect(pc, cur, lexer::TK::Identifier)
        seg_toks = seg_toks.push(tidx)
      else:
        qual_done = true
    let seg_fl: FlushResult = flush_list(cur, seg_toks)
    return ps_add_node(seg_fl.ps, Node::QualNameE(seg_lp = seg_fl.list_pos, seg_count = seg_toks.length()))

  // Check for generic: Name<...>
  if peek_is(pc, ps2, lexer::TK::Lt):
    let ps3: PS = ps_advance(pc, ps2)
    // Parse type arguments — collect then flush for contiguity
    let collected: Vector<i64> = Vector<i64>::new()
    let first_arg: PR = parse_type(pc, ps3)
    if first_arg.node >= 0:
      collected = collected.push(first_arg.node)
      let cur: PS = first_arg.ps
      let done: bool = false
      while done == false:
        if peek_is(pc, cur, lexer::TK::Comma):
          cur = ps_advance(pc, cur)
          let arg: PR = parse_type(pc, cur)
          if arg.node >= 0:
            collected = collected.push(arg.node)
            cur = arg.ps
          else:
            cur = arg.ps
            done = true
        else:
          done = true
      let fl: FlushResult = flush_list(cur, collected)
      let ps7: PS = expect(pc, fl.ps, lexer::TK::Gt)
      return ps_add_node(ps7, Node::GenericT(name = name_tidx, args_lp = fl.list_pos, arg_count = collected.length()))
    else:
      // Error parsing first type arg
      let ps5: PS = expect(pc, first_arg.ps, lexer::TK::Gt)
      return ps_add_node(ps5, Node::ErrorT(tok = name_tidx))

  // Simple named type
  return ps_add_node(ps2, Node::NamedT(tok = name_tidx))

// =========================================================================
// Section 11: Expression parsing — precedence tower
// =========================================================================

// Primary expressions
fn parse_primary(pc: PC, ps: PS): PR
  let k: lexer::TK = peek_kind(pc, ps)

  // Integer literal
  if tk_eq(k, lexer::TK::IntLiteral):
    let tidx: i64 = ps.pos
    return ps_add_node(ps_advance(pc, ps), Node::IntLitE(tok = tidx))

  // Float literal
  if tk_eq(k, lexer::TK::FloatLiteral):
    let tidx: i64 = ps.pos
    return ps_add_node(ps_advance(pc, ps), Node::FloatLitE(tok = tidx))

  // String literal
  if tk_eq(k, lexer::TK::StringLiteral):
    let tidx: i64 = ps.pos
    return ps_add_node(ps_advance(pc, ps), Node::StringLitE(tok = tidx))

  // Bool literal true
  if tk_eq(k, lexer::TK::KwTrue):
    let tidx: i64 = ps.pos
    return ps_add_node(ps_advance(pc, ps), Node::BoolLitE(tok = tidx))

  // Bool literal false
  if tk_eq(k, lexer::TK::KwFalse):
    let tidx: i64 = ps.pos
    return ps_add_node(ps_advance(pc, ps), Node::BoolLitE(tok = tidx))

  // Parenthesized expression
  if tk_eq(k, lexer::TK::LParen):
    let ps2: PS = ps_advance(pc, ps)
    let inner: PR = parse_expr(pc, ps2)
    if inner.node < 0:
      return inner
    let ps3: PS = expect(pc, inner.ps, lexer::TK::RParen)
    return PR(ps3, inner.node)

  // List literal: [elem, ...]
  if tk_eq(k, lexer::TK::LBracket):
    return parse_list_literal(pc, ps)

  // Lambda: |params| -> body
  if tk_eq(k, lexer::TK::Pipe):
    return parse_lambda(pc, ps)

  // Identifier or qualified name
  if tk_eq(k, lexer::TK::Identifier):
    return parse_ident_or_qual(pc, ps)

  // self keyword as expression (inside method bodies)
  if tk_eq(k, lexer::TK::KwSelf):
    let self_tidx: i64 = ps.pos
    return ps_add_node(ps_advance(pc, ps), Node::IdentE(tok = self_tidx))

  // Error
  let sp: Span = tok_span(pc, ps)
  let ps2: PS = ps_add_diag(ps, sp, "expected expression")
  return ps_add_node(ps_advance(pc, ps2), Node::ErrorE(tok = ps.pos))

fn parse_list_literal(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  let collected: Vector<i64> = Vector<i64>::new()
  let cur: PS = ps2

  if peek_is(pc, cur, lexer::TK::RBracket) == false:
    let first: PR = parse_expr(pc, cur)
    if first.node >= 0:
      collected = collected.push(first.node)
      cur = first.ps
      let done: bool = false
      while done == false:
        if peek_is(pc, cur, lexer::TK::Comma):
          cur = ps_advance(pc, cur)
          let elem: PR = parse_expr(pc, cur)
          if elem.node >= 0:
            collected = collected.push(elem.node)
            cur = elem.ps
          else:
            cur = elem.ps
            done = true
        else:
          done = true
    else:
      cur = first.ps

  let fl: FlushResult = flush_list(cur, collected)
  cur = expect(pc, fl.ps, lexer::TK::RBracket)
  return ps_add_node(cur, Node::ListLitE(elems_lp = fl.list_pos, elem_count = collected.length()))

fn parse_lambda(pc: PC, ps: PS): PR
  let ps2: PS = expect(pc, ps, lexer::TK::Pipe)
  let param_toks: Vector<i64> = Vector<i64>::new()
  let cur: PS = ps2

  if peek_is(pc, cur, lexer::TK::Pipe) == false:
    // First param
    let tidx: i64 = cur.pos
    cur = expect(pc, cur, lexer::TK::Identifier)
    param_toks = param_toks.push(tidx)
    let done: bool = false
    while done == false:
      if peek_is(pc, cur, lexer::TK::Comma):
        cur = ps_advance(pc, cur)
        let tidx2: i64 = cur.pos
        cur = expect(pc, cur, lexer::TK::Identifier)
        param_toks = param_toks.push(tidx2)
      else:
        done = true

  let param_fl: FlushResult = flush_list(cur, param_toks)
  cur = expect(pc, param_fl.ps, lexer::TK::Pipe)
  cur = expect(pc, cur, lexer::TK::Arrow)
  let body: PR = parse_expr(pc, cur)
  if body.node < 0:
    return body
  return ps_add_node(body.ps, Node::LambdaE(params_lp = param_fl.list_pos, param_count = param_toks.length(), body = body.node))

fn parse_ident_or_qual(pc: PC, ps: PS): PR
  let first_tidx: i64 = ps.pos
  let ps2: PS = ps_advance(pc, ps)

  // Check for :: (qualified name)
  if peek_is(pc, ps2, lexer::TK::ColonColon) == false:
    return ps_add_node(ps2, Node::IdentE(tok = first_tidx))

  // Qualified name: ident::ident (::ident)*
  let seg_toks: Vector<i64> = Vector<i64>::new()
  seg_toks = seg_toks.push(first_tidx)
  let cur: PS = ps2
  let done: bool = false
  while done == false:
    if peek_is(pc, cur, lexer::TK::ColonColon):
      cur = ps_advance(pc, cur)
      let tidx: i64 = cur.pos
      cur = expect(pc, cur, lexer::TK::Identifier)
      seg_toks = seg_toks.push(tidx)
    else:
      done = true

  let seg_fl: FlushResult = flush_list(cur, seg_toks)
  return ps_add_node(seg_fl.ps, Node::QualNameE(seg_lp = seg_fl.list_pos, seg_count = seg_toks.length()))

// Type arguments read speculatively after a callee name: the state past
// `>` and the flushed list when accepted, else `ok` false and the state
// the caller had (a parser state is a value, so the attempt's nodes and
// diagnostics are dropped with it).
class TypeArgsResult:
  ps: PS
  list_pos: i64
  count: i64
  ok: bool

// `<Type, ..>` at `ps` is call-site type arguments only when `>` follows
// the types and `(` or `::` follows the `>` -- the host parser's rule;
// otherwise `<` is a comparison.  A type that fails to parse fails the
// attempt too, so `x < 3 > (y)` stays a comparison.
fn try_call_type_args(pc: PC, ps: PS): TypeArgsResult
  let none: TypeArgsResult = TypeArgsResult(ps, to_i64(-1), to_i64(0), false)
  let cur: PS = ps_advance(pc, ps)
  let collected: Vector<i64> = Vector<i64>::new()
  let first: PR = parse_type(pc, cur)
  collected = collected.push(first.node)
  cur = first.ps
  let more: bool = true
  while more:
    if peek_is(pc, cur, lexer::TK::Comma):
      cur = ps_advance(pc, cur)
      let arg: PR = parse_type(pc, cur)
      collected = collected.push(arg.node)
      cur = arg.ps
    else:
      more = false
  if cur.diags.length() != ps.diags.length():
    return none
  if peek_is(pc, cur, lexer::TK::Gt) == false:
    return none
  cur = ps_advance(pc, cur)
  let next: lexer::TK = peek_kind(pc, cur)
  if tk_eq(next, lexer::TK::LParen) == false and tk_eq(next, lexer::TK::ColonColon) == false:
    return none
  let fl: FlushResult = flush_list(cur, collected)
  return TypeArgsResult(fl.ps, fl.list_pos, collected.length(), true)

// Whether `node` is a member access, `obj.field`.
fn is_member(ps: PS, node: i64): bool
  match ps.nodes.get(node):
    Node::FieldE(obj, field):
      return true
  return false

// Whether `node` is a callee type arguments may follow: an identifier,
// a qualified name, or a member (`raw.cast<i64>()`, `b.map<string>(…)`).
// `<` after one is a comparison unless a type list, `>`, and a call
// follow (try_call_type_args), so `p.x < y` stays one.
fn names_callee(ps: PS, node: i64): bool
  match ps.nodes.get(node):
    Node::IdentE(t):
      return true
    Node::QualNameE(lp, n):
      return true
    Node::FieldE(obj, field):
      return true
  return false

// The qualified name `node::member`: the name's segments plus one.
fn extend_qual_name(ps: PS, node: i64, member_tidx: i64): PR
  let seg_toks: Vector<i64> = Vector<i64>::new()
  match ps.nodes.get(node):
    Node::IdentE(t):
      seg_toks = seg_toks.push(t)
    Node::QualNameE(lp, n):
      seg_toks = read_list(ps.idx, lp)
  seg_toks = seg_toks.push(member_tidx)
  let fl: FlushResult = flush_list(ps, seg_toks)
  return ps_add_node(fl.ps, Node::QualNameE(seg_lp = fl.list_pos, seg_count = seg_toks.length()))

// One call argument at `ps`: `name = expr` when an identifier is followed
// by `=` (`==` is a comparison), else an expression.  The name's token
// index rides in `names`, -1 for a positional argument.
class CallArg:
  ps: PS
  node: i64
  name_tidx: i64

fn parse_call_arg(pc: PC, ps: PS): CallArg
  if peek_is(pc, ps, lexer::TK::Identifier):
    let after: PS = ps_advance(pc, ps)
    if peek_is(pc, after, lexer::TK::Eq):
      let value: PR = parse_expr(pc, ps_advance(pc, after))
      return CallArg(value.ps, value.node, ps.pos)
  let expr: PR = parse_expr(pc, ps)
  return CallArg(expr.ps, expr.node, to_i64(-1))

// The call `(args)` on `callee` at `ps`, carrying the type arguments the
// callee was read with (`targs_lp` -1 for none) and whether they were
// written on the type (`Type<..>::member(args)`).  The argument names
// are a list beside the arguments, one entry each.
fn parse_call_suffix(pc: PC, ps: PS, callee: i64, targs_lp: i64, targs_on_type: bool): PR
  let inner: PS = expect(pc, ps, lexer::TK::LParen)
  let call_args: Vector<i64> = Vector<i64>::new()
  let arg_names: Vector<i64> = Vector<i64>::new()
  if peek_is(pc, inner, lexer::TK::RParen) == false:
    let arg: CallArg = parse_call_arg(pc, inner)
    inner = arg.ps
    if arg.node >= 0:
      call_args = call_args.push(arg.node)
      arg_names = arg_names.push(arg.name_tidx)
      let arg_done: bool = false
      while arg_done == false:
        if peek_is(pc, inner, lexer::TK::Comma):
          inner = ps_advance(pc, inner)
          let arg2: CallArg = parse_call_arg(pc, inner)
          inner = arg2.ps
          if arg2.node >= 0:
            call_args = call_args.push(arg2.node)
            arg_names = arg_names.push(arg2.name_tidx)
          else:
            arg_done = true
        else:
          arg_done = true
  let call_fl: FlushResult = flush_list(inner, call_args)
  let names_fl: FlushResult = flush_list(call_fl.ps, arg_names)
  inner = expect(pc, names_fl.ps, lexer::TK::RParen)
  return ps_add_node(inner, Node::CallE(callee = callee, args_lp = call_fl.list_pos, arg_count = call_args.length(), targs_lp = targs_lp, names_lp = names_fl.list_pos, targs_on_type = targs_on_type))

// Postfix expressions: call (with call-site type arguments), field, index, try
fn parse_postfix(pc: PC, ps: PS): PR
  let prim: PR = parse_primary(pc, ps)
  if prim.node < 0:
    return prim
  let cur_ps: PS = prim.ps
  let cur_node: i64 = prim.node
  let done: bool = false
  while done == false:
    let k: lexer::TK = peek_kind(pc, cur_ps)

    // Type arguments on a name: name<T, ..>(args) or name<T, ..>::member(args)
    let targs: TypeArgsResult = TypeArgsResult(cur_ps, to_i64(-1), to_i64(0), false)
    if tk_eq(k, lexer::TK::Lt):
      if names_callee(cur_ps, cur_node):
        targs = try_call_type_args(pc, cur_ps)
        // A member's type arguments are its call's: `obj.m<T>::x`
        // names nothing, so there the `<` is a comparison.
        if targs.ok and is_member(cur_ps, cur_node):
          if peek_is(pc, targs.ps, lexer::TK::ColonColon):
            targs = TypeArgsResult(cur_ps, to_i64(-1), to_i64(0), false)
    if targs.ok:
      let after: PS = targs.ps
      let on_type: bool = false
      if peek_is(pc, after, lexer::TK::ColonColon):
        let ps_m: PS = ps_advance(pc, after)
        let member_tidx: i64 = ps_m.pos
        ps_m = expect(pc, ps_m, lexer::TK::Identifier)
        let qual_r: PR = extend_qual_name(ps_m, cur_node, member_tidx)
        after = qual_r.ps
        cur_node = qual_r.node
        on_type = true
      let typed_call: PR = parse_call_suffix(pc, after, cur_node, targs.list_pos, on_type)
      cur_ps = typed_call.ps
      cur_node = typed_call.node

    // Call: expr(args)
    else:
      if tk_eq(k, lexer::TK::LParen):
        let call_r: PR = parse_call_suffix(pc, cur_ps, cur_node, to_i64(-1), false)
        cur_ps = call_r.ps
        cur_node = call_r.node

      // Field access: expr.field
      else:
        if tk_eq(k, lexer::TK::Dot):
          let ps2: PS = ps_advance(pc, cur_ps)
          let field_tidx: i64 = ps2.pos
          let ps3: PS = expect(pc, ps2, lexer::TK::Identifier)
          let fld_r: PR = ps_add_node(ps3, Node::FieldE(obj = cur_node, field = field_tidx))
          cur_ps = fld_r.ps
          cur_node = fld_r.node

        // Index: expr[index]
        else:
          if tk_eq(k, lexer::TK::LBracket):
            let ps2: PS = ps_advance(pc, cur_ps)
            let idx_expr: PR = parse_expr(pc, ps2)
            if idx_expr.node < 0:
              return idx_expr
            let ps3: PS = expect(pc, idx_expr.ps, lexer::TK::RBracket)
            let idx_r: PR = ps_add_node(ps3, Node::IndexE(obj = cur_node, idx = idx_expr.node))
            cur_ps = idx_r.ps
            cur_node = idx_r.node

          // Try: expr?
          else:
            if tk_eq(k, lexer::TK::Question):
              let ps2: PS = ps_advance(pc, cur_ps)
              let try_r: PR = ps_add_node(ps2, Node::TryE(operand = cur_node))
              cur_ps = try_r.ps
              cur_node = try_r.node

            else:
              done = true

  return PR(cur_ps, cur_node)

// Unary: -expr, !expr.  A pointer is read and written through the
// methods of `Ptr<T>` — `get`, `set`, `offset`, `cast`, `is_null` — so
// neither `*` nor `&` leads an expression (ADR_RAW_POINTER_SURFACE.md).
fn parse_unary(pc: PC, ps: PS): PR
  let k: lexer::TK = peek_kind(pc, ps)
  // The sigils that led an expression are reported where they stand;
  // the operand is still read, so it raises no second diagnostic.
  if tk_eq(k, lexer::TK::Star) or tk_eq(k, lexer::TK::Amp):
    let sigil_sp: Span = tok_span(pc, ps)
    let msg: string = "unary '&' is no Dao syntax; Dao has no address-of operator"
    if tk_eq(k, lexer::TK::Star):
      msg = "unary '*' is no Dao syntax; read a pointer with 'p.get()' and write it with 'p.set(value)'"
    let ps_sig: PS = ps_add_diag(ps, sigil_sp, msg)
    let operand: PR = parse_unary(pc, ps_advance(pc, ps_sig))
    return ps_add_node(operand.ps, Node::ErrorE(tok = ps.pos))
  if tk_eq(k, lexer::TK::Minus) or tk_eq(k, lexer::TK::Bang):
    let op_tidx: i64 = ps.pos
    let operand: PR = parse_unary(pc, ps_advance(pc, ps))
    if operand.node < 0:
      return operand
    return ps_add_node(operand.ps, Node::UnaryE(op = op_tidx, operand = operand.node))
  return parse_postfix(pc, ps)

// Multiplicative: expr * expr, expr / expr, expr % expr
fn parse_multiplicative(pc: PC, ps: PS): PR
  let left: PR = parse_unary(pc, ps)
  if left.node < 0:
    return left
  let cur_ps: PS = left.ps
  let cur_node: i64 = left.node
  let done: bool = false
  while done == false:
    let k: lexer::TK = peek_kind(pc, cur_ps)
    if tk_eq(k, lexer::TK::Star) or tk_eq(k, lexer::TK::Slash) or tk_eq(k, lexer::TK::Percent):
      let op_tidx: i64 = cur_ps.pos
      let right: PR = parse_unary(pc, ps_advance(pc, cur_ps))
      if right.node < 0:
        return right
      let bin_r: PR = ps_add_node(right.ps, Node::BinaryE(op = op_tidx, left = cur_node, right = right.node))
      cur_ps = bin_r.ps
      cur_node = bin_r.node
    else:
      done = true
  return PR(cur_ps, cur_node)

// Additive: expr + expr, expr - expr
fn parse_additive(pc: PC, ps: PS): PR
  let left: PR = parse_multiplicative(pc, ps)
  if left.node < 0:
    return left
  let cur_ps: PS = left.ps
  let cur_node: i64 = left.node
  let done: bool = false
  while done == false:
    let k: lexer::TK = peek_kind(pc, cur_ps)
    if tk_eq(k, lexer::TK::Plus) or tk_eq(k, lexer::TK::Minus):
      let op_tidx: i64 = cur_ps.pos
      let right: PR = parse_multiplicative(pc, ps_advance(pc, cur_ps))
      if right.node < 0:
        return right
      let bin_r: PR = ps_add_node(right.ps, Node::BinaryE(op = op_tidx, left = cur_node, right = right.node))
      cur_ps = bin_r.ps
      cur_node = bin_r.node
    else:
      done = true
  return PR(cur_ps, cur_node)

// Relational: <, <=, >, >=
fn parse_relational(pc: PC, ps: PS): PR
  let left: PR = parse_additive(pc, ps)
  if left.node < 0:
    return left
  let cur_ps: PS = left.ps
  let cur_node: i64 = left.node
  let done: bool = false
  while done == false:
    let k: lexer::TK = peek_kind(pc, cur_ps)
    if tk_eq(k, lexer::TK::Lt) or tk_eq(k, lexer::TK::LtEq) or tk_eq(k, lexer::TK::Gt) or tk_eq(k, lexer::TK::GtEq):
      let op_tidx: i64 = cur_ps.pos
      let right: PR = parse_additive(pc, ps_advance(pc, cur_ps))
      if right.node < 0:
        return right
      let bin_r: PR = ps_add_node(right.ps, Node::BinaryE(op = op_tidx, left = cur_node, right = right.node))
      cur_ps = bin_r.ps
      cur_node = bin_r.node
    else:
      done = true
  return PR(cur_ps, cur_node)

// Equality: ==, !=
fn parse_equality(pc: PC, ps: PS): PR
  let left: PR = parse_relational(pc, ps)
  if left.node < 0:
    return left
  let cur_ps: PS = left.ps
  let cur_node: i64 = left.node
  let done: bool = false
  while done == false:
    let k: lexer::TK = peek_kind(pc, cur_ps)
    if tk_eq(k, lexer::TK::EqEq) or tk_eq(k, lexer::TK::BangEq):
      let op_tidx: i64 = cur_ps.pos
      let right: PR = parse_relational(pc, ps_advance(pc, cur_ps))
      if right.node < 0:
        return right
      let bin_r: PR = ps_add_node(right.ps, Node::BinaryE(op = op_tidx, left = cur_node, right = right.node))
      cur_ps = bin_r.ps
      cur_node = bin_r.node
    else:
      done = true
  return PR(cur_ps, cur_node)

// Logical and
fn parse_logical_and(pc: PC, ps: PS): PR
  let left: PR = parse_equality(pc, ps)
  if left.node < 0:
    return left
  let cur_ps: PS = left.ps
  let cur_node: i64 = left.node
  let done: bool = false
  while done == false:
    if peek_is(pc, cur_ps, lexer::TK::KwAnd):
      let op_tidx: i64 = cur_ps.pos
      let right: PR = parse_equality(pc, ps_advance(pc, cur_ps))
      if right.node < 0:
        return right
      let bin_r: PR = ps_add_node(right.ps, Node::BinaryE(op = op_tidx, left = cur_node, right = right.node))
      cur_ps = bin_r.ps
      cur_node = bin_r.node
    else:
      done = true
  return PR(cur_ps, cur_node)

// Logical or
fn parse_logical_or(pc: PC, ps: PS): PR
  let left: PR = parse_logical_and(pc, ps)
  if left.node < 0:
    return left
  let cur_ps: PS = left.ps
  let cur_node: i64 = left.node
  let done: bool = false
  while done == false:
    if peek_is(pc, cur_ps, lexer::TK::KwOr):
      let op_tidx: i64 = cur_ps.pos
      let right: PR = parse_logical_and(pc, ps_advance(pc, cur_ps))
      if right.node < 0:
        return right
      let bin_r: PR = ps_add_node(right.ps, Node::BinaryE(op = op_tidx, left = cur_node, right = right.node))
      cur_ps = bin_r.ps
      cur_node = bin_r.node
    else:
      done = true
  return PR(cur_ps, cur_node)

// Pipe: expr |> expr
fn parse_pipe(pc: PC, ps: PS): PR
  let left: PR = parse_logical_or(pc, ps)
  if left.node < 0:
    return left
  let cur_ps: PS = left.ps
  let cur_node: i64 = left.node
  let done: bool = false
  while done == false:
    if peek_is(pc, cur_ps, lexer::TK::PipeGt):
      let right: PR = parse_logical_or(pc, ps_advance(pc, cur_ps))
      if right.node < 0:
        return right
      let pipe_r: PR = ps_add_node(right.ps, Node::PipeE(left = cur_node, right = right.node))
      cur_ps = pipe_r.ps
      cur_node = pipe_r.node
    else:
      done = true
  return PR(cur_ps, cur_node)

// Top-level expression entry
fn parse_expr(pc: PC, ps: PS): PR
  return parse_pipe(pc, ps)

// =========================================================================
// Section 12: Statement parsing
// =========================================================================

// Parse a suite (body block): NEWLINE INDENT stmts DEDENT
// Returns PR where .node = list_pos (position of count in idx)
fn parse_suite(pc: PC, ps: PS): PR
  let ps2: PS = expect(pc, ps, lexer::TK::Newline)
  let ps3: PS = expect(pc, ps2, lexer::TK::Indent)
  let collected: Vector<i64> = Vector<i64>::new()
  let cur: PS = ps3
  let done: bool = false
  while done == false:
    cur = skip_newlines(pc, cur)
    let k: lexer::TK = peek_kind(pc, cur)
    if tk_eq(k, lexer::TK::Dedent) or at_end(pc, cur):
      done = true
    else:
      let stmt: PR = parse_statement(pc, cur)
      if stmt.node >= 0:
        collected = collected.push(stmt.node)
        cur = stmt.ps
      else:
        // Error recovery: skip to next statement boundary
        cur = sync_to_stmt(pc, stmt.ps)
        let err_r: PR = ps_add_node(cur, Node::ErrorS(tok = cur.pos))
        collected = collected.push(err_r.node)
        cur = err_r.ps

  let fl: FlushResult = flush_list(cur, collected)
  cur = expect(pc, fl.ps, lexer::TK::Dedent)
  return PR(cur, fl.list_pos)

fn parse_statement(pc: PC, ps: PS): PR
  let k: lexer::TK = peek_kind(pc, ps)

  if tk_eq(k, lexer::TK::KwLet):
    return parse_let_stmt(pc, ps)
  if tk_eq(k, lexer::TK::KwIf):
    return parse_if_stmt(pc, ps)
  if tk_eq(k, lexer::TK::KwWhile):
    return parse_while_stmt(pc, ps)
  if tk_eq(k, lexer::TK::KwFor):
    return parse_for_stmt(pc, ps)
  if tk_eq(k, lexer::TK::KwReturn):
    return parse_return_stmt(pc, ps)
  if tk_eq(k, lexer::TK::KwBreak):
    let tidx: i64 = ps.pos
    let ps2: PS = ps_advance(pc, ps)
    let ps3: PS = match_tok(pc, ps2, lexer::TK::Newline)
    return ps_add_node(ps3, Node::BreakS(tok = tidx))
  if tk_eq(k, lexer::TK::KwMatch):
    return parse_match_stmt(pc, ps)
  if tk_eq(k, lexer::TK::KwResource):
    return parse_resource_stmt(pc, ps)
  if tk_eq(k, lexer::TK::KwMode):
    return parse_mode_stmt(pc, ps)
  if tk_eq(k, lexer::TK::KwYield):
    return parse_yield_stmt(pc, ps)

  // Expression or assignment
  let expr: PR = parse_expr(pc, ps)
  if expr.node < 0:
    return expr

  // Check for assignment: expr = value
  if peek_is(pc, expr.ps, lexer::TK::Eq):
    let ps2: PS = ps_advance(pc, expr.ps)
    let val: PR = parse_expr(pc, ps2)
    if val.node < 0:
      return val
    let ps3: PS = match_tok(pc, val.ps, lexer::TK::Newline)
    return ps_add_node(ps3, Node::AssignS(target = expr.node, value = val.node))

  // Expression statement
  let ps2: PS = match_tok(pc, expr.ps, lexer::TK::Newline)
  return ps_add_node(ps2, Node::ExprStmtS(expr = expr.node))

fn parse_let_stmt(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  let name_tidx: i64 = ps2.pos
  let ps3: PS = expect(pc, ps2, lexer::TK::Identifier)

  let type_node: i64 = to_i64(-1)
  let init_node: i64 = to_i64(-1)

  // Check for : Type
  if peek_is(pc, ps3, lexer::TK::Colon):
    let ps4: PS = ps_advance(pc, ps3)
    let ty: PR = parse_type(pc, ps4)
    if ty.node >= 0:
      type_node = ty.node
      ps3 = ty.ps
    else:
      ps3 = ty.ps
    // Check for = init after type
    if peek_is(pc, ps3, lexer::TK::Eq):
      let ps5: PS = ps_advance(pc, ps3)
      let init: PR = parse_expr(pc, ps5)
      if init.node >= 0:
        init_node = init.node
        ps3 = init.ps
      else:
        ps3 = init.ps
  else:
    if peek_is(pc, ps3, lexer::TK::Eq):
      let ps4: PS = ps_advance(pc, ps3)
      let init: PR = parse_expr(pc, ps4)
      if init.node >= 0:
        init_node = init.node
        ps3 = init.ps
      else:
        ps3 = init.ps
    else:
      let sp: Span = tok_span(pc, ps3)
      ps3 = ps_add_diag(ps3, sp, "expected ':' or '=' after let binding name")

  let ps4: PS = match_tok(pc, ps3, lexer::TK::Newline)
  return ps_add_node(ps4, Node::LetS(name = name_tidx, typ = type_node, init = init_node))

fn parse_if_stmt(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  let cond: PR = parse_expr(pc, ps2)
  if cond.node < 0:
    let psr: PS = sync_to_stmt(pc, cond.ps)
    return ps_add_node(psr, Node::ErrorS(tok = ps.pos))
  let ps3: PS = expect(pc, cond.ps, lexer::TK::Colon)
  let then_suite: PR = parse_suite(pc, ps3)
  let then_list_pos: i64 = then_suite.node
  let cur: PS = then_suite.ps

  let else_list_pos: i64 = to_i64(-1)
  if peek_is(pc, cur, lexer::TK::KwElse):
    cur = ps_advance(pc, cur)
    if peek_is(pc, cur, lexer::TK::KwIf):
      // else if — parse as a single-element body containing an if stmt
      let nested_if: PR = parse_if_stmt(pc, cur)
      if nested_if.node >= 0:
        let else_items: Vector<i64> = Vector<i64>::new()
        else_items = else_items.push(nested_if.node)
        let else_fl: FlushResult = flush_list(nested_if.ps, else_items)
        else_list_pos = else_fl.list_pos
        cur = else_fl.ps
      else:
        cur = nested_if.ps
    else:
      let ps4: PS = expect(pc, cur, lexer::TK::Colon)
      let else_suite: PR = parse_suite(pc, ps4)
      else_list_pos = else_suite.node
      cur = else_suite.ps

  return ps_add_node(cur, Node::IfS(cond = cond.node, then_lp = then_list_pos, else_lp = else_list_pos))

fn parse_while_stmt(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  let cond: PR = parse_expr(pc, ps2)
  if cond.node < 0:
    let psr: PS = sync_to_stmt(pc, cond.ps)
    return ps_add_node(psr, Node::ErrorS(tok = ps.pos))
  let ps3: PS = expect(pc, cond.ps, lexer::TK::Colon)
  let body: PR = parse_suite(pc, ps3)
  return ps_add_node(body.ps, Node::WhileS(cond = cond.node, body_lp = body.node))

// `resource <kind> <name> =>` and its suite: the block's kind and name
// are kept as token indexes; the domain they name has no MIR
// representation in the bootstrap yet, so MIR rejects the block.
fn parse_resource_stmt(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  let kind_tidx: i64 = ps2.pos
  let ps3: PS = expect(pc, ps2, lexer::TK::Identifier)
  let name_tidx: i64 = ps3.pos
  let ps4: PS = expect(pc, ps3, lexer::TK::Identifier)
  let ps5: PS = expect(pc, ps4, lexer::TK::FatArrow)
  let body: PR = parse_suite(pc, ps5)
  return ps_add_node(body.ps, Node::ResourceS(kind = kind_tidx, name = name_tidx, body_lp = body.node))

// `mode <name> =>` and its suite (host `parse_mode_block`).  The mode
// name is preserved; the body is a block.
fn parse_mode_stmt(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)          // consume 'mode'
  let name_tidx: i64 = ps2.pos
  let ps3: PS = expect(pc, ps2, lexer::TK::Identifier)
  let ps4: PS = expect(pc, ps3, lexer::TK::FatArrow)
  let body: PR = parse_suite(pc, ps4)
  return ps_add_node(body.ps, Node::ModeS(name = name_tidx, body_lp = body.node))

// `yield <expr>` (host `parse_yield_statement`).  The value is preserved.
fn parse_yield_stmt(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)          // consume 'yield'
  let val: PR = parse_expr(pc, ps2)
  if val.node < 0:
    let psr: PS = sync_to_stmt(pc, val.ps)
    return ps_add_node(psr, Node::ErrorS(tok = ps.pos))
  let ps3: PS = match_tok(pc, val.ps, lexer::TK::Newline)
  return ps_add_node(ps3, Node::YieldS(tok = ps.pos, value = val.node))

fn parse_for_stmt(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  let var_tidx: i64 = ps2.pos
  let ps3: PS = expect(pc, ps2, lexer::TK::Identifier)
  let ps4: PS = expect(pc, ps3, lexer::TK::KwIn)
  let iter: PR = parse_expr(pc, ps4)
  if iter.node < 0:
    let psr: PS = sync_to_stmt(pc, iter.ps)
    return ps_add_node(psr, Node::ErrorS(tok = ps.pos))
  let ps5: PS = expect(pc, iter.ps, lexer::TK::Colon)
  let body: PR = parse_suite(pc, ps5)
  return ps_add_node(body.ps, Node::ForS(var_tok = var_tidx, iter = iter.node, body_lp = body.node))

fn parse_return_stmt(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  let k: lexer::TK = peek_kind(pc, ps2)
  if tk_eq(k, lexer::TK::Newline) or tk_eq(k, lexer::TK::Dedent) or at_end(pc, ps2):
    let ps3: PS = match_tok(pc, ps2, lexer::TK::Newline)
    return ps_add_node(ps3, Node::ReturnS(value = to_i64(-1)))
  let val: PR = parse_expr(pc, ps2)
  if val.node < 0:
    return val
  let ps3: PS = match_tok(pc, val.ps, lexer::TK::Newline)
  return ps_add_node(ps3, Node::ReturnS(value = val.node))

fn parse_match_stmt(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  let scrut: PR = parse_expr(pc, ps2)
  if scrut.node < 0:
    let psr: PS = sync_to_stmt(pc, scrut.ps)
    return ps_add_node(psr, Node::ErrorS(tok = ps.pos))
  let ps3: PS = expect(pc, scrut.ps, lexer::TK::Colon)
  let ps4: PS = expect(pc, ps3, lexer::TK::Newline)
  let ps5: PS = expect(pc, ps4, lexer::TK::Indent)

  // Arms: collect [pattern, body_list_pos] pairs, then flush
  let arm_pairs: Vector<i64> = Vector<i64>::new()
  let arm_count: i64 = 0
  let cur: PS = ps5
  let done: bool = false
  while done == false:
    cur = skip_newlines(pc, cur)
    let k: lexer::TK = peek_kind(pc, cur)
    if tk_eq(k, lexer::TK::Dedent) or at_end(pc, cur):
      done = true
    else:
      // Parse pattern (as expression)
      let pat: PR = parse_expr(pc, cur)
      if pat.node < 0:
        cur = sync_to_stmt(pc, pat.ps)
      else:
        cur = expect(pc, pat.ps, lexer::TK::Colon)
        let arm_body: PR = parse_suite(pc, cur)
        arm_pairs = arm_pairs.push(pat.node)
        arm_pairs = arm_pairs.push(arm_body.node)
        cur = arm_body.ps
        arm_count = arm_count + 1

  let arms_fl: FlushResult = flush_pairs(cur, arm_pairs, arm_count)
  cur = expect(pc, arms_fl.ps, lexer::TK::Dedent)
  return ps_add_node(cur, Node::MatchS(scrutinee = scrut.node, arms_lp = arms_fl.list_pos))

// =========================================================================
// Section 13: Declaration parsing
// =========================================================================

fn parse_declaration(pc: PC, ps: PS): PR
  let k: lexer::TK = peek_kind(pc, ps)

  if tk_eq(k, lexer::TK::KwExtern):
    return parse_extern_fn(pc, ps)
  if tk_eq(k, lexer::TK::KwFn):
    return parse_fn_decl(pc, ps)
  if tk_eq(k, lexer::TK::KwClass):
    return parse_class_decl(pc, ps)
  if tk_eq(k, lexer::TK::KwEnum):
    return parse_enum_decl(pc, ps)
  if tk_eq(k, lexer::TK::KwType):
    return parse_type_alias(pc, ps)
  if tk_eq(k, lexer::TK::KwConcept):
    return parse_concept_decl(pc, ps, to_i64(0))
  if tk_eq(k, lexer::TK::KwDerived):
    // `derived concept ...` — consume `derived`, require `concept` next,
    // then parse the concept body with the derived marker set.
    let ps_d: PS = ps_advance(pc, ps)
    if peek_is(pc, ps_d, lexer::TK::KwConcept):
      return parse_concept_decl(pc, ps_d, to_i64(1))
    let sp_d: Span = tok_span(pc, ps_d)
    let ps_de: PS = ps_add_diag(ps_d, sp_d, "expected 'concept' after 'derived'")
    return ps_add_node(ps_advance(pc, ps_de), Node::ErrorD(tok = ps.pos))
  if tk_eq(k, lexer::TK::KwExtend):
    return parse_extend_decl(pc, ps)

  let sp: Span = tok_span(pc, ps)
  let ps2: PS = ps_add_diag(ps, sp, "expected declaration (fn, extern, class, enum, type, concept, or extend)")
  return ps_add_node(ps_advance(pc, ps2), Node::ErrorD(tok = ps.pos))

// Parse an optional concept bound after a type parameter name:
// `: Concept`, `: A + B`, or a qualified `: core::Printable`.  Each bound
// is a full type node (as the host's `parse_type()` does), so qualified
// and generic concept names parse.  Returns PR where .node is a list_pos
// of the bound type-node indices, or -1 when there is no bound.  The
// bounds are preserved for the resolver and type checker.
fn parse_type_param_bounds(pc: PC, ps: PS): PR
  if peek_is(pc, ps, lexer::TK::Colon) == false:
    return PR(ps, to_i64(-1))
  let ps2: PS = ps_advance(pc, ps)      // consume ':'
  let bounds: Vector<i64> = Vector<i64>::new()
  let first: PR = parse_type(pc, ps2)
  let cur: PS = first.ps
  if first.node >= 0:
    bounds = bounds.push(first.node)
  let done: bool = false
  while done == false:
    if peek_is(pc, cur, lexer::TK::Plus):
      cur = ps_advance(pc, cur)          // consume '+'
      let next_b: PR = parse_type(pc, cur)
      cur = next_b.ps
      if next_b.node >= 0:
        bounds = bounds.push(next_b.node)
    else:
      done = true
  let fl: FlushResult = flush_list(cur, bounds)
  return PR(fl.ps, fl.list_pos)

// Parse optional type parameters: <T, U: C, V: A + B> — returns PR where
// .node = list_pos.  Returns -1 if no type params are present.
fn parse_type_params(pc: PC, ps: PS): PR
  if peek_is(pc, ps, lexer::TK::Lt) == false:
    return PR(ps, to_i64(-1))
  let ps2: PS = ps_advance(pc, ps)
  let collected: Vector<i64> = Vector<i64>::new()
  // Parse first type param (must be an identifier)
  if peek_is(pc, ps2, lexer::TK::Identifier):
    let tidx: i64 = ps2.pos
    let ps3: PS = ps_advance(pc, ps2)
    let b1: PR = parse_type_param_bounds(pc, ps3)
    let gp: PR = ps_add_node(b1.ps, Node::GenericParamT(tok = tidx, bounds = b1.node))
    collected = collected.push(gp.node)
    let cur: PS = gp.ps
    let done: bool = false
    while done == false:
      if peek_is(pc, cur, lexer::TK::Comma):
        cur = ps_advance(pc, cur)
        let tidx2: i64 = cur.pos
        let curi: PS = expect(pc, cur, lexer::TK::Identifier)
        let b2: PR = parse_type_param_bounds(pc, curi)
        let gp2: PR = ps_add_node(b2.ps, Node::GenericParamT(tok = tidx2, bounds = b2.node))
        collected = collected.push(gp2.node)
        cur = gp2.ps
      else:
        done = true
    let fl: FlushResult = flush_list(cur, collected)
    let ps_end: PS = expect(pc, fl.ps, lexer::TK::Gt)
    return PR(ps_end, fl.list_pos)
  else:
    let sp: Span = tok_span(pc, ps2)
    let pse: PS = ps_add_diag(ps2, sp, "expected type parameter name")
    let pse2: PS = expect(pc, pse, lexer::TK::Gt)
    return PR(pse2, to_i64(-1))

// Parse (name: Type, name: Type, ...) — returns PR where .node = list_pos
// Pushes pairs [name_tok, type_node, ...], then count
fn parse_params_list(pc: PC, ps: PS): PR
  let ps2: PS = expect(pc, ps, lexer::TK::LParen)
  let param_pairs: Vector<i64> = Vector<i64>::new()
  let count: i64 = 0
  let cur: PS = ps2

  if peek_is(pc, cur, lexer::TK::RParen) == false:
    // Parse first param — accept KwSelf as a parameter name (self param)
    let name_tidx: i64 = cur.pos
    if peek_is(pc, cur, lexer::TK::KwSelf):
      cur = ps_advance(pc, cur)
      param_pairs = param_pairs.push(name_tidx)
      param_pairs = param_pairs.push(to_i64(-1))
      count = count + 1
    else:
      cur = expect(pc, cur, lexer::TK::Identifier)
      cur = expect(pc, cur, lexer::TK::Colon)
      let ty: PR = parse_type(pc, cur)
      cur = ty.ps
      param_pairs = param_pairs.push(name_tidx)
      if ty.node >= 0:
        param_pairs = param_pairs.push(ty.node)
      else:
        param_pairs = param_pairs.push(to_i64(-1))
      count = count + 1

    let done: bool = false
    while done == false:
      if peek_is(pc, cur, lexer::TK::Comma):
        cur = ps_advance(pc, cur)
        let name_tidx2: i64 = cur.pos
        // self is only valid as the first parameter — reject here
        if peek_is(pc, cur, lexer::TK::KwSelf):
          let sp: Span = tok_span(pc, cur)
          cur = ps_add_diag(cur, sp, "self must be the first parameter")
          cur = ps_advance(pc, cur)
          param_pairs = param_pairs.push(name_tidx2)
          param_pairs = param_pairs.push(to_i64(-1))
          count = count + 1
        else:
          cur = expect(pc, cur, lexer::TK::Identifier)
          cur = expect(pc, cur, lexer::TK::Colon)
          let ty2: PR = parse_type(pc, cur)
          cur = ty2.ps
          param_pairs = param_pairs.push(name_tidx2)
          if ty2.node >= 0:
            param_pairs = param_pairs.push(ty2.node)
          else:
            param_pairs = param_pairs.push(to_i64(-1))
          count = count + 1
      else:
        done = true

  let fl: FlushResult = flush_pairs(cur, param_pairs, count)
  cur = expect(pc, fl.ps, lexer::TK::RParen)
  return PR(cur, fl.list_pos)

fn parse_fn_decl(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  let name_tidx: i64 = ps2.pos
  let ps3: PS = expect(pc, ps2, lexer::TK::Identifier)

  // Parse optional type parameters
  let tparams: PR = parse_type_params(pc, ps3)
  let tparams_lp: i64 = tparams.node

  let params: PR = parse_params_list(pc, tparams.ps)
  let params_lp: i64 = params.node
  let cur: PS = params.ps

  // Optional return type
  let ret_type: i64 = to_i64(-1)
  if peek_is(pc, cur, lexer::TK::Colon):
    cur = ps_advance(pc, cur)
    let ty: PR = parse_type(pc, cur)
    if ty.node >= 0:
      ret_type = ty.node
    cur = ty.ps

  // Expression-bodied: -> expr NEWLINE
  if peek_is(pc, cur, lexer::TK::Arrow):
    cur = ps_advance(pc, cur)
    let body_expr: PR = parse_expr(pc, cur)
    if body_expr.node < 0:
      return body_expr
    let psfn: PS = match_tok(pc, body_expr.ps, lexer::TK::Newline)
    return ps_add_node(psfn, Node::ExprFnD(name = name_tidx, tparams = tparams_lp, params = params_lp, ret = ret_type, body = body_expr.node))

  // Block-bodied: NEWLINE INDENT stmts DEDENT
  let ps4: PS = expect(pc, cur, lexer::TK::Newline)
  if peek_is(pc, ps4, lexer::TK::Indent):
    let ps5: PS = ps_advance(pc, ps4)
    // Parse statement list inline — collect then flush
    let body_items: Vector<i64> = Vector<i64>::new()
    let bcur: PS = ps5
    let bdone: bool = false
    while bdone == false:
      bcur = skip_newlines(pc, bcur)
      let bk: lexer::TK = peek_kind(pc, bcur)
      if tk_eq(bk, lexer::TK::Dedent) or at_end(pc, bcur):
        bdone = true
      else:
        let stmt: PR = parse_statement(pc, bcur)
        if stmt.node >= 0:
          body_items = body_items.push(stmt.node)
          bcur = stmt.ps
        else:
          bcur = sync_to_stmt(pc, stmt.ps)
          let err_r: PR = ps_add_node(bcur, Node::ErrorS(tok = bcur.pos))
          body_items = body_items.push(err_r.node)
          bcur = err_r.ps
    let body_fl: FlushResult = flush_list(bcur, body_items)
    bcur = expect(pc, body_fl.ps, lexer::TK::Dedent)
    return ps_add_node(bcur, Node::FnDeclD(name = name_tidx, tparams = tparams_lp, params = params_lp, ret = ret_type, body = body_fl.list_pos))
  else:
    // No body — error
    let sp: Span = tok_span(pc, ps4)
    let pse: PS = ps_add_diag(ps4, sp, "expected function body (indented block or -> expression)")
    return ps_add_node(pse, Node::ErrorD(tok = name_tidx))

fn parse_extern_fn(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  if peek_is(pc, ps2, lexer::TK::KwFn) == false:
    let sp: Span = tok_span(pc, ps2)
    let pse: PS = ps_add_diag(ps2, sp, "expected 'fn' after 'extern'")
    return ps_add_node(pse, Node::ErrorD(tok = ps.pos))
  let ps3: PS = ps_advance(pc, ps2)
  let name_tidx: i64 = ps3.pos
  let ps4: PS = expect(pc, ps3, lexer::TK::Identifier)

  // Parse optional type parameters
  let tparams: PR = parse_type_params(pc, ps4)
  let tparams_lp: i64 = tparams.node

  let params: PR = parse_params_list(pc, tparams.ps)
  let params_lp: i64 = params.node
  let cur: PS = params.ps

  // Return type is required for extern fn (CONTRACT_SYNTAX_SURFACE.md §extern).
  let ret_type: i64 = to_i64(-1)
  if peek_is(pc, cur, lexer::TK::Colon):
    cur = ps_advance(pc, cur)
    let ty: PR = parse_type(pc, cur)
    if ty.node >= 0:
      ret_type = ty.node
    cur = ty.ps
  else:
    let sp: Span = tok_span(pc, cur)
    cur = ps_add_diag(cur, sp, "extern fn requires a return type annotation")

  cur = match_tok(pc, cur, lexer::TK::Newline)
  return ps_add_node(cur, Node::ExternFnD(name = name_tidx, tparams = tparams_lp, params = params_lp, ret = ret_type))

fn parse_class_decl(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  let name_tidx: i64 = ps2.pos
  let ps3: PS = expect(pc, ps2, lexer::TK::Identifier)

  // Parse optional type parameters
  let tparams: PR = parse_type_params(pc, ps3)
  let tparams_lp: i64 = tparams.node

  let ps4: PS = expect(pc, tparams.ps, lexer::TK::Colon)
  let ps5: PS = expect(pc, ps4, lexer::TK::Newline)
  let ps6: PS = expect(pc, ps5, lexer::TK::Indent)

  // Parse fields: collect [name_tok, type_node] pairs, then flush.
  let field_pairs: Vector<i64> = Vector<i64>::new()
  let field_count: i64 = 0
  let cur: PS = ps6
  let done: bool = false
  while done == false:
    cur = skip_newlines(pc, cur)
    let k: lexer::TK = peek_kind(pc, cur)
    if tk_eq(k, lexer::TK::Dedent) or at_end(pc, cur):
      done = true
    else:
      if tk_eq(k, lexer::TK::KwFn):
        done = true
      else:
        let fname_tidx: i64 = cur.pos
        cur = expect(pc, cur, lexer::TK::Identifier)
        cur = expect(pc, cur, lexer::TK::Colon)
        let fty: PR = parse_type(pc, cur)
        cur = fty.ps
        field_pairs = field_pairs.push(fname_tidx)
        if fty.node >= 0:
          field_pairs = field_pairs.push(fty.node)
        else:
          field_pairs = field_pairs.push(to_i64(-1))
        field_count = field_count + 1
        cur = match_tok(pc, cur, lexer::TK::Newline)

  // Diagnose empty class body (contract: must have at least one field).
  if field_count == 0:
    let sp: Span = tok_span(pc, cur)
    cur = ps_add_diag(cur, sp, "class body must contain at least one field")

  let fields_fl: FlushResult = flush_pairs(cur, field_pairs, field_count)
  cur = fields_fl.ps

  // Parse methods: collect method node indices when we see KwFn
  let method_items: Vector<i64> = Vector<i64>::new()
  let mdone: bool = false
  while mdone == false:
    cur = skip_newlines(pc, cur)
    let mk: lexer::TK = peek_kind(pc, cur)
    if tk_eq(mk, lexer::TK::KwFn):
      let meth: PR = parse_fn_decl(pc, cur)
      if meth.node >= 0:
        method_items = method_items.push(meth.node)
      cur = meth.ps
    else:
      mdone = true

  let methods_lp: i64 = to_i64(-1)
  if method_items.length() > 0:
    let mfl: FlushResult = flush_list(cur, method_items)
    cur = mfl.ps
    methods_lp = mfl.list_pos

  cur = expect(pc, cur, lexer::TK::Dedent)
  return ps_add_node(cur, Node::ClassDeclD(name = name_tidx, tparams = tparams_lp, fields = fields_fl.list_pos, methods = methods_lp))

fn parse_enum_decl(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  // Track whether this is 'enum class' (named-field variants) or
  // plain 'enum' (fieldless only, per CONTRACT_SYNTAX_SURFACE.md).
  let is_enum_class: bool = false
  if peek_is(pc, ps2, lexer::TK::KwClass):
    ps2 = ps_advance(pc, ps2)
    is_enum_class = true
  let name_tidx: i64 = ps2.pos
  let ps3: PS = expect(pc, ps2, lexer::TK::Identifier)

  // Parse optional type parameters
  let tparams: PR = parse_type_params(pc, ps3)
  let tparams_lp: i64 = tparams.node

  let ps4: PS = expect(pc, tparams.ps, lexer::TK::Colon)
  let ps5: PS = expect(pc, ps4, lexer::TK::Newline)
  let ps6: PS = expect(pc, ps5, lexer::TK::Indent)

  // Variants: push [name_tok, payload_list_pos] pairs, then count
  // Each variant has a name_tok and a payload_list_pos.
  // Collect variant pairs, flushing payload lists first.
  let variant_pairs: Vector<i64> = Vector<i64>::new()
  let variant_count: i64 = 0
  let cur: PS = ps6
  let done: bool = false
  while done == false:
    cur = skip_newlines(pc, cur)
    let k: lexer::TK = peek_kind(pc, cur)
    if tk_eq(k, lexer::TK::Dedent) or at_end(pc, cur):
      done = true
    else:
      let vname_tidx: i64 = cur.pos
      cur = expect(pc, cur, lexer::TK::Identifier)

      // Parse optional payload.
      // Plain enum: payloads are illegal (CONTRACT_SYNTAX_SURFACE §Enum).
      // Enum class: fields must be named (CONTRACT_SYNTAX_SURFACE §Enum Class).
      let payload_types: Vector<i64> = Vector<i64>::new()
      if peek_is(pc, cur, lexer::TK::LParen):
        if is_enum_class == false:
          // Plain enum with payload — diagnose per contract.
          let sp: Span = tok_span(pc, cur)
          cur = ps_add_diag(cur, sp, "enum variants cannot carry payloads; use 'enum class' for structured variants")
        cur = ps_advance(pc, cur)
        if peek_is(pc, cur, lexer::TK::RParen) == false:
          let field_tidx: i64 = to_i64(-1)
          if is_enum_class:
            // Enum class: a field is `name: Type`; the name is kept
            // beside the type, for construction by name.
            field_tidx = cur.pos
            cur = expect(pc, cur, lexer::TK::Identifier)
            cur = expect(pc, cur, lexer::TK::Colon)
          let pty: PR = parse_type(pc, cur)
          if pty.node >= 0:
            payload_types = payload_types.push(field_tidx)
            payload_types = payload_types.push(pty.node)
            cur = pty.ps
          else:
            cur = pty.ps
          let pdone: bool = false
          while pdone == false:
            if peek_is(pc, cur, lexer::TK::Comma):
              cur = ps_advance(pc, cur)
              let field2_tidx: i64 = to_i64(-1)
              if is_enum_class:
                field2_tidx = cur.pos
                cur = expect(pc, cur, lexer::TK::Identifier)
                cur = expect(pc, cur, lexer::TK::Colon)
              let pty2: PR = parse_type(pc, cur)
              if pty2.node >= 0:
                payload_types = payload_types.push(field2_tidx)
                payload_types = payload_types.push(pty2.node)
                cur = pty2.ps
              else:
                cur = pty2.ps
                pdone = true
            else:
              pdone = true
        cur = expect(pc, cur, lexer::TK::RParen)

      // Flush payload list
      let payload_fl: FlushResult = flush_list(cur, payload_types)
      cur = payload_fl.ps

      // Collect variant pair: name_tok, payload_list_pos
      variant_pairs = variant_pairs.push(vname_tidx)
      variant_pairs = variant_pairs.push(payload_fl.list_pos)
      variant_count = variant_count + 1
      cur = match_tok(pc, cur, lexer::TK::Newline)

  // Flush variant pairs
  let variants_fl: FlushResult = flush_pairs(cur, variant_pairs, variant_count)
  cur = expect(pc, variants_fl.ps, lexer::TK::Dedent)
  return ps_add_node(cur, Node::EnumDeclD(name = name_tidx, tparams = tparams_lp, variants = variants_fl.list_pos))

fn parse_type_alias(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)
  let name_tidx: i64 = ps2.pos
  let ps3: PS = expect(pc, ps2, lexer::TK::Identifier)
  let ps4: PS = expect(pc, ps3, lexer::TK::Eq)
  let ty: PR = parse_type(pc, ps4)
  if ty.node < 0:
    return ty
  let cur: PS = match_tok(pc, ty.ps, lexer::TK::Newline)
  return ps_add_node(cur, Node::TypeAliasD(name = name_tidx, typ = ty.node))

fn parse_concept_decl(pc: PC, ps: PS, is_derived: i64): PR
  let ps2: PS = ps_advance(pc, ps)
  let name_tidx: i64 = ps2.pos
  let ps3: PS = expect(pc, ps2, lexer::TK::Identifier)

  // Parse optional type parameters
  let tparams: PR = parse_type_params(pc, ps3)
  let tparams_lp: i64 = tparams.node

  let ps4: PS = expect(pc, tparams.ps, lexer::TK::Colon)
  let ps5: PS = expect(pc, ps4, lexer::TK::Newline)
  let ps6: PS = expect(pc, ps5, lexer::TK::Indent)

  // Parse method signatures (fn without body)
  let method_items: Vector<i64> = Vector<i64>::new()
  let cur: PS = ps6
  let done: bool = false
  while done == false:
    cur = skip_newlines(pc, cur)
    let k: lexer::TK = peek_kind(pc, cur)
    if tk_eq(k, lexer::TK::Dedent) or at_end(pc, cur):
      done = true
    else:
      if tk_eq(k, lexer::TK::KwFn):
        // Parse signature only: fn name(params): RetType NEWLINE (no body)
        let ps_fn: PS = ps_advance(pc, cur)
        let sig_name_tidx: i64 = ps_fn.pos
        let ps_fn2: PS = expect(pc, ps_fn, lexer::TK::Identifier)
        let sig_tparams: PR = parse_type_params(pc, ps_fn2)
        let sig_params: PR = parse_params_list(pc, sig_tparams.ps)
        let sig_cur: PS = sig_params.ps
        let sig_ret_type: i64 = to_i64(-1)
        if peek_is(pc, sig_cur, lexer::TK::Colon):
          sig_cur = ps_advance(pc, sig_cur)
          let sig_ty: PR = parse_type(pc, sig_cur)
          if sig_ty.node >= 0:
            sig_ret_type = sig_ty.node
          sig_cur = sig_ty.ps
        // Check for default implementation: -> expr or NEWLINE INDENT body
        if peek_is(pc, sig_cur, lexer::TK::Arrow):
          // Expression-bodied default: fn name(params): T -> expr
          sig_cur = ps_advance(pc, sig_cur)
          let body_expr: PR = parse_expr(pc, sig_cur)
          if body_expr.node < 0:
            cur = body_expr.ps
          else:
            sig_cur = match_tok(pc, body_expr.ps, lexer::TK::Newline)
            let sig_r: PR = ps_add_node(sig_cur, Node::ExprFnD(name = sig_name_tidx, tparams = sig_tparams.node, params = sig_params.node, ret = sig_ret_type, body = body_expr.node))
            method_items = method_items.push(sig_r.node)
            cur = sig_r.ps
        else:
          if peek_is(pc, sig_cur, lexer::TK::Newline):
            // Check for block body (NEWLINE followed by INDENT)
            let next_pos: i64 = sig_cur.pos + 1
            let has_indent: bool = false
            if next_pos < pc.toks.length():
              let next_tok: lexer::Token = pc.toks.get(next_pos)
              if tk_eq(next_tok.kind, lexer::TK::Indent):
                has_indent = true
            if has_indent:
              // Block-bodied default: parse as full fn decl
              let body_suite: PR = parse_suite(pc, sig_cur)
              let sig_r: PR = ps_add_node(body_suite.ps, Node::FnDeclD(name = sig_name_tidx, tparams = sig_tparams.node, params = sig_params.node, ret = sig_ret_type, body = body_suite.node))
              method_items = method_items.push(sig_r.node)
              cur = sig_r.ps
            else:
              // Signature only (no body)
              sig_cur = match_tok(pc, sig_cur, lexer::TK::Newline)
              let sig_r: PR = ps_add_node(sig_cur, Node::ExternFnD(name = sig_name_tidx, tparams = sig_tparams.node, params = sig_params.node, ret = sig_ret_type))
              method_items = method_items.push(sig_r.node)
              cur = sig_r.ps
          else:
            // Signature only (no newline — error recovery)
            let sig_r: PR = ps_add_node(sig_cur, Node::ExternFnD(name = sig_name_tidx, tparams = sig_tparams.node, params = sig_params.node, ret = sig_ret_type))
            method_items = method_items.push(sig_r.node)
            cur = sig_r.ps
      else:
        // Skip unexpected token
        let sp: Span = tok_span(pc, cur)
        cur = ps_add_diag(cur, sp, "expected method signature in concept body")
        cur = ps_advance(pc, cur)

  let methods_lp: i64 = to_i64(-1)
  if method_items.length() > 0:
    let mfl: FlushResult = flush_list(cur, method_items)
    cur = mfl.ps
    methods_lp = mfl.list_pos

  cur = expect(pc, cur, lexer::TK::Dedent)
  return ps_add_node(cur, Node::ConceptDeclD(name = name_tidx, tparams = tparams_lp, methods = methods_lp, is_derived = is_derived))

fn extend_concept_tok(nodes: Vector<Node>, idx: Vector<i64>, concept_node: i64): i64
  if concept_node < 0 or concept_node >= nodes.length():
    return to_i64(-1)
  match nodes.get(concept_node):
    Node::NamedT(tidx):
      return tidx
    Node::QualNameE(seg_lp, seg_count):
      let segs: Vector<i64> = read_list(idx, seg_lp)
      if segs.length() > to_i64(0):
        return segs.get(segs.length() - to_i64(1))
  return to_i64(-1)

fn parse_extend_decl(pc: PC, ps: PS): PR
  let ps2: PS = ps_advance(pc, ps)

  // Parse target type
  let target_ty: PR = parse_type(pc, ps2)
  let target_type_node: i64 = target_ty.node
  let cur: PS = target_ty.ps

  // Consume 'as'
  cur = expect(pc, cur, lexer::TK::KwAs)

  // Parse concept target (`Concept` or `mod::Concept`)
  let first_tidx: i64 = cur.pos
  cur = expect(pc, cur, lexer::TK::Identifier)
  let concept_node: i64 = to_i64(-1)
  if peek_is(pc, cur, lexer::TK::ColonColon):
    let seg_toks: Vector<i64> = Vector<i64>::new().push(first_tidx)
    while peek_is(pc, cur, lexer::TK::ColonColon):
      cur = ps_advance(pc, cur)
      let seg_tidx: i64 = cur.pos
      cur = expect(pc, cur, lexer::TK::Identifier)
      seg_toks = seg_toks.push(seg_tidx)
    let seg_fl: FlushResult = flush_list(cur, seg_toks)
    cur = seg_fl.ps
    let qn: PR = ps_add_node(cur, Node::QualNameE(seg_lp = seg_fl.list_pos, seg_count = seg_toks.length()))
    cur = qn.ps
    concept_node = qn.node
  else:
    let nn: PR = ps_add_node(cur, Node::NamedT(tok = first_tidx))
    cur = nn.ps
    concept_node = nn.node

  cur = expect(pc, cur, lexer::TK::Colon)
  cur = expect(pc, cur, lexer::TK::Newline)
  cur = expect(pc, cur, lexer::TK::Indent)

  // Parse method definitions (full fn with body)
  let method_items: Vector<i64> = Vector<i64>::new()
  let done: bool = false
  while done == false:
    cur = skip_newlines(pc, cur)
    let k: lexer::TK = peek_kind(pc, cur)
    if tk_eq(k, lexer::TK::Dedent) or at_end(pc, cur):
      done = true
    else:
      if tk_eq(k, lexer::TK::KwFn):
        let meth: PR = parse_fn_decl(pc, cur)
        if meth.node >= 0:
          method_items = method_items.push(meth.node)
        cur = meth.ps
      else:
        let sp: Span = tok_span(pc, cur)
        cur = ps_add_diag(cur, sp, "expected method definition in extend body")
        cur = ps_advance(pc, cur)

  let methods_lp: i64 = to_i64(-1)
  if method_items.length() > 0:
    let mfl: FlushResult = flush_list(cur, method_items)
    cur = mfl.ps
    methods_lp = mfl.list_pos

  cur = expect(pc, cur, lexer::TK::Dedent)
  return ps_add_node(cur, Node::ExtendDeclD(target = target_type_node, concept_name = concept_node, methods = methods_lp))

// =========================================================================
// Section 14: File-level parsing
// =========================================================================

// Parse a module path: identifier (:: identifier)*
// Returns a PR whose node is a ModuleDeclN or ImportDeclN (caller wraps).
// On return, ps.idx contains flushed segment token indices and node is
// the list_pos.  seg_count is returned via the PR.node field as a
// negative-encoded pair — callers use parse_module_path_raw instead.
//
// parse_module_path_raw: returns (ps_after, list_pos, seg_count) packed
// into a dedicated result type.

class ModulePathResult:
  ps: PS
  list_pos: i64
  seg_count: i64

fn parse_module_path(pc: PC, ps: PS): ModulePathResult
  let first_tidx: i64 = ps.pos
  let cur: PS = expect(pc, ps, lexer::TK::Identifier)
  let seg_toks: Vector<i64> = Vector<i64>::new()
  seg_toks = seg_toks.push(first_tidx)
  let done: bool = false
  while done == false:
    if peek_is(pc, cur, lexer::TK::ColonColon):
      cur = ps_advance(pc, cur)
      let tidx: i64 = cur.pos
      cur = expect(pc, cur, lexer::TK::Identifier)
      seg_toks = seg_toks.push(tidx)
    else:
      done = true
  let fl: FlushResult = flush_list(cur, seg_toks)
  return ModulePathResult(fl.ps, fl.list_pos, seg_toks.length())

fn parse_module_decl(pc: PC, ps: PS): PR
  // consume 'module' keyword
  let cur: PS = ps_advance(pc, ps)
  let path: ModulePathResult = parse_module_path(pc, cur)
  cur = expect(pc, path.ps, lexer::TK::Newline)
  return ps_add_node(cur, Node::ModuleDeclN(path_lp = path.list_pos, seg_count = path.seg_count))

fn parse_import_decl(pc: PC, ps: PS): PR
  // consume 'import' keyword
  let cur: PS = ps_advance(pc, ps)
  let path: ModulePathResult = parse_module_path(pc, cur)
  cur = expect(pc, path.ps, lexer::TK::Newline)
  return ps_add_node(cur, Node::ImportDeclN(path_lp = path.list_pos, seg_count = path.seg_count))

fn parse_file(pc: PC, ps: PS): PR
  let cur: PS = skip_newlines(pc, ps)

  // Optional module declaration
  let mod_node: i64 = to_i64(-1)
  if peek_is(pc, cur, lexer::TK::KwModule):
    let md: PR = parse_module_decl(pc, cur)
    mod_node = md.node
    cur = md.ps
    cur = skip_newlines(pc, cur)

  // Import declarations
  let import_items: Vector<i64> = Vector<i64>::new()
  let imp_done: bool = false
  while imp_done == false:
    cur = skip_newlines(pc, cur)
    if peek_is(pc, cur, lexer::TK::KwImport):
      let imp: PR = parse_import_decl(pc, cur)
      import_items = import_items.push(imp.node)
      cur = imp.ps
    else:
      imp_done = true
  let imports_fl: FlushResult = flush_list(cur, import_items)
  cur = imports_fl.ps

  // Top-level declarations
  let decl_items: Vector<i64> = Vector<i64>::new()
  let done: bool = false
  while done == false:
    cur = skip_newlines(pc, cur)
    if at_end(pc, cur):
      done = true
    else:
      // Diagnose misplaced module/import after declarations
      if peek_is(pc, cur, lexer::TK::KwModule):
        let sp: Span = tok_span(pc, cur)
        cur = ps_add_diag(cur, sp, "module declaration must appear before top-level declarations")
        cur = ps_advance(pc, cur)
        // skip to newline for recovery
        let sync_done: bool = false
        while sync_done == false:
          if at_end(pc, cur):
            sync_done = true
          else:
            if peek_is(pc, cur, lexer::TK::Newline):
              sync_done = true
            else:
              cur = ps_advance(pc, cur)
      else:
        if peek_is(pc, cur, lexer::TK::KwImport):
          let sp: Span = tok_span(pc, cur)
          cur = ps_add_diag(cur, sp, "import declaration must appear before top-level declarations")
          cur = ps_advance(pc, cur)
          let sync_done: bool = false
          while sync_done == false:
            if at_end(pc, cur):
              sync_done = true
            else:
              if peek_is(pc, cur, lexer::TK::Newline):
                sync_done = true
              else:
                cur = ps_advance(pc, cur)
        else:
          let decl: PR = parse_declaration(pc, cur)
          if decl.node >= 0:
            decl_items = decl_items.push(decl.node)
            cur = decl.ps
          else:
            cur = sync_to_decl(pc, decl.ps)
            let err_r: PR = ps_add_node(cur, Node::ErrorD(tok = cur.pos))
            decl_items = decl_items.push(err_r.node)
            cur = err_r.ps
    cur = skip_newlines(pc, cur)

  let decls_fl: FlushResult = flush_list(cur, decl_items)
  return ps_add_node(decls_fl.ps, Node::FileN(module_decl = mod_node, imports_lp = imports_fl.list_pos, decls_lp = decls_fl.list_pos))

// =========================================================================
// Section 15: Public API
// =========================================================================

fn parse(src: string): ParseOutput
  let lr: lexer::LexResult = lexer::lex(src)
  let pc: PC = PC(lr.tokens, src)
  let ps: PS = PS(to_i64(0), Vector<Node>::new(), Vector<i64>::new(), lr.diagnostics)
  let result: PR = parse_file(pc, ps)
  return ParseOutput(pc.toks, pc.src, result.ps.nodes, result.ps.idx, result.ps.diags, result.node)

// =========================================================================
// Section 16: Node kind name (for test output)
// =========================================================================

fn node_kind_name(n: Node): string
  match n:
    Node::IntLitE(t):
      return "IntLitE"
    Node::FloatLitE(t):
      return "FloatLitE"
    Node::StringLitE(t):
      return "StringLitE"
    Node::BoolLitE(t):
      return "BoolLitE"
    Node::IdentE(t):
      return "IdentE"
    Node::QualNameE(a, b):
      return "QualNameE"
    Node::BinaryE(a, b, c):
      return "BinaryE"
    Node::UnaryE(a, b):
      return "UnaryE"
    Node::CallE(a, b, c, d, e, f):
      return "CallE"
    Node::IndexE(a, b):
      return "IndexE"
    Node::FieldE(a, b):
      return "FieldE"
    Node::PipeE(a, b):
      return "PipeE"
    Node::TryE(a):
      return "TryE"
    Node::LambdaE(a, b, c):
      return "LambdaE"
    Node::ListLitE(a, b):
      return "ListLitE"
    Node::ErrorE(t):
      return "ErrorE"
    Node::NamedT(t):
      return "NamedT"
    Node::GenericT(a, b, c):
      return "GenericT"
    Node::GenericParamT(t, b):
      return "GenericParamT"
    Node::ErrorT(t):
      return "ErrorT"
    Node::LetS(a, b, c):
      return "LetS"
    Node::AssignS(a, b):
      return "AssignS"
    Node::IfS(a, b, c):
      return "IfS"
    Node::WhileS(a, b):
      return "WhileS"
    Node::ResourceS(a, b, c):
      return "ResourceS"
    Node::ModeS(a, b):
      return "ModeS"
    Node::YieldS(a, b):
      return "YieldS"
    Node::ForS(a, b, c):
      return "ForS"
    Node::ReturnS(a):
      return "ReturnS"
    Node::BreakS(a):
      return "BreakS"
    Node::MatchS(a, b):
      return "MatchS"
    Node::ExprStmtS(a):
      return "ExprStmtS"
    Node::ErrorS(a):
      return "ErrorS"
    Node::FnDeclD(a, b, c, d, e):
      return "FnDeclD"
    Node::ExternFnD(a, b, c, d):
      return "ExternFnD"
    Node::ExprFnD(a, b, c, d, e):
      return "ExprFnD"
    Node::ClassDeclD(a, b, c, d):
      return "ClassDeclD"
    Node::EnumDeclD(a, b, c):
      return "EnumDeclD"
    Node::TypeAliasD(a, b):
      return "TypeAliasD"
    Node::ConceptDeclD(a, b, c, d):
      return "ConceptDeclD"
    Node::ExtendDeclD(a, b, c):
      return "ExtendDeclD"
    Node::ErrorD(a):
      return "ErrorD"
    Node::ModuleDeclN(a, b):
      return "ModuleDeclN"
    Node::ImportDeclN(a, b):
      return "ImportDeclN"
    Node::FileN(a, b, c):
      return "FileN"
  return "Unknown"

