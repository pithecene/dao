module bootstrap::lexer::tests

import bootstrap::lexer
// =========================================================================
// Lexer tests
// =========================================================================
//
// Test helpers return bool and print PASS/FAIL lines.  The main()
// function tallies results and prints a summary.

fn expect_token(label: string, result: lexer::LexResult, idx: i64, expected_kind: lexer::TK, src: string): bool
  if idx >= result.tokens.length():
    print("FAIL " + label + ": token index out of bounds")
    return false
  let tok = result.tokens.get(idx)
  if lexer::tk_name(tok.kind) == lexer::tk_name(expected_kind):
    print("PASS " + label)
    return true
  let text = ""
  if tok.len > 0:
    text = substring(src, tok.offset, tok.len)
  print("FAIL " + label + ": expected " + lexer::tk_name(expected_kind) + ", got " + lexer::tk_name(tok.kind) + " '" + text + "'")
  return false

fn expect_token_text(label: string, result: lexer::LexResult, idx: i64, expected_kind: lexer::TK, expected_text: string, src: string): bool
  if idx >= result.tokens.length():
    print("FAIL " + label + ": token index out of bounds")
    return false
  let tok = result.tokens.get(idx)
  let text = ""
  if tok.len > 0:
    text = substring(src, tok.offset, tok.len)
  if lexer::tk_name(tok.kind) == lexer::tk_name(expected_kind):
    if text == expected_text:
      print("PASS " + label)
      return true
    print("FAIL " + label + ": text expected '" + expected_text + "', got '" + text + "'")
    return false
  print("FAIL " + label + ": expected " + lexer::tk_name(expected_kind) + ", got " + lexer::tk_name(tok.kind))
  return false

fn expect_token_span(label: string, result: lexer::LexResult, idx: i64, expected_offset: i64, expected_len: i64): bool
  if idx >= result.tokens.length():
    print("FAIL " + label + ": token index out of bounds")
    return false
  let tok = result.tokens.get(idx)
  if tok.offset == expected_offset:
    if tok.len == expected_len:
      print("PASS " + label)
      return true
    print("FAIL " + label + ": len expected " + i64_to_string(expected_len) + ", got " + i64_to_string(tok.len))
    return false
  print("FAIL " + label + ": offset expected " + i64_to_string(expected_offset) + ", got " + i64_to_string(tok.offset))
  return false

fn expect_no_errors(label: string, result: lexer::LexResult): bool
  if result.diagnostics.length() == 0:
    print("PASS " + label)
    return true
  print("FAIL " + label + ": expected no errors, got " + i64_to_string(result.diagnostics.length()))
  return false

fn expect_error_count(label: string, result: lexer::LexResult, expected: i64): bool
  if result.diagnostics.length() == expected:
    print("PASS " + label)
    return true
  print("FAIL " + label + ": expected " + i64_to_string(expected) + " errors, got " + i64_to_string(result.diagnostics.length()))
  return false

fn expect_min_tokens(label: string, result: lexer::LexResult, min_count: i64): bool
  if result.tokens.length() >= min_count:
    print("PASS " + label)
    return true
  print("FAIL " + label + ": expected >= " + i64_to_string(min_count) + " tokens, got " + i64_to_string(result.tokens.length()))
  return false

// Check that the token stream ends with Eof.
fn expect_eof_last(label: string, result: lexer::LexResult): bool
  if result.tokens.length() == 0:
    print("FAIL " + label + ": empty token stream")
    return false
  let last = result.tokens.get(result.tokens.length() - 1)
  if lexer::tk_name(last.kind) == lexer::tk_name(lexer::TK::Eof):
    print("PASS " + label)
    return true
  print("FAIL " + label + ": last token is " + lexer::tk_name(last.kind) + ", expected Eof")
  return false

// Check that a given token kind appears at least once.
fn expect_has_kind(label: string, result: lexer::LexResult, kind: lexer::TK): bool
  let i: i64 = 0
  while i < result.tokens.length():
    let tok = result.tokens.get(i)
    if lexer::tk_name(tok.kind) == lexer::tk_name(kind):
      print("PASS " + label)
      return true
    i = i + 1
  print("FAIL " + label + ": token kind " + lexer::tk_name(kind) + " not found in stream")
  return false

// =========================================================================
// Section 7: Golden token stream tests
// =========================================================================

fn main(): i32
  print("=== bootstrap/lexer: Task 20 — Bootstrap Lexer ===")
  print("")

  let pass_count = 0

  // -----------------------------------------------------------------
  // 7.1 Basic tokens
  // -----------------------------------------------------------------

  let src1 = "let x = 42\n"
  let r1 = lexer::lex(src1)
  if expect_token_text("let_kw", r1, 0, lexer::TK::KwLet, "let", src1):
    pass_count = pass_count + 1
  if expect_token_text("ident_x", r1, 1, lexer::TK::Identifier, "x", src1):
    pass_count = pass_count + 1
  if expect_token("eq_op", r1, 2, lexer::TK::Eq, src1):
    pass_count = pass_count + 1
  if expect_token_text("int_42", r1, 3, lexer::TK::IntLiteral, "42", src1):
    pass_count = pass_count + 1
  if expect_token("newline", r1, 4, lexer::TK::Newline, src1):
    pass_count = pass_count + 1
  if expect_token("eof", r1, 5, lexer::TK::Eof, src1):
    pass_count = pass_count + 1
  if expect_no_errors("basic_no_err", r1):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.2 All keywords
  // -----------------------------------------------------------------

  let src_kw = "fn class enum if else while for in return match\n"
  let rkw = lexer::lex(src_kw)
  if expect_token("kw_fn", rkw, 0, lexer::TK::KwFn, src_kw):
    pass_count = pass_count + 1
  if expect_token("kw_class", rkw, 1, lexer::TK::KwClass, src_kw):
    pass_count = pass_count + 1
  if expect_token("kw_enum", rkw, 2, lexer::TK::KwEnum, src_kw):
    pass_count = pass_count + 1
  if expect_token("kw_if", rkw, 3, lexer::TK::KwIf, src_kw):
    pass_count = pass_count + 1
  if expect_token("kw_match", rkw, 9, lexer::TK::KwMatch, src_kw):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.3 Multi-character operators
  // -----------------------------------------------------------------

  let src2 = "== != <= >= -> => :: |>\n"
  let r2 = lexer::lex(src2)
  if expect_token("op_eqeq", r2, 0, lexer::TK::EqEq, src2):
    pass_count = pass_count + 1
  if expect_token("op_bangeq", r2, 1, lexer::TK::BangEq, src2):
    pass_count = pass_count + 1
  if expect_token("op_lteq", r2, 2, lexer::TK::LtEq, src2):
    pass_count = pass_count + 1
  if expect_token("op_gteq", r2, 3, lexer::TK::GtEq, src2):
    pass_count = pass_count + 1
  if expect_token("op_arrow", r2, 4, lexer::TK::Arrow, src2):
    pass_count = pass_count + 1
  if expect_token("op_fatarrow", r2, 5, lexer::TK::FatArrow, src2):
    pass_count = pass_count + 1
  if expect_token("op_coloncolon", r2, 6, lexer::TK::ColonColon, src2):
    pass_count = pass_count + 1
  if expect_token("op_pipegt", r2, 7, lexer::TK::PipeGt, src2):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.4 Single-character operators
  // -----------------------------------------------------------------

  let src_ops = "+ - * / % & . , | ! < > ?\n"
  let r_ops = lexer::lex(src_ops)
  if expect_token("op_plus", r_ops, 0, lexer::TK::Plus, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_minus", r_ops, 1, lexer::TK::Minus, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_star", r_ops, 2, lexer::TK::Star, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_slash", r_ops, 3, lexer::TK::Slash, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_percent", r_ops, 4, lexer::TK::Percent, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_amp", r_ops, 5, lexer::TK::Amp, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_dot", r_ops, 6, lexer::TK::Dot, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_comma", r_ops, 7, lexer::TK::Comma, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_pipe", r_ops, 8, lexer::TK::Pipe, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_bang", r_ops, 9, lexer::TK::Bang, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_lt", r_ops, 10, lexer::TK::Lt, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_gt", r_ops, 11, lexer::TK::Gt, src_ops):
    pass_count = pass_count + 1
  if expect_token("op_question", r_ops, 12, lexer::TK::Question, src_ops):
    pass_count = pass_count + 1
  if expect_no_errors("ops_no_err", r_ops):
    pass_count = pass_count + 1

  // Two dots are one rest marker, and a third is a dot of its own.
  let src_rest = "(a, ..) ...\n"
  let r_rest = lexer::lex(src_rest)
  if expect_token("rest_marker_after_comma", r_rest, 3, lexer::TK::DotDot, src_rest):
    pass_count = pass_count + 1
  if expect_token("third_dot_stands_alone", r_rest, 6, lexer::TK::Dot, src_rest):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.5 String literal
  // -----------------------------------------------------------------

  let src3 = "\"hello world\"\n"
  let r3 = lexer::lex(src3)
  if expect_token("str_lit", r3, 0, lexer::TK::StringLiteral, src3):
    pass_count = pass_count + 1
  if expect_no_errors("str_no_err", r3):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.6 String with escape sequences
  // -----------------------------------------------------------------

  let src_esc = "\"hello\\nworld\\t\\\"end\"\n"
  let r_esc = lexer::lex(src_esc)
  if expect_token("str_esc", r_esc, 0, lexer::TK::StringLiteral, src_esc):
    pass_count = pass_count + 1
  if expect_no_errors("str_esc_no_err", r_esc):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.7 Float literal
  // -----------------------------------------------------------------

  let src4 = "3.14\n"
  let r4 = lexer::lex(src4)
  if expect_token_text("float_lit", r4, 0, lexer::TK::FloatLiteral, "3.14", src4):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.8 Indentation with span assertions
  // -----------------------------------------------------------------

  let src5 = "fn foo():\n  let x = 1\n  let y = 2\nlet z = 3\n"
  let r5 = lexer::lex(src5)
  // Tokens: fn foo ( ) : NL INDENT let x = 1 NL let y = 2 NL DEDENT let z = 3 NL EOF
  if expect_token("indent_fn", r5, 0, lexer::TK::KwFn, src5):
    pass_count = pass_count + 1
  if expect_token("indent_tok", r5, 6, lexer::TK::Indent, src5):
    pass_count = pass_count + 1
  // INDENT span: line_begin=10, length=2.
  if expect_token_span("indent_span", r5, 6, 10, 2):
    pass_count = pass_count + 1
  // DEDENT at index 17: line_begin=34, length=0.
  if expect_token("dedent_tok", r5, 17, lexer::TK::Dedent, src5):
    pass_count = pass_count + 1
  if expect_token_span("dedent_span", r5, 17, 34, 0):
    pass_count = pass_count + 1
  if expect_no_errors("indent_no_err", r5):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.9 Multi-level indentation
  // -----------------------------------------------------------------

  let src_ml = "if x:\n  if y:\n    z\n"
  let r_ml = lexer::lex(src_ml)
  // Tokens: if(0) x(1) :(2) NL(3) INDENT(4) if(5) y(6) :(7) NL(8)
  //         INDENT(9) z(10) NL(11) DEDENT(12) DEDENT(13) EOF(14)
  if expect_token("ml_if", r_ml, 0, lexer::TK::KwIf, src_ml):
    pass_count = pass_count + 1
  if expect_token("ml_indent1", r_ml, 4, lexer::TK::Indent, src_ml):
    pass_count = pass_count + 1
  if expect_token("ml_indent2", r_ml, 9, lexer::TK::Indent, src_ml):
    pass_count = pass_count + 1
  // Two DEDENTs emitted at EOF
  if expect_token("ml_dedent1", r_ml, 12, lexer::TK::Dedent, src_ml):
    pass_count = pass_count + 1
  if expect_token("ml_dedent2", r_ml, 13, lexer::TK::Dedent, src_ml):
    pass_count = pass_count + 1
  if expect_no_errors("ml_no_err", r_ml):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.10 Paren depth suppresses newlines
  // -----------------------------------------------------------------

  let src6 = "foo(\n  1,\n  2\n)\n"
  let r6 = lexer::lex(src6)
  // Inside parens, newlines and indentation are suppressed.
  // Tokens: foo ( 1 , 2 ) NL EOF
  if expect_token("paren_foo", r6, 0, lexer::TK::Identifier, src6):
    pass_count = pass_count + 1
  if expect_token("paren_lparen", r6, 1, lexer::TK::LParen, src6):
    pass_count = pass_count + 1
  if expect_token("paren_1", r6, 2, lexer::TK::IntLiteral, src6):
    pass_count = pass_count + 1
  if expect_token("paren_comma", r6, 3, lexer::TK::Comma, src6):
    pass_count = pass_count + 1
  if expect_token("paren_2", r6, 4, lexer::TK::IntLiteral, src6):
    pass_count = pass_count + 1
  if expect_token("paren_rparen", r6, 5, lexer::TK::RParen, src6):
    pass_count = pass_count + 1
  if expect_token("paren_nl", r6, 6, lexer::TK::Newline, src6):
    pass_count = pass_count + 1
  if expect_no_errors("paren_no_err", r6):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.11 Nested brackets inside parens
  // -----------------------------------------------------------------

  let src_nb = "f(a[0], b)\n"
  let r_nb = lexer::lex(src_nb)
  // f ( a [ 0 ] , b ) NL EOF
  if expect_token("nb_f", r_nb, 0, lexer::TK::Identifier, src_nb):
    pass_count = pass_count + 1
  if expect_token("nb_lp", r_nb, 1, lexer::TK::LParen, src_nb):
    pass_count = pass_count + 1
  if expect_token("nb_lb", r_nb, 3, lexer::TK::LBracket, src_nb):
    pass_count = pass_count + 1
  if expect_token("nb_rb", r_nb, 5, lexer::TK::RBracket, src_nb):
    pass_count = pass_count + 1
  if expect_token("nb_rp", r_nb, 8, lexer::TK::RParen, src_nb):
    pass_count = pass_count + 1
  if expect_no_errors("nb_no_err", r_nb):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.12 Comments
  // -----------------------------------------------------------------

  let src7 = "x // comment\ny\n"
  let r7 = lexer::lex(src7)
  // comment is skipped: x NL y NL EOF
  if expect_token_text("comment_x", r7, 0, lexer::TK::Identifier, "x", src7):
    pass_count = pass_count + 1
  if expect_token("comment_nl", r7, 1, lexer::TK::Newline, src7):
    pass_count = pass_count + 1
  if expect_token_text("comment_y", r7, 2, lexer::TK::Identifier, "y", src7):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.13 Comment-only line preserves indentation
  // -----------------------------------------------------------------

  let src_co = "if x:\n  // comment\n  y\n"
  let r_co = lexer::lex(src_co)
  // Comment line is blank — does not affect indentation.
  // Tokens: if x : NL INDENT y NL DEDENT EOF
  if expect_token("co_indent", r_co, 4, lexer::TK::Indent, src_co):
    pass_count = pass_count + 1
  if expect_token_text("co_y", r_co, 5, lexer::TK::Identifier, "y", src_co):
    pass_count = pass_count + 1
  if expect_no_errors("co_no_err", r_co):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.14 Tab error
  // -----------------------------------------------------------------

  let src8 = "\tx\n"
  let r8 = lexer::lex(src8)
  // Tab emits TK::Error token (matching C++ emit_error behavior).
  if expect_token("tab_err_tok", r8, 0, lexer::TK::Error, src8):
    pass_count = pass_count + 1
  if expect_error_count("tab_err", r8, 1):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.15 Question mark (try operator)
  // -----------------------------------------------------------------

  let src9 = "x?\n"
  let r9 = lexer::lex(src9)
  if expect_token("try_ident", r9, 0, lexer::TK::Identifier, src9):
    pass_count = pass_count + 1
  if expect_token("try_question", r9, 1, lexer::TK::Question, src9):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.16 Brackets track paren depth
  // -----------------------------------------------------------------

  let src10 = "a[0]\n"
  let r10 = lexer::lex(src10)
  if expect_token("bracket_a", r10, 0, lexer::TK::Identifier, src10):
    pass_count = pass_count + 1
  if expect_token("bracket_l", r10, 1, lexer::TK::LBracket, src10):
    pass_count = pass_count + 1
  if expect_token("bracket_0", r10, 2, lexer::TK::IntLiteral, src10):
    pass_count = pass_count + 1
  if expect_token("bracket_r", r10, 3, lexer::TK::RBracket, src10):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.17 Unterminated string at EOF
  // -----------------------------------------------------------------

  let src11 = "\"hello"
  let r11 = lexer::lex(src11)
  if expect_token("unterm_eof_tok", r11, 0, lexer::TK::Error, src11):
    pass_count = pass_count + 1
  if expect_error_count("unterm_eof_err", r11, 1):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.18 Unterminated string at newline
  // -----------------------------------------------------------------

  let src_unl = "\"hello\nx\n"
  let r_unl = lexer::lex(src_unl)
  if expect_token("unterm_nl_tok", r_unl, 0, lexer::TK::Error, src_unl):
    pass_count = pass_count + 1
  if expect_error_count("unterm_nl_err", r_unl, 1):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.19 Unexpected character
  // -----------------------------------------------------------------

  let src_uc = "x @ y\n"
  let r_uc = lexer::lex(src_uc)
  if expect_token("uc_x", r_uc, 0, lexer::TK::Identifier, src_uc):
    pass_count = pass_count + 1
  if expect_token("uc_err", r_uc, 1, lexer::TK::Error, src_uc):
    pass_count = pass_count + 1
  if expect_token("uc_y", r_uc, 2, lexer::TK::Identifier, src_uc):
    pass_count = pass_count + 1
  if expect_error_count("uc_err_count", r_uc, 1):
    pass_count = pass_count + 1

  // A character outside ASCII is one error token over all its bytes:
  // two for U+00E9, three for U+201C, four for U+1F600.
  let src_two = "x é y\n"
  let r_two = lexer::lex(src_two)
  if expect_token_span("uc_two_byte_span", r_two, 1, 2, 2):
    pass_count = pass_count + 1
  let src_three = "x “ y\n"
  let r_three = lexer::lex(src_three)
  if expect_token("uc_three_byte_err", r_three, 1, lexer::TK::Error, src_three):
    pass_count = pass_count + 1
  if expect_token_span("uc_three_byte_span", r_three, 1, 2, 3):
    pass_count = pass_count + 1
  if expect_token("uc_three_byte_y", r_three, 2, lexer::TK::Identifier, src_three):
    pass_count = pass_count + 1
  if expect_error_count("uc_three_byte_count", r_three, 1):
    pass_count = pass_count + 1
  let src_four = "x 😀 y\n"
  let r_four = lexer::lex(src_four)
  if expect_token_span("uc_four_byte_span", r_four, 1, 2, 4):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.20 Empty source
  // -----------------------------------------------------------------

  let src_empty = ""
  let re = lexer::lex(src_empty)
  if expect_token("empty_eof", re, 0, lexer::TK::Eof, src_empty):
    pass_count = pass_count + 1

  // -----------------------------------------------------------------
  // 7.21 Comprehensive Dao snippet (golden regression)
  // -----------------------------------------------------------------

  let src_dao = "enum Color:\n  Red\n  Green\n  Blue\n\nclass Point:\n  x: f64\n  y: f64\n\nfn distance(a: Point, b: Point): f64\n  let dx: f64 = b.x - a.x\n  let dy: f64 = b.y - a.y\n  return sqrt(dx * dx + dy * dy)\n\nfn main(): i32\n  let p: Point = Point(1.0, 2.0)\n  let q: Point = Point(4.0, 6.0)\n  print(distance(p, q))\n  return 0\n"
  let r_dao = lexer::lex(src_dao)
  // Smoke: correct keywords, no errors, ends with Eof.
  if expect_has_kind("dao_has_enum", r_dao, lexer::TK::KwEnum):
    pass_count = pass_count + 1
  if expect_has_kind("dao_has_class", r_dao, lexer::TK::KwClass):
    pass_count = pass_count + 1
  if expect_has_kind("dao_has_fn", r_dao, lexer::TK::KwFn):
    pass_count = pass_count + 1
  if expect_has_kind("dao_has_return", r_dao, lexer::TK::KwReturn):
    pass_count = pass_count + 1
  if expect_has_kind("dao_has_float", r_dao, lexer::TK::FloatLiteral):
    pass_count = pass_count + 1
  if expect_has_kind("dao_has_indent", r_dao, lexer::TK::Indent):
    pass_count = pass_count + 1
  if expect_has_kind("dao_has_dedent", r_dao, lexer::TK::Dedent):
    pass_count = pass_count + 1
  if expect_eof_last("dao_eof_last", r_dao):
    pass_count = pass_count + 1
  if expect_no_errors("dao_no_err", r_dao):
    pass_count = pass_count + 1

  // =========================================================================
  // Section 8: Self-lex regression over authored module files
  // =========================================================================

  let impl_path = "bootstrap/lexer/impl.dao"
  if file_exists(impl_path):
    let impl_src = read_file(impl_path)
    let r_self = lexer::lex(impl_src)
    if expect_min_tokens("self_lex_count", r_self, 500):
      pass_count = pass_count + 1
    if expect_eof_last("self_lex_eof", r_self):
      pass_count = pass_count + 1
    if expect_has_kind("self_lex_has_fn", r_self, lexer::TK::KwFn):
      pass_count = pass_count + 1
    if expect_has_kind("self_lex_has_enum", r_self, lexer::TK::KwEnum):
      pass_count = pass_count + 1
    if expect_has_kind("self_lex_has_match", r_self, lexer::TK::KwMatch):
      pass_count = pass_count + 1
    if expect_has_kind("self_lex_has_class", r_self, lexer::TK::KwClass):
      pass_count = pass_count + 1
    if expect_has_kind("self_lex_has_string", r_self, lexer::TK::StringLiteral):
      pass_count = pass_count + 1
    if expect_no_errors("self_lex_no_err", r_self):
      pass_count = pass_count + 1
  else:
    print("FAIL self_lex: missing authored file " + impl_path)

  let tests_path = "bootstrap/lexer/tests.dao"
  if file_exists(tests_path):
    let r_tests = lexer::lex(read_file(tests_path))
    if expect_has_kind("tests_lex_has_import", r_tests, lexer::TK::KwImport):
      pass_count = pass_count + 1
    if expect_has_kind("tests_lex_has_coloncolon", r_tests, lexer::TK::ColonColon):
      pass_count = pass_count + 1
    if expect_no_errors("tests_lex_no_err", r_tests):
      pass_count = pass_count + 1
  else:
    print("FAIL tests_lex: missing authored file " + tests_path)

  // =========================================================================
  // Section 9: Summary
  // =========================================================================

  let total = 116
  print("")
  print("--- results ---")
  print(i32_to_string(pass_count) + " / " + i32_to_string(total) + " passed")

  if pass_count == total:
    print("ALL TESTS PASSED")
    return 0
  return 1
