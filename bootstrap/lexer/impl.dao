module bootstrap::lexer

import bootstrap::ascii

// Canonical token model and indentation-aware lexer for the self-hosted
// Dao compiler pipeline.

enum TK:
  // Keywords — control
  KwModule
  KwImport
  KwExtern
  KwFn
  KwClass
  KwEnum
  KwType
  KwLet
  KwIf
  KwElse
  KwWhile
  KwFor
  KwIn
  KwReturn
  KwYield
  KwBreak
  KwMatch
  // Keywords — execution / resource
  KwMode
  KwResource
  // Keywords — literals
  KwTrue
  KwFalse
  // Keywords — logical
  KwAnd
  KwOr
  // Keywords — concepts and conformance
  KwConcept
  KwDerived
  KwAs
  KwExtend
  KwDeny
  KwSelf
  KwWhere
  // Operators
  Colon
  ColonColon
  Arrow
  FatArrow
  Eq
  EqEq
  BangEq
  Lt
  LtEq
  Gt
  GtEq
  Plus
  Minus
  Star
  Slash
  Percent
  Amp
  Bang
  Dot
  Comma
  Pipe
  PipeGt
  Question
  // Delimiters
  LParen
  RParen
  LBracket
  RBracket
  // Literals
  IntLiteral
  FloatLiteral
  StringLiteral
  // Identifier
  Identifier
  // Synthetic
  Newline
  Indent
  Dedent
  Eof
  // Error
  Error

class Token:
  kind: TK
  offset: i64
  len: i64

class LexResult:
  tokens: Vector<Token>
  diagnostics: Vector<Diagnostic>

fn lex_result_empty(): LexResult -> LexResult(Vector<Token>::new(), Vector<Diagnostic>::new())

fn classify_keyword(src: string, start: i64, klen: i64): TK
  let text = substring(src, start, klen)
  if text == "module":
    return TK::KwModule
  if text == "import":
    return TK::KwImport
  if text == "extern":
    return TK::KwExtern
  if text == "fn":
    return TK::KwFn
  if text == "class":
    return TK::KwClass
  if text == "enum":
    return TK::KwEnum
  if text == "type":
    return TK::KwType
  if text == "let":
    return TK::KwLet
  if text == "if":
    return TK::KwIf
  if text == "else":
    return TK::KwElse
  if text == "while":
    return TK::KwWhile
  if text == "for":
    return TK::KwFor
  if text == "in":
    return TK::KwIn
  if text == "return":
    return TK::KwReturn
  if text == "yield":
    return TK::KwYield
  if text == "break":
    return TK::KwBreak
  if text == "match":
    return TK::KwMatch
  if text == "mode":
    return TK::KwMode
  if text == "resource":
    return TK::KwResource
  if text == "true":
    return TK::KwTrue
  if text == "false":
    return TK::KwFalse
  if text == "and":
    return TK::KwAnd
  if text == "or":
    return TK::KwOr
  if text == "concept":
    return TK::KwConcept
  if text == "derived":
    return TK::KwDerived
  if text == "as":
    return TK::KwAs
  if text == "extend":
    return TK::KwExtend
  if text == "deny":
    return TK::KwDeny
  if text == "self":
    return TK::KwSelf
  if text == "where":
    return TK::KwWhere
  return TK::Identifier

fn tk_name(kind: TK): string
  match kind:
    TK::KwModule:
      return "KwModule"
    TK::KwImport:
      return "KwImport"
    TK::KwExtern:
      return "KwExtern"
    TK::KwFn:
      return "KwFn"
    TK::KwClass:
      return "KwClass"
    TK::KwEnum:
      return "KwEnum"
    TK::KwType:
      return "KwType"
    TK::KwLet:
      return "KwLet"
    TK::KwIf:
      return "KwIf"
    TK::KwElse:
      return "KwElse"
    TK::KwWhile:
      return "KwWhile"
    TK::KwFor:
      return "KwFor"
    TK::KwIn:
      return "KwIn"
    TK::KwReturn:
      return "KwReturn"
    TK::KwYield:
      return "KwYield"
    TK::KwBreak:
      return "KwBreak"
    TK::KwMatch:
      return "KwMatch"
    TK::KwMode:
      return "KwMode"
    TK::KwResource:
      return "KwResource"
    TK::KwTrue:
      return "KwTrue"
    TK::KwFalse:
      return "KwFalse"
    TK::KwAnd:
      return "KwAnd"
    TK::KwOr:
      return "KwOr"
    TK::KwConcept:
      return "KwConcept"
    TK::KwDerived:
      return "KwDerived"
    TK::KwAs:
      return "KwAs"
    TK::KwExtend:
      return "KwExtend"
    TK::KwDeny:
      return "KwDeny"
    TK::KwSelf:
      return "KwSelf"
    TK::KwWhere:
      return "KwWhere"
    TK::Colon:
      return "Colon"
    TK::ColonColon:
      return "ColonColon"
    TK::Arrow:
      return "Arrow"
    TK::FatArrow:
      return "FatArrow"
    TK::Eq:
      return "Eq"
    TK::EqEq:
      return "EqEq"
    TK::BangEq:
      return "BangEq"
    TK::Lt:
      return "Lt"
    TK::LtEq:
      return "LtEq"
    TK::Gt:
      return "Gt"
    TK::GtEq:
      return "GtEq"
    TK::Plus:
      return "Plus"
    TK::Minus:
      return "Minus"
    TK::Star:
      return "Star"
    TK::Slash:
      return "Slash"
    TK::Percent:
      return "Percent"
    TK::Amp:
      return "Amp"
    TK::Bang:
      return "Bang"
    TK::Dot:
      return "Dot"
    TK::Comma:
      return "Comma"
    TK::Pipe:
      return "Pipe"
    TK::PipeGt:
      return "PipeGt"
    TK::Question:
      return "Question"
    TK::LParen:
      return "LParen"
    TK::RParen:
      return "RParen"
    TK::LBracket:
      return "LBracket"
    TK::RBracket:
      return "RBracket"
    TK::IntLiteral:
      return "IntLiteral"
    TK::FloatLiteral:
      return "FloatLiteral"
    TK::StringLiteral:
      return "StringLiteral"
    TK::Identifier:
      return "Identifier"
    TK::Newline:
      return "Newline"
    TK::Indent:
      return "Indent"
    TK::Dedent:
      return "Dedent"
    TK::Eof:
      return "Eof"
    TK::Error:
      return "Error"
  return "Unknown"

class ScanCursor:
  pos: i64
  paren_depth: i64
  at_line_start: bool

class IndentStack:
  levels: Vector<i64>
  depth: i64

class LexState:
  cursor: ScanCursor
  indent: IndentStack
  tokens: Vector<Token>
  diags: Vector<Diagnostic>

fn lex_state_new(): LexState
  let zero = to_i64(0)
  let levels = Vector<i64>::new().push(zero)
  return LexState(ScanCursor(zero, zero, true), IndentStack(levels, to_i64(1)), Vector<Token>::new(), Vector<Diagnostic>::new())

fn emit1(tokens: Vector<Token>, kind: TK, pos: i64): Vector<Token>
  return tokens.push(Token(kind, pos, to_i64(1)))

fn emit2(tokens: Vector<Token>, kind: TK, pos: i64): Vector<Token>
  return tokens.push(Token(kind, pos, to_i64(2)))

fn indent_top(st: LexState): i64
  return st.indent.levels.get(st.indent.depth - to_i64(1))

fn indent_push(st: LexState, spaces: i64): LexState
  let levels = st.indent.levels
  let depth = st.indent.depth
  if depth < levels.length():
    levels = levels.set(depth, spaces)
  else:
    levels = levels.push(spaces)
  st.indent = IndentStack(levels, depth + to_i64(1))
  return st

fn indent_pop(st: LexState): LexState
  st.indent = IndentStack(st.indent.levels, st.indent.depth - to_i64(1))
  return st

fn lex_line_start(st: LexState, src: string, src_len: i64): LexState
  let pos = st.cursor.pos
  let line_begin = pos
  let spaces = to_i64(0)
  let one = to_i64(1)
  let zero = to_i64(0)
  while pos < src_len:
    let lc = char_at(src, pos)
    if lc == 32:
      spaces = spaces + one
      pos = pos + one
    else if lc == 9:
      st.diags = st.diags.push(make_error(Span(pos, one), "tabs are not allowed in Dao source"))
      st.tokens = st.tokens.push(Token(TK::Error, pos, one))
      spaces = spaces + one
      pos = pos + one
    else:
      break

  if pos < src_len:
    let lc = char_at(src, pos)
    if lc == 10:
      st.cursor = ScanCursor(pos + one, st.cursor.paren_depth, true)
      return st
    if lc == 13:
      pos = pos + one
      if pos < src_len:
        if char_at(src, pos) == 10:
          pos = pos + one
      st.cursor = ScanCursor(pos, st.cursor.paren_depth, true)
      return st
    if lc == 47:
      if pos + one < src_len:
        if char_at(src, pos + one) == 47:
          while pos < src_len:
            if char_at(src, pos) == 10:
              break
            pos = pos + one
          if pos < src_len:
            pos = pos + one
          st.cursor = ScanCursor(pos, st.cursor.paren_depth, true)
          return st

  if st.cursor.paren_depth == zero:
    let current_indent = indent_top(st)
    if spaces > current_indent:
      st = indent_push(st, spaces)
      st.tokens = st.tokens.push(Token(TK::Indent, line_begin, spaces))
    else if spaces < current_indent:
      while st.indent.depth > one:
        if indent_top(st) <= spaces:
          break
        st = indent_pop(st)
        st.tokens = st.tokens.push(Token(TK::Dedent, line_begin, zero))
      if indent_top(st) != spaces:
        st.diags = st.diags.push(make_error(Span(line_begin, spaces), "inconsistent indentation"))
        st.tokens = st.tokens.push(Token(TK::Error, line_begin, spaces))
  st.cursor = ScanCursor(pos, st.cursor.paren_depth, false)
  return st

fn lex_string(st: LexState, src: string, src_len: i64): LexState
  let one = to_i64(1)
  let str_start = st.cursor.pos
  let pos = str_start + one
  let terminated = false
  let done = false
  while pos < src_len:
    if done:
      break
    let sc = char_at(src, pos)
    if sc == 34:
      pos = pos + one
      done = true
      terminated = true
    else if sc == 92:
      pos = pos + one
      if pos < src_len:
        pos = pos + one
    else if sc == 10:
      st.diags = st.diags.push(make_error(Span(str_start, pos - str_start), "unterminated string literal"))
      done = true
    else:
      pos = pos + one
  if done == false:
    st.diags = st.diags.push(make_error(Span(str_start, pos - str_start), "unterminated string literal"))
  if terminated:
    st.tokens = st.tokens.push(Token(TK::StringLiteral, str_start, pos - str_start))
  else:
    st.tokens = st.tokens.push(Token(TK::Error, str_start, pos - str_start))
  st.cursor = ScanCursor(pos, st.cursor.paren_depth, false)
  return st

fn lex_number(st: LexState, src: string, src_len: i64): LexState
  let one = to_i64(1)
  let num_start = st.cursor.pos
  let pos = num_start
  while pos < src_len:
    if ascii::is_digit(char_at(src, pos)) == false:
      break
    pos = pos + one
  let is_float = false
  if pos < src_len:
    if char_at(src, pos) == 46:
      if pos + one < src_len:
        if ascii::is_digit(char_at(src, pos + one)):
          is_float = true
          pos = pos + one
          while pos < src_len:
            if ascii::is_digit(char_at(src, pos)) == false:
              break
            pos = pos + one
  if is_float:
    st.tokens = st.tokens.push(Token(TK::FloatLiteral, num_start, pos - num_start))
  else:
    st.tokens = st.tokens.push(Token(TK::IntLiteral, num_start, pos - num_start))
  st.cursor = ScanCursor(pos, st.cursor.paren_depth, false)
  return st

fn lex_ident_or_keyword(st: LexState, src: string, src_len: i64): LexState
  let one = to_i64(1)
  let id_start = st.cursor.pos
  let pos = id_start
  while pos < src_len:
    if ascii::is_alnum(char_at(src, pos)) == false:
      break
    pos = pos + one
  let kind = classify_keyword(src, id_start, pos - id_start)
  st.tokens = st.tokens.push(Token(kind, id_start, pos - id_start))
  st.cursor = ScanCursor(pos, st.cursor.paren_depth, false)
  return st

fn lex_two_or_one(st: LexState, src: string, src_len: i64, second_ch: i32, two_kind: TK, one_kind: TK): LexState
  let pos = st.cursor.pos
  if pos + to_i64(1) < src_len:
    if char_at(src, pos + to_i64(1)) == second_ch:
      st.tokens = emit2(st.tokens, two_kind, pos)
      st.cursor = ScanCursor(pos + to_i64(2), st.cursor.paren_depth, false)
      return st
  st.tokens = emit1(st.tokens, one_kind, pos)
  st.cursor = ScanCursor(pos + to_i64(1), st.cursor.paren_depth, false)
  return st

fn lex_single(st: LexState, kind: TK, depth_delta: i64): LexState
  let pos = st.cursor.pos
  let next_depth = st.cursor.paren_depth + depth_delta
  if next_depth < to_i64(0):
    next_depth = to_i64(0)
  st.tokens = emit1(st.tokens, kind, pos)
  st.cursor = ScanCursor(pos + to_i64(1), next_depth, false)
  return st

fn lex_token(st: LexState, src: string, src_len: i64): LexState
  let one = to_i64(1)
  let zero = to_i64(0)
  let pos = st.cursor.pos
  let ch = char_at(src, pos)

  if ch == 32:
    st.cursor = ScanCursor(pos + one, st.cursor.paren_depth, false)
    return st

  if ch == 10:
    if st.cursor.paren_depth == zero:
      st.tokens = emit1(st.tokens, TK::Newline, pos)
    st.cursor = ScanCursor(pos + one, st.cursor.paren_depth, true)
    return st

  if ch == 13:
    pos = pos + one
    if pos < src_len:
      if char_at(src, pos) == 10:
        pos = pos + one
    if st.cursor.paren_depth == zero:
      st.tokens = emit1(st.tokens, TK::Newline, pos - one)
    st.cursor = ScanCursor(pos, st.cursor.paren_depth, true)
    return st

  if ch == 47:
    if pos + one < src_len:
      if char_at(src, pos + one) == 47:
        while pos < src_len:
          if char_at(src, pos) == 10:
            break
          pos = pos + one
        st.cursor = ScanCursor(pos, st.cursor.paren_depth, false)
        return st
    return lex_single(st, TK::Slash, zero)

  if ch == 34:
    return lex_string(st, src, src_len)
  if ascii::is_digit(ch):
    return lex_number(st, src, src_len)
  if ascii::is_alpha(ch):
    return lex_ident_or_keyword(st, src, src_len)

  if ch == 58:
    return lex_two_or_one(st, src, src_len, 58, TK::ColonColon, TK::Colon)
  if ch == 61:
    if pos + one < src_len:
      let nx = char_at(src, pos + one)
      if nx == 61:
        st.tokens = emit2(st.tokens, TK::EqEq, pos)
        st.cursor = ScanCursor(pos + to_i64(2), st.cursor.paren_depth, false)
        return st
      if nx == 62:
        st.tokens = emit2(st.tokens, TK::FatArrow, pos)
        st.cursor = ScanCursor(pos + to_i64(2), st.cursor.paren_depth, false)
        return st
    return lex_single(st, TK::Eq, zero)
  if ch == 33:
    return lex_two_or_one(st, src, src_len, 61, TK::BangEq, TK::Bang)
  if ch == 60:
    return lex_two_or_one(st, src, src_len, 61, TK::LtEq, TK::Lt)
  if ch == 62:
    return lex_two_or_one(st, src, src_len, 61, TK::GtEq, TK::Gt)
  if ch == 45:
    return lex_two_or_one(st, src, src_len, 62, TK::Arrow, TK::Minus)
  if ch == 124:
    return lex_two_or_one(st, src, src_len, 62, TK::PipeGt, TK::Pipe)

  if ch == 43:
    return lex_single(st, TK::Plus, zero)
  if ch == 42:
    return lex_single(st, TK::Star, zero)
  if ch == 37:
    return lex_single(st, TK::Percent, zero)
  if ch == 38:
    return lex_single(st, TK::Amp, zero)
  if ch == 46:
    return lex_single(st, TK::Dot, zero)
  if ch == 44:
    return lex_single(st, TK::Comma, zero)
  if ch == 63:
    return lex_single(st, TK::Question, zero)

  if ch == 40:
    return lex_single(st, TK::LParen, one)
  if ch == 41:
    return lex_single(st, TK::RParen, to_i64(-1))
  if ch == 91:
    return lex_single(st, TK::LBracket, one)
  if ch == 93:
    return lex_single(st, TK::RBracket, to_i64(-1))

  st.diags = st.diags.push(make_error(Span(pos, one), "unexpected character"))
  st.tokens = emit1(st.tokens, TK::Error, pos)
  st.cursor = ScanCursor(pos + one, st.cursor.paren_depth, false)
  return st

fn lex(src: string): LexResult
  let src_len = length(src)
  let zero = to_i64(0)
  let one = to_i64(1)
  let st = lex_state_new()

  while st.cursor.pos < src_len:
    if st.cursor.at_line_start:
      st = lex_line_start(st, src, src_len)
    else:
      st = lex_token(st, src, src_len)

  while st.indent.depth > one:
    st = indent_pop(st)
    st.tokens = st.tokens.push(Token(TK::Dedent, st.cursor.pos, zero))

  st.tokens = st.tokens.push(Token(TK::Eof, st.cursor.pos, zero))
  return LexResult(st.tokens, st.diags)
