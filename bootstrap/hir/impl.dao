module bootstrap::hir
// =========================================================================
// Section 49: HIR node definitions
// =========================================================================
//
// Bootstrap HIR lowering — Task 24.
//
// This file is a library FRAGMENT: it is assembled after
// shared/base.dao, resolver/impl.dao and typecheck/impl.dao (all
// library-only files), then its own test runner in hir/tests.dao.  It
// must NOT contain any token model, lexer, parser, resolver, or type
// checker code — those come from the preceding files — and it carries
// no test runner of its own.  See bootstrap/assemble.sh.
//
// Tier B deferrals:
//   - Lambda lowering
//   - List literal lowering
//   - Try operator
//   - Index expressions
//   - Generics / monomorphization
//   - Methods / extend
//   - Execution-mode and resource domains beyond the block: `mode`
//     blocks and `yield` are represented (HirMode, HirYield) and a
//     resource block lowers to HirResource, but none of them lowers past
//     HIR yet — MIR rejects each fail-closed

enum class HirNode:
  // Program (D6/D7: multi-module root)
  HirProgram(module_list_lp: i64)
  HirModule(name_tok: i64, decl_list_lp: i64, module_id: i64)

  // File (single-file legacy path)
  HirFile(decls_lp: i64)

  // Declarations
  HirFunction(sym: i64, tparams: i64, params: i64, ret: i64, body: i64, is_extern: i64, class_owner: i64)
  HirStruct(name: i64, tparams: i64, fields: i64)
  HirEnum(name: i64, tparams: i64, variants: i64)
  HirTypeAlias(name: i64, typ: i64)

  // Statements
  HirLet(sym: i64, typ: i64, init: i64)
  HirAssign(target: i64, value: i64)
  HirIf(cond: i64, then_lp: i64, else_lp: i64)
  HirWhile(cond: i64, body_lp: i64)
  HirResource(kind: i64, name: i64, body_lp: i64)
  // `mode` block and `yield` carried fail-closed: preserved through HIR,
  // rejected at MIR (Tier A) rather than silently erased.
  HirMode(name: i64, body_lp: i64)
  HirYield(value: i64)
  // `for x in it:` — `var_sym` is the loop variable's symbol.
  HirFor(var_sym: i64, iter: i64, body_lp: i64)
  HirReturn(value: i64)
  HirBreak(tok: i64)
  HirExprStmt(expr: i64)
  HirErrorStmt(tok: i64)

  // Expressions
  HirIntLit(value: i64, typ: i64)
  HirFloatLit(tok: i64, typ: i64)
  HirStringLit(tok: i64, typ: i64)
  HirBoolLit(tok: i64, typ: i64)
  HirIdent(sym: i64, typ: i64, tok: i64)
  HirBinary(op: i64, left: i64, right: i64, typ: i64)
  HirUnary(op: i64, operand: i64, typ: i64)
  // `subst`: the checker's record of what the call decided of the
  // parameters its callee is generic over (call_subst_key), or -1.
  HirCall(callee: i64, args_lp: i64, arg_count: i64, typ: i64, subst: i64)
  HirFieldAccess(obj: i64, field: i64, typ: i64)
  HirPipe(left: i64, right: i64, typ: i64)
  HirQualName(segs_lp: i64, seg_count: i64, typ: i64)
  // The declaration index of the variant an enum value holds, and the
  // `field`-th payload value of its `variant`-th variant: what `match`
  // lowers a payload-bearing enum's arms to (the host's
  // HirEnumDiscriminant / HirEnumPayload).
  HirEnumDiscriminant(value: i64, typ: i64)
  HirEnumPayload(value: i64, variant: i64, field: i64, typ: i64)
  // A class value built from its fields, in declaration order (the
  // host's HirConstruct), and a payload-bearing enum's value of its
  // `variant`-th variant (HirEnumConstruct): the payload is
  // (argument, field index) pairs in source order — evaluated in that
  // order, placed by field index.
  HirConstruct(args_lp: i64, arg_count: i64, typ: i64)
  // An operation of `Ptr<T>` (the host's HirPtrOp): `op` is a
  // ptr_op_* code; `pointer` is the receiver (-1 for `new`), `argument`
  // the value written or the elements walked (-1 where there is none).
  HirPtrOp(op: i64, pointer: i64, argument: i64, typ: i64)
  HirEnumConstruct(variant: i64, payload_lp: i64, payload_count: i64, typ: i64)
  HirErrorExpr(tok: i64)

// =========================================================================
// Section 50: HIR state and result types
// =========================================================================

// The module being lowered: its syntax, source, and identity.
class HirModule:
  nodes: Vector<Node>
  idx_data: Vector<i64>
  toks: Vector<Token>
  src: string
  module_id: i64                 // module id (used in composite keys)
  file_id: i64                   // file id (used in composite keys)

// The HIR being built: its nodes and its index data.
class HirArena:
  nodes: Vector<HirNode>
  idx: Vector<i64>

class HS:
  unit: HirModule                // the module being lowered
  symbols: Vector<Symbol>
  typecheck: TypeCheckData       // the program's type tables, expression types, and method dispatch
  uses_map: HashMap<i64>         // program-level uses_key(file_id, tok_idx) → sym_idx
  arena: HirArena
  diags: Vector<Diagnostic>

// A lowering state over module `mid` of `p`, writing into `arena`.
fn hs_new(p: Program, mid: i64, arena: HirArena): HS
  let sf: SourceFile = program_file_of_module(p, mid)
  let po: ParseOutput = sf.parse_output
  return HS(HirModule(po.nodes, po.idx, po.toks, sf.source_text, mid, sf.file_id), p.resolve.symbols, p.typecheck, p.resolve.uses, arena, Vector<Diagnostic>::new())

fn arena_empty(): HirArena
  return HirArena(Vector<HirNode>::new(), Vector<i64>::new())

fn hir_result_empty(): HirResult
  return HirResult(Vector<HirNode>::new(), Vector<i64>::new(), Vector<DaoType>::new(), Vector<i64>::new(), Vector<Token>::new(), "", Vector<Diagnostic>::new(), to_i64(-1))

class HirResult:
  hir_nodes: Vector<HirNode>
  hir_idx: Vector<i64>
  types: Vector<DaoType>
  type_info: Vector<i64>
  toks: Vector<Token>
  src: string
  diags: Vector<Diagnostic>
  root: i64

class HirR:
  hs: HS
  hir: i64

// =========================================================================
// Section 51: HS state helpers
// =========================================================================

fn hs_add_node(hs: HS, node: HirNode): HirR
  let idx: i64 = hs.arena.nodes.length()
  hs.arena = HirArena(hs.arena.nodes.push(node), hs.arena.idx)
  return HirR(hs, idx)

fn hs_add_diag(hs: HS, span: Span, msg: string): HS
  hs.diags = hs.diags.push(make_error(span, msg))
  return hs

fn hs_idx_push(hs: HS, val: i64): HS
  hs.arena = HirArena(hs.arena.nodes, hs.arena.idx.push(val))
  return hs

fn hs_tok_name(hs: HS, tidx: i64): string
  let tok: Token = hs.unit.toks.get(tidx)
  return substring(hs.unit.src, tok.offset, tok.len)

fn hs_tok_span(hs: HS, tidx: i64): Span
  let tok: Token = hs.unit.toks.get(tidx)
  return Span(tok.offset, tok.len)

// =========================================================================
// Section 52: HIR flush list
// =========================================================================

class HirFlush:
  hs: HS
  list_pos: i64

fn hir_flush_list(hs: HS, items: Vector<i64>): HirFlush
  let cur: HS = hs
  let i: i64 = 0
  while i < items.length():
    cur = hs_idx_push(cur, items.get(i))
    i = i + 1
  let lp: i64 = cur.arena.idx.length()
  cur = hs_idx_push(cur, items.length())
  return HirFlush(cur, lp)

fn hir_flush_pairs(hs: HS, items: Vector<i64>, pair_count: i64): HirFlush
  let cur: HS = hs
  let i: i64 = 0
  while i < items.length():
    cur = hs_idx_push(cur, items.get(i))
    i = i + 1
  let lp: i64 = cur.arena.idx.length()
  cur = hs_idx_push(cur, pair_count)
  return HirFlush(cur, lp)

// =========================================================================
// Section 53: Type lookup helpers
// =========================================================================

// Extract type_idx from an already-lowered HIR expression node.
fn hir_expr_type(node: HirNode): i64
  match node:
    HirNode::HirIntLit(t, ti):
      return ti
    HirNode::HirFloatLit(t, ti):
      return ti
    HirNode::HirStringLit(t, ti):
      return ti
    HirNode::HirBoolLit(t, ti):
      return ti
    HirNode::HirIdent(s, ti, t):
      return ti
    HirNode::HirBinary(o, l, r, ti):
      return ti
    HirNode::HirUnary(o, op, ti):
      return ti
    HirNode::HirCall(c, a, n, ti, sb):
      return ti
    HirNode::HirFieldAccess(o, f, ti):
      return ti
    HirNode::HirPipe(l, r, ti):
      return ti
    HirNode::HirQualName(t, n, ti):
      return ti
    HirNode::HirEnumDiscriminant(v, ti):
      return ti
    HirNode::HirEnumPayload(v, vi, fi, ti):
      return ti
    HirNode::HirConstruct(a, n, ti):
      return ti
    HirNode::HirEnumConstruct(v, p, n, ti):
      return ti
    HirNode::HirPtrOp(op, p, a, ti):
      return ti
  return to_i64(-1)

// The concept that provides the member a field expression names — the
// checker records it (under the access's `:concept` key) when it typed
// the access through a derived conformance or a type parameter's bound
// — or -1 for a field or a class's own method.  Such a member has no
// implementation to dispatch to until the concept's method is
// synthesized for the receiver (derivation) or the parameter is
// instantiated (generic inference), so lowering rejects it.
fn hir_member_concept(hs: HS, field_node_idx: i64): i64
  return hm_get_or(hs.typecheck.lookup.expr_types, concept_member_key(hs.unit.module_id, field_node_idx), to_i64(-1))

// Whether the field expression `node_idx` (`obj.field`) names a method
// of the receiver's type rather than a field: its type is a function
// type and the dispatch index answers the name for that type.
fn hir_is_method_value(hs: HS, node_idx: i64, obj: i64, field_tidx: i64): bool
  let ti: i64 = hir_get_expr_type(hs, node_idx)
  if ti < 0:
    return false
  if ti >= hs.typecheck.types.length():
    return false
  let is_fn: bool = false
  match hs.typecheck.types.get(ti).kind:
    TypeKind::TFunction:
      is_fn = true
  if is_fn == false:
    return false
  return hir_find_method_sym(hs, hs_tok_name(hs, field_tidx), hir_get_expr_type(hs, obj)) >= 0

// Reject a use of a concept-provided member (see hir_member_concept)
// with a diagnostic naming the member, its concept, and the use.
fn hir_reject_concept_member(hs: HS, field_node_idx: i64, field_tidx: i64, use_desc: string): HirR
  let concept_ti: i64 = hir_member_concept(hs, field_node_idx)
  let concept_name: string = "?"
  if concept_ti >= 0:
    if concept_ti < hs.typecheck.types.length():
      concept_name = hs.typecheck.types.get(concept_ti).name
  let cur: HS = hs_add_diag(hs, hs_tok_span(hs, field_tidx), "method '" + hs_tok_name(hs, field_tidx) + "' of concept '" + concept_name + "' is provided through a derived conformance or a bound and cannot be " + use_desc + " in Tier A HIR (no implementation to dispatch to yet)")
  return hs_add_node(cur, HirNode::HirErrorExpr(tok = field_tidx))

fn hir_get_expr_type(hs: HS, ast_node_idx: i64): i64
  let key: string = expr_id_key(hs.unit.module_id, ast_node_idx)
  let found: Option<i64> = hs.typecheck.lookup.expr_types.get(key)
  match found:
    Option::Some(ti):
      return ti
    Option::None:
      return to_i64(-1)

fn hir_lookup_use(hs: HS, tok_idx: i64): i64
  let key: string = uses_key(hs.unit.file_id, tok_idx)
  let result: Option<i64> = hs.uses_map.get(key)
  match result:
    Option::Some(sym_idx):
      return sym_idx
    Option::None:
      return to_i64(-1)

fn hir_sym_type(hs: HS, sym_idx: i64): i64
  if sym_idx < 0:
    return to_i64(-1)
  if sym_idx >= hs.typecheck.sym_types.length():
    return to_i64(-1)
  return hs.typecheck.sym_types.get(sym_idx)

// =========================================================================
// Section 53b: Method dispatch helpers
// =========================================================================

// The method a receiver answers to, by the checker's rule (typecheck
// find_method_sym_for_receiver): its own type's method, else an extend of
// that very type visible from this module — so HIR desugars a dot-call
// to the symbol the checker typed it with, never a same-named one.
fn hir_find_method_sym(hs: HS, name: string, receiver_ti: i64): i64
  let owner_ti: i64 = dispatch_owner(hs.typecheck.types, hs.typecheck.type_info, receiver_ti)
  return find_method_sym_for_receiver(hs.typecheck.lookup.methods, hs.unit.module_id, name, receiver_ti, owner_ti)

// =========================================================================
// Section 54: Expression lowering
// =========================================================================

fn lower_expr(hs: HS, node_idx: i64): HirR
  if node_idx < 0:
    return hs_add_node(hs, HirNode::HirErrorExpr(tok = to_i64(0)))
  let node: Node = hs.unit.nodes.get(node_idx)
  let ti: i64 = hir_get_expr_type(hs, node_idx)
  match node:
    Node::IntLitE(tidx):
      let int_ti: i64 = ti
      if int_ti < 0:
        int_ti = 2  // default i32
      let lexeme: string = hs_tok_name(hs, tidx)
      if i64_literal_fits(lexeme) == false:
        let wide: HS = hs_add_diag(hs, hs_tok_span(hs, tidx), "integer literal " + lexeme + " does not fit in 64 bits")
        return hs_add_node(wide, HirNode::HirErrorExpr(tok = tidx))
      return hs_add_node(hs, HirNode::HirIntLit(value = parse_i64_literal(lexeme), typ = int_ti))
    Node::FloatLitE(tidx):
      let float_ti: i64 = ti
      if float_ti < 0:
        float_ti = 9  // default f64
      return hs_add_node(hs, HirNode::HirFloatLit(tok = tidx, typ = float_ti))
    Node::StringLitE(tidx):
      let str_ti: i64 = ti
      if str_ti < 0:
        str_ti = 12  // default string
      return hs_add_node(hs, HirNode::HirStringLit(tok = tidx, typ = str_ti))
    Node::BoolLitE(tidx):
      let bool_ti: i64 = ti
      if bool_ti < 0:
        bool_ti = 10  // default bool
      return hs_add_node(hs, HirNode::HirBoolLit(tok = tidx, typ = bool_ti))
    Node::IdentE(tidx):
      let sym_idx: i64 = hir_lookup_use(hs, tidx)
      let ident_ti: i64 = ti
      if ident_ti < 0:
        if sym_idx >= 0:
          ident_ti = hir_sym_type(hs, sym_idx)
      return hs_add_node(hs, HirNode::HirIdent(sym = sym_idx, typ = ident_ti, tok = tidx))
    Node::BinaryE(op_tidx, left, right):
      let lr: HirR = lower_expr(hs, left)
      let rr: HirR = lower_expr(lr.hs, right)
      // Fallback: if typechecker didn't record type (value-corruption),
      // infer from the already-lowered HIR children's types.
      let bin_ti: i64 = ti
      if bin_ti < 0:
        let tok: Token = rr.hs.unit.toks.get(op_tidx)
        let is_cmp: bool = false
        if tk_name(tok.kind) == tk_name(TK::EqEq):
          is_cmp = true
        if tk_name(tok.kind) == tk_name(TK::BangEq):
          is_cmp = true
        if tk_name(tok.kind) == tk_name(TK::Lt):
          is_cmp = true
        if tk_name(tok.kind) == tk_name(TK::LtEq):
          is_cmp = true
        if tk_name(tok.kind) == tk_name(TK::Gt):
          is_cmp = true
        if tk_name(tok.kind) == tk_name(TK::GtEq):
          is_cmp = true
        if tk_name(tok.kind) == tk_name(TK::KwAnd):
          is_cmp = true
        if tk_name(tok.kind) == tk_name(TK::KwOr):
          is_cmp = true
        if is_cmp:
          bin_ti = 10  // bool
        else:
          // Arithmetic: extract type from left HIR child node
          let left_hir: HirNode = rr.hs.arena.nodes.get(lr.hir)
          bin_ti = hir_expr_type(left_hir)
      return hs_add_node(rr.hs, HirNode::HirBinary(op = op_tidx, left = lr.hir, right = rr.hir, typ = bin_ti))
    Node::UnaryE(op_tidx, operand):
      let or2: HirR = lower_expr(hs, operand)
      return hs_add_node(or2.hs, HirNode::HirUnary(op = op_tidx, operand = or2.hir, typ = ti))
    Node::CallE(callee, args_lp, arg_count, targs_lp, names_lp, targs_on_type):
      return with_call_subst(lower_call_expr(hs, node_idx, callee, args_lp, names_lp, ti), hm_get_or(hs.typecheck.lookup.expr_types, call_subst_key(hs.unit.module_id, node_idx), to_i64(-1)))
    Node::FieldE(obj, field_tidx):
      // A concept-provided member taken as a value has no field to read
      // and no implementation to name (see hir_member_concept).
      if hir_member_concept(hs, node_idx) >= 0:
        return hir_reject_concept_member(hs, node_idx, field_tidx, "taken as a value")
      // A method taken as a value — the access has a function type and
      // the receiver's type answers the name — has no field to read
      // either; a bound method value is no Tier A construct, so it is
      // rejected rather than lowered as a field access.
      if hir_is_method_value(hs, node_idx, obj, field_tidx):
        let mcur: HS = hs_add_diag(hs, hs_tok_span(hs, field_tidx), "method '" + hs_tok_name(hs, field_tidx) + "' taken as a value is not lowered in Tier A HIR")
        return hs_add_node(mcur, HirNode::HirErrorExpr(tok = field_tidx))
      let obj_r: HirR = lower_expr(hs, obj)
      return hs_add_node(obj_r.hs, HirNode::HirFieldAccess(obj = obj_r.hir, field = field_tidx, typ = ti))
    Node::PipeE(left, right):
      let lr: HirR = lower_expr(hs, left)
      let rr: HirR = lower_expr(lr.hs, right)
      return hs_add_node(rr.hs, HirNode::HirPipe(left = lr.hir, right = rr.hir, typ = ti))
    Node::QualNameE(seg_lp, seg_count):
      // `Enum::Variant` as a value: a classification enum's is its
      // index; a payload-bearing enum's a construction with no payload.
      let named_variant: i64 = hir_named_variant(hs, node_idx)
      if named_variant >= 0:
        return lower_variant_value(hs, named_variant, to_i64(-1), Vector<i64>::new(), ti)
      let segs: Vector<i64> = read_list(hs.unit.idx_data, seg_lp)
      // `Type::method` as a value names one of the type's own methods:
      // a function reference to its symbol, like a free function's name.
      let smsym: i64 = hir_qualified_method_sym(hs, segs)
      if smsym >= 0:
        return hs_add_node(hs, HirNode::HirIdent(sym = smsym, typ = hir_sym_type(hs, smsym), tok = segs.get(to_i64(1))))
      // `module::name` names that module's member: a reference to its
      // symbol, as the unqualified name would be.
      let member: i64 = hir_module_member_sym(hs, segs)
      if member >= 0:
        return hs_add_node(hs, HirNode::HirIdent(sym = member, typ = hir_sym_type(hs, member), tok = segs.get(to_i64(1))))
      // Preserve all segment token indices in HIR idx.
      let seg_fl: HirFlush = hir_flush_list(hs, segs)
      return hs_add_node(seg_fl.hs, HirNode::HirQualName(segs_lp = seg_fl.list_pos, seg_count = segs.length(), typ = ti))
    Node::TryE(operand):
      // Tier B deferral — lower operand, emit error
      let cur: HS = hs_add_diag(hs, Span(to_i64(0), to_i64(1)), "try operator not supported in Tier A HIR")
      return hs_add_node(cur, HirNode::HirErrorExpr(tok = to_i64(0)))
    Node::LambdaE(params_lp, param_count, body):
      let cur: HS = hs_add_diag(hs, Span(to_i64(0), to_i64(1)), "lambda not supported in Tier A HIR")
      return hs_add_node(cur, HirNode::HirErrorExpr(tok = to_i64(0)))
    Node::ListLitE(elems_lp, elem_count):
      let cur: HS = hs_add_diag(hs, Span(to_i64(0), to_i64(1)), "list literal not supported in Tier A HIR")
      return hs_add_node(cur, HirNode::HirErrorExpr(tok = to_i64(0)))
    Node::IndexE(obj, idx_expr):
      let cur: HS = hs_add_diag(hs, Span(to_i64(0), to_i64(1)), "index expression not supported in Tier A HIR")
      return hs_add_node(cur, HirNode::HirErrorExpr(tok = to_i64(0)))
    Node::ErrorE(t):
      return hs_add_node(hs, HirNode::HirErrorExpr(tok = to_i64(0)))
  return hs_add_node(hs, HirNode::HirErrorExpr(tok = to_i64(0)))

// A lowered call carries the checker's record of what it decided
// (record_call_subst); whatever else the call lowered to is unchanged.
fn with_call_subst(r: HirR, subst: i64): HirR
  if subst < 0 or r.hir < 0:
    return r
  match r.hs.arena.nodes.get(r.hir):
    HirNode::HirCall(callee, args_lp, arg_count, typ, old):
      r.hs.arena = HirArena(r.hs.arena.nodes.set(r.hir, HirNode::HirCall(callee = callee, args_lp = args_lp, arg_count = arg_count, typ = typ, subst = subst)), r.hs.arena.idx)
  return r

// `p.get()`, `p.set(v)`, `p.offset(n)`, `p.cast<U>()`, `p.is_null()`,
// `Ptr<T>::new()` → HirPtrOp: the receiver first, then the argument.
fn lower_ptr_op(hs: HS, op: i64, callee: i64, args_lp: i64, ti: i64): HirR
  let cur: HS = hs
  let pointer: i64 = to_i64(-1)
  match cur.unit.nodes.get(callee):
    Node::FieldE(obj, field_tidx):
      let pr: HirR = lower_expr(cur, obj)
      cur = pr.hs
      pointer = pr.hir
  let argument: i64 = to_i64(-1)
  let args: Vector<i64> = Vector<i64>::new()
  if args_lp >= 0:
    args = read_list(cur.unit.idx_data, args_lp)
  if args.length() > 0:
    let ar: HirR = lower_expr(cur, args.get(0))
    cur = ar.hs
    argument = ar.hir
  return hs_add_node(cur, HirNode::HirPtrOp(op = op, pointer = pointer, argument = argument, typ = ti))

// The declaration index of the variant the name at `node_idx` denotes,
// as the checker recorded it; -1 when it names no variant.
fn hir_named_variant(hs: HS, node_idx: i64): i64
  return hm_get_or(hs.typecheck.lookup.expr_types, variant_index_key(hs.unit.module_id, node_idx), to_i64(-1))

// The value of variant `variant` of the enum `ti`, its payload the
// lowered `hir_args` of the AST arguments `args`: a classification
// enum's value is the variant's index; a payload-bearing enum's is a
// construction whose payload pairs each argument, in source order, with
// the field it fills — its declaration position, by name when the
// checker recorded one (`<arg key>:param`), else by position.
fn lower_variant_value(hs: HS, variant: i64, args_lp: i64, hir_args: Vector<i64>, ti: i64): HirR
  if hir_enum_has_payload(hs, ti) == false:
    return hs_add_node(hs, HirNode::HirIntLit(value = variant, typ = ti))
  let args: Vector<i64> = Vector<i64>::new()
  if args_lp >= 0:
    args = read_list(hs.unit.idx_data, args_lp)
  let pairs: Vector<i64> = Vector<i64>::new()
  let ai: i64 = 0
  while ai < hir_args.length():
    let field: i64 = ai
    if ai < args.length():
      field = hm_get_or(hs.typecheck.lookup.expr_types, expr_id_key(hs.unit.module_id, args.get(ai)) + ":param", ai)
    pairs = pairs.push(hir_args.get(ai))
    pairs = pairs.push(field)
    ai = ai + 1
  let fl: HirFlush = hir_flush_pairs(hs, pairs, hir_args.length())
  return hs_add_node(fl.hs, HirNode::HirEnumConstruct(variant = variant, payload_lp = fl.list_pos, payload_count = hir_args.length(), typ = ti))

// Whether a call's callee names a class — `P(1, 2)`, `Box<i32>(3)`,
// `lib::P(1)` — so the call builds a value of it: the callee names a
// type, and the call is typed as a class.
fn hir_callee_is_class(hs: HS, callee: i64, call_ti: i64): bool
  if call_ti < 0 or call_ti >= hs.typecheck.types.length():
    return false
  match hs.typecheck.types.get(call_ti).kind:
    TypeKind::TStruct:
      return hir_names_type(hs, callee)
  return false

// Whether a callee expression names a type: a name resolving to a type,
// or `module::Type` — which the checker types as the type itself (a
// module's function it types as a function).
fn hir_names_type(hs: HS, callee: i64): bool
  match hs.unit.nodes.get(callee):
    Node::IdentE(ctidx):
      let csym: i64 = hir_lookup_use(hs, ctidx)
      if csym < 0:
        return false
      match hs.symbols.get(csym).kind:
        SymbolKind::Type:
          return true
    Node::QualNameE(seg_lp, seg_count):
      let callee_ti: i64 = hir_get_expr_type(hs, callee)
      if callee_ti >= 0 and callee_ti < hs.typecheck.types.length():
        match hs.typecheck.types.get(callee_ti).kind:
          TypeKind::TStruct:
            return true
  return false

// The method a two-segment qualified name `Type::method` names — the
// type's own, by the dispatch index — or -1 when the name is something
// else (an enum's variant, a module's member).  Any of the type's own
// methods qualifies: a static one takes its declared parameters, and an
// instance one takes its receiver as an explicit first argument
// (`C::get(c)`), as the checker typed it.
// The member `module::name` names: the use the resolver recorded on
// its last segment (the overload of the call's arity, for a call), when
// the head is an imported module; -1 otherwise.
fn hir_module_member_sym(hs: HS, segs: Vector<i64>): i64
  if segs.length() != 2:
    return to_i64(-1)
  let head_sym: i64 = hir_lookup_use(hs, segs.get(to_i64(0)))
  if head_sym < 0:
    return to_i64(-1)
  if symbol_kind_name(hs.symbols.get(head_sym).kind) != "Module":
    return to_i64(-1)
  return hir_lookup_use(hs, segs.get(to_i64(1)))

fn hir_qualified_method_sym(hs: HS, segs: Vector<i64>): i64
  if segs.length() != 2:
    return to_i64(-1)
  let head_sym: i64 = hir_lookup_use(hs, segs.get(to_i64(0)))
  if head_sym < 0:
    return to_i64(-1)
  // Only a type's name is a namespace (the checker rejects a value's).
  if symbol_kind_name(hs.symbols.get(head_sym).kind) != "Type":
    return to_i64(-1)
  let head_ti: i64 = hir_sym_type(hs, head_sym)
  if head_ti < 0:
    return to_i64(-1)
  return find_inherent_method_sym(hs.typecheck.lookup.methods, hs_tok_name(hs, segs.get(to_i64(1))), head_ti)

// Emit a call of the method symbol `msym` (its type names the result):
// the receiver, when there is one, then the arguments in order.
fn emit_method_call(hs: HS, msym: i64, callee_tok: i64, receiver: i64, args_lp: i64, ti: i64): HirR
  let cur: HS = hs
  let hir_args: Vector<i64> = Vector<i64>::new()
  if receiver >= 0:
    let obj_r: HirR = lower_expr(cur, receiver)
    cur = obj_r.hs
    hir_args = hir_args.push(obj_r.hir)
  let args: Vector<i64> = read_list(cur.unit.idx_data, args_lp)
  let ai: i64 = 0
  while ai < args.length():
    let ar: HirR = lower_expr(cur, args.get(ai))
    cur = ar.hs
    hir_args = hir_args.push(ar.hir)
    ai = ai + 1
  let fl: HirFlush = hir_flush_list(cur, hir_args)
  let meth_ti: i64 = hir_sym_type(fl.hs, msym)
  let callee_hir: HirR = hs_add_node(fl.hs, HirNode::HirIdent(sym = msym, typ = meth_ti, tok = callee_tok))
  // The call's type: the checker's, else the method's return type.
  let call_ti: i64 = ti
  if call_ti < 0:
    if meth_ti >= 0:
      let mt: DaoType = callee_hir.hs.typecheck.types.get(meth_ti)
      match mt.kind:
        TypeKind::TFunction:
          call_ti = mt.ret_type
  return hs_add_node(callee_hir.hs, HirNode::HirCall(callee = callee_hir.hir, args_lp = fl.list_pos, arg_count = hir_args.length(), typ = call_ti, subst = to_i64(-1)))

// Whether the expression's type is a type parameter.
fn hir_is_type_param(hs: HS, node_idx: i64): bool
  let ti: i64 = hir_get_expr_type(hs, node_idx)
  if ti < 0 or ti >= hs.typecheck.types.length():
    return false
  match hs.typecheck.types.get(ti).kind:
    TypeKind::TGenericParam:
      return true
  return false

// `x.to_string()` with `T: Printable`: a call whose callee is the
// member access on the parameter, typed by the concept's signature
// (host).  The arguments follow the receiver's access, not the receiver
// itself.
fn lower_bound_call(hs: HS, callee: i64, obj: i64, field_tidx: i64, args_lp: i64, callee_ti: i64, ti: i64): HirR
  let obj_r: HirR = lower_expr(hs, obj)
  let access_r: HirR = hs_add_node(obj_r.hs, HirNode::HirFieldAccess(obj = obj_r.hir, field = field_tidx, typ = callee_ti))
  let cur: HS = access_r.hs
  let hir_args: Vector<i64> = Vector<i64>::new()
  let args: Vector<i64> = read_list(cur.unit.idx_data, args_lp)
  let ai: i64 = 0
  while ai < args.length():
    let ar: HirR = lower_expr(cur, args.get(ai))
    cur = ar.hs
    hir_args = hir_args.push(ar.hir)
    ai = ai + 1
  let fl: HirFlush = hir_flush_list(cur, hir_args)
  return hs_add_node(fl.hs, HirNode::HirCall(callee = access_r.hir, args_lp = fl.list_pos, arg_count = hir_args.length(), typ = ti, subst = to_i64(-1)))

fn lower_call_expr(hs: HS, node_idx: i64, callee: i64, args_lp: i64, names_lp: i64, ti: i64): HirR
  // ---------------------------------------------------------------
  // Method call desugaring: obj.method(args) → Method(obj, args)
  // ---------------------------------------------------------------
  // Preconditions for desugaring:
  //   1. Callee is a FieldE node.
  //   2. The type checker resolved the FieldE's expression type as
  //      TFunction.  If it resolved as anything else (e.g. TStruct
  //      for a concrete field with the same name as a method), the
  //      callee is a field access, not a method — do NOT desugar.
  //   3. The receiver's type answers to the name in the method dispatch
  //      index (its own method, or an extend of it visible here) — a
  //      struct, a builtin (`extend i32 as Show`), any type.
  //
  // Gating on (2) prevents rewriting `obj.name()` to `Type.name(obj)`
  // when the class has both a field `name` and a method `name`:
  // check_field_expr prefers field lookup, so the FieldE's resolved
  // type is the field's type, not a function type.
  // An operation of `Ptr<T>`, as the checker recorded it: never a
  // method call or a call of a qualified name.
  let ptr_op: i64 = hm_get_or(hs.typecheck.lookup.expr_types, ptr_op_key(hs.unit.module_id, node_idx), to_i64(-1))
  if ptr_op >= 0:
    return lower_ptr_op(hs, ptr_op, callee, args_lp, ti)
  let callee_node: Node = hs.unit.nodes.get(callee)
  match callee_node:
    Node::FieldE(mobj, mfield_tidx):
      // Check if the type checker resolved the FieldE as a function
      // type.  If not (e.g. it's a concrete field), suppress the
      // desugaring so we don't rewrite a field access as a method call.
      let callee_ti: i64 = hir_get_expr_type(hs, callee)
      let is_method_callee: bool = false
      if callee_ti >= 0:
        let callee_type: DaoType = hs.typecheck.types.get(callee_ti)
        match callee_type.kind:
          TypeKind::TFunction:
            is_method_callee = true
      // A member a concept provides through a type parameter's bound is
      // called on the parameter: the host carries the call with the
      // member access as its callee, and an instantiation resolves it
      // (monomorphization, Tasks 42–45), so MIR rejects it fail-closed
      // (lower_bound_call).  One provided through a derived conformance
      // has no implementation to dispatch to at all, and is rejected.
      if hir_member_concept(hs, callee) >= 0:
        if hir_is_type_param(hs, mobj):
          return lower_bound_call(hs, callee, mobj, mfield_tidx, args_lp, callee_ti, ti)
        return hir_reject_concept_member(hs, callee, mfield_tidx, "called")
      let obj_ti: i64 = hir_get_expr_type(hs, mobj)
      // Use sentinel values to avoid deep nesting: if any guard fails,
      // obj_ti is set to -1 and the lookup is skipped.
      let method_obj_ti: i64 = obj_ti
      if is_method_callee == false:
        method_obj_ti = to_i64(-1)
      if method_obj_ti >= 0:
        let msym: i64 = hir_find_method_sym(hs, hs_tok_name(hs, mfield_tidx), method_obj_ti)
        // With no method for the receiver's type (and no providing
        // concept, rejected above) the access is a field, which the
        // normal call path below calls as a value.  A method found here
        // takes `self` (the checker rejects a static one called through
        // a value), so the receiver is its first argument:
        //   CallE(FieldE(obj, method), [a1, a2])
        //     → HirCall(HirIdent(msym), [obj, a1, a2])
        if msym >= 0:
          return emit_method_call(hs, msym, mfield_tidx, mobj, args_lp, ti)
    Node::QualNameE(seg_lp, seg_count):
      // `Type::method(...)`: one of the type's own methods, as the
      // checker typed it (check_qualname_expr) — static, or an instance
      // method given its receiver as the first argument.  The call names
      // the method symbol, never a qualified name MIR cannot lower.
      let qsegs: Vector<i64> = read_list(hs.unit.idx_data, seg_lp)
      let smsym: i64 = hir_qualified_method_sym(hs, qsegs)
      if smsym >= 0:
        return emit_method_call(hs, smsym, qsegs.get(to_i64(1)), to_i64(-1), args_lp, ti)

  // ---------------------------------------------------------------
  // Normal call path (non-method)
  // ---------------------------------------------------------------
  // A variant's construction, and a class's: the host's EnumConstruct
  // and Construct, never a call of a type.  Decided before the callee is
  // lowered — a callee naming a type or a variant is no value to lower.
  let call_variant: i64 = hir_named_variant(hs, callee)
  let constructs_class: bool = hir_callee_is_class(hs, callee, ti)
  let cur: HS = hs
  let callee_hir: i64 = to_i64(-1)
  if call_variant < 0 and constructs_class == false:
    let callee_r: HirR = lower_expr(hs, callee)
    cur = callee_r.hs
    callee_hir = callee_r.hir
  let args: Vector<i64> = read_list(cur.unit.idx_data, args_lp)
  let hir_args: Vector<i64> = Vector<i64>::new()
  let ai: i64 = 0
  while ai < args.length():
    let ar: HirR = lower_expr(cur, args.get(ai))
    cur = ar.hs
    hir_args = hir_args.push(ar.hir)
    ai = ai + 1
  if call_variant >= 0:
    return lower_variant_value(cur, call_variant, args_lp, hir_args, ti)
  if constructs_class:
    let cfl: HirFlush = hir_flush_list(cur, hir_args)
    return hs_add_node(cfl.hs, HirNode::HirConstruct(args_lp = cfl.list_pos, arg_count = hir_args.length(), typ = ti))
  let fl: HirFlush = hir_flush_list(cur, hir_args)
  // Fallback: if typechecker didn't record type (value-corruption),
  // infer from callee — if it's a function, use return type;
  // if it's a struct constructor (IdentE resolving to Type sym), use struct type.
  let call_ti: i64 = ti
  if call_ti < 0:
    let callee_ti: i64 = hir_get_expr_type(fl.hs, callee)
    if callee_ti >= 0:
      let ct: DaoType = fl.hs.typecheck.types.get(callee_ti)
      match ct.kind:
        TypeKind::TFunction:
          call_ti = ct.ret_type
    // Check if callee is an IdentE resolving to a Type symbol (struct constructor)
    if call_ti < 0:
      let cn: Node = fl.hs.unit.nodes.get(callee)
      match cn:
        Node::IdentE(ctidx):
          let csym: i64 = hir_lookup_use(fl.hs, ctidx)
          if csym >= 0:
            let sym: Symbol = fl.hs.symbols.get(csym)
            match sym.kind:
              SymbolKind::Type:
                call_ti = hir_sym_type(fl.hs, csym)
  return hs_add_node(fl.hs, HirNode::HirCall(callee = callee_hir, args_lp = fl.list_pos, arg_count = args.length(), typ = call_ti, subst = to_i64(-1)))

// =========================================================================
// Section 55: Statement lowering
// =========================================================================

fn lower_stmt(hs: HS, node_idx: i64): HirR
  if node_idx < 0:
    return hs_add_node(hs, HirNode::HirErrorStmt(tok = to_i64(0)))
  let node: Node = hs.unit.nodes.get(node_idx)
  match node:
    Node::LetS(name_tidx, type_node, init_node):
      return lower_let_stmt(hs, node_idx, name_tidx, type_node, init_node)
    Node::AssignS(target, value):
      let tr: HirR = lower_expr(hs, target)
      let vr: HirR = lower_expr(tr.hs, value)
      return hs_add_node(vr.hs, HirNode::HirAssign(target = tr.hir, value = vr.hir))
    Node::IfS(cond, then_lp, else_lp):
      return lower_if_stmt(hs, cond, then_lp, else_lp)
    Node::WhileS(cond, body_lp):
      return lower_while_stmt(hs, cond, body_lp)
    Node::ResourceS(kind_tidx, name_tidx, body_lp):
      let body_fl: HirFlush = lower_body_stmts(hs, body_lp)
      return hs_add_node(body_fl.hs, HirNode::HirResource(kind = kind_tidx, name = name_tidx, body_lp = body_fl.list_pos))
    Node::ModeS(name_tidx, body_lp):
      let mode_body_fl: HirFlush = lower_body_stmts(hs, body_lp)
      return hs_add_node(mode_body_fl.hs, HirNode::HirMode(name = name_tidx, body_lp = mode_body_fl.list_pos))
    Node::YieldS(yield_tidx, val_node):
      if val_node < 0:
        return hs_add_node(hs, HirNode::HirYield(value = to_i64(-1)))
      let yr: HirR = lower_expr(hs, val_node)
      return hs_add_node(yr.hs, HirNode::HirYield(value = yr.hir))
    Node::ForS(var_tidx, iter_node, body_lp):
      return lower_for_stmt(hs, node_idx, iter_node, body_lp)
    Node::ReturnS(val_node):
      return lower_return_stmt(hs, val_node)
    Node::BreakS(tidx):
      return hs_add_node(hs, HirNode::HirBreak(tok = to_i64(0)))
    Node::MatchS(scrut_node, arms_lp):
      // A match is two statements; it lowers into its statement list
      // (lower_stmts_into), never alone.
      let lone: HS = hs_add_diag(hs, Span(to_i64(0), to_i64(1)), "match lowered outside a statement list")
      return hs_add_node(lone, HirNode::HirErrorStmt(tok = to_i64(0)))
    Node::ExprStmtS(expr_node):
      let er: HirR = lower_expr(hs, expr_node)
      return hs_add_node(er.hs, HirNode::HirExprStmt(expr = er.hir))
    Node::ErrorS(t):
      return hs_add_node(hs, HirNode::HirErrorStmt(tok = to_i64(0)))
  return hs_add_node(hs, HirNode::HirErrorStmt(tok = to_i64(0)))

fn lower_let_stmt(hs: HS, node_idx: i64, name_tidx: i64, type_node: i64, init_node: i64): HirR
  // The Local the resolver declared for this `let`, by the program's
  // declaration index — keyed by module, since a declaration's node index
  // is only unique within its module.  Stored on HirLet so MIR binds the
  // slot to the symbol every read and store of the name resolves to.
  let let_sym: i64 = member_sym_of(hs.typecheck.lookup.index, hs.unit.module_id, node_idx, "Local", "")
  let let_ti: i64 = to_i64(-1)
  if let_sym >= 0:
    let_ti = hir_sym_type(hs, let_sym)
  let init_hir: i64 = to_i64(-1)
  let cur: HS = hs
  if init_node >= 0:
    let ir: HirR = lower_expr(cur, init_node)
    cur = ir.hs
    init_hir = ir.hir
  return hs_add_node(cur, HirNode::HirLet(sym = let_sym, typ = let_ti, init = init_hir))

fn lower_if_stmt(hs: HS, cond: i64, then_lp: i64, else_lp: i64): HirR
  let cr: HirR = lower_expr(hs, cond)
  let cur: HS = cr.hs
  let then_fl: HirFlush = lower_body_stmts(cur, then_lp)
  cur = then_fl.hs
  let else_list_pos: i64 = to_i64(-1)
  if else_lp >= 0:
    let else_fl: HirFlush = lower_body_stmts(cur, else_lp)
    cur = else_fl.hs
    else_list_pos = else_fl.list_pos
  return hs_add_node(cur, HirNode::HirIf(cond = cr.hir, then_lp = then_fl.list_pos, else_lp = else_list_pos))

fn lower_while_stmt(hs: HS, cond: i64, body_lp: i64): HirR
  let cr: HirR = lower_expr(hs, cond)
  let body_fl: HirFlush = lower_body_stmts(cr.hs, body_lp)
  return hs_add_node(body_fl.hs, HirNode::HirWhile(cond = cr.hir, body_lp = body_fl.list_pos))

// The loop variable is the Local the resolver declared for the `for`
// statement itself.
fn lower_for_stmt(hs: HS, for_node: i64, iter_node: i64, body_lp: i64): HirR
  let var_sym: i64 = member_sym_of(hs.typecheck.lookup.index, hs.unit.module_id, for_node, "Local", "")
  let ir: HirR = lower_expr(hs, iter_node)
  let cur: HS = ir.hs
  if var_sym < 0:
    cur = hs_add_diag(cur, Span(to_i64(0), to_i64(1)), "for loop variable has no symbol")
  let body_fl: HirFlush = lower_body_stmts(cur, body_lp)
  return hs_add_node(body_fl.hs, HirNode::HirFor(var_sym = var_sym, iter = ir.hir, body_lp = body_fl.list_pos))

fn lower_return_stmt(hs: HS, val_node: i64): HirR
  if val_node < 0:
    return hs_add_node(hs, HirNode::HirReturn(value = to_i64(-1)))
  let vr: HirR = lower_expr(hs, val_node)
  return hs_add_node(vr.hs, HirNode::HirReturn(value = vr.hir))

// Whether a decimal literal's value fits a signed 64-bit integer, so
// parse_i64_literal can accumulate it without overflowing: at most
// 9223372036854775807 (…808 with a leading minus).  Decided on the
// digits, never by arithmetic that could itself overflow.
fn i64_literal_fits(lex: string): bool
  let start: i64 = 0
  let limit: string = "9223372036854775807"
  if length(lex) > to_i64(0):
    if substring(lex, to_i64(0), to_i64(1)) == "-":
      start = to_i64(1)
      limit = "9223372036854775808"
  while start < length(lex) - to_i64(1) and substring(lex, start, to_i64(1)) == "0":
    start = start + to_i64(1)
  let digits: string = substring(lex, start, length(lex) - start)
  if length(digits) != length(limit):
    return length(digits) < length(limit)
  // Same length: the first differing digit decides.
  let i: i64 = 0
  while i < length(limit):
    let d: i64 = char_to_digit(substring(digits, i, to_i64(1)))
    let m: i64 = char_to_digit(substring(limit, i, to_i64(1)))
    if d != m:
      return d < m
    i = i + to_i64(1)
  return true

// Parse an i64 literal (base 10, optional leading minus).
fn parse_i64_literal(lex: string): i64
  let lex_len: i64 = length(lex)
  let neg: bool = false
  let start: i64 = 0
  if lex_len > to_i64(0):
    if substring(lex, to_i64(0), to_i64(1)) == "-":
      neg = true
      start = to_i64(1)
  let v: i64 = to_i64(0)
  let i: i64 = start
  while i < lex_len:
    let ch: string = substring(lex, i, to_i64(1))
    let d: i64 = char_to_digit(ch)
    if d >= 0:
      v = v * to_i64(10) + d
    i = i + to_i64(1)
  if neg:
    v = to_i64(0) - v
  return v

fn char_to_digit(ch: string): i64
  if ch == "0":
    return to_i64(0)
  if ch == "1":
    return to_i64(1)
  if ch == "2":
    return to_i64(2)
  if ch == "3":
    return to_i64(3)
  if ch == "4":
    return to_i64(4)
  if ch == "5":
    return to_i64(5)
  if ch == "6":
    return to_i64(6)
  if ch == "7":
    return to_i64(7)
  if ch == "8":
    return to_i64(8)
  if ch == "9":
    return to_i64(9)
  return to_i64(-1)

// The operator a comparison `match` lowering synthesizes carries: `==`,
// with no source token behind it.
fn synthesized_equality_op(): i64
  return to_i64(-1)

// The symbol of a local a lowering synthesizes — `match`'s scrutinee —
// named by the HirLet that declares it: negative, below -1, so it is
// never a resolver symbol and never "no symbol".
fn synthetic_local_sym(let_node: i64): i64
  return to_i64(-2) - let_node

// Statements lowered into a list: the state after them, and the list
// grown by them.
class HirStmts:
  hs: HS
  stmts: Vector<i64>

// Lower a `match` into `out` as the host does (lower_match_into): a
// `let` of the scrutinee, then an `if` chain with one arm per test.  A
// payload-bearing enum is tested on its discriminant against each arm's
// variant index, the arm binding a `let` per payload value; any other
// scrutinee (a classification enum, an integer) against the pattern's
// value, a variant's being its index.
fn lower_match_into(hs: HS, scrut_node: i64, arms_lp: i64, out: Vector<i64>): HirStmts
  let scrut_r: HirR = lower_expr(hs, scrut_node)
  let cur: HS = scrut_r.hs
  let scrut_ti: i64 = hir_get_expr_type(cur, scrut_node)
  let scrut_sym: i64 = synthetic_local_sym(cur.arena.nodes.length())
  let scrut_let_r: HirR = hs_add_node(cur, HirNode::HirLet(sym = scrut_sym, typ = scrut_ti, init = scrut_r.hir))
  cur = scrut_let_r.hs
  let tagged: bool = hir_enum_has_payload(cur, scrut_ti)

  let arms: Vector<i64> = read_pairs(cur.unit.idx_data, arms_lp)
  let arm_conds: Vector<i64> = Vector<i64>::new()
  let arm_bodies: Vector<i64> = Vector<i64>::new()
  let i: i64 = 0
  while i < arms.length():
    let pat_node: i64 = arms.get(i)
    let variant: i64 = hir_pattern_variant(cur, pat_node)
    let scrut_ref: HirR = hs_add_node(cur, HirNode::HirIdent(sym = scrut_sym, typ = scrut_ti, tok = to_i64(-1)))
    cur = scrut_ref.hs
    let tested: i64 = scrut_ref.hir
    if tagged:
      let disc_r: HirR = hs_add_node(cur, HirNode::HirEnumDiscriminant(value = scrut_ref.hir, typ = scrut_ti))
      cur = disc_r.hs
      tested = disc_r.hir
    let pattern: i64 = to_i64(-1)
    if variant >= 0:
      let tag_r: HirR = hs_add_node(cur, HirNode::HirIntLit(value = variant, typ = scrut_ti))
      cur = tag_r.hs
      pattern = tag_r.hir
    else:
      let pat_r: HirR = lower_expr(cur, pat_node)
      cur = pat_r.hs
      pattern = pat_r.hir
    let cond_r: HirR = hs_add_node(cur, HirNode::HirBinary(op = synthesized_equality_op(), left = tested, right = pattern, typ = to_i64(10)))
    cur = cond_r.hs
    // Each binding a `let` of its payload value, ahead of the body.
    let bound: HirStmts = HirStmts(cur, Vector<i64>::new())
    if tagged and variant >= 0:
      bound = lower_arm_bindings(cur, pat_node, scrut_sym, scrut_ti, variant)
    let body: HirStmts = lower_stmts_into(bound.hs, arms.get(i + 1), bound.stmts)
    let body_fl: HirFlush = hir_flush_list(body.hs, body.stmts)
    cur = body_fl.hs
    arm_conds = arm_conds.push(cond_r.hir)
    arm_bodies = arm_bodies.push(body_fl.list_pos)
    i = i + 2

  // The chain, from the last arm to the first.
  let chain_hir: i64 = to_i64(-1)
  let ai: i64 = arm_conds.length() - 1
  while ai >= 0:
    let else_lp: i64 = to_i64(-1)
    if chain_hir >= 0:
      let else_items: Vector<i64> = Vector<i64>::new()
      else_items = else_items.push(chain_hir)
      let else_fl: HirFlush = hir_flush_list(cur, else_items)
      cur = else_fl.hs
      else_lp = else_fl.list_pos
    let if_r: HirR = hs_add_node(cur, HirNode::HirIf(cond = arm_conds.get(ai), then_lp = arm_bodies.get(ai), else_lp = else_lp))
    cur = if_r.hs
    chain_hir = if_r.hir
    ai = ai - 1

  let grown: Vector<i64> = out.push(scrut_let_r.hir)
  if chain_hir >= 0:
    grown = grown.push(chain_hir)
  return HirStmts(cur, grown)

// The `let`s an arm's bindings lower to: binding `j` of variant
// `variant`'s pattern holds the scrutinee's `j`-th payload value, typed
// as the checker typed the binding.
fn lower_arm_bindings(hs: HS, pat_node: i64, scrut_sym: i64, scrut_ti: i64, variant: i64): HirStmts
  let lets: Vector<i64> = Vector<i64>::new()
  let cur: HS = hs
  match cur.unit.nodes.get(pat_node):
    Node::CallE(callee, args_lp, arg_count, targs_lp, names_lp, targs_on_type):
      let binders: Vector<i64> = read_list(cur.unit.idx_data, args_lp)
      let bi: i64 = 0
      while bi < binders.length():
        let binding_sym: i64 = member_sym_of(cur.typecheck.lookup.index, cur.unit.module_id, binders.get(bi), "Local", "")
        if binding_sym < 0:
          cur = hs_add_diag(cur, Span(to_i64(0), to_i64(1)), "match arm binding has no symbol")
        else:
          let binding_ti: i64 = hir_sym_type(cur, binding_sym)
          let ref_r: HirR = hs_add_node(cur, HirNode::HirIdent(sym = scrut_sym, typ = scrut_ti, tok = to_i64(-1)))
          let payload_r: HirR = hs_add_node(ref_r.hs, HirNode::HirEnumPayload(value = ref_r.hir, variant = variant, field = bi, typ = binding_ti))
          let let_r: HirR = hs_add_node(payload_r.hs, HirNode::HirLet(sym = binding_sym, typ = binding_ti, init = payload_r.hir))
          cur = let_r.hs
          lets = lets.push(let_r.hir)
        bi = bi + 1
  return HirStmts(cur, lets)

// The declaration index of the variant a pattern names — `Enum::Variant`
// or the same applied to bindings — as the checker recorded it; -1 for
// any other pattern.
fn hir_pattern_variant(hs: HS, pat_node: i64): i64
  let named: i64 = pat_node
  match hs.unit.nodes.get(pat_node):
    Node::CallE(callee, args_lp, arg_count, targs_lp, names_lp, targs_on_type):
      named = callee
  return hm_get_or(hs.typecheck.lookup.expr_types, variant_index_key(hs.unit.module_id, named), to_i64(-1))

// Whether `ti` is an enum with a variant that carries a payload: its
// values are tagged, and `match` tests their discriminant.  Variants
// are recorded on the head (an instantiation's record names it).
fn hir_enum_has_payload(hs: HS, ti: i64): bool
  if ti < 0 or ti >= hs.typecheck.types.length():
    return false
  let t: DaoType = hs.typecheck.types.get(ti)
  match t.kind:
    TypeKind::TEnum:
      let head: DaoType = t
      if t.ret_type >= 0 and t.ret_type < hs.typecheck.type_info.length():
        head = hs.typecheck.types.get(hs.typecheck.type_info.get(t.ret_type))
      // Per variant: name, payload count, then (name, type) per value.
      let at: i64 = head.info_lp
      let vi: i64 = 0
      while vi < head.info_count:
        let count: i64 = hs.typecheck.type_info.get(at + 1)
        if count > 0:
          return true
        at = at + 2 + count * 2
        vi = vi + 1
  return false

// Lower the statements at `list_pos` onto `prefix`.  A `match` lowers
// into two statements (lower_match_into), so statements lower into a
// list rather than one node each.
fn lower_stmts_into(hs: HS, list_pos: i64, prefix: Vector<i64>): HirStmts
  if list_pos < 0:
    return HirStmts(hs, prefix)
  let stmts: Vector<i64> = read_list(hs.unit.idx_data, list_pos)
  let cur: HirStmts = HirStmts(hs, prefix)
  let i: i64 = 0
  while i < stmts.length():
    let is_match: bool = false
    match cur.hs.unit.nodes.get(stmts.get(i)):
      Node::MatchS(scrut_node, arms_lp):
        is_match = true
        cur = lower_match_into(cur.hs, scrut_node, arms_lp, cur.stmts)
    if is_match == false:
      let sr: HirR = lower_stmt(cur.hs, stmts.get(i))
      cur = HirStmts(sr.hs, cur.stmts.push(sr.hir))
    i = i + 1
  return cur

fn lower_body_stmts(hs: HS, list_pos: i64): HirFlush
  let lowered: HirStmts = lower_stmts_into(hs, list_pos, Vector<i64>::new())
  return hir_flush_list(lowered.hs, lowered.stmts)

// =========================================================================
// Section 56: Declaration lowering
// =========================================================================

// Re-lower AST type param list into HIR-owned idx.
// AST tparams_lp points to GenericParamT node indices in ast_idx.
// HIR stores (name token, type index) pairs via hir_flush_pairs: the
// type index is the parameter's TGenericParam type, which carries the
// parameter's bound concepts (`info_lp` / `info_count`, recorded by the
// type checker), so a bound reaches HIR with its meaning rather than as
// a bare name; -1 when the checker never typed the parameter.
fn lower_type_params(hs: HS, ast_tparams_lp: i64): HirFlush
  if ast_tparams_lp < 0:
    // No type params — return a flush with list_pos = -1
    return HirFlush(hs, to_i64(-1))
  let tparam_nodes: Vector<i64> = read_list(hs.unit.idx_data, ast_tparams_lp)
  let items: Vector<i64> = Vector<i64>::new()
  let count: i64 = 0
  let i: i64 = 0
  while i < tparam_nodes.length():
    let tp_node_idx: i64 = tparam_nodes.get(i)
    if tp_node_idx >= 0:
      let tp_node: Node = hs.unit.nodes.get(tp_node_idx)
      match tp_node:
        Node::GenericParamT(tidx, bounds_lp):
          items = items.push(tidx)
          items = items.push(hir_generic_param_type(hs, tidx))
          count = count + 1
    i = i + 1
  if count == 0:
    return HirFlush(hs, to_i64(-1))
  return hir_flush_pairs(hs, items, count)

// The TGenericParam type index of the type parameter declared at token
// `tidx` (the resolver binds a parameter's declaring token to its
// symbol), or -1 when the checker never typed it.
fn hir_generic_param_type(hs: HS, tidx: i64): i64
  let sym_idx: i64 = hir_lookup_use(hs, tidx)
  if sym_idx < 0:
    return to_i64(-1)
  return hir_sym_type(hs, sym_idx)

// A callable's lowered header — what every function form (block- or
// expression-bodied, extern, a class's or an extend's method) shares:
// its symbol, its return type (from its function type), and its type
// parameters and (symbol, type) parameter pairs flushed into the arena.
class FnHeader:
  hs: HS
  sym: i64
  ret: i64
  tparams_pos: i64
  params_pos: i64

fn lower_fn_header(hs: HS, decl_idx: i64, tparams_lp: i64, params_lp: i64): FnHeader
  let tp_fl: HirFlush = lower_type_params(hs, tparams_lp)
  let ret_ti: i64 = to_i64(11)
  let fn_sym: i64 = hir_find_callable_sym_by_decl(tp_fl.hs, decl_idx)
  if fn_sym >= 0:
    let fn_ti: i64 = hir_sym_type(tp_fl.hs, fn_sym)
    if fn_ti >= 0:
      let fn_type: DaoType = tp_fl.hs.typecheck.types.get(fn_ti)
      ret_ti = fn_type.ret_type
  let pairs: Vector<i64> = read_pairs(tp_fl.hs.unit.idx_data, params_lp)
  let param_items: Vector<i64> = Vector<i64>::new()
  let param_count: i64 = 0
  let pi: i64 = 0
  while pi < pairs.length():
    let p_tidx: i64 = pairs.get(pi)
    let p_name: string = hs_tok_name(hs, p_tidx)
    let p_sym: i64 = hir_find_param_sym(hs, decl_idx, p_name)
    let p_ti: i64 = to_i64(-1)
    if p_sym >= 0:
      p_ti = hir_sym_type(hs, p_sym)
    param_items = param_items.push(p_sym)
    param_items = param_items.push(p_ti)
    param_count = param_count + 1
    pi = pi + 2
  let param_fl: HirFlush = hir_flush_pairs(tp_fl.hs, param_items, param_count)
  return FnHeader(param_fl.hs, fn_sym, ret_ti, tp_fl.list_pos, param_fl.list_pos)

// A block-bodied function, or a method of the class or extend whose
// name token is `class_owner_tidx` (-1 for a free function).
fn lower_fn_decl_with_owner(hs: HS, decl_idx: i64, tparams_lp: i64, params_lp: i64, body_lp: i64, class_owner_tidx: i64): HirR
  let hd: FnHeader = lower_fn_header(hs, decl_idx, tparams_lp, params_lp)
  let body_fl: HirFlush = lower_body_stmts(hd.hs, body_lp)
  return hs_add_node(body_fl.hs, HirNode::HirFunction(sym = hd.sym, tparams = hd.tparams_pos, params = hd.params_pos, ret = hd.ret, body = body_fl.list_pos, is_extern = to_i64(0), class_owner = class_owner_tidx))

fn lower_fn_decl(hs: HS, decl_idx: i64, name_tidx: i64, tparams_lp: i64, params_lp: i64, ret_type_node: i64, body_lp: i64): HirR
  return lower_fn_decl_with_owner(hs, decl_idx, tparams_lp, params_lp, body_lp, to_i64(-1))

// An expression-bodied function or method: the body is one `return`
// of the expression.
fn lower_expr_fn_decl_with_owner(hs: HS, decl_idx: i64, tparams_lp: i64, params_lp: i64, body_expr: i64, class_owner_tidx: i64): HirR
  let hd: FnHeader = lower_fn_header(hs, decl_idx, tparams_lp, params_lp)
  let body_r: HirR = lower_expr(hd.hs, body_expr)
  let ret_r: HirR = hs_add_node(body_r.hs, HirNode::HirReturn(value = body_r.hir))
  let body_stmts: Vector<i64> = Vector<i64>::new()
  body_stmts = body_stmts.push(ret_r.hir)
  let body_fl: HirFlush = hir_flush_list(ret_r.hs, body_stmts)
  return hs_add_node(body_fl.hs, HirNode::HirFunction(sym = hd.sym, tparams = hd.tparams_pos, params = hd.params_pos, ret = hd.ret, body = body_fl.list_pos, is_extern = to_i64(0), class_owner = class_owner_tidx))

fn lower_expr_fn_decl(hs: HS, decl_idx: i64, name_tidx: i64, tparams_lp: i64, params_lp: i64, ret_type_node: i64, body_expr: i64): HirR
  return lower_expr_fn_decl_with_owner(hs, decl_idx, tparams_lp, params_lp, body_expr, to_i64(-1))

fn lower_extern_fn_decl(hs: HS, decl_idx: i64, name_tidx: i64, tparams_lp: i64, params_lp: i64, ret_type_node: i64): HirR
  let hd: FnHeader = lower_fn_header(hs, decl_idx, tparams_lp, params_lp)
  // No body — use empty list
  let empty_body_fl: HirFlush = hir_flush_list(hd.hs, Vector<i64>::new())
  return hs_add_node(empty_body_fl.hs, HirNode::HirFunction(sym = hd.sym, tparams = hd.tparams_pos, params = hd.params_pos, ret = hd.ret, body = empty_body_fl.list_pos, is_extern = to_i64(1), class_owner = to_i64(-1)))

fn lower_class_decl(hs: HS, decl_idx: i64, name_tidx: i64, tparams_lp: i64, fields_lp: i64, methods_lp: i64): HirR
  let tp_fl: HirFlush = lower_type_params(hs, tparams_lp)
  let pairs: Vector<i64> = read_pairs(tp_fl.hs.unit.idx_data, fields_lp)
  let field_items: Vector<i64> = Vector<i64>::new()
  let field_count: i64 = 0
  let fi: i64 = 0
  while fi < pairs.length():
    let f_tidx: i64 = pairs.get(fi)
    let f_type_node: i64 = pairs.get(fi + 1)
    let fname: string = hs_tok_name(hs, f_tidx)
    let fsym: i64 = hir_find_field_sym(hs, decl_idx, fname)
    let f_ti: i64 = to_i64(-1)
    if fsym >= 0:
      f_ti = hir_sym_type(hs, fsym)
    field_items = field_items.push(f_tidx)
    field_items = field_items.push(f_ti)
    field_count = field_count + 1
    fi = fi + 2
  let fl: HirFlush = hir_flush_pairs(tp_fl.hs, field_items, field_count)
  return hs_add_node(fl.hs, HirNode::HirStruct(name = name_tidx, tparams = tp_fl.list_pos, fields = fl.list_pos))

// Resolve an AST type node to a type index. Handles NamedT, GenericT
// (`Ptr<T>` among them), and qualified names.
fn resolve_type_to_idx(hs: HS, type_node_idx: i64): i64
  if type_node_idx < 0:
    return to_i64(-1)
  // First try expr_types (type checker may have recorded it)
  let ti: i64 = hir_get_expr_type(hs, type_node_idx)
  if ti >= 0:
    return ti
  let tn: Node = hs.unit.nodes.get(type_node_idx)
  match tn:
    Node::NamedT(ttidx):
      let tsym: i64 = hir_lookup_use(hs, ttidx)
      if tsym >= 0:
        return hir_sym_type(hs, tsym)
      // Try builtin name lookup
      let tname: string = hs_tok_name(hs, ttidx)
      if tname == "i8":
        return 0
      if tname == "i16":
        return 1
      if tname == "i32":
        return 2
      if tname == "i64":
        return 3
      if tname == "u8":
        return 4
      if tname == "u16":
        return 5
      if tname == "u32":
        return 6
      if tname == "u64":
        return 7
      if tname == "f32":
        return 8
      if tname == "f64":
        return 9
      if tname == "bool":
        return 10
      if tname == "string":
        return 12
    Node::GenericT(name_tidx, args_lp, arg_count):
      // `Ptr<T>` names the pointer the type checker registered for that
      // pointee (ADR_RAW_POINTER_SURFACE.md); every other generic head
      // resolves by its name.
      if hs_tok_name(hs, name_tidx) == "Ptr":
        let pargs: Vector<i64> = read_list(hs.unit.idx_data, args_lp)
        if pargs.length() == 1:
          let inner_ti: i64 = resolve_type_to_idx(hs, pargs.get(0))
          let pti: i64 = 0
          while pti < hs.typecheck.types.length():
            let pt: DaoType = hs.typecheck.types.get(pti)
            match pt.kind:
              TypeKind::TPointer:
                if pt.pointee == inner_ti:
                  return pti
            pti = pti + 1
          return to_i64(-1)
      let tsym: i64 = hir_lookup_use(hs, name_tidx)
      if tsym >= 0:
        return hir_sym_type(hs, tsym)
  return to_i64(-1)

fn lower_enum_decl(hs: HS, decl_idx: i64, name_tidx: i64, tparams_lp: i64, variants_lp: i64): HirR
  let tp_fl: HirFlush = lower_type_params(hs, tparams_lp)
  let pairs: Vector<i64> = read_pairs(tp_fl.hs.unit.idx_data, variants_lp)
  let var_items: Vector<i64> = Vector<i64>::new()
  let var_count: i64 = 0
  let cur: HS = tp_fl.hs
  let vi: i64 = 0
  while vi < pairs.length():
    let v_tidx: i64 = pairs.get(vi)
    let ast_payload_lp: i64 = pairs.get(vi + 1)
    // The payload list is (field name token, type node) pairs; HIR keeps
    // the types in declaration order.
    let payload_fields: Vector<i64> = read_list(cur.unit.idx_data, ast_payload_lp)
    let hir_payload: Vector<i64> = Vector<i64>::new()
    let pi: i64 = 1
    while pi < payload_fields.length():
      let pti: i64 = resolve_type_to_idx(cur, payload_fields.get(pi))
      hir_payload = hir_payload.push(pti)
      pi = pi + 2
    // Flush payload types into HIR idx
    let payload_fl: HirFlush = hir_flush_list(cur, hir_payload)
    cur = payload_fl.hs
    var_items = var_items.push(v_tidx)
    var_items = var_items.push(payload_fl.list_pos)
    var_count = var_count + 1
    vi = vi + 2
  let fl: HirFlush = hir_flush_pairs(cur, var_items, var_count)
  return hs_add_node(fl.hs, HirNode::HirEnum(name = name_tidx, tparams = tp_fl.list_pos, variants = fl.list_pos))

fn lower_type_alias_decl(hs: HS, decl_idx: i64, name_tidx: i64, target_type_node: i64): HirR
  // Find the type index for the alias
  let sym_idx: i64 = hir_find_type_sym_by_decl(hs, decl_idx)
  let ti: i64 = to_i64(-1)
  if sym_idx >= 0:
    ti = hir_sym_type(hs, sym_idx)
  return hs_add_node(hs, HirNode::HirTypeAlias(name = name_tidx, typ = ti))

fn lower_decl(hs: HS, decl_idx: i64): HirR
  let node: Node = hs.unit.nodes.get(decl_idx)
  match node:
    Node::FnDeclD(name_tidx, tparams_lp, params_lp, ret_type_node, body_lp):
      return lower_fn_decl(hs, decl_idx, name_tidx, tparams_lp, params_lp, ret_type_node, body_lp)
    Node::ExprFnD(name_tidx, tparams_lp, params_lp, ret_type_node, body_expr):
      return lower_expr_fn_decl(hs, decl_idx, name_tidx, tparams_lp, params_lp, ret_type_node, body_expr)
    Node::ExternFnD(name_tidx, tparams_lp, params_lp, ret_type_node):
      return lower_extern_fn_decl(hs, decl_idx, name_tidx, tparams_lp, params_lp, ret_type_node)
    Node::ClassDeclD(name_tidx, tparams_lp, fields_lp, methods_lp):
      return lower_class_decl(hs, decl_idx, name_tidx, tparams_lp, fields_lp, methods_lp)
    Node::EnumDeclD(name_tidx, tparams_lp, variants_lp):
      return lower_enum_decl(hs, decl_idx, name_tidx, tparams_lp, variants_lp)
    Node::TypeAliasD(name_tidx, target_type):
      return lower_type_alias_decl(hs, decl_idx, name_tidx, target_type)
    Node::ConceptDeclD(name_tidx, tparams_lp, methods_lp, is_derived):
      // Concepts produce no runtime code — emit a no-op.  The derived
      // marker is preserved on the AST; it drives no lowering yet.
      return hs_add_node(hs, HirNode::HirErrorStmt(tok = to_i64(0)))
    Node::ExtendDeclD(target_type_node, concept_name_tidx, methods_lp):
      // Extend methods are emitted in lower_file; return a no-op here
      return hs_add_node(hs, HirNode::HirErrorStmt(tok = to_i64(0)))
    Node::ErrorD(t):
      return hs_add_node(hs, HirNode::HirErrorStmt(tok = to_i64(0)))
  return hs_add_node(hs, HirNode::HirErrorStmt(tok = to_i64(0)))

// =========================================================================
// Section 57: Symbol lookup helpers for HIR
// =========================================================================

// The callable symbol a declaration introduces (see
// `find_callable_sym`).  A declaration whose symbol is not found
// lowers with a `void` return, so the lookup must know both kinds —
// and both halves of the identity, since declaration indices are
// file-local.
// The declaration indexes the checker built (ProgramIndex) answer HIR's
// symbol lookups in constant time, keyed by the module being lowered.
fn hir_find_callable_sym_by_decl(hs: HS, decl_idx: i64): i64
  return hm_get_or(hs.typecheck.lookup.index.callables, decl_key(hs.unit.module_id, decl_idx), to_i64(-1))

// The type symbol (a class, enum, alias, or concept) declared at
// `decl_idx` in the module being lowered, from the declaration index.
fn hir_find_type_sym_by_decl(hs: HS, decl_idx: i64): i64
  return hm_get_or(hs.typecheck.lookup.index.type_syms, decl_key(hs.unit.module_id, decl_idx), to_i64(-1))

fn hir_find_param_sym(hs: HS, decl_idx: i64, param_name: string): i64
  return member_sym_of(hs.typecheck.lookup.index, hs.unit.module_id, decl_idx, "Param", param_name)

fn hir_find_field_sym(hs: HS, decl_idx: i64, field_name: string): i64
  return member_sym_of(hs.typecheck.lookup.index, hs.unit.module_id, decl_idx, "Field", field_name)

// =========================================================================
// Section 58: File lowering and public API
// =========================================================================

fn lower_file(hs: HS, file_node_idx: i64): HirR
  let node: Node = hs.unit.nodes.get(file_node_idx)
  match node:
    Node::FileN(module_decl, imports_lp, decls_lp):
      let decls: Vector<i64> = read_list(hs.unit.idx_data, decls_lp)
      let cur: HS = hs
      let hir_decls: Vector<i64> = Vector<i64>::new()
      let i: i64 = 0
      while i < decls.length():
        let dr: HirR = lower_decl(cur, decls.get(i))
        cur = dr.hs
        hir_decls = hir_decls.push(dr.hir)
        // Emit methods as flat top-level HirFunction nodes with
        // class_owner set to the class name token for mangled identity.
        let decl_node: Node = hs.unit.nodes.get(decls.get(i))
        match decl_node:
          Node::ClassDeclD(cn_tidx, cn_tp, cn_fl, cn_ml):
            if cn_ml >= 0:
              let methods: Vector<i64> = read_list(cur.unit.idx_data, cn_ml)
              let mi: i64 = 0
              while mi < methods.length():
                let meth_idx: i64 = methods.get(mi)
                let meth_node: Node = cur.unit.nodes.get(meth_idx)
                match meth_node:
                  Node::FnDeclD(m_name_tidx, m_tparams_lp, m_params_lp, m_ret_type, m_body_lp):
                    let mr: HirR = lower_fn_decl_with_owner(cur, meth_idx, m_tparams_lp, m_params_lp, m_body_lp, cn_tidx)
                    cur = mr.hs
                    hir_decls = hir_decls.push(mr.hir)
                  Node::ExprFnD(m_name_tidx, m_tparams_lp, m_params_lp, m_ret_type, m_body_expr):
                    let mer: HirR = lower_expr_fn_decl_with_owner(cur, meth_idx, m_tparams_lp, m_params_lp, m_body_expr, cn_tidx)
                    cur = mer.hs
                    hir_decls = hir_decls.push(mer.hir)
                mi = mi + 1
          Node::ExtendDeclD(ext_target, ext_cname, ext_ml):
            if ext_ml >= 0:
              // Get target type name token for owner
              let ext_owner_tidx: i64 = to_i64(-1)
              if ext_target >= 0:
                let tnode: Node = cur.unit.nodes.get(ext_target)
                match tnode:
                  Node::NamedT(t_tidx):
                    ext_owner_tidx = t_tidx
              let ext_methods: Vector<i64> = read_list(cur.unit.idx_data, ext_ml)
              let emi: i64 = 0
              while emi < ext_methods.length():
                let emeth_idx: i64 = ext_methods.get(emi)
                let emeth_node: Node = cur.unit.nodes.get(emeth_idx)
                match emeth_node:
                  Node::FnDeclD(em_name_tidx, em_tparams_lp, em_params_lp, em_ret_type, em_body_lp):
                    let emr: HirR = lower_fn_decl_with_owner(cur, emeth_idx, em_tparams_lp, em_params_lp, em_body_lp, ext_owner_tidx)
                    cur = emr.hs
                    hir_decls = hir_decls.push(emr.hir)
                  Node::ExprFnD(em_name_tidx, em_tparams_lp, em_params_lp, em_ret_type, em_body_expr):
                    let emer: HirR = lower_expr_fn_decl_with_owner(cur, emeth_idx, em_tparams_lp, em_params_lp, em_body_expr, ext_owner_tidx)
                    cur = emer.hs
                    hir_decls = hir_decls.push(emer.hir)
                emi = emi + 1
        i = i + 1
      let fl: HirFlush = hir_flush_list(cur, hir_decls)
      return hs_add_node(fl.hs, HirNode::HirFile(decls_lp = fl.list_pos))
  return hs_add_node(hs, HirNode::HirErrorStmt(tok = to_i64(0)))

// =========================================================================
// Section 58a: Program-level HIR lowering (Task 27 D6/D7)
// =========================================================================

// Build a per-module HS from Program state.
fn build_module_hs(p: Program, mid: i64): HS
  return hs_new(p, mid, arena_empty())

// Lower the full program to HIR. For each module in topo order,
// lower its file AST via `lower_file` (unchanged), extract the
// HirFile's decls, wrap in HirModule, and collect all modules in
// a HirProgram root.
//
// Requires: `program_run_resolve` and `program_run_typecheck` have
// already populated `p.resolve` and `p.typecheck`.
fn program_run_hir(p: Program): Program
  // Guard: if HIR is already initialized, return unchanged. Same
  // pattern as program_init_typecheck — prevents diagnostic
  // duplication on reentrant calls.
  if p.hir.initialized:
    return p
  return program_lower_hir(p).program

// A program lowered to HIR and the HIR itself: the arena lives beside
// the program because `HirData` is shared with programs that have no
// HIR types (shared/base.dao).
class ProgramHir:
  program: Program
  arena: HirArena

// Lower the program to HIR and keep the arena, for a pass that lowers
// it further (MIR).  The arena exists only in the result, so a program
// already lowered cannot give it back: that is reported, never answered
// with an empty arena.
fn program_lower_hir(p: Program): ProgramHir
  if p.hir.initialized:
    let already: Vector<FileDiagnostic> = p.diags.push(FileDiagnostic(to_i64(-1), "", make_error(Span(to_i64(0), to_i64(1)), "program already lowered to HIR; its arena was not kept")))
    return ProgramHir(Program(p.graph, p.resolve, p.typecheck, p.hir, already), arena_empty())
  let hir_nodes: Vector<HirNode> = Vector<HirNode>::new()
  let hir_idx: Vector<i64> = Vector<i64>::new()
  let module_indices: Vector<i64> = Vector<i64>::new()
  // Seed diagnostics from the program's so far (parse, resolve,
  // typecheck): a construct the checker rejected stays reported.  This
  // pass runs once per program (the guard above), so nothing is added
  // twice.
  let all_diags: Vector<FileDiagnostic> = p.diags

  let ti: i64 = 0
  while ti < p.graph.topo_order.length():
    let mid: i64 = p.graph.topo_order.get(ti)
    let sf: SourceFile = program_file_of_module(p, mid)
    let po: ParseOutput = sf.parse_output
    let hs: HS = hs_new(p, mid, HirArena(hir_nodes, hir_idx))

    let file_r: HirR = lower_file(hs, po.root)
    // Extract the HirFile's decls_lp and wrap in HirModule.
    hir_nodes = file_r.hs.arena.nodes
    hir_idx = file_r.hs.arena.idx
    let file_node: HirNode = hir_nodes.get(file_r.hir)
    let module_decls_lp: i64 = to_i64(-1)
    match file_node:
      HirNode::HirFile(dlp):
        module_decls_lp = dlp
    // Extract module name token from the ModuleDeclN node.
    let mod_name_tok: i64 = to_i64(-1)
    let root_node: Node = po.nodes.get(po.root)
    match root_node:
      Node::FileN(mod_decl, imp_lp, dec_lp):
        if mod_decl >= 0:
          let md_node: Node = po.nodes.get(mod_decl)
          match md_node:
            Node::ModuleDeclN(path_lp, seg_count):
              if seg_count > 0:
                // First segment token of the module path.
                mod_name_tok = po.idx.get(path_lp - seg_count)
    // Emit HirModule wrapping the file's decls.
    let mod_idx: i64 = hir_nodes.length()
    hir_nodes = hir_nodes.push(HirNode::HirModule(name_tok = mod_name_tok, decl_list_lp = module_decls_lp, module_id = mid))
    module_indices = module_indices.push(mod_idx)
    // Merge diagnostics.
    let di: i64 = 0
    while di < file_r.hs.diags.length():
      all_diags = all_diags.push(FileDiagnostic(sf.file_id, sf.path, file_r.hs.diags.get(di)))
      di = di + 1
    ti = ti + 1

  // Emit HirProgram root. Build a temporary HS to use hir_flush_list.
  let tmp_hs: HS = HS(HirModule(Vector<Node>::new(), Vector<i64>::new(), Vector<Token>::new(), "", to_i64(-1), to_i64(-1)), Vector<Symbol>::new(), TypeCheckData(false, Vector<DaoType>::new(), Vector<i64>::new(), Vector<i64>::new(), program_lookup_empty()), HashMap<i64>::new(), HirArena(hir_nodes, hir_idx), Vector<Diagnostic>::new())
  let mod_fl: HirFlush = hir_flush_list(tmp_hs, module_indices)
  hir_nodes = mod_fl.hs.arena.nodes
  hir_idx = mod_fl.hs.arena.idx
  let prog_idx: i64 = hir_nodes.length()
  hir_nodes = hir_nodes.push(HirNode::HirProgram(module_list_lp = mod_fl.list_pos))

  let hd: HirData = HirData(true, prog_idx, hir_nodes.length(), p.graph.topo_order.length())
  return ProgramHir(Program(p.graph, p.resolve, p.typecheck, hd, all_diags), HirArena(hir_nodes, hir_idx))

// =========================================================================
// Section 58b: Legacy single-file HIR adapter
// =========================================================================

fn lower_to_hir(src: string): HirResult
  // Route through the program pipeline so HS sees the same
  // composite-keyed uses/expr_types HashMaps as program_run_hir.
  // wrap_test_module leaves the source unchanged if it already
  // starts with its own `module` declaration, so callers that
  // provide complete file text still work.
  let wrapped: string = wrap_test_module(src)
  let inputs: Vector<SourceInput> = Vector<SourceInput>::new()
  inputs = inputs.push(SourceInput("test.dao", wrapped, false))
  let pg: ProgramGraph = program_graph_empty()
  resource memory graph =>
    pg = build_program(inputs)
  let p: Program = program_from_graph(pg)
  // Each stage in its own domain: its scratch is reclaimed at the exit and the result is copied out.
  resource memory resolve =>
    p = program_run_resolve(p)
  resource memory typecheck =>
    p = program_run_typecheck(p)

  // Single module at mid=0.
  let mid: i64 = to_i64(0)
  let sf: SourceFile = program_file_of_module(p, mid)
  let po: ParseOutput = sf.parse_output
  let hs: HS = hs_new(p, mid, arena_empty())

  // Lower
  let result: HirR = HirR(hs, to_i64(-1))
  resource memory hir_lowering =>
    result = lower_file(hs, po.root)
  let final_hs: HS = result.hs

  // Every diagnostic of the stages before HIR travels with the result,
  // so a construct the checker rejected is reported, never lowered as
  // if it were sound.
  return HirResult(final_hs.arena.nodes, final_hs.arena.idx, final_hs.typecheck.types, final_hs.typecheck.type_info, final_hs.unit.toks, final_hs.unit.src, program_and_hir_diags(p, final_hs.diags), result.hir)

// The diagnostics a single-file lowering carries on: the program's
// (parse, resolve, typecheck) and the HIR stage's.
fn program_and_hir_diags(p: Program, hir_diags: Vector<Diagnostic>): Vector<Diagnostic>
  let out: Vector<Diagnostic> = Vector<Diagnostic>::new()
  let i: i64 = 0
  while i < p.diags.length():
    out = out.push(p.diags.get(i).diag)
    i = i + 1
  let j: i64 = 0
  while j < hir_diags.length():
    out = out.push(hir_diags.get(j))
    j = j + 1
  return out

// =========================================================================
// Section 59: HIR node kind name
// =========================================================================

fn hir_node_kind(node: HirNode): string
  match node:
    HirNode::HirProgram(a):
      return "HirProgram"
    HirNode::HirModule(a, b, c):
      return "HirModule"
    HirNode::HirFile(a):
      return "HirFile"
    HirNode::HirFunction(a, b, c, d, e, f, g):
      return "HirFunction"
    HirNode::HirStruct(a, b, c):
      return "HirStruct"
    HirNode::HirEnum(a, b, c):
      return "HirEnum"
    HirNode::HirTypeAlias(a, b):
      return "HirTypeAlias"
    HirNode::HirLet(a, b, c):
      return "HirLet"
    HirNode::HirAssign(a, b):
      return "HirAssign"
    HirNode::HirIf(a, b, c):
      return "HirIf"
    HirNode::HirWhile(a, b):
      return "HirWhile"
    HirNode::HirResource(a, b, c):
      return "HirResource"
    HirNode::HirMode(a, b):
      return "HirMode"
    HirNode::HirYield(a):
      return "HirYield"
    HirNode::HirFor(a, b, c):
      return "HirFor"
    HirNode::HirReturn(a):
      return "HirReturn"
    HirNode::HirBreak(a):
      return "HirBreak"
    HirNode::HirExprStmt(a):
      return "HirExprStmt"
    HirNode::HirErrorStmt(a):
      return "HirErrorStmt"
    HirNode::HirIntLit(a, b):
      return "HirIntLit"
    HirNode::HirFloatLit(a, b):
      return "HirFloatLit"
    HirNode::HirStringLit(a, b):
      return "HirStringLit"
    HirNode::HirBoolLit(a, b):
      return "HirBoolLit"
    HirNode::HirIdent(a, b, c):
      return "HirIdent"
    HirNode::HirBinary(a, b, c, d):
      return "HirBinary"
    HirNode::HirUnary(a, b, c):
      return "HirUnary"
    HirNode::HirCall(a, b, c, d, e):
      return "HirCall"
    HirNode::HirFieldAccess(a, b, c):
      return "HirFieldAccess"
    HirNode::HirPipe(a, b, c):
      return "HirPipe"
    HirNode::HirQualName(a, b, c):
      return "HirQualName"
    HirNode::HirEnumDiscriminant(a, b):
      return "HirEnumDiscriminant"
    HirNode::HirEnumPayload(a, b, c, d):
      return "HirEnumPayload"
    HirNode::HirConstruct(a, b, c):
      return "HirConstruct"
    HirNode::HirPtrOp(a, b, c, d):
      return "HirPtrOp"
    HirNode::HirEnumConstruct(a, b, c, d):
      return "HirEnumConstruct"
    HirNode::HirErrorExpr(a):
      return "HirErrorExpr"
  return "Unknown"

// =========================================================================
// Section 60: HIR textual dump
// =========================================================================

// `<T: A + B, U>` for a HIR type-parameter pair list ((name token, type
// index) pairs, see lower_type_params): each parameter's bound concepts
// are read off its TGenericParam type; a bound whose concept type is
// unreadable in this module prints as `?`.
fn hir_tparams_label(hr: HirResult, tparams_lp: i64): string
  let count: i64 = hr.hir_idx.get(tparams_lp)
  let start: i64 = tparams_lp - count * 2
  let line: string = "<"
  let i: i64 = 0
  while i < count:
    if i > 0:
      line = line + ", "
    let tp_tidx: i64 = hr.hir_idx.get(start + i * 2)
    let tp_ti: i64 = hr.hir_idx.get(start + i * 2 + 1)
    if tp_tidx >= 0:
      let tp_tok: Token = hr.toks.get(tp_tidx)
      line = line + substring(hr.src, tp_tok.offset, tp_tok.len)
    if tp_ti >= 0:
      if tp_ti < hr.types.length():
        let gt: DaoType = hr.types.get(tp_ti)
        if gt.info_count > 0:
          if gt.info_lp + gt.info_count <= hr.type_info.length():
            line = line + ": "
            let bi: i64 = 0
            while bi < gt.info_count:
              if bi > 0:
                line = line + " + "
              let cti: i64 = hr.type_info.get(gt.info_lp + bi)
              let bound_label: string = "?"
              if cti >= 0:
                if cti < hr.types.length():
                  let ct: DaoType = hr.types.get(cti)
                  bound_label = ct.name
              line = line + bound_label
              bi = bi + 1
    i = i + 1
  return line + ">"

fn hir_type_label(hr: HirResult, ti: i64): string
  if ti < 0:
    return "<unknown>"
  if ti >= hr.types.length():
    return "<out-of-range>"
  let t: DaoType = hr.types.get(ti)
  return t.name

fn hir_dump_node(hr: HirResult, idx: i64, indent: i64): string
  if idx < 0:
    return ""
  let node: HirNode = hr.hir_nodes.get(idx)
  let pad: string = ""
  let pi: i64 = 0
  while pi < indent:
    pad = pad + "  "
    pi = pi + 1
  let kind: string = hir_node_kind(node)
  let line: string = pad + kind
  match node:
    HirNode::HirProgram(module_list_lp):
      line = line + "\n"
      let mods: Vector<i64> = read_list(hr.hir_idx, module_list_lp)
      let mi: i64 = 0
      while mi < mods.length():
        line = line + hir_dump_node(hr, mods.get(mi), indent + 1)
        mi = mi + 1
      return line
    HirNode::HirModule(name_tok, decl_list_lp, mod_id):
      line = line + " (module_id=" + i64_to_string(mod_id) + ")\n"
      let decls: Vector<i64> = read_list(hr.hir_idx, decl_list_lp)
      let di: i64 = 0
      while di < decls.length():
        line = line + hir_dump_node(hr, decls.get(di), indent + 1)
        di = di + 1
      return line
    HirNode::HirFile(decls_lp):
      line = line + "\n"
      let decls: Vector<i64> = read_list(hr.hir_idx, decls_lp)
      let di: i64 = 0
      while di < decls.length():
        line = line + hir_dump_node(hr, decls.get(di), indent + 1)
        di = di + 1
      return line
    HirNode::HirFunction(fn_sym, tparams_lp, params_lp, ret_ti, body_lp, is_extern, class_owner):
      if class_owner >= 0:
        let co_tok: Token = hr.toks.get(class_owner)
        line = line + " [" + substring(hr.src, co_tok.offset, co_tok.len) + ".]"
      if tparams_lp >= 0:
        line = line + hir_tparams_label(hr, tparams_lp)
      if is_extern > 0:
        line = line + " [extern]"
      line = line + " -> " + hir_type_label(hr, ret_ti)
      line = line + "\n"
      let body: Vector<i64> = read_list(hr.hir_idx, body_lp)
      let bi: i64 = 0
      while bi < body.length():
        line = line + hir_dump_node(hr, body.get(bi), indent + 1)
        bi = bi + 1
      return line
    HirNode::HirStruct(name_tidx, tparams_lp, fields_lp):
      if tparams_lp >= 0:
        let tps: Vector<i64> = read_list(hr.hir_idx, tparams_lp)
        line = line + "<" + i64_to_string(tps.length()) + " params>"
      line = line + "\n"
      return line
    HirNode::HirEnum(name_tidx, tparams_lp, variants_lp):
      if tparams_lp >= 0:
        let tps: Vector<i64> = read_list(hr.hir_idx, tparams_lp)
        line = line + "<" + i64_to_string(tps.length()) + " params>"
      line = line + "\n"
      return line
    HirNode::HirTypeAlias(name_tidx, ti2):
      line = line + " -> " + hir_type_label(hr, ti2) + "\n"
      return line
    HirNode::HirLet(name_tidx, ti2, init_hir):
      line = line + " : " + hir_type_label(hr, ti2)
      if init_hir >= 0:
        line = line + " =\n"
        line = line + hir_dump_node(hr, init_hir, indent + 1)
      else:
        line = line + "\n"
      return line
    HirNode::HirAssign(target, value):
      line = line + "\n"
      line = line + hir_dump_node(hr, target, indent + 1)
      line = line + hir_dump_node(hr, value, indent + 1)
      return line
    HirNode::HirIf(cond, then_lp, else_lp):
      line = line + "\n"
      line = line + hir_dump_node(hr, cond, indent + 1)
      let then_stmts: Vector<i64> = read_list(hr.hir_idx, then_lp)
      let ti2: i64 = 0
      while ti2 < then_stmts.length():
        line = line + hir_dump_node(hr, then_stmts.get(ti2), indent + 1)
        ti2 = ti2 + 1
      if else_lp >= 0:
        let else_stmts: Vector<i64> = read_list(hr.hir_idx, else_lp)
        let ei: i64 = 0
        while ei < else_stmts.length():
          line = line + hir_dump_node(hr, else_stmts.get(ei), indent + 1)
          ei = ei + 1
      return line
    HirNode::HirWhile(cond, body_lp):
      line = line + "\n"
      line = line + hir_dump_node(hr, cond, indent + 1)
      let body: Vector<i64> = read_list(hr.hir_idx, body_lp)
      let bi: i64 = 0
      while bi < body.length():
        line = line + hir_dump_node(hr, body.get(bi), indent + 1)
        bi = bi + 1
      return line
    HirNode::HirResource(kind_tidx, name_tidx, body_lp):
      let kind_tok: Token = hr.toks.get(kind_tidx)
      let name_tok: Token = hr.toks.get(name_tidx)
      line = line + " " + substring(hr.src, kind_tok.offset, kind_tok.len) + " " + substring(hr.src, name_tok.offset, name_tok.len) + "\n"
      let rbody: Vector<i64> = read_list(hr.hir_idx, body_lp)
      let ri: i64 = 0
      while ri < rbody.length():
        line = line + hir_dump_node(hr, rbody.get(ri), indent + 1)
        ri = ri + 1
      return line
    HirNode::HirMode(name_tidx, body_lp):
      let mode_tok: Token = hr.toks.get(name_tidx)
      line = line + " " + substring(hr.src, mode_tok.offset, mode_tok.len) + "\n"
      let mbody: Vector<i64> = read_list(hr.hir_idx, body_lp)
      let mi: i64 = 0
      while mi < mbody.length():
        line = line + hir_dump_node(hr, mbody.get(mi), indent + 1)
        mi = mi + 1
      return line
    HirNode::HirYield(val):
      if val >= 0:
        line = line + "\n"
        line = line + hir_dump_node(hr, val, indent + 1)
        return line
      line = line + "\n"
      return line
    HirNode::HirFor(var_sym, iter, body_lp):
      line = line + "\n"
      line = line + hir_dump_node(hr, iter, indent + 1)
      let body: Vector<i64> = read_list(hr.hir_idx, body_lp)
      let bi: i64 = 0
      while bi < body.length():
        line = line + hir_dump_node(hr, body.get(bi), indent + 1)
        bi = bi + 1
      return line
    HirNode::HirReturn(val):
      if val >= 0:
        line = line + "\n"
        line = line + hir_dump_node(hr, val, indent + 1)
        return line
      line = line + "\n"
      return line
    HirNode::HirBreak(d):
      line = line + "\n"
      return line
    HirNode::HirExprStmt(expr):
      line = line + "\n"
      line = line + hir_dump_node(hr, expr, indent + 1)
      return line
    HirNode::HirErrorStmt(d):
      line = line + "\n"
      return line
    HirNode::HirIntLit(value, ti2):
      line = line + " " + i64_to_string(value) + " : " + hir_type_label(hr, ti2) + "\n"
      return line
    HirNode::HirFloatLit(tidx, ti2):
      line = line + " : " + hir_type_label(hr, ti2) + "\n"
      return line
    HirNode::HirStringLit(tidx, ti2):
      line = line + " : " + hir_type_label(hr, ti2) + "\n"
      return line
    HirNode::HirBoolLit(tidx, ti2):
      line = line + " : " + hir_type_label(hr, ti2) + "\n"
      return line
    HirNode::HirIdent(sym_idx, ti2, tidx):
      line = line + " : " + hir_type_label(hr, ti2) + "\n"
      return line
    HirNode::HirBinary(op_tidx, left, right, ti2):
      line = line + " : " + hir_type_label(hr, ti2) + "\n"
      line = line + hir_dump_node(hr, left, indent + 1)
      line = line + hir_dump_node(hr, right, indent + 1)
      return line
    HirNode::HirUnary(op_tidx, operand, ti2):
      line = line + " : " + hir_type_label(hr, ti2) + "\n"
      line = line + hir_dump_node(hr, operand, indent + 1)
      return line
    HirNode::HirCall(callee, args_lp, arg_count, ti2, subst):
      line = line + " : " + hir_type_label(hr, ti2) + "\n"
      line = line + hir_dump_node(hr, callee, indent + 1)
      let args: Vector<i64> = read_list(hr.hir_idx, args_lp)
      let ai: i64 = 0
      while ai < args.length():
        line = line + hir_dump_node(hr, args.get(ai), indent + 1)
        ai = ai + 1
      return line
    HirNode::HirFieldAccess(obj, ftidx, ti2):
      line = line + " : " + hir_type_label(hr, ti2) + "\n"
      line = line + hir_dump_node(hr, obj, indent + 1)
      return line
    HirNode::HirPipe(left, right, ti2):
      line = line + " : " + hir_type_label(hr, ti2) + "\n"
      line = line + hir_dump_node(hr, left, indent + 1)
      line = line + hir_dump_node(hr, right, indent + 1)
      return line
    HirNode::HirQualName(first_tok, seg_count, ti2):
      line = line + " : " + hir_type_label(hr, ti2) + "\n"
      return line
    HirNode::HirEnumDiscriminant(value, ti2):
      line = line + "\n"
      line = line + hir_dump_node(hr, value, indent + 1)
      return line
    HirNode::HirEnumPayload(value, variant, field, ti2):
      line = line + " variant=" + i64_to_string(variant) + " field=" + i64_to_string(field) + " : " + hir_type_label(hr, ti2) + "\n"
      line = line + hir_dump_node(hr, value, indent + 1)
      return line
    HirNode::HirConstruct(args_lp, arg_count, ti2):
      line = line + " : " + hir_type_label(hr, ti2) + "\n"
      let cargs: Vector<i64> = read_list(hr.hir_idx, args_lp)
      let ci: i64 = 0
      while ci < cargs.length():
        line = line + hir_dump_node(hr, cargs.get(ci), indent + 1)
        ci = ci + 1
      return line
    HirNode::HirPtrOp(op, pointer, argument, ti2):
      line = line + " " + ptr_op_name(op) + " : " + hir_type_label(hr, ti2) + "\n"
      line = line + hir_dump_node(hr, pointer, indent + 1)
      line = line + hir_dump_node(hr, argument, indent + 1)
      return line
    HirNode::HirEnumConstruct(variant, payload_lp, payload_count, ti2):
      line = line + " variant=" + i64_to_string(variant) + " : " + hir_type_label(hr, ti2) + "\n"
      let pairs: Vector<i64> = read_pairs(hr.hir_idx, payload_lp)
      let pi2: i64 = 0
      while pi2 < pairs.length():
        line = line + hir_dump_node(hr, pairs.get(pi2), indent + 1)
        pi2 = pi2 + 2
      return line
    HirNode::HirErrorExpr(d):
      line = line + "\n"
      return line
  return pad + "???\n"

fn hir_dump(hr: HirResult): string
  return hir_dump_node(hr, hr.root, 0)
