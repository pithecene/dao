    // The expr fn should be desugared: HirFunction body contains HirReturn
    let found_fn11: bool = false
    let found_ret11: bool = false
    let i11: i64 = 0
    while i11 < hir_count_nodes(r11):
      let n11: HirNode = r11.hir_nodes.get(i11)
