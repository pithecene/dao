File
  Module enums
  EnumDecl Direction
    Variant North
    Variant South
    Variant East
    Variant West
  FunctionDecl opposite
    Param d: Direction
    ReturnType: Direction
    IfStatement
      Condition
        BinaryExpr ==
          Identifier d
          QualifiedName Direction::North
      Then
        ReturnStatement
          QualifiedName Direction::South
    IfStatement
      Condition
        BinaryExpr ==
          Identifier d
          QualifiedName Direction::South
      Then
        ReturnStatement
          QualifiedName Direction::North
    IfStatement
      Condition
        BinaryExpr ==
          Identifier d
          QualifiedName Direction::East
      Then
        ReturnStatement
          QualifiedName Direction::West
    ReturnStatement
      QualifiedName Direction::East
  FunctionDecl direction_name
    Param d: Direction
    ReturnType: string
    IfStatement
      Condition
        BinaryExpr ==
          Identifier d
          QualifiedName Direction::North
      Then
        ReturnStatement
          StringLiteral "North"
    IfStatement
      Condition
        BinaryExpr ==
          Identifier d
          QualifiedName Direction::South
      Then
        ReturnStatement
          StringLiteral "South"
    IfStatement
      Condition
        BinaryExpr ==
          Identifier d
          QualifiedName Direction::East
      Then
        ReturnStatement
          StringLiteral "East"
    IfStatement
      Condition
        BinaryExpr ==
          Identifier d
          QualifiedName Direction::West
      Then
        ReturnStatement
          StringLiteral "West"
    ReturnStatement
      StringLiteral "?"
  FunctionDecl main
    ReturnType: i32
    LetStatement d: Direction
      QualifiedName Direction::East
    ExpressionStatement
      CallExpr
        Callee
          Identifier print
        Args
          BinaryExpr +
            StringLiteral "direction: "
            CallExpr
              Callee
                Identifier direction_name
              Args
                Identifier d
    ExpressionStatement
      CallExpr
        Callee
          Identifier print
        Args
          BinaryExpr +
            StringLiteral "opposite:  "
            CallExpr
              Callee
                Identifier direction_name
              Args
                CallExpr
                  Callee
                    Identifier opposite
                  Args
                    Identifier d
    IfStatement
      Condition
        BinaryExpr ==
          Identifier d
          QualifiedName Direction::East
      Then
        ExpressionStatement
          CallExpr
            Callee
              Identifier print
            Args
              StringLiteral "heading east"
    IfStatement
      Condition
        BinaryExpr !=
          Identifier d
          QualifiedName Direction::North
      Then
        ExpressionStatement
          CallExpr
            Callee
              Identifier print
            Args
              StringLiteral "not heading north"
    ReturnStatement
      IntLiteral 0
