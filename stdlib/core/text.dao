module core::text

// Text is assembled in a Builder: a Vector<u8> of bytes that grows
// amortized, turned into a string once, by one copy into the current
// domain.  `a = a + piece` in a loop copies the whole accumulated
// string every round -- quadratic in the result -- and leaves every
// intermediate behind; a builder leaves only its dead buffers, which
// the domain reclaims.

// A string of `len` bytes copied from `bytes`, owned by the current domain.
extern fn __dao_str_from_bytes(bytes: Ptr<u8>, len: i64): string

class Builder:
  bytes: Vector<u8>

  fn new(): Builder
    return Builder(Vector<u8>::new())

  fn with_capacity(cap: i64): Builder
    return Builder(Vector<u8>::with_capacity(cap))

  fn is_empty(self): bool -> self.bytes.length() == to_i64(0)

  // The builder with the bytes of `s` appended.
  fn push(self, s: string): Builder
    let out: Vector<u8> = self.bytes
    let n: i64 = length(s)
    let i: i64 = 0
    while i < n:
      out = out.push(u32_to_u8(i32_to_u32(char_at(s, i))))
      i = i + 1
    return Builder(out)

  // The builder with one byte appended, given as `char_at` gives it.
  fn push_char(self, c: i32): Builder
    return Builder(self.bytes.push(u32_to_u8(i32_to_u32(c))))

  // The builder with `s` followed by LF (`\n`) appended.
  fn push_line(self, s: string): Builder
    return self.push(s).push_char(10)

  fn push_i64(self, n: i64): Builder
    return self.push(i64_to_string(n))

  fn push_i32(self, n: i32): Builder
    return self.push(i32_to_string(n))

  fn push_bool(self, b: bool): Builder
    return self.push(bool_to_string(b))

  fn length(self): i64 -> self.bytes.length()

  // One copy of the bytes, as a string the current domain owns.  The
  // bytes are read as this builder's value sees them, so a later write
  // through another value of the same buffer is invisible here.
  fn to_string(self): string
    let bytes: Vector<u8> = self.bytes.snapshot()
    return __dao_str_from_bytes(bytes.data, bytes.len)

fn join(parts: Vector<string>, sep: string): string
  let count: i64 = parts.length()
  if count == to_i64(0):
    return ""
  if count == to_i64(1):
    return parts.get(to_i64(0))
  let sep_len: i64 = length(sep)
  let total: i64 = sep_len * (count - to_i64(1))
  let i: i64 = 0
  while i < count:
    total = total + length(parts.get(i))
    i = i + 1
  let out: Builder = Builder::with_capacity(total)
  i = to_i64(0)
  while i < count:
    if i > to_i64(0):
      out = out.push(sep)
    out = out.push(parts.get(i))
    i = i + 1
  return out.to_string()

fn repeat(s: string, count: i64): string
  if count < to_i64(0):
    panic("repeat: negative count")
  if count == to_i64(0) or length(s) == to_i64(0):
    return ""
  let out: Builder = Builder::with_capacity(length(s) * count)
  let i: i64 = 0
  while i < count:
    out = out.push(s)
    i = i + 1
  return out.to_string()
