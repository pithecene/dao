module core::string
extern fn __dao_str_concat(a: string, b: string): string
extern fn __dao_str_length(s: string): i64
extern fn __dao_str_char_at(s: string, index: i64): i32
extern fn __dao_str_substring(s: string, start: i64, len: i64): string
extern fn __dao_str_index_of(s: string, needle: string): i64
extern fn __dao_str_starts_with(s: string, prefix: string): bool
extern fn __dao_str_ends_with(s: string, suffix: string): bool
extern fn __dao_str_compare(a: string, b: string): i32
extern fn __dao_str_copy_outer(s: string): string

// A copy of `s` in the enclosing domain (what `copy_out` does for a string).
fn copy_out_string(s: string): string -> __dao_str_copy_outer(s)

fn concat(a: string, b: string): string -> __dao_str_concat(a, b)
fn length(s: string): i64 -> __dao_str_length(s)
fn char_at(s: string, index: i64): i32 -> __dao_str_char_at(s, index)
fn substring(s: string, start: i64, len: i64): string -> __dao_str_substring(s, start, len)
fn index_of(s: string, needle: string): i64 -> __dao_str_index_of(s, needle)
fn starts_with(s: string, prefix: string): bool -> __dao_str_starts_with(s, prefix)
fn ends_with(s: string, suffix: string): bool -> __dao_str_ends_with(s, suffix)
fn str_compare(a: string, b: string): i32 -> __dao_str_compare(a, b)

fn is_ascii_space(c: i32): bool
  return c == 32 or c == 9 or c == 10 or c == 13

fn trim_start(s: string): string
  let n: i64 = __dao_str_length(s)
  let i: i64 = 0
  while i < n:
    if is_ascii_space(__dao_str_char_at(s, i)) == false:
      return __dao_str_substring(s, i, n - i)
    i = i + 1
  return ""

fn trim_end(s: string): string
  let end: i64 = __dao_str_length(s)
  while end > to_i64(0):
    if is_ascii_space(__dao_str_char_at(s, end - to_i64(1))) == false:
      return __dao_str_substring(s, to_i64(0), end)
    end = end - to_i64(1)
  return ""

fn trim(s: string): string
  let n: i64 = __dao_str_length(s)
  let start: i64 = 0
  while start < n:
    if is_ascii_space(__dao_str_char_at(s, start)) == false:
      break
    start = start + 1
  if start >= n:
    return ""
  let end: i64 = n
  while end > start:
    if is_ascii_space(__dao_str_char_at(s, end - to_i64(1))) == false:
      break
    end = end - to_i64(1)
  return __dao_str_substring(s, start, end - start)

fn index_of_from(s: string, s_len: i64, needle: string, needle_len: i64, from: i64): i64
  if needle_len == to_i64(0):
    return from
  if needle_len > s_len - from:
    return to_i64(-1)
  let first: i32 = __dao_str_char_at(needle, to_i64(0))
  let limit: i64 = s_len - needle_len
  let pos: i64 = from
  while pos <= limit:
    if __dao_str_char_at(s, pos) == first:
      let matched: bool = true
      let j: i64 = 1
      while j < needle_len:
        if __dao_str_char_at(s, pos + j) != __dao_str_char_at(needle, j):
          matched = false
          break
        j = j + 1
      if matched:
        return pos
    pos = pos + 1
  return to_i64(-1)

fn split(s: string, sep: string): Vector<string>
  let sep_len: i64 = __dao_str_length(sep)
  if sep_len == to_i64(0):
    panic("split: separator must not be empty")
  let out: Vector<string> = Vector<string>::new()
  let n: i64 = __dao_str_length(s)
  let start: i64 = 0
  while start <= n:
    let match_pos: i64 = index_of_from(s, n, sep, sep_len, start)
    if match_pos < to_i64(0):
      out = out.push(__dao_str_substring(s, start, n - start))
      return out
    out = out.push(__dao_str_substring(s, start, match_pos - start))
    start = match_pos + sep_len
  return out

fn lines(s: string): Vector<string>
  let out: Vector<string> = Vector<string>::new()
  let n: i64 = __dao_str_length(s)
  if n == to_i64(0):
    return out
  let pos: i64 = 0
  while pos < n:
    let line_start: i64 = pos
    while pos < n:
      if __dao_str_char_at(s, pos) == 10:
        break
      pos = pos + 1
    let line_end: i64 = pos
    if line_end > line_start:
      if __dao_str_char_at(s, line_end - to_i64(1)) == 13:
        line_end = line_end - to_i64(1)
    out = out.push(__dao_str_substring(s, line_start, line_end - line_start))
    pos = pos + 1
  return out

// Checked decimal `i64` parser accepting optional leading `+` or `-` and
// handling `INT64_MIN` (`-9223372036854775808`) without overflow trap.
fn parse_i64(s: string): Option<i64>
  let n: i64 = __dao_str_length(s)
  if n == to_i64(0):
    return Option::None
  let pos: i64 = 0
  let negative: bool = false
  let first: i32 = __dao_str_char_at(s, to_i64(0))
  if first == 45:
    negative = true
    pos = to_i64(1)
  else if first == 43:
    pos = to_i64(1)
  if pos >= n:
    return Option::None
  // Accumulate as negative so INT64_MIN (-9223372036854775808) fits in i64.
  let neg_acc: i64 = to_i64(0)
  while pos < n:
    let ch: i32 = __dao_str_char_at(s, pos)
    if ch < 48 or ch > 57:
      return Option::None
    let digit: i64 = to_i64(ch - 48)
    match checked_mul_i64(neg_acc, to_i64(10)):
      Option::Some(scaled):
        neg_acc = scaled
      Option::None:
        return Option::None
    match checked_sub_i64(neg_acc, digit):
      Option::Some(next_val):
        neg_acc = next_val
      Option::None:
        return Option::None
    pos = pos + 1
  if negative:
    return Option::Some(value = neg_acc)
  match checked_sub_i64(to_i64(0), neg_acc):
    Option::Some(pos_val):
      return Option::Some(value = pos_val)
    Option::None:
      return Option::None
  return Option::None

fn parse_i32(s: string): Option<i32>
  match parse_i64(s):
    Option::Some(v):
      if v < to_i64(-2147483648) or v > to_i64(2147483647):
        return Option::None
      return Option::Some(value = i64_to_i32(v))
    Option::None:
      return Option::None
  return Option::None
