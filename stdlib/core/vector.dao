module core::vector
// vector.dao — Generic dynamic array.
//
// Value semantics without a copy per write.  The values made from one
// another by `push` and `set` share one buffer; the buffer keeps the
// stamp of its latest write, and a value keeps the stamp it reads at
// (`version`).  The latest value -- the one whose version is the
// buffer's stamp -- pushes and sets in place: a push writes past every
// older value's length, invisible to them, and a set logs the value it
// overwrites, so an older value still reads its own through the log.
// A value that is not the latest copies what it sees before writing.
// Linear use is therefore O(n) in total, and an older value is exact.

// The values a buffer's sets overwrote, shared by every value of the
// buffer through pointers, so a log that grows stays visible to all:
// the slot indexes and write stamps in one header, the values behind
// one cell (a class holding a `*T` of its own parameter cannot be
// instantiated inside `Vector<T>` yet).
class VecLogHead:
  index: *i64
  stamp: *i64
  len: i64
  cap: i64

fn vec_log_head_new(outer: bool): *VecLogHead
  let raw: *void = null_ptr<void>()
  if outer:
    raw = __dao_mem_alloc_outer(size_of<VecLogHead>(), align_of<VecLogHead>())
  else:
    raw = __dao_mem_alloc(size_of<VecLogHead>(), align_of<VecLogHead>())
  mode unsafe =>
    let head: *VecLogHead = ptr_cast<VecLogHead>(raw)
    *head = VecLogHead(null_ptr<i64>(), null_ptr<i64>(), to_i64(0), to_i64(0))
    return head
  panic("unreachable")

fn vec_log_values_new<T>(outer: bool): **T
  let raw: *void = null_ptr<void>()
  if outer:
    raw = __dao_mem_alloc_outer(size_of<*T>(), align_of<*T>())
  else:
    raw = __dao_mem_alloc(size_of<*T>(), align_of<*T>())
  mode unsafe =>
    let cell: **T = ptr_cast<*T>(raw)
    *cell = null_ptr<T>()
    return cell
  panic("unreachable")

class Vector<T>:
  data: *T
  len: i64
  cap: i64
  gen: *i64          // the buffer's latest write stamp; shared
  version: i64       // the stamp this value reads at
  log: *VecLogHead   // overwritten slots: indexes and stamps; shared
  log_value: **T     // overwritten slots: the values; shared

  fn new(): Vector<T>
    mode unsafe =>
      let gen: *i64 = ptr_cast<i64>(__dao_mem_alloc(size_of<i64>(), align_of<i64>()))
      *gen = to_i64(0)
      return Vector(null_ptr<T>(), to_i64(0), to_i64(0), gen, to_i64(0), vec_log_head_new(false), vec_log_values_new<T>(false))
    panic("unreachable")

  fn length(self): i64 -> self.len

  // Record that slot `index` holds its current value until write `stamp`.
  fn log_overwrite(self, index: i64, stamp: i64): void
    mode unsafe =>
      let l: VecLogHead = *self.log
      let values: *T = *self.log_value
      if l.len == l.cap:
        // The log lives with the buffer, in the domain that owns it:
        // a set inside a deeper block must not attach storage the
        // block reclaims to a buffer an outer value still reads.
        let owner: *void = ptr_cast<void>(self.data)
        let cap: i64 = l.cap * 2
        if cap < 8:
          cap = 8
        let ni: *i64 = ptr_cast<i64>(__dao_mem_alloc_owner(owner, size_of<i64>() * cap, align_of<i64>()))
        let ns: *i64 = ptr_cast<i64>(__dao_mem_alloc_owner(owner, size_of<i64>() * cap, align_of<i64>()))
        let nv: *T = ptr_cast<T>(__dao_mem_alloc_owner(owner, size_of<T>() * cap, align_of<T>()))
        let k: i64 = 0
        while k < l.len:
          *ptr_offset(ni, k) = *ptr_offset(l.index, k)
          *ptr_offset(ns, k) = *ptr_offset(l.stamp, k)
          *ptr_offset(nv, k) = *ptr_offset(values, k)
          k = k + 1
        l = VecLogHead(ni, ns, l.len, cap)
        values = nv
        *self.log_value = nv
      *ptr_offset(l.index, l.len) = index
      *ptr_offset(l.stamp, l.len) = stamp
      *ptr_offset(values, l.len) = *ptr_offset(self.data, index)
      *self.log = VecLogHead(l.index, l.stamp, l.len + 1, l.cap)

  // The element at `index` as this value sees it: the buffer's slot,
  // unless a later write overwrote it, in which case the value the
  // earliest such write logged.
  fn get(self, index: i64): T
    if index < 0:
      panic("Vector.get: index out of bounds")
    if index >= self.len:
      panic("Vector.get: index out of bounds")
    mode unsafe =>
      if *self.gen == self.version:
        return *ptr_offset(self.data, index)
      let l: VecLogHead = *self.log
      let best: i64 = to_i64(-1)
      let best_stamp: i64 = to_i64(0)
      let k: i64 = 0
      while k < l.len:
        if *ptr_offset(l.index, k) == index:
          let stamp: i64 = *ptr_offset(l.stamp, k)
          if stamp > self.version:
            if best < to_i64(0) or stamp < best_stamp:
              best = k
              best_stamp = stamp
        k = k + 1
      if best >= to_i64(0):
        return *ptr_offset(*self.log_value, best)
      return *ptr_offset(self.data, index)
    panic("unreachable")

  // This value's elements in one buffer no later write touched: the
  // buffer itself when this value is the latest, else a fresh copy of
  // what this value sees.  For readers of the raw buffer.
  fn snapshot(self): Vector<T>
    let latest: bool = false
    mode unsafe =>
      latest = *self.gen == self.version
    if latest:
      return self
    return self.refreshed(self.cap)

  // A fresh buffer of `cap` slots holding what this value sees, in the
  // current domain.  No element is copied out here, so an ordinary push
  // or set never instantiates an element type's copier.
  fn refreshed(self, cap: i64): Vector<T>
    mode unsafe =>
      let data: *T = ptr_cast<T>(__dao_mem_alloc(size_of<T>() * cap, align_of<T>()))
      let i: i64 = 0
      while i < self.len:
        *ptr_offset(data, i) = self.get(i)
        i = i + 1
      let gen: *i64 = ptr_cast<i64>(__dao_mem_alloc(size_of<i64>(), align_of<i64>()))
      *gen = to_i64(0)
      return Vector(data, self.len, cap, gen, to_i64(0), vec_log_head_new(false), vec_log_values_new<T>(false))
    panic("unreachable")

  fn push(self, elem: T): Vector<T>
    mode unsafe =>
      if self.len < self.cap:
        if *self.gen == self.version:
          // Latest with room: write past every older value's length.
          *ptr_offset(self.data, self.len) = elem
          let stamp: i64 = self.version + 1
          *self.gen = stamp
          return Vector(self.data, self.len + 1, self.cap, self.gen, stamp, self.log, self.log_value)
      // Grow, or leave a buffer another value wrote to: fresh storage
      // holding what this value sees, then the element.
      let cap: i64 = self.cap
      if self.len >= cap:
        cap = cap * 2
        if cap < 8:
          cap = 8
      let fresh: Vector<T> = self.refreshed(cap)
      *ptr_offset(fresh.data, fresh.len) = elem
      *fresh.gen = to_i64(1)
      return Vector(fresh.data, fresh.len + 1, fresh.cap, fresh.gen, to_i64(1), fresh.log, fresh.log_value)
    panic("unreachable")

  fn set(self, index: i64, elem: T): Vector<T>
    if index < 0:
      panic("Vector.set: index out of bounds")
    if index >= self.len:
      panic("Vector.set: index out of bounds")
    mode unsafe =>
      if *self.gen == self.version:
        // Latest: log what the slot held, then write in place.
        let stamp: i64 = self.version + 1
        self.log_overwrite(index, stamp)
        *ptr_offset(self.data, index) = elem
        *self.gen = stamp
        return Vector(self.data, self.len, self.cap, self.gen, stamp, self.log, self.log_value)
      let fresh: Vector<T> = self.refreshed(self.cap)
      *ptr_offset(fresh.data, index) = elem
      *fresh.gen = to_i64(1)
      return Vector(fresh.data, fresh.len, fresh.cap, fresh.gen, to_i64(1), fresh.log, fresh.log_value)
    panic("unreachable")

  // A copy of this vector, buffer and elements, in the enclosing
  // domain: what `copy_out` does for a vector.  Elements are copied
  // out one by one, so a vector of strings leaves with its strings.
  fn copy_out(self): Vector<T>
    mode unsafe =>
      let data: *T = ptr_cast<T>(__dao_mem_alloc_outer(size_of<T>() * self.cap, align_of<T>()))
      let i: i64 = 0
      while i < self.len:
        *ptr_offset(data, i) = copy_out<T>(self.get(i))
        i = i + 1
      let gen: *i64 = ptr_cast<i64>(__dao_mem_alloc_outer(size_of<i64>(), align_of<i64>()))
      *gen = to_i64(0)
      return Vector(data, self.len, self.cap, gen, to_i64(0), vec_log_head_new(true), vec_log_values_new<T>(true))
    panic("unreachable")

  fn iter(self): Generator<T>
    let i: i64 = 0
    while i < self.len:
      yield self.get(i)
      i = i + 1
