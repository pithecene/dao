module core::result

enum class Result<T, E>:
  Ok(value: T)
  Err(error: E)

fn result_is_ok<T, E>(res: Result<T, E>): bool
  match res:
    Result::Ok(v):
      return true
    Result::Err(e):
      return false
  return false

fn result_is_err<T, E>(res: Result<T, E>): bool
  match res:
    Result::Ok(v):
      return false
    Result::Err(e):
      return true
  return true

fn result_unwrap_or<T, E>(res: Result<T, E>, fallback: T): T
  match res:
    Result::Ok(v):
      return v
    Result::Err(e):
      return fallback
  return fallback

fn result_expect<T, E>(res: Result<T, E>, message: string): T
  match res:
    Result::Ok(v):
      return v
    Result::Err(e):
      panic(message)
  panic("unreachable")

fn result_ok<T, E>(res: Result<T, E>): Option<T>
  match res:
    Result::Ok(v):
      return Option::Some(value = v)
    Result::Err(e):
      return Option::None
  return Option::None

fn result_err<T, E>(res: Result<T, E>): Option<E>
  match res:
    Result::Ok(v):
      return Option::None
    Result::Err(e):
      return Option::Some(value = e)
  return Option::None
